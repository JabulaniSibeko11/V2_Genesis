@* ═══════════════════════════════════════════════════════════════════
   Views/Section78/Display.cshtml
   Unified display for Query, Review, Multi-purpose
   Deploy SAME file as both Display.cshtml and MultiPurposeDisplay.cshtml
   Controller sets ViewBag.IsMulti = true for multi-purpose path

   Redesigned to use the same dp-* structure/classes as
   Views/Objection/Display.cshtml so every "submission acknowledged"
   page in the app looks identical.
═══════════════════════════════════════════════════════════════════ *@
@{
    ViewData["Title"] = "Submission Acknowledged";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    bool isMulti = ViewBag.IsMulti == true;
    bool isReview = TempData.Peek("ReviewStat")?.ToString() == "R";
    string typeWord = isReview ? "Review" : "Query";

    var queryRef = TempData["id"]?.ToString() ?? "—";
    var pin = TempData["pin"]?.ToString() ?? "—";
    var count = TempData["Count"]?.ToString() ?? "0";
    var reason = TempData["objection_reason"]?.ToString();
    var date = DateTime.Now.ToString("dd MMMM yyyy HH:mm");

    var oldPropDesc = TempData["Old_Property_Description"]?.ToString();
    var oldCat = TempData["Old_Category"]?.ToString();
    var oldAddress = TempData["Old_Address"]?.ToString();
    var oldExtent = TempData["Old_Extent"]?.ToString();
    var oldMV = TempData["Old_Market_Value"]?.ToString();
    var oldOwner = TempData["Old_Owner"]?.ToString();

    var oldCat2 = TempData["Old2_Category"]?.ToString();
    var oldMV2 = TempData["Old2_Market_Value"]?.ToString();
    var oldExt2 = TempData["Old2_Extent"]?.ToString();
    var oldCat3 = TempData["Old3_Category"]?.ToString();
    var oldMV3 = TempData["Old3_Market_Value"]?.ToString();
    var oldExt3 = TempData["Old3_Extent"]?.ToString();

    var newPropDesc = TempData["new_Property_Description"]?.ToString();
    var newCat = TempData["new_Category"]?.ToString();
    var newAddress = TempData["new_Address"]?.ToString();
    var newExtent = TempData["new_Extent"]?.ToString();
    var newMV = TempData["new_Market_Value"]?.ToString();
    var newOwner = TempData["new_Owner"]?.ToString();

    var newCat2 = TempData["new2_Category"]?.ToString();
    var newMV2 = TempData["new2_Market_Value"]?.ToString();
    var newExt2 = TempData["new2_Extent"]?.ToString();
    var newCat3 = TempData["new3_Category"]?.ToString();
    var newMV3 = TempData["new3_Market_Value"]?.ToString();
    var newExt3 = TempData["new3_Extent"]?.ToString();

    var files = new List<string>();
    for (int i = 1; i <= 10; i++)
    {
        var f = TempData[$"File{i}"]?.ToString();
        if (!string.IsNullOrWhiteSpace(f)) files.Add(f);
    }

    // Keep everything alive in case page is refreshed
    TempData.Keep("id"); TempData.Keep("pin"); TempData.Keep("Count"); TempData.Keep("ReviewStat");
    for (int i = 1; i <= 10; i++) TempData.Keep($"File{i}");
    foreach (var k in new[]{ "Old_Property_Description","Old_Category","Old_Address",
        "Old_Extent","Old_Market_Value","Old_Owner",
        "Old2_Category","Old2_Market_Value","Old2_Extent",
        "Old3_Category","Old3_Market_Value","Old3_Extent",
        "new_Property_Description","new_Category","new_Address",
        "new_Extent","new_Market_Value","new_Owner",
        "new2_Category","new2_Market_Value","new2_Extent",
        "new3_Category","new3_Market_Value","new3_Extent",
        "objection_reason" })
    { TempData.Keep(k); }
}

@section Styles {
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/objection-display.css" rel="stylesheet" asp-append-version="true" />
}

<div class="dp-page">
    <div class="dp-inner">

        <div class="dp-hero">
            <div class="dp-hero-top">
                <div class="dp-hero-icon">
                    <i class="fa-solid fa-@(isReview ? "magnifying-glass" : "magnifying-glass-chart")"></i>
                </div>
                <div class="dp-hero-text">
                    <div class="dp-hero-eyebrow">City of Johannesburg · Valuation Services</div>
                    <h1 class="dp-hero-title">
                        <span>Section 78 @typeWord</span> @(isMulti ? "(Multiple Purposes) " : "")Acknowledged
                    </h1>
                    <p class="dp-hero-sub">
                        Your Section 78 @typeWord.ToLower() has been successfully received and logged.
                        An acknowledgement has been sent to the registered email address.
                    </p>
                </div>
                <div class="dp-type-badge">
                    <i class="fa-solid fa-circle-check"></i>
                    @(isReview ? "Review" : isMulti ? "Multi-Purpose" : "Query")
                </div>
            </div>

            <div class="dp-hero-meta">
                <div class="dp-hero-meta-item">
                    <div class="dp-hero-meta-label">Reference No.</div>
                    <div class="dp-hero-meta-value gold">@queryRef</div>
                </div>
                <div class="dp-hero-meta-item">
                    <div class="dp-hero-meta-label">PIN</div>
                    <div class="dp-hero-meta-value gold">@pin</div>
                </div>
                <div class="dp-hero-meta-item">
                    <div class="dp-hero-meta-label">Submitted On</div>
                    <div class="dp-hero-meta-value">@date</div>
                </div>
                <div class="dp-hero-meta-item">
                    <div class="dp-hero-meta-label">Supporting Documents</div>
                    <div class="dp-hero-meta-value">@count uploaded</div>
                </div>
            </div>
        </div>

        <div class="dp-body">

            <div class="dp-section">
                <div class="dp-section-header">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Important
                </div>
                <div class="dp-section-body">
                    <div class="dp-reason">
                        <div class="dp-reason-label">
                            <i class="fa-solid fa-clock" style="margin-right:5px;"></i>
                            48-hour evidence window
                        </div>
                        You have <strong>48 hours</strong> from the time of submission to upload any
                        outstanding supporting evidence. Keep your reference number
                        <strong>@queryRef</strong> for all future correspondence.
                    </div>
                </div>
            </div>

            <div class="dp-section">
                <div class="dp-section-header">
                    <i class="fa-solid fa-scale-balanced"></i>
                    Property Details &amp; Requested Changes
                </div>
                <div class="dp-section-body">
                    <div class="dp-compare">

                        <div>
                            <div class="dp-compare-col-head current">
                                <i class="fa-solid fa-book" style="margin-right:6px;"></i>
                                Entry on Valuation Roll
                            </div>

                            <table class="dp-compare-table">
                                <tr><td>Property</td><td>@(string.IsNullOrWhiteSpace(oldPropDesc) ? "–" : oldPropDesc)</td></tr>
                                <tr><td>Address</td><td>@(string.IsNullOrWhiteSpace(oldAddress) ? "–" : oldAddress)</td></tr>
                                <tr><td>Owner</td><td>@(string.IsNullOrWhiteSpace(oldOwner) ? "–" : oldOwner)</td></tr>
                            </table>

                            @if (isMulti)
                            {
                                <div class="dp-multi-title">Multipurpose Current Values</div>

                                <table class="dp-compare-table dp-multi-table">
                                    <thead>
                                        <tr>
                                            <th>Purpose</th>
                                            <th>Category</th>
                                            <th>Extent</th>
                                            <th>Market Value</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td>Purpose 1</td>
                                            <td>@(string.IsNullOrWhiteSpace(oldCat) ? "–" : oldCat)</td>
                                            <td>@(string.IsNullOrWhiteSpace(oldExtent) ? "–" : oldExtent)</td>
                                            <td>@(string.IsNullOrWhiteSpace(oldMV) ? "–" : oldMV)</td>
                                        </tr>

                                        @if (!string.IsNullOrWhiteSpace(oldCat2))
                                        {
                                            <tr>
                                                <td>Purpose 2</td>
                                                <td>@oldCat2</td>
                                                <td>@(oldExt2 ?? "–")</td>
                                                <td>@(oldMV2 ?? "–")</td>
                                            </tr>
                                        }

                                        @if (!string.IsNullOrWhiteSpace(oldCat3))
                                        {
                                            <tr>
                                                <td>Purpose 3</td>
                                                <td>@oldCat3</td>
                                                <td>@(oldExt3 ?? "–")</td>
                                                <td>@(oldMV3 ?? "–")</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <table class="dp-compare-table">
                                    <tr><td>Category</td><td>@(string.IsNullOrWhiteSpace(oldCat) ? "–" : oldCat)</td></tr>
                                    <tr><td>Extent</td><td>@(string.IsNullOrWhiteSpace(oldExtent) ? "–" : oldExtent)</td></tr>
                                    <tr><td>Market Value</td><td>@(string.IsNullOrWhiteSpace(oldMV) ? "–" : oldMV)</td></tr>
                                </table>
                            }
                        </div>

                        <div>
                            <div class="dp-compare-col-head requested">
                                <i class="fa-solid fa-pen-to-square" style="margin-right:6px;"></i>
                                Requested Changes
                            </div>

                            @{
                                void NewVal(string? v)
                                {
                                    <td class="dp-new-val @(string.IsNullOrWhiteSpace(v) ? "empty" : "")">
                                        @(string.IsNullOrWhiteSpace(v) ? "No change requested" : v)
                                    </td>
                                }
                            }

                            <table class="dp-compare-table">
                                <tr><td>Property</td>@{
                                    NewVal(newPropDesc);
                                }
                            </tr>
                            <tr><td>Address</td>@{
                                NewVal(newAddress);
                            }
                        </tr>
                        <tr><td>Owner</td>@{
                            NewVal(newOwner);
                        }
                    </tr>
                </table>

                @if (isMulti)
                {
                    <div class="dp-multi-title">Multipurpose Requested Changes</div>

                    <table class="dp-compare-table dp-multi-table">
                        <thead>
                            <tr>
                                <th>Purpose</th>
                                <th>Category</th>
                                <th>Extent</th>
                                <th>Market Value</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td>Purpose 1</td>
                                @{
                                    NewVal(newCat);
                                }
                                @{
                                    NewVal(newExtent);
                                }
                                @{
                                    NewVal(newMV);
                                }
                            </tr>
                            <tr>
                                <td>Purpose 2</td>
                                @{
                                    NewVal(newCat2);
                                }
                                @{
                                    NewVal(newExt2);
                                }
                                @{
                                    NewVal(newMV2);
                                }
                            </tr>
                            <tr>
                                <td>Purpose 3</td>
                                @{
                                    NewVal(newCat3);
                                }
                                @{
                                    NewVal(newExt3);
                                }
                                @{
                                    NewVal(newMV3);
                                }
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <table class="dp-compare-table">
                        <tr><td>Category</td>@{
                            NewVal(newCat);
                        }
                    </tr>
                    <tr><td>Extent</td>@{
                        NewVal(newExtent);
                    }
                </tr>
                <tr><td>Market Value</td>@{
                    NewVal(newMV);
                }
            </tr>
        </table>
    }
</div>
</div>

                    @if (!string.IsNullOrWhiteSpace(reason))
{
    <div style="margin-top:20px;">
        <div class="dp-reason">
            <div class="dp-reason-label">
                <i class="fa-solid fa-quote-left" style="margin-right:5px;"></i>
                @typeWord Reason
            </div>
            @reason
        </div>
    </div>
}
</div>
</div>

<div class="dp-section">
    <div class="dp-section-header">
        <i class="fa-solid fa-paperclip"></i>
        Supporting Documents / Evidence
    </div>

    <div class="dp-section-body">
        <p style="margin-bottom:14px;color:#555;">
            Files uploaded with the submitted @typeWord.ToLowerInvariant() form:
            <strong>@files.Count</strong>
        </p>

        @if (files.Any())
        {
            <div class="dp-doc-list">
                @for (int i = 0; i < files.Count; i++)
                {
                    <div class="dp-doc-item">
                        <div class="dp-doc-icon">
                            <i class="fa-solid fa-file"></i>
                        </div>
                        <div class="dp-doc-main">
                            <span class="dp-doc-name">@files[i]</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="dp-doc-empty">
                No supporting documents/evidence files were uploaded.
            </div>
        }
    </div>
</div>

<div class="dp-actions">
    <a href="@Url.Action("DownloadAcknowledgement", "Notice", new { objectionNo = queryRef, rollSource = "Query" })"
           class="dp-btn-primary"
           onclick="showDlToast()">
        <i class="fa-solid fa-download"></i>
        Download Acknowledgement
    </a>
    <a asp-controller="Dashboard" asp-action="Index" class="dp-btn-secondary">
        <i class="fa-solid fa-gauge-high"></i>
        My Dashboard
    </a>
    <a asp-controller="Home" asp-action="Index" class="dp-btn-secondary">
        <i class="fa-solid fa-house"></i>
        Home
    </a>
</div>

</div>

<div style="text-align:center; font-size:11.5px; color:#aaa; padding:16px 8px 0;">
    This is an official document generated by the City of Johannesburg
    Valuation Services Department. Generated: @date
</div>

</div>
</div>

@section Scripts {
    <script>
        function showDlToast() {
            console.log('Acknowledgement download started');
        }
    </script>
}
