@* ═══════════════════════════════════════════════════════════════════
   Views/Section78/Display.cshtml
   Unified display for Query, Review, Multi-purpose
   Deploy SAME file as both Display.cshtml and MultiPurposeDisplay.cshtml
   Controller sets ViewBag.IsMulti = true for multi-purpose path

   Redesigned to use the same dp-* structure/classes as
   Views/Objection/Display.cshtml so every "submission acknowledged"
   page in the app looks identical.
═══════════════════════════════════════════════════════════════════ *@
@{
    ViewData["Title"] = "Submission Acknowledged";
    // Layout = "~/Views/Shared/_ClientLayout.cshtml";
    Layout = "~/Views/Shared/_Legend_Layout.cshtml";

    bool isMulti = ViewBag.IsMulti == true;
    bool isReview = TempData.Peek("ReviewStat")?.ToString() == "R";
    string typeWord = isReview ? "Review" : "Query";

    var queryRef = TempData["id"]?.ToString();
    if (string.IsNullOrWhiteSpace(queryRef))
        queryRef = Context.Session.GetString("Section78Ref");
    if (string.IsNullOrWhiteSpace(queryRef))
        queryRef = "—";
    var hasAckRef = queryRef != "—";
    var pin = TempData["pin"]?.ToString() ?? "—";
    var count = TempData["Count"]?.ToString() ?? "0";
    var reason = TempData["objection_reason"]?.ToString();
    var date = DateTime.Now.ToString("dd MMMM yyyy HH:mm");

    string FormatRand(string? value)
    {
        if (string.IsNullOrWhiteSpace(value) || value.Trim() is "-" or "–")
            return "–";

        var cleaned = System.Text.RegularExpressions.Regex.Replace(
            value.Trim(),
            @"[Rr\s,\u00A0\u202F]",
            string.Empty);

        if (decimal.TryParse(
            cleaned,
            System.Globalization.NumberStyles.AllowDecimalPoint |
            System.Globalization.NumberStyles.AllowLeadingSign,
            System.Globalization.CultureInfo.InvariantCulture,
            out var amount))
        {
            var rounded = decimal.Round(amount, 0, MidpointRounding.AwayFromZero);
            return "R " + rounded
                .ToString("#,0", System.Globalization.CultureInfo.InvariantCulture)
                .Replace(',', ' ');
        }

        var fallback = value.Trim().TrimStart('R', 'r').Trim();
        return string.IsNullOrWhiteSpace(fallback) ? "–" : $"R {fallback}";
    }

    decimal? ParseDisplayNumber(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return null;

        var cleaned = System.Text.RegularExpressions.Regex.Replace(
            value.Trim(),
            @"[Rr\s,\u00A0\u202F]",
            string.Empty);

        return decimal.TryParse(
            cleaned,
            System.Globalization.NumberStyles.AllowDecimalPoint |
            System.Globalization.NumberStyles.AllowLeadingSign,
            System.Globalization.CultureInfo.InvariantCulture,
            out var amount)
                ? amount
                : null;
    }

    string FormatExtent(string? value)
    {
        var amount = ParseDisplayNumber(value);
        if (!amount.HasValue) return "–";

        return amount.Value
            .ToString("#,0.##", System.Globalization.CultureInfo.InvariantCulture)
            .Replace(',', ' ');
    }

    var oldPropDesc = TempData["Old_Property_Description"]?.ToString();
    var oldCat = TempData["Old_Category"]?.ToString();
    var oldAddress = TempData["Old_Address"]?.ToString();
    var oldExtent = TempData["Old_Extent"]?.ToString();
    var oldMV = TempData["Old_Market_Value"]?.ToString();
    var oldOwner = TempData["Old_Owner"]?.ToString();

    var oldCat2 = TempData["Old2_Category"]?.ToString();
    var oldMV2 = TempData["Old2_Market_Value"]?.ToString();
    var oldExt2 = TempData["Old2_Extent"]?.ToString();
    var oldCat3 = TempData["Old3_Category"]?.ToString();
    var oldMV3 = TempData["Old3_Market_Value"]?.ToString();
    var oldExt3 = TempData["Old3_Extent"]?.ToString();

    var newPropDesc = TempData["new_Property_Description"]?.ToString();
    var newCat = TempData["new_Category"]?.ToString();
    var newAddress = TempData["new_Address"]?.ToString();
    var newExtent = TempData["new_Extent"]?.ToString();
    var newMV = TempData["new_Market_Value"]?.ToString();
    var newOwner = TempData["new_Owner"]?.ToString();

    var newCat2 = TempData["new2_Category"]?.ToString();
    var newMV2 = TempData["new2_Market_Value"]?.ToString();
    var newExt2 = TempData["new2_Extent"]?.ToString();
    var newCat3 = TempData["new3_Category"]?.ToString();
    var newMV3 = TempData["new3_Market_Value"]?.ToString();
    var newExt3 = TempData["new3_Extent"]?.ToString();

    // ── Multipurpose layout (display only, no database change) ──────
    // LEFT  (roll): top level = the roll's Multiple Purposes row (or the
    //        single category), then Split 1-3 = the roll's split rows.
    //        The form keeps the roll rows in TempData (CurrentFilter_mult_*),
    //        so they are read here. Peek keeps them for a page refresh.
    // RIGHT (requested): top level = what the client typed (never a sum),
    //        Split 1 = new2_, Split 2 = new3_, Split 3 = filled by the page
    //        script from the form (sessionStorage).
    string? Peek(string key) => TempData.Peek(key)?.ToString();
    string? FirstValue(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));

    var rollTopCat = FirstValue(Peek("CurrentFilter_mult_purp_CAT"), oldCat);
    var rollTopExt = FirstValue(Peek("CurrentFilter_mult_purp_EXT"), oldExtent);
    var rollTopMV = FirstValue(Peek("CurrentFilter_mult_purp_MV"), oldMV);

    var rollSplits = new[]
    {
        (Cat: FirstValue(Peek("CurrentFilter_mult_Res_CAT"), oldCat2),
         Ext: FirstValue(Peek("CurrentFilter_mult_Res_EXT"), oldExt2),
         MV:  FirstValue(Peek("CurrentFilter_mult_Res_MV"), oldMV2)),
        (Cat: FirstValue(Peek("CurrentFilter_mult_Bus_CAT"), oldCat3),
         Ext: FirstValue(Peek("CurrentFilter_mult_Bus_EXT"), oldExt3),
         MV:  FirstValue(Peek("CurrentFilter_mult_Bus_MV"), oldMV3)),
        (Cat: Peek("CurrentFilter_mult_S3_CAT"),
         Ext: Peek("CurrentFilter_mult_S3_EXT"),
         MV:  Peek("CurrentFilter_mult_S3_MV"))
    };

    var requestedSplits = new[]
    {
        (Cat: newCat2, Ext: newExt2, MV: newMV2),
        (Cat: newCat3, Ext: newExt3, MV: newMV3)
    };

    var files = new List<string>();
    for (int i = 1; i <= 10; i++)
    {
        var f = TempData[$"File{i}"]?.ToString();
        if (!string.IsNullOrWhiteSpace(f)) files.Add(f);
    }

    // Keep everything alive in case page is refreshed
    TempData.Keep("id"); TempData.Keep("pin"); TempData.Keep("Count"); TempData.Keep("ReviewStat");
    for (int i = 1; i <= 10; i++) TempData.Keep($"File{i}");
    foreach (var k in new[]{ "Old_Property_Description","Old_Category","Old_Address",
        "Old_Extent","Old_Market_Value","Old_Owner",
        "Old2_Category","Old2_Market_Value","Old2_Extent",
        "Old3_Category","Old3_Market_Value","Old3_Extent",
        "new_Property_Description","new_Category","new_Address",
        "new_Extent","new_Market_Value","new_Owner",
        "new2_Category","new2_Market_Value","new2_Extent",
        "new3_Category","new3_Market_Value","new3_Extent",
        "objection_reason" })
    { TempData.Keep(k); }
}

@section Styles {
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/objection-display.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .dp-multi-table .dp-total-row td {
            background: #f2f7f7;
            font-weight: 700;
        }

        .dp-multi-table .dp-split-start td {
            border-top: 2px solid #08737c;
        }

        .dp-multi-table .dp-split-label {
            color: #173b44;
            font-weight: 700;
        }
    </style>
}

<div class="dp-page">
    <div class="dp-inner">

        <div class="dp-hero">
            <div class="dp-hero-top">
                <div class="dp-hero-icon">
                    <i class="fa-solid fa-@(isReview ? "magnifying-glass" : "magnifying-glass-chart")"></i>
                </div>
                <div class="dp-hero-text">
                    <div class="dp-hero-eyebrow">City of Johannesburg · Valuation Services</div>
                    <h1 class="dp-hero-title">
                        <span>Section 78 @typeWord</span> @(isMulti ? "(Multiple Purposes) " : "")Acknowledged
                    </h1>
                    <p class="dp-hero-sub">
                        Your Section 78 @typeWord.ToLower() has been successfully received and logged.
                        An acknowledgement has been sent to the registered email address.
                    </p>
                </div>
                <div class="dp-type-badge">
                    <i class="fa-solid fa-circle-check"></i>
                    @(isReview ? "Review" : isMulti ? "Multi-Purpose" : "Query")
                </div>
            </div>

            <div class="dp-hero-meta">
                <div class="dp-hero-meta-item">
                    <div class="dp-hero-meta-label">Reference No.</div>
                    <div class="dp-hero-meta-value gold">@queryRef</div>
                </div>
                <div class="dp-hero-meta-item">
                    <div class="dp-hero-meta-label">PIN</div>
                    <div class="dp-hero-meta-value gold">@pin</div>
                </div>
                <div class="dp-hero-meta-item">
                    <div class="dp-hero-meta-label">Submitted On</div>
                    <div class="dp-hero-meta-value">@date</div>
                </div>
                <div class="dp-hero-meta-item">
                    <div class="dp-hero-meta-label">Supporting Documents</div>
                    <div class="dp-hero-meta-value">@count uploaded</div>
                </div>
            </div>
        </div>

        <div class="dp-body">

            <div class="dp-section">
                <div class="dp-section-header">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Important
                </div>
                <div class="dp-section-body">
                    <div class="dp-reason">
                        <div class="dp-reason-label">
                            <i class="fa-solid fa-clock" style="margin-right:5px;"></i>
                            48-hour evidence window
                        </div>
                        You have <strong>48 hours</strong> from the time of submission to upload any
                        outstanding supporting evidence. Keep your reference number
                        <strong>@queryRef</strong> for all future correspondence.
                    </div>
                </div>
            </div>

            <div class="dp-section">
                <div class="dp-section-header">
                    <i class="fa-solid fa-scale-balanced"></i>
                    Property Details &amp; Requested Changes
                </div>
                <div class="dp-section-body">
                    <div class="dp-compare">

                        <div>
                            <div class="dp-compare-col-head current">
                                <i class="fa-solid fa-book" style="margin-right:6px;"></i>
                                Entry on Valuation Roll
                            </div>

                            <table class="dp-compare-table">
                                <tr><td>Property</td><td>@(string.IsNullOrWhiteSpace(oldPropDesc) ? "–" : oldPropDesc)</td></tr>
                                <tr><td>Address</td><td>@(string.IsNullOrWhiteSpace(oldAddress) ? "–" : oldAddress)</td></tr>
                                <tr><td>Owner</td><td>@(string.IsNullOrWhiteSpace(oldOwner) ? "–" : oldOwner)</td></tr>
                            </table>

                            @if (isMulti)
                            {
                                <div class="dp-multi-title">Multipurpose Current Values and Splits</div>

                                <table class="dp-compare-table dp-multi-table">
                                    <tbody>
                                        <tr class="dp-total-row">
                                            <td>Category</td>
                                            <td>@(string.IsNullOrWhiteSpace(rollTopCat) ? "–" : rollTopCat)</td>
                                        </tr>
                                        <tr class="dp-total-row">
                                            <td>Extent</td>
                                            <td>@FormatExtent(rollTopExt)</td>
                                        </tr>
                                        <tr class="dp-total-row">
                                            <td>Market Value</td>
                                            <td>@FormatRand(rollTopMV)</td>
                                        </tr>

                                        @for (var s = 0; s < rollSplits.Length; s++)
                                        {
                                            var roll = rollSplits[s];
                                            <tr class="dp-split-start">
                                                <td class="dp-split-label">Category Split @(s + 1)</td>
                                                <td>@(string.IsNullOrWhiteSpace(roll.Cat) ? "–" : roll.Cat)</td>
                                            </tr>
                                            <tr>
                                                <td class="dp-split-label">Extent Split @(s + 1)</td>
                                                <td>@FormatExtent(roll.Ext)</td>
                                            </tr>
                                            <tr>
                                                <td class="dp-split-label">Market Value Split @(s + 1)</td>
                                                <td>@FormatRand(roll.MV)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            }
                            else
                            {
                                <table class="dp-compare-table">
                                    <tr><td>Category</td><td>@(string.IsNullOrWhiteSpace(oldCat) ? "–" : oldCat)</td></tr>
                                    <tr><td>Extent</td><td>@FormatExtent(oldExtent)</td></tr>
                                    <tr><td>Market Value</td><td>@FormatRand(oldMV)</td></tr>
                                </table>
                            }
                        </div>

                        <div>
                            <div class="dp-compare-col-head requested">
                                <i class="fa-solid fa-pen-to-square" style="margin-right:6px;"></i>
                                Requested Changes
                            </div>

                            @{
                                void NewVal(string? v, bool isMoney = false, bool isExtent = false)
                                {
                                    var hasValue = !string.IsNullOrWhiteSpace(v);
                                    var displayValue = hasValue
                                        ? (isMoney ? FormatRand(v) : isExtent ? FormatExtent(v) : v)
                                        : "No change requested";

                                    <td class="dp-new-val @(string.IsNullOrWhiteSpace(v) ? "empty" : "")">
                                        @displayValue
                                    </td>
                                }
                            }

                            <table class="dp-compare-table">
                                <tr>
                                    <td>Property</td>@{
                                    NewVal(newPropDesc);
                                }
                            </tr>
                            <tr>
                                <td>Address</td>@{
                                NewVal(newAddress);
                            }
                        </tr>
                        <tr>
                            <td>Owner</td>@{
                            NewVal(newOwner);
                        }
                    </tr>
                </table>

                @if (isMulti)
                {
                    <div class="dp-multi-title">Multipurpose Requested Values and Splits</div>

                    <table class="dp-compare-table dp-multi-table">
                        <tbody>
                            <tr class="dp-total-row">
                                <td>Category</td>
                                @{
                                    NewVal(newCat);
                                }
                            </tr>
                            <tr class="dp-total-row">
                                <td>Extent</td>
                                @{
                                    NewVal(newExtent, isExtent: true);
                                }
                            </tr>
                            <tr class="dp-total-row">
                                <td>Market Value</td>
                                @{
                                    NewVal(newMV, true);
                                }
                            </tr>

                            @for (var s = 0; s < requestedSplits.Length; s++)
                            {
                                var req = requestedSplits[s];
                                <tr class="dp-split-start">
                                    <td class="dp-split-label">Category Split @(s + 1)</td>
                                    @{
                                        NewVal(req.Cat);
                                    }
                                </tr>
                                <tr>
                                    <td class="dp-split-label">Extent Split @(s + 1)</td>
                                    @{
                                        NewVal(req.Ext, isExtent: true);
                                    }
                                </tr>
                                <tr>
                                    <td class="dp-split-label">Market Value Split @(s + 1)</td>
                                    @{
                                        NewVal(req.MV, true);
                                    }
                                </tr>
                            }

                            @* Split 3 is not saved to the database; the page script fills it
                               from the values the client typed on the form. *@
                            <tr class="dp-split-start">
                                <td class="dp-split-label">Category Split 3</td>
                                <td class="dp-new-val empty" data-s78-split3="cat">No change requested</td>
                            </tr>
                            <tr>
                                <td class="dp-split-label">Extent Split 3</td>
                                <td class="dp-new-val empty" data-s78-split3="ext">No change requested</td>
                            </tr>
                            <tr>
                                <td class="dp-split-label">Market Value Split 3</td>
                                <td class="dp-new-val empty" data-s78-split3="mv">No change requested</td>
                            </tr>
                        </tbody>
                    </table>
                }
                else
                {
                    <table class="dp-compare-table">
                        <tr>
                            <td>Category</td>@{
                            NewVal(newCat);
                        }
                    </tr>
                    <tr>
                        <td>Extent</td>@{
                        NewVal(newExtent, isExtent: true);
                    }
                </tr>
                <tr>
                    <td>Market Value</td>@{
                    NewVal(newMV, true);
                }
            </tr>
        </table>
    }
</div>
</div>

                    @if (!string.IsNullOrWhiteSpace(reason))
{
    <div style="margin-top:20px;">
        <div class="dp-reason">
            <div class="dp-reason-label">
                <i class="fa-solid fa-quote-left" style="margin-right:5px;"></i>
                @typeWord Reason
            </div>
            @reason
        </div>
    </div>
}
</div>
</div>

<div class="dp-section">
    <div class="dp-section-header">
        <i class="fa-solid fa-paperclip"></i>
        Supporting Documents / Evidence
    </div>

    <div class="dp-section-body">
        <p style="margin-bottom:14px;color:#555;">
            Files uploaded with the submitted @typeWord.ToLowerInvariant() form:
            <strong>@files.Count</strong>
        </p>

        @if (files.Any())
        {
            <div class="dp-doc-list">
                @for (int i = 0; i < files.Count; i++)
                {
                    <div class="dp-doc-item">
                        <div class="dp-doc-icon">
                            <i class="fa-solid fa-file"></i>
                        </div>
                        <div class="dp-doc-main">
                            <span class="dp-doc-name">@files[i]</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="dp-doc-empty">
                No supporting documents/evidence files were uploaded.
            </div>
        }
    </div>
</div>

<div class="dp-actions">
    @if (hasAckRef)
    {
        <a href="@Url.Action("DownloadAcknowledgement", "Notice", new { objectionNo = queryRef, rollSource = "Objection_Query", returnUrl = Context.Request.Path.Value })"
               class="dp-btn-primary"
               data-no-loader
               onclick="showDlToast()">
            <i class="fa-solid fa-download"></i>
            Download Acknowledgement
        </a>
    }
    else
    {
        <a href="/dashboard/roll-detail/Objection_Query?section=queries" class="dp-btn-primary">
            <i class="fa-solid fa-download"></i>
            Download from My Dashboard
        </a>
    }
    <a asp-controller="Dashboard" asp-action="Index" class="dp-btn-secondary">
        <i class="fa-solid fa-gauge-high"></i>
        My Dashboard
    </a>
    <a asp-controller="Home" asp-action="Index" class="dp-btn-secondary">
        <i class="fa-solid fa-house"></i>
        Home
    </a>
</div>

</div>

<div style="text-align:center; font-size:11.5px; color:#aaa; padding:16px 8px 0;">
    This is an official document generated by the City of Johannesburg
    Valuation Services Department. Generated: @date
</div>

</div>
</div>

@section Scripts {
    <script>
        function showDlToast() {
            console.log('Acknowledgement download started');
        }

        // Multipurpose Requested Split 3 — saved by the Section 78
        // Multipurpose form in sessionStorage (it is not stored in the DB).
        (function () {
            var cells = document.querySelectorAll('[data-s78-split3]');
            if (!cells.length) return;

            function read(key) {
                try { return (sessionStorage.getItem(key) || '').trim(); }
                catch (e) { return ''; }
            }

            function formatRand(value) {
                var digits = value.replace(/[^\d.]/g, '');
                if (!digits) return value;
                var whole = Math.round(parseFloat(digits));
                if (isNaN(whole)) return value;
                return 'R ' + whole.toString().replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
            }

            function formatExtent(value) {
                var num = parseFloat(value.replace(/\s+/g, '').replace(/,/g, '.'));
                if (isNaN(num)) return value;
                return (num % 1 === 0 ? num.toString() : num.toFixed(2))
                    .replace(/\B(?=(\d{3})+(?!\d))/g, ' ');
            }

            var values = {
                cat: read('s78_New4_Category'),
                ext: read('s78_New4_Extent'),
                mv: read('s78_New4_Market_Value')
            };

            cells.forEach(function (cell) {
                var part = cell.getAttribute('data-s78-split3');
                var value = values[part];
                if (!value) return;

                cell.textContent = part === 'mv'
                    ? formatRand(value)
                    : part === 'ext' ? formatExtent(value) : value;
                cell.classList.remove('empty');
            });
        })();
    </script>
}
