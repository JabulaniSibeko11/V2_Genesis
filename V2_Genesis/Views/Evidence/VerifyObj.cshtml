@{
    Layout = User.Identity?.IsAuthenticated == true
        ? "~/Views/Shared/_ClientLayout.cshtml"
        : "~/Views/Shared/_Layout.cshtml";

    ViewData["Title"] = "Verify Reference — Add Evidence";

    bool isAuth = User.Identity?.IsAuthenticated == true;
    string? preRef = ViewBag.PrefilledRef as string;
    bool hasRef = !string.IsNullOrWhiteSpace(preRef);
    bool isAppeal = preRef?.Trim().ToUpper().StartsWith("APP") == true;
    string refLabel = isAppeal ? "Appeal Number" : "Objection Number";
}

@section Styles {
    <link href="~/css/views/evidence1.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
}

<div class="ev-page">
    <div class="ev-card ev-card-premium">

        <!-- Step indicator -->
        <div class="ev-steps">
            <div class="ev-step active">
                <span class="ev-step-num">1</span> Verify Reference
            </div>
            <div class="ev-step-line"></div>
            <div class="ev-step">
                <span class="ev-step-num">2</span> Upload Evidence
            </div>
        </div>

        <!-- Header -->
        <div class="ev-card-header">
            <div class="ev-card-icon ev-card-icon-round">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div>
                <h1 class="ev-card-title">Verify Your Reference</h1>
                <p class="ev-card-sub">
                    @if (hasRef)
                    {
                        @:Confirm your PIN to unlock evidence upload for this @(isAppeal ? "appeal" : "objection")
                    }
                    else
                    {
                        @:Enter your objection or appeal number and PIN to continue
                    }
                </p>
            </div>
        </div>

        @* ── LOGGED IN + reference pre-filled → show ref as read-only ── *@
        @if (isAuth && hasRef)
        {
            <!-- Reference info box — read only -->
            <div class="ev-ref-box ev-ref-box-prefilled">
                <div class="ev-ref-item">
                    <span class="ev-ref-label">@refLabel</span>
                    <span class="ev-ref-value ev-ref-readonly">
                        <i class="fa-solid fa-lock" style="font-size:11px;color:#6b6b6b;"></i>
                        @preRef
                    </span>
                </div>
            </div>

            @if (ViewBag.Error is not null)
            {
                <div class="ev-error-banner">
                    <i class="fa-solid fa-circle-xmark"></i>
                    @ViewBag.Error
                </div>
            }

            <div class="ev-notice-premium">
                <div class="ev-notice-icon">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <div>
                    <p class="ev-notice-title">48-Hour Upload Window</p>
                    <p class="ev-notice-text">
                        You have 48 hours from your original submission to upload
                        evidence. This window closes automatically after that.
                    </p>
                </div>
            </div>

            <!-- PIN only form -->
            <form method="post" action="/evidence/verify">
                @Html.AntiForgeryToken()
                <input type="hidden" name="refNo" value="@preRef" />

                <div class="ev-form-group">
                    <label class="ev-label">
                        <i class="fa-solid fa-key"></i> PIN
                    </label>
                    <div class="ev-input-group">
                        <i class="fa-solid fa-key ev-input-icon"></i>
                        <input type="text"
                               name="pin"
                               id="pinInput"
                               class="ev-input ev-input-lg ev-input-with-icon"
                               placeholder="Enter your PIN (case-sensitive)"
                               autocomplete="off"
                               autofocus
                               required />
                    </div>
                    <p class="ev-hint">
                        Your PIN was included in the acknowledgement letter
                        you received when you submitted your
                        @(isAppeal ? "appeal" : "objection").
                    </p>
                </div>

                <div class="ev-form-actions">
                    <button type="submit" class="ev-btn ev-btn-primary">
                        <i class="fa-solid fa-shield-check"></i>
                        Verify &amp; Continue
                    </button>
                    <a href="/dashboard" class="ev-btn ev-btn-ghost">
                        <i class="fa-solid fa-arrow-left"></i> Back
                    </a>
                </div>
            </form>
        }

        @* ── NOT LOGGED IN or no reference → full form ── *@
        else
        {
            @if (ViewBag.Error is not null)
            {
                <div class="ev-error-banner">
                    <i class="fa-solid fa-circle-xmark"></i>
                    @ViewBag.Error
                </div>
            }

            <div class="ev-notice-premium">
                <div class="ev-notice-icon">
                    <i class="fa-solid fa-clock"></i>
                </div>
                <div>
                    <p class="ev-notice-title">48-Hour Upload Window</p>
                    <p class="ev-notice-text">
                        You have 48 hours from your original submission to upload
                        evidence. This window closes automatically after that.
                    </p>
                </div>
            </div>

            <!-- Full form: reference + PIN -->
            <form method="post" action="/evidence/verify" id="verifyForm">
                @Html.AntiForgeryToken()

                <div class="ev-form-group">
                    <label class="ev-label">
                        <i class="fa-solid fa-hashtag"></i>
                        Objection / Appeal Number
                    </label>
                    <div class="ev-input-group">
                        <i class="fa-solid fa-hashtag ev-input-icon"></i>
                        <input type="text"
                               name="refNo"
                               id="refNoInput"
                               class="ev-input ev-input-with-icon"
                               placeholder="e.g. OBJ-GV23-12345 or APP-GV23-1234"
                               autocomplete="off"
                               autofocus
                               required />
                    </div>
                    <p class="ev-hint">
                        Enter it exactly as it appears on your acknowledgement letter.
                    </p>
                </div>

                <div class="ev-form-group">
                    <label class="ev-label">
                        <i class="fa-solid fa-key"></i> PIN
                    </label>
                    <div class="ev-input-group">
                        <i class="fa-solid fa-key ev-input-icon"></i>
                        <input type="text"
                               name="pin"
                               class="ev-input ev-input-with-icon"
                               placeholder="Enter your PIN (case-sensitive)"
                               autocomplete="off"
                               required />
                    </div>
                    <p class="ev-hint">
                        Your PIN was included in the acknowledgement letter
                        received when you submitted your objection or appeal.
                    </p>
                </div>

                <div class="ev-form-actions">
                    <button type="submit" class="ev-btn ev-btn-primary">
                        <i class="fa-solid fa-shield-check"></i>
                        Verify &amp; Continue
                    </button>
                    <a href="/" class="ev-btn ev-btn-ghost">
                        <i class="fa-solid fa-house"></i> Home
                    </a>
                </div>
            </form>
        }

    </div>
</div>
