@{
    ViewData["Title"] = "Add Evidence — Verify";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    bool isAppeal = (bool)(ViewBag.IsAppeal ?? false);
}

@section Styles {
    <link href="~/css/views/evidence.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
}

<div class="ev-page">
    <div class="ev-card">
        <div class="ev-card-header">
            <div class="ev-card-icon">
                <i class="fa-solid fa-lock"></i>
            </div>
            <div>
                <h1 class="ev-card-title">
                    Verify Your @(isAppeal ? "Appeal" : "Objection")
                </h1>
                <p class="ev-card-sub">
                    Enter your PIN to upload supporting evidence
                </p>
            </div>
        </div>

        <!-- Reference info -->
        <div class="ev-ref-box">
            <div class="ev-ref-item">
                <span class="ev-ref-label">
                    @(isAppeal ? "Appeal" : "Objection") Number
                </span>
                <span class="ev-ref-value">@ViewBag.ObjectionNo</span>
            </div>
            <div class="ev-ref-item">
                <span class="ev-ref-label">Roll</span>
                <span class="ev-ref-value">@ViewBag.RollSource</span>
            </div>
        </div>

        <!-- Error -->
        @if (ViewBag.Error is not null)
        {
            <div class="ev-error-banner">
                <i class="fa-solid fa-circle-xmark"></i>
                @ViewBag.Error
            </div>
        }

        <!-- Notice -->
        <div class="ev-notice">
            <i class="fa-solid fa-clock"></i>
            You have <strong>48 hours</strong> from submission to upload
            evidence. After that, the upload window closes permanently.
        </div>

        <!-- Form -->
        <form method="post" action="/evidence/verify">
            @Html.AntiForgeryToken()
            <input type="hidden" name="objectionNo" value="@ViewBag.ObjectionNo" />
            <input type="hidden" name="rollSource" value="@ViewBag.RollSource" />

            <div class="ev-form-group">
                <label class="ev-label">
                    <i class="fa-solid fa-key"></i> PIN
                </label>
                <input type="text"
                       name="pin"
                       class="ev-input"
                       placeholder="Enter your PIN (case-sensitive)"
                       autocomplete="off"
                       required />
                <p class="ev-hint">
                    Your PIN was included in the acknowledgement letter
                    you received when you submitted your
                    @(isAppeal ? "appeal" : "objection").
                </p>
            </div>

            <div class="ev-form-actions">
                <button type="submit" class="ev-btn ev-btn-primary">
                    <i class="fa-solid fa-shield-check"></i> Verify &amp; Continue
                </button>
                <a href="/dashboard" class="ev-btn ev-btn-ghost">
                    <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
                </a>
            </div>
        </form>
    </div>
</div>