@model V2_Genesis.Models.ViewModels.Attributes.AttributeWithdrawalViewModel
@{
    ViewData["Title"] = "Withdraw Attributes Submission";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    var returnUrl = !string.IsNullOrWhiteSpace(Model.ReturnUrl)
        ? Model.ReturnUrl
        : "/Dashboard?openRoll=Attributes";
}

@section Styles {
    <link href="~/css/views/objection-withdrawal.css"
          rel="stylesheet"
          asp-append-version="true" />
    <link href="~/css/views/attribute-withdrawal.css"
          rel="stylesheet"
          asp-append-version="true" />
    <link href="~/css/views/clientdashboardcss.css"
          rel="stylesheet"
          asp-append-version="true" />
}

<div class="wd-wrap">
    <div class="wd-card wd-card--attributes">
        <form asp-route="AttributeWithdrawalPost" method="post">
            @Html.AntiForgeryToken()
            <input asp-for="AttrId" type="hidden" />
            <input asp-for="ReturnUrl" type="hidden" />

            <div class="wd-header">
                <div class="wd-header-icon">
                    <i class="fa-solid fa-clipboard-list"></i>
                </div>
                <div class="wd-header-text">
                    <h2>Withdraw Attributes Submission</h2>
                    <p>City of Johannesburg · Valuation Services</p>
                </div>
            </div>

            <div class="wd-warning">
                <i class="fa-solid fa-triangle-exclamation"></i>
                Are you sure you want to withdraw this Attributes submission?
            </div>

            <div class="wd-body">
                <div asp-validation-summary="ModelOnly"
                     class="wd-error"
                     role="alert"></div>

                <div class="wd-meta-grid">
                    <div class="wd-field">
                        <label>
                            <i class="fa-solid fa-hashtag"></i>
                            Attributes Reference Number
                        </label>
                        <input class="wd-ref"
                               value="@Model.AttrNo"
                               readonly
                               aria-label="Attributes reference number" />
                    </div>

                    <div class="wd-field">
                        <label>
                            <i class="fa-solid fa-signal"></i>
                            Current Status
                        </label>
                        <input class="wd-ref wd-status"
                               value="@Model.CurrentStatus"
                               readonly
                               aria-label="Current status" />
                    </div>

                    <div class="wd-field wd-field--full">
                        <label>
                            <i class="fa-solid fa-location-dot"></i>
                            Property Description
                        </label>
                        <div class="wd-property">@Model.PropertyDescription</div>
                    </div>
                </div>

                <div class="wd-field">
                    <label asp-for="Reason">
                        <i class="fa-solid fa-comment"></i>
                        Withdrawal Reason <span class="wd-required">*</span>
                    </label>
                    <textarea asp-for="Reason"
                              rows="5"
                              maxlength="1000"
                              required
                              aria-describedby="reasonHelp reasonError"
                              placeholder="Explain why you are withdrawing this Attributes submission"></textarea>
                    <span asp-validation-for="Reason"
                          id="reasonError"
                          class="wd-validation"></span>
                    <small id="reasonHelp" class="wd-help">
                        Enter between 10 and 1,000 characters.
                    </small>
                </div>

                <div class="wd-note">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <div>
                        <strong>This action cannot be undone.</strong>
                        The submission will be marked as withdrawn, its evidence access will be
                        disabled and the property will become available for a new Attributes
                        submission. Withdrawal is allowed only before allocation to a valuer.
                    </div>
                </div>
            </div>

            <div class="wd-footer">
                <button type="submit" class="wd-btn wd-btn-confirm">
                    <i class="fa-solid fa-check-circle"></i>
                    Yes, Withdraw
                </button>
                <a href="@returnUrl" class="wd-btn wd-btn-cancel">
                    <i class="fa-solid fa-times-circle"></i>
                    No, Cancel
                </a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
