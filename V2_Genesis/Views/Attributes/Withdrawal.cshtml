@model V2_Genesis.Models.ViewModels.Attributes.AttributeWithdrawalViewModel
@{
    ViewData["Title"] = "Withdraw Attributes Submission";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}

<div class="container py-4" style="max-width:900px;">
    <div class="card border-0 shadow-sm" style="border-radius:16px;overflow:hidden;">
        <div style="background:#12343b;color:#fff;padding:24px 28px;border-bottom:5px solid #e6b000;">
            <div class="d-flex align-items-center gap-3">
                <div style="width:52px;height:52px;border-radius:12px;background:rgba(230,176,0,.16);
                    display:flex;align-items:center;justify-content:center;color:#e6b000;font-size:22px;">
                    <i class="fa-solid fa-file-circle-xmark"></i>
                </div>
                <div>
                    <div style="font-size:13px;color:rgba(255,255,255,.65);font-weight:700;">
                        Property Attributes
                    </div>
                    <h1 class="h3 mb-0 fw-bold">Withdraw Submission</h1>
                </div>
            </div>
        </div>

        <div class="card-body p-4 p-md-5">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

            <div class="alert alert-warning d-flex gap-3 align-items-start" role="alert">
                <i class="fa-solid fa-triangle-exclamation mt-1"></i>
                <div>
                    <strong>This action cannot be undone.</strong><br />
                    The submission will be marked as withdrawn and the property will become available
                    for a new Attributes submission.
                </div>
            </div>

            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Reference</label>
                    <div class="form-control bg-light fw-bold">@Model.AttrNo</div>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-bold">Property</label>
                    <div class="form-control bg-light">@Model.PropertyDescription</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Current Status</label>
                    <div class="form-control bg-light">@Model.CurrentStatus</div>
                </div>
            </div>

            <form asp-route="AttributeWithdrawalPost" method="post">
                @Html.AntiForgeryToken()
                <input asp-for="AttrId" type="hidden" />
                <input asp-for="ReturnUrl" type="hidden" />

                <div class="mb-4">
                    <label asp-for="Reason" class="form-label fw-bold">
                        Reason for withdrawal <span class="text-danger">*</span>
                    </label>
                    <textarea asp-for="Reason"
                              class="form-control"
                              rows="5"
                              maxlength="1000"
                              placeholder="Explain why you are withdrawing this Attributes submission."
                              style="font-size:16px;"></textarea>
                    <span asp-validation-for="Reason" class="text-danger fw-semibold"></span>
                    <div class="form-text">Minimum 10 characters; maximum 1,000 characters.</div>
                </div>

                <div class="d-flex flex-column flex-sm-row justify-content-end gap-3">
                    <a href="@Model.ReturnUrl" class="btn btn-outline-secondary btn-lg px-4">
                        <i class="fa-solid fa-arrow-left me-2"></i>Cancel
                    </a>
                    <button type="submit" class="btn btn-danger btn-lg px-4">
                        <i class="fa-solid fa-file-circle-xmark me-2"></i>Confirm Withdrawal
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
