@model V2_Genesis.Models.ViewModels.Attributes.AttributeSelectViewModel
@{
    ViewData["Title"] = "Submit Property Attributes";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}

<link href="~/css/views/attribute-create.css" rel="stylesheet" asp-append-version="true" />



<div class="sf-page">

    @* ── Hero ──────────────────────────────────────────────────── *@
    <div class="sf-hero">
        <div class="sf-hero-inner">
            <div class="sf-hero-icon">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>
            <div>
                <div class="sf-hero-eyebrow">
                    <span></span>
                    City of Johannesburg · Valuation Services
                </div>
                <h1 class="sf-hero-title">
                    Property Attribute <em>Submission</em>
                </h1>
                <p class="sf-hero-sub">
                    <i class="fa-solid fa-lock" style="font-size:10px;"></i>
                    GV23 / Supplementary Valuation Roll
                    <span class="sf-hero-sub-dot"></span>
                    1 July 2023 – 30 June 2027
                </p>
            </div>
        </div>
    </div>

    @* ── FORM (single POST to SelectForm action) ───────────────── *@
    <form asp-action="SelectForm" asp-controller="Attributes"
          method="post" id="sfForm">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="All" class="text-danger" style="margin:12px 0;font-weight:700;"></div>
        <input type="hidden" name="UnitKey"      value="@Model.UnitKey" />
        <input type="hidden" name="PropertyDesc" value="@Model.PropertyDesc" />

        <div class="sf-body">

            @* ══════════════════════════════════════════════
               SECTION 1 — PROPERTY DETAILS (read-only)
            ══════════════════════════════════════════════ *@
            <div class="sf-card">
                <div class="sf-card-bar">
                    <i class="fa-solid fa-location-dot"></i>
                    <h3>Property Details <span>— read only, pulled from your linked properties</span></h3>
                </div>
                <div class="sf-card-body">
                    <div class="sf-prop-grid">

                        <div class="sf-prop-field">
                            <span class="sf-prop-label">Municipality</span>
                            <span class="sf-prop-value">City of Johannesburg</span>
                        </div>

                        <div class="sf-prop-field">
                            <span class="sf-prop-label">Township</span>
                            <span class="sf-prop-value">@Model.TownNameDesc</span>
                        </div>

                        <div class="sf-prop-field">
                            <span class="sf-prop-label">Erf</span>
                            <span class="sf-prop-value">@Model.Erf</span>
                        </div>

                      @*   <div class="sf-prop-field wide">
                            <span class="sf-prop-label">SG Number</span>
                            <span class="sf-prop-value">@Model.SchemeNumber</span>
                        </div> *@

                        <div class="sf-prop-field">
                            <span class="sf-prop-label">Extent</span>
                            <span class="sf-prop-value">@Model.RateableArea m²</span>
                        </div>

                        <div class="sf-prop-field full">
                            <span class="sf-prop-label">Property Description</span>
                            <span class="sf-prop-value address">@Model.PropertyDesc</span>
                        </div>

                        <div class="sf-prop-field full">
                            <span class="sf-prop-label">Address</span>
                            <span class="sf-prop-value address">@Model.LisStreetAddress</span>
                        </div>

                        <div class="sf-prop-field">
                            <span class="sf-prop-label">Category</span>
                            <span class="sf-prop-value">@Model.CatDesc</span>
                        </div>

                        <div class="sf-prop-field">
                            <span class="sf-prop-label">Market Value</span>
                            <span class="sf-prop-value">@(!string.IsNullOrWhiteSpace(Model.MarketValue) ? "R " + Model.MarketValue : "—")</span>
                        </div>

                        <div class="sf-prop-field">
                            <span class="sf-prop-label">Zoning</span>
                            <span class="sf-prop-value">@(Model.Zoning ?? "—")</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.OwnerName))
                        {
                            <div class="sf-prop-field full">
                                <span class="sf-prop-label">Registered Owner</span>
                                <span class="sf-prop-value">@Model.OwnerName</span>
                            </div>
                        }

                    </div>
                </div>
            </div>

            @* ══════════════════════════════════════════════
               SECTION 2 — FORM TYPE
            ══════════════════════════════════════════════ *@
            <div class="sf-card">
                <div class="sf-card-bar">
                    <i class="fa-solid fa-list-check"></i>
                    <h3>Select Form Type <span>— choose the form that matches your property</span></h3>
                </div>
                <div class="sf-card-body">
                    @if (!string.IsNullOrWhiteSpace(Model.SuggestedFormType))
                    {
                        <div style="display:flex;align-items:center;gap:10px;margin-bottom:16px;
                                    padding:12px 16px;background:#e8f3f4;border-radius:9px;
                                    border:1px solid rgba(0,101,112,.2);font-family:'Poppins',sans-serif;">
                            <i class="fa-solid fa-lightbulb" style="color:#e6b000;font-size:15px;flex-shrink:0;"></i>
                            <span style="font-size:12.5px;font-weight:600;color:#006570;">
                                <strong>Suggested:</strong>
                                Based on your property category, we suggest
                                <strong>@Model.SuggestedFormType</strong>.
                                You may still select any form type below.
                            </span>
                        </div>
                    }
                    <div class="sf-form-grid">

                        <label class="sf-form-tile" id="tile-res" onclick="pickForm(this)">
                            <input type="radio" name="SelectedFormType" value="Residential" />
                            <div class="sf-tile-icon"><i class="fa-solid fa-house"></i></div>
                            <div>
                                <div class="sf-tile-title">Form A — Residential</div>
                                <div class="sf-tile-desc">Full title residential properties — houses, townhouses</div>
                            </div>
                            <div class="sf-tile-check"><i class="fa-solid fa-check"></i></div>
                        </label>

                        <label class="sf-form-tile" id="tile-st" onclick="pickForm(this)">
                            <input type="radio" name="SelectedFormType" value="ResidentialST" />
                            <div class="sf-tile-icon"><i class="fa-solid fa-building"></i></div>
                            <div>
                                <div class="sf-tile-title">Form B — Residential ST</div>
                                <div class="sf-tile-desc">Sectional title units — apartments, flats, units</div>
                            </div>
                            <div class="sf-tile-check"><i class="fa-solid fa-check"></i></div>
                        </label>

                        <label class="sf-form-tile" id="tile-bus" onclick="pickForm(this)">
                            <input type="radio" name="SelectedFormType" value="BusinessCommercial" />
                            <div class="sf-tile-icon"><i class="fa-solid fa-store"></i></div>
                            <div>
                                <div class="sf-tile-title">Form C — Business &amp; Commercial</div>
                                <div class="sf-tile-desc">Offices, retail, warehouses — DCF method</div>
                            </div>
                            <div class="sf-tile-check"><i class="fa-solid fa-check"></i></div>
                        </label>

                        <label class="sf-form-tile" id="tile-drc" onclick="pickForm(this)">
                            <input type="radio" name="SelectedFormType" value="DRCMethod" />
                            <div class="sf-tile-icon"><i class="fa-solid fa-calculator"></i></div>
                            <div>
                                <div class="sf-tile-title">Form D — DRC Method</div>
                                <div class="sf-tile-desc">Depreciated replacement cost — industrial, special use</div>
                            </div>
                            <div class="sf-tile-check"><i class="fa-solid fa-check"></i></div>
                        </label>

                    </div>
                </div>
            </div>

            @* ══════════════════════════════════════════════
               SECTION 3 — WHO IS SUBMITTING
            ══════════════════════════════════════════════ *@
            <div class="sf-card">
                <div class="sf-card-bar">
                    <i class="fa-solid fa-user-circle"></i>
                    <h3>Who is Submitting? <span>— select your relationship to the property</span></h3>
                </div>
                <div class="sf-card-body">
                    <div class="sf-sub-grid">

                        <label class="sf-sub-tile" id="sub-owner" onclick="pickSub(this)">
                            <input type="radio" name="DeclarationType" value="Owner" />
                            <div class="sf-sub-icon"><i class="fa-solid fa-house-user"></i></div>
                            <div>
                                <div class="sf-sub-title">Property Owner</div>
                                <div class="sf-sub-desc">I am the registered owner submitting on my own behalf</div>
                            </div>
                            <div class="sf-tile-check"><i class="fa-solid fa-check"></i></div>
                        </label>

                        <label class="sf-sub-tile" id="sub-rep" onclick="pickSub(this)">
                            <input type="radio" name="DeclarationType" value="Representative" />
                            <div class="sf-sub-icon"><i class="fa-solid fa-user-tie"></i></div>
                            <div>
                                <div class="sf-sub-title">Authorised Representative</div>
                                <div class="sf-sub-desc">I have written authorisation to submit on behalf of the owner</div>
                            </div>
                            <div class="sf-tile-check"><i class="fa-solid fa-check"></i></div>
                        </label>

                    </div>

                    <div class="sf-rep-notice" id="repNotice">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <span>You will be required to upload a signed authorisation letter from the registered owner in the next step.</span>
                    </div>
                </div>
            </div>

            @* ══════════════════════════════════════════════
               VALIDATION + SUBMIT
            ══════════════════════════════════════════════ *@
            <div class="sf-card">
                <div class="sf-nudge" id="sfNudge">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <span id="sfNudgeMsg">Please select a form type and submitter type before continuing.</span>
                </div>
                <div class="sf-submit-row">
                    <span class="sf-submit-hint">
                        <i class="fa-solid fa-circle-info"></i>
                        You can save progress — complete and submit in one session
                    </span>
                    <button type="button" class="sf-btn-submit"
                            id="sfSubmitBtn" onclick="submitForm()">
                        <i class="fa-solid fa-arrow-right"></i> Continue to Attribute Form
                    </button>
                </div>
            </div>

        </div>@* end sf-body *@
    </form>

</div>

@section Scripts {
    <script>
        var _formPicked = false;
        var _subPicked  = false;

        document.addEventListener('DOMContentLoaded', function () {
            var selectedForm = document.querySelector('input[name="SelectedFormType"]:checked');
            var selectedSub = document.querySelector('input[name="DeclarationType"]:checked');

            if (selectedForm) {
                var formTile = selectedForm.closest('.sf-form-tile');
                if (formTile) {
                    formTile.classList.add('selected');
                    _formPicked = true;
                }
            }

            if (selectedSub) {
                var subTile = selectedSub.closest('.sf-sub-tile');
                if (subTile) {
                    subTile.classList.add('selected');
                    _subPicked = true;

                    var notice = document.getElementById('repNotice');
                    if (selectedSub.value === 'Representative') {
                        notice.classList.add('show');
                    }
                }
            }
        });

        function pickForm(el) {
            document.querySelectorAll('.sf-form-tile').forEach(function(t) {
                t.classList.remove('selected');
            });

            el.classList.add('selected');
            el.querySelector('input[type="radio"]').checked = true;

            _formPicked = true;
            hideNudge();
        }

        function pickSub(el) {
            document.querySelectorAll('.sf-sub-tile').forEach(function(t) {
                t.classList.remove('selected');
            });

            el.classList.add('selected');
            el.querySelector('input[type="radio"]').checked = true;

            _subPicked = true;
            hideNudge();

            var notice = document.getElementById('repNotice');
            var val = el.querySelector('input[type="radio"]').value;

            if (val === 'Representative') {
                notice.classList.add('show');
            } else {
                notice.classList.remove('show');
            }
        }

        function submitForm() {
            var selectedForm = document.querySelector('input[name="SelectedFormType"]:checked');
            var selectedSub = document.querySelector('input[name="DeclarationType"]:checked');

            if (!selectedForm && !selectedSub) {
                showNudge('Please select a form type and submitter type before continuing.');
                return;
            }

            if (!selectedForm) {
                showNudge('Please select a form type before continuing.');
                return;
            }

            if (!selectedSub) {
                showNudge('Please select whether you are the owner or a representative.');
                return;
            }

            document.getElementById('sfForm').submit();
        }

        function showNudge(msg) {
            document.getElementById('sfNudgeMsg').textContent = msg;
            document.getElementById('sfNudge').classList.add('show');
            document.getElementById('sfNudge').scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function hideNudge() {
            document.getElementById('sfNudge').classList.remove('show');
        }
    </script>
}
