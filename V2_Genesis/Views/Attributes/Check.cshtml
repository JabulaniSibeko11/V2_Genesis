@model V2_Genesis.Models.ViewModels.Attributes.CheckAttributesViewModel
@{
    ViewData["Title"] = "Confirm Property — Attributes";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    var formLabel = Model.FormType switch
    {
        "Residential" => "Residential",
        "ResidentialST" => "Residential — Sectional Title",
        "BusinessCommercial" => "Business and Commercial",
        "DRCMethod" => "DRC Method",
        _ => Model.FormType
    };
}

@section Styles {
    <link href="~/css/views/attributes-search.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/attributes-check.css" rel="stylesheet" asp-append-version="true" />
}

<div class="ca-page">
    <div class="ca-inner">

        <a href="/dashboard" class="ca-back">
            <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
        </a>

        <div class="ca-heading">
            <div class="ca-heading-icon">
                <i class="fa-solid fa-clipboard-check"></i>
            </div>
            <div>
                <h1 class="ca-title">Confirm Property</h1>
                <p class="ca-subtitle">
                    Review the property details and confirm your role before
                    completing the attribute submission form
                </p>
            </div>
        </div>

        <div class="ca-form-badge">
            <i class="fa-solid fa-file-alt"></i>
            Form Type Detected: <span>@formLabel</span>
        </div>

        @if (TempData["AttrCheckError"] is not null)
        {
            <div class="ca-error">
                <i class="fa-solid fa-circle-xmark"></i>
                @TempData["AttrCheckError"]
            </div>
        }

        <!-- Property Details -->
        <div class="ca-card">
            <div class="ca-card-header">
                <i class="fa-solid fa-building"></i>
                Property Details
            </div>
            <div class="ca-card-body">

                <div class="ca-field ca-field-full">
                    <span class="ca-label">
                        <i class="fa-solid fa-file-alt"></i> Property Description
                    </span>
                    <div class="ca-value">@(Model.PropertyDesc ?? "–")</div>
                </div>

                <div class="ca-field">
                    <span class="ca-label">
                        <i class="fa-solid fa-tag"></i> Category
                    </span>
                    <div class="ca-value">@(Model.CatDesc ?? "–")</div>
                </div>

                <div class="ca-field">
                    <span class="ca-label">
                        <i class="fa-solid fa-city"></i> Township
                    </span>
                    <div class="ca-value">@(Model.TownNameDesc ?? "–")</div>
                </div>

                <div class="ca-field ca-field-full">
                    <span class="ca-label">
                        <i class="fa-solid fa-map-pin"></i> Address
                    </span>
                    <div class="ca-value">@(Model.LisStreetAddress ?? "–")</div>
                </div>

                <div class="ca-field">
                    <span class="ca-label">
                        <i class="fa-solid fa-hashtag"></i> ERF / Stand
                    </span>
                    <div class="ca-value">@Model.Erf</div>
                </div>

                <div class="ca-field">
                    <span class="ca-label">
                        <i class="fa-solid fa-hashtag"></i> Portion
                    </span>
                    <div class="ca-value">@Model.Ptn</div>
                </div>

                @if (Model.UnitNo > 0)
                {
                    <div class="ca-field">
                        <span class="ca-label">
                            <i class="fa-solid fa-door-open"></i> Unit No.
                        </span>
                        <div class="ca-value">@Model.UnitNo</div>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.SchemeName))
                {
                    <div class="ca-field">
                        <span class="ca-label">
                            <i class="fa-solid fa-building"></i> Scheme
                        </span>
                        <div class="ca-value">@Model.SchemeName</div>
                    </div>
                }

                <div class="ca-field">
                    <span class="ca-label">
                        <i class="fa-solid fa-money-bill-wave"></i> Market Value
                    </span>
                    <div class="ca-value ca-market-val">@(Model.MarketValue ?? "–")</div>
                </div>

                <div class="ca-field">
                    <span class="ca-label">
                        <i class="fa-solid fa-ruler-combined"></i> Extent
                    </span>
                    <div class="ca-value">@(Model.RateableArea ?? "–")</div>
                </div>

            </div>
        </div>

        <!-- Declaration -->
        <form method="post" action="/attributes/check" id="checkForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="idProperty" value="@Model.IDProperty" />
            <input type="hidden" name="formType" value="@Model.FormType" />

            <div class="ca-decl-card">
                <div class="ca-decl-header">
                    <i class="fa-solid fa-user-check"></i>
                    Declaration — Select Your Role
                </div>
                <div class="ca-decl-body">

                    <!-- Owner — no ID entry needed, goes straight to form -->
                    <label class="ca-decl-option">
                        <input type="radio"
                               name="declarationType"
                               value="Owner"
                               id="declOwner"
                               required
                               onchange="updateContinueBtn()" />
                        <div class="ca-decl-text">
                            <h4>
                                <i class="fa-solid fa-house-user"
                                   style="color:#e6b000;"></i>
                                I am the Owner
                            </h4>
                            <p>
                                I am the registered owner of this property and I am
                                submitting this information on my own behalf.
                            </p>
                        </div>
                    </label>

                    <!-- Representative -->
                    <label class="ca-decl-option">
                        <input type="radio"
                               name="declarationType"
                               value="Representative"
                               id="declRep"
                               required
                               onchange="updateContinueBtn()" />
                        <div class="ca-decl-text">
                            <h4>
                                <i class="fa-solid fa-user-tie"
                                   style="color:#e6b000;"></i>
                                I am an Authorised Representative
                            </h4>
                            <p>
                                I am authorised to act on behalf of the property owner.
                                You will be asked to provide your contact details and
                                upload an authorisation letter on the next page.
                            </p>
                        </div>
                    </label>

                </div>
            </div>

            <!-- Disclaimer -->
            <div class="ca-disclaimer">
                <div class="ca-disclaimer-title">
                    <i class="fa-solid fa-circle-info"></i>
                    Important Notice
                </div>
                <strong>Submission does not imply acceptance.</strong>
                All submitted property information is subject to professional review
                and validation by a City of Johannesburg Valuer. Existing system data
                remains unchanged until submissions are explicitly reviewed and approved.
                <br /><br />
                By continuing, you confirm that:
                <ul style="margin:8px 0 0 16px; padding:0;">
                    <li>
                        The information you are about to submit is true and correct
                        to the best of your knowledge
                    </li>
                    <li>
                        You are either the registered owner or an authorised
                        representative of the above property
                    </li>
                    <li>
                        You understand that submission does not guarantee any changes
                        to the valuation roll
                    </li>
                </ul>
            </div>

            <!-- Actions -->
            <div class="ca-actions" style="margin-top:4px;">
                <button type="submit" class="ca-btn-primary" id="continueBtn">
                    <i class="fa-solid fa-arrow-right" id="continueBtnIcon"></i>
                    <span id="continueBtnText">Continue to Form</span>
                </button>
                <a href="/dashboard" class="ca-btn-outline">
                    <i class="fa-solid fa-xmark"></i> Cancel
                </a>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {

            // Format market value
            document.querySelectorAll('.ca-market-val').forEach(function (el) {
                var raw = parseFloat(el.textContent.replace(/[^0-9.-]+/g, ''));
                if (!isNaN(raw) && raw > 0) {
                    el.textContent = raw.toLocaleString('en-ZA', {
                        style: 'currency', currency: 'ZAR',
                        minimumFractionDigits: 0, maximumFractionDigits: 0
                    });
                }
            });

            // Validate before submit
            document.getElementById('checkForm')
                .addEventListener('submit', function (e) {
                    var selected = document.querySelector(
                        'input[name="declarationType"]:checked');
                    if (!selected) {
                        e.preventDefault();
                        alert('Please select whether you are the Owner or Representative.');
                    }
                });
        });

        // Update button text based on selection
        function updateContinueBtn() {
            var isRep  = document.getElementById('declRep').checked;
            var text   = document.getElementById('continueBtnText');
            var icon   = document.getElementById('continueBtnIcon');

            if (isRep) {
                text.textContent   = 'Fill Representative Details';
                icon.className     = 'fa-solid fa-user-tie';
            } else {
                text.textContent   = 'Continue to Form';
                icon.className     = 'fa-solid fa-arrow-right';
            }
        }
    </script>
}
