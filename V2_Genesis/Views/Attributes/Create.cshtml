@model V2_Genesis.Models.ViewModels.Attributes.AttributeSubmissionViewModel

@{
    ViewData["Title"] = "Attribute Property Submission";

    bool isResidential = Model.FormType == "Residential";
    bool isBusiness = Model.FormType == "BusinessCommercial";
    bool isDrc = Model.FormType == "DRCMethod";
    bool isSt = Model.FormType == "ResidentialST";

    string formTitle = Model.FormType switch
    {
        "Residential" => "Residential",
        "BusinessCommercial" => "Business and Commercial / Non-Residential",
        "DRCMethod" => "DRC Method",
        "ResidentialST" => "Residential - ST",
        _ => "Attribute Property Submission"
    };
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}
<link href="~/css/views/attribute-create.css" rel="stylesheet" asp-append-version="true" />


<div class="attr-page">

    <form asp-action="Create"
          asp-controller="Attributes"
          method="post"
          enctype="multipart/form-data">

        @Html.AntiForgeryToken()

        <input asp-for="FormType" type="hidden" />
        <input asp-for="AttrId" type="hidden" />
        <input asp-for="AttrNo" type="hidden" />
        <input asp-for="FormType" type="hidden" />


        <input asp-for="PropertyDetails.PropertyId" type="hidden" />
        @* <input asp-for="PropertyDetails.PremiseId" type="hidden" /> *@

        <div asp-validation-summary="All"></div>

        <div class="attr-card">
            <div class="attr-title">@formTitle</div>

            <!-- PROPERTY HEADER DETAILS -->
            <table class="attr-table">
                <tr>
                    <td class="attr-label">H Area</td>
                    <td class="attr-input-cell">
                        <input asp-for="PropertyDetails.HArea" class="attr-input" />
                    </td>

                    <td class="attr-label">Data Controller</td>
                    <td class="attr-input-cell">
                        <input asp-for="PropertyDetails.DataController" class="attr-input" />
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Collection Block</td>
                    <td>
                        <input asp-for="PropertyDetails.CollectionBlock" class="attr-input" />
                    </td>

                    <td class="attr-label">Data Collector</td>
                    <td>
                        <input asp-for="PropertyDetails.DataCollector" class="attr-input" />
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">SG Number</td>
                    <td>
                        <input asp-for="PropertyDetails.SGNumber" class="attr-input" />
                    </td>

                    <td class="attr-label">Centroid</td>
                    <td>
                        <input asp-for="PropertyDetails.Centroid" class="attr-input" />
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Erf</td>
                    <td>
                        <input asp-for="PropertyDetails.Erf" class="attr-input" />
                    </td>

                    <td class="attr-label">Extent</td>
                    <td>
                        <input asp-for="PropertyDetails.Extent" class="attr-input" />
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Sectional Title</td>
                    <td>
                        <input asp-for="PropertyDetails.SectionalTitle" class="attr-input" />
                    </td>

                    <td class="attr-label">Land Use Financials</td>
                    <td>
                        <input asp-for="PropertyDetails.LandUseFinancials" class="attr-input" />
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Municipality</td>
                    <td>
                        <input asp-for="PropertyDetails.Municipality" class="attr-input" value="City Of Johannesburg"/>
                    </td>

                    <td class="attr-label">Ward</td>
                    <td>
                        <input asp-for="PropertyDetails.Ward" class="attr-input" />
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Township</td>
                    <td>
                        <input asp-for="PropertyDetails.Township" class="attr-input" />
                    </td>

                    <td class="attr-label">Zoning</td>
                    <td>
                        <input asp-for="PropertyDetails.Zoning" class="attr-input" />
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Sources</td>
                    <td>
                        <input asp-for="PropertyDetails.Sources" class="attr-input" />
                    </td>

                    <td class="attr-label">Address</td>
                    <td>
                        <input asp-for="PropertyDetails.Address" class="attr-input" />
                    </td>
                </tr>
            </table>

            <div class="attr-section-title">Property Details</div>

            <table class="attr-table">
                <tr>
                    <td class="attr-label">Valuation Category on Roll</td>
                    <td colspan="3">
                        <select asp-for="ValuationDetails.ValuationCategoryOnRoll" class="attr-select">
                            <option value="">-- Select --</option>
                            <option>Residential</option>
                            <option>Residential with Consent Use</option>
                            <option>Business and Commercial</option>
                            <option>Multiple Purposes</option>
                            <option>Public Service Purposes</option>
                            <option>Public Service Infrastructure</option>
                            <option>Agricultural</option>
                            <option>Mining</option>
                            <option>Municipal</option>
                            <option>Private Open Space</option>
                            <option>Public Open Space</option>
                            <option>Religious</option>
                        </select>
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Actual Use</td>
                    <td colspan="3">
                        <input asp-for="ValuationDetails.ActualUse" class="attr-input" />
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Mixed Use?</td>
                    <td>
                        <div class="attr-radio-row">
                            <label>
                                <input type="radio" asp-for="ValuationDetails.IsMixedUse" value="true" />
                                Yes
                            </label>
                            <label>
                                <input type="radio" asp-for="ValuationDetails.IsMixedUse" value="false" />
                                No
                            </label>
                        </div>
                    </td>

                    <td class="attr-label">If mixed use, specify alternate usages</td>
                    <td>
                        <input asp-for="ValuationDetails.AlternateUsages" class="attr-input" />
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Owners Title Deeds</td>
                    <td colspan="3">
                        <textarea asp-for="ValuationDetails.OwnersTitleDeeds" class="attr-textarea"></textarea>
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Owners Financials</td>
                    <td colspan="3">
                        <textarea asp-for="ValuationDetails.OwnersFinancials" class="attr-textarea"></textarea>
                    </td>
                </tr>
            </table>

            <div class="attr-section-title">System Property Reference</div>

            <table class="attr-table">
                <tr>
                    <td class="attr-label">Property Description</td>
                    <td>
                        <input asp-for="PropertyDetails.PropertyDesc" class="attr-input" />
                    </td>

                    <td class="attr-label">Premise ID</td>
                    <td>
                        <input asp-for="PropertyDetails.PremiseId" class="attr-input" />
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Unit Key</td>
                    <td>
                        <input asp-for="PropertyDetails.UnitKey" class="attr-input" />
                    </td>

                    <td class="attr-label">Property ID</td>
                    <td>
                        <input asp-for="PropertyDetails.PropertyId" class="attr-input" />
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Valuation Key</td>
                    <td>
                        <input asp-for="PropertyDetails.ValuationKey" class="attr-input" />
                    </td>

                    <td class="attr-label">Sector</td>
                    <td>
                        <input asp-for="PropertyDetails.Sector" class="attr-input" />
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Roll Type</td>
                    <td>
                        <input asp-for="PropertyDetails.RollType" class="attr-input" />
                    </td>

                    <td class="attr-label">Roll Description</td>
                    <td>
                        <input asp-for="PropertyDetails.RollDescription" class="attr-input" />
                    </td>
                </tr>
            </table>
        </div>

        <!-- ACCESS -->
        <div class="attr-card">
            <div class="attr-section-title">Access</div>

            <table class="attr-table">
                <tr>
                    <td class="attr-label">Access Type</td>
                    <td colspan="3">
                        <div class="attr-radio-row">
                            <label><input type="radio" asp-for="Access.AccessType" value="None" /> None</label>
                            <label><input type="radio" asp-for="Access.AccessType" value="Garden Only" /> Garden Only</label>
                            <label><input type="radio" asp-for="Access.AccessType" value="House Only" /> House Only</label>
                            <label><input type="radio" asp-for="Access.AccessType" value="Partial" /> Partial</label>
                            <label><input type="radio" asp-for="Access.AccessType" value="Full" /> Full</label>
                        </div>
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Permission</td>
                    <td colspan="3">
                        <div class="attr-radio-row">
                            <label><input type="radio" asp-for="Access.PermissionStatus" value="Granted" /> Granted</label>
                            <label><input type="radio" asp-for="Access.PermissionStatus" value="Refused" /> Refused</label>
                            <label><input type="radio" asp-for="Access.PermissionStatus" value="No-one home" /> No-one home</label>
                            <label><input type="radio" asp-for="Access.PermissionStatus" value="Unoccupied" /> Unoccupied</label>
                        </div>
                    </td>
                </tr>

                <tr>
                    <td class="attr-label">Comments</td>
                    <td colspan="3">
                        <textarea asp-for="Access.Comments" class="attr-textarea"></textarea>
                    </td>
                </tr>
            </table>
        </div>

        <!-- CONTACT INFO -->
        <div class="attr-card">
            <div class="attr-section-title">Contact Info</div>

            @for (int i = 0; i < Model.ContactInfos.Count; i++)
            {
                <table class="attr-table">
                    <tr>
                        <th colspan="4">Contact @(i + 1)</th>
                    </tr>

                    <tr>
                        <td class="attr-label">Contact Type</td>
                        <td>
                            <select asp-for="ContactInfos[i].ContactType" class="attr-select">
                                <option>Owner</option>
                                <option>Representative</option>
                                <option>Company</option>
                                <option>Tenant</option>
                                <option>Other</option>
                            </select>
                        </td>

                        <td class="attr-label">Is Company?</td>
                        <td>
                            <div class="attr-radio-row">
                                <label>
                                    <input type="radio" asp-for="ContactInfos[i].IsCompany" value="true" />
                                    Yes
                                </label>
                                <label>
                                    <input type="radio" asp-for="ContactInfos[i].IsCompany" value="false" />
                                    No
                                </label>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="attr-label">Company Name</td>
                        <td>
                            <input asp-for="ContactInfos[i].CompanyName" class="attr-input" />
                        </td>

                        <td class="attr-label">Company Registration Number</td>
                        <td>
                            <input asp-for="ContactInfos[i].CompanyRegistrationNumber" class="attr-input" />
                        </td>
                    </tr>

                    <tr>
                        <td class="attr-label">First Names</td>
                        <td>
                            <input asp-for="ContactInfos[i].FirstNames" class="attr-input" />
                        </td>

                        <td class="attr-label">Last Name</td>
                        <td>
                            <input asp-for="ContactInfos[i].LastName" class="attr-input" />
                        </td>
                    </tr>

                    <tr>
                        <td class="attr-label">Maiden Name</td>
                        <td>
                            <input asp-for="ContactInfos[i].MaidenName" class="attr-input" />
                        </td>

                        <td class="attr-label">ID Number</td>
                        <td>
                            <input asp-for="ContactInfos[i].IDNumber" class="attr-input" />
                        </td>
                    </tr>

                    <tr>
                        <td class="attr-label">Date of Birth</td>
                        <td>
                            <input asp-for="ContactInfos[i].DateOfBirth" type="date" class="attr-input" />
                        </td>

                        <td class="attr-label">Gender</td>
                        <td>
                            <div class="attr-radio-row">
                                <label><input type="radio" asp-for="ContactInfos[i].Gender" value="Male" /> Male</label>
                                <label><input type="radio" asp-for="ContactInfos[i].Gender" value="Female" /> Female</label>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="attr-label">Marital Status</td>
                        <td colspan="3">
                            <div class="attr-radio-row">
                                <label><input type="radio" asp-for="ContactInfos[i].MaritalStatus" value="Single" /> Single</label>
                                <label><input type="radio" asp-for="ContactInfos[i].MaritalStatus" value="Married" /> Married</label>
                                <label><input type="radio" asp-for="ContactInfos[i].MaritalStatus" value="Trad Marriage" /> Trad Marriage</label>
                                <label><input type="radio" asp-for="ContactInfos[i].MaritalStatus" value="Co-Habiting" /> Co-Habiting</label>
                                <label><input type="radio" asp-for="ContactInfos[i].MaritalStatus" value="Divorced" /> Divorced</label>
                                <label><input type="radio" asp-for="ContactInfos[i].MaritalStatus" value="Widowed" /> Widowed</label>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="attr-label">Citizenship</td>
                        <td colspan="3">
                            <div class="attr-radio-row">
                                <label><input type="radio" asp-for="ContactInfos[i].Citizenship" value="RSA" /> RSA</label>
                                <label><input type="radio" asp-for="ContactInfos[i].Citizenship" value="Botswana" /> Botswana</label>
                                <label><input type="radio" asp-for="ContactInfos[i].Citizenship" value="Lesotho" /> Lesotho</label>
                                <label><input type="radio" asp-for="ContactInfos[i].Citizenship" value="Mozambique" /> Mozambique</label>
                                <label><input type="radio" asp-for="ContactInfos[i].Citizenship" value="Namibia" /> Namibia</label>
                                <label><input type="radio" asp-for="ContactInfos[i].Citizenship" value="Swaziland" /> Swaziland</label>
                                <label><input type="radio" asp-for="ContactInfos[i].Citizenship" value="Zimbabwe" /> Zimbabwe</label>
                                <label><input type="radio" asp-for="ContactInfos[i].Citizenship" value="Other" /> Other</label>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="attr-label">Physical Address</td>
                        <td colspan="3">
                            <textarea asp-for="ContactInfos[i].PhysicalAddress" class="attr-textarea"></textarea>
                        </td>
                    </tr>

                    <tr>
                        <td class="attr-label">Postal Address</td>
                        <td colspan="3">
                            <textarea asp-for="ContactInfos[i].PostalAddress" class="attr-textarea"></textarea>
                        </td>
                    </tr>

                    <tr>
                        <td class="attr-label">Email</td>
                        <td>
                            <input asp-for="ContactInfos[i].Email" type="email" class="attr-input" />
                        </td>

                        <td class="attr-label">Home Phone No</td>
                        <td>
                            <input asp-for="ContactInfos[i].HomePhoneNo" class="attr-input" />
                        </td>
                    </tr>

                    <tr>
                        <td class="attr-label">Work Phone No</td>
                        <td>
                            <input asp-for="ContactInfos[i].WorkPhoneNo" class="attr-input" />
                        </td>

                        <td class="attr-label">Cell No</td>
                        <td>
                            <input asp-for="ContactInfos[i].CellNo" class="attr-input" />
                        </td>
                    </tr>

                    <tr>
                        <td class="attr-label">Fax No</td>
                        <td>
                            <input asp-for="ContactInfos[i].FaxNo" class="attr-input" />
                        </td>

                        <td class="attr-label">Interviewed</td>
                        <td>
                            <div class="attr-radio-row">
                                <label><input type="radio" asp-for="ContactInfos[i].Interviewed" value="true" /> Yes</label>
                                <label><input type="radio" asp-for="ContactInfos[i].Interviewed" value="false" /> No</label>
                            </div>
                        </td>
                    </tr>

                    <tr>
                        <td class="attr-label">Comments</td>
                        <td colspan="3">
                            <textarea asp-for="ContactInfos[i].Comments" class="attr-textarea"></textarea>
                        </td>
                    </tr>
                </table>
            }
        </div>

        @if (isResidential || isSt)
        {
            <!-- PRIMARY ATTRIBUTES -->
            <div class="attr-card">
                <div class="attr-section-title">Primary Attributes</div>

                <table class="attr-table">
                    @if (isResidential)
                    {
                        <tr>
                            <td class="attr-label">Tla1</td>
                            <td><input asp-for="PrimaryAttributes.Tla1" class="attr-input" /></td>

                            <td class="attr-label">Tla2</td>
                            <td><input asp-for="PrimaryAttributes.Tla2" class="attr-input" /></td>
                        </tr>

                        <tr>
                            <td class="attr-label">Tla3</td>
                            <td><input asp-for="PrimaryAttributes.Tla3" class="attr-input" /></td>

                            <td class="attr-label">Garage</td>
                            <td><input asp-for="PrimaryAttributes.Garage" class="attr-input" /></td>
                        </tr>

                        <tr>
                            <td class="attr-label">Carport CP</td>
                            <td><input asp-for="PrimaryAttributes.CarportCp" class="attr-input" /></td>

                            <td class="attr-label">Granny Flat GF</td>
                            <td><input asp-for="PrimaryAttributes.GrannyFlatGf" class="attr-input" /></td>
                        </tr>

                        <tr>
                            <td class="attr-label">Staff Quarters SQ</td>
                            <td><input asp-for="PrimaryAttributes.StaffQuartersSq" class="attr-input" /></td>

                            <td class="attr-label">Storage</td>
                            <td><input asp-for="PrimaryAttributes.Storage" class="attr-input" /></td>
                        </tr>

                        <tr>
                            <td class="attr-label">Adjustment Factor</td>
                            <td colspan="3">
                                <input asp-for="PrimaryAttributes.AdjustmentFactor" class="attr-input" />
                            </td>
                        </tr>
                    }

                    @if (isSt)
                    {
                        <tr>
                            <td class="attr-label">ST Main</td>
                            <td><input asp-for="PrimaryAttributes.STMain" class="attr-input" /></td>

                            <td class="attr-label">Garage</td>
                            <td><input asp-for="PrimaryAttributes.Garage" class="attr-input" /></td>
                        </tr>

                        <tr>
                            <td class="attr-label">Carport CP</td>
                            <td><input asp-for="PrimaryAttributes.CarportCp" class="attr-input" /></td>

                            <td class="attr-label">Storage</td>
                            <td><input asp-for="PrimaryAttributes.Storage" class="attr-input" /></td>
                        </tr>
                    }
                </table>
            </div>

            <!-- SECONDARY ATTRIBUTES -->
            <div class="attr-card">
                <div class="attr-section-title">Secondary Attributes</div>

                <table class="attr-table">
                    @if (isResidential)
                    {
                        <tr>
                            <td class="attr-label">Storeys</td>
                            <td>
                                <select asp-for="SecondaryAttributes.Storeys" class="attr-select">
                                    <option value="">-- Select --</option>
                                    <option value="1">1</option>
                                    <option value="2">2</option>
                                    <option value="3">3</option>
                                    <option value="4">4</option>
                                </select>
                            </td>

                            <td class="attr-label">Security</td>
                            <td>
                                <select asp-for="SecondaryAttributes.Security" class="attr-select">
                                    <option value="">-- Select --</option>
                                    <option>High</option>
                                    <option>Medium</option>
                                    <option>Low</option>
                                    <option>None</option>
                                </select>
                            </td>
                        </tr>

                        <tr>
                            <td class="attr-label">Noise</td>
                            <td>
                                <select asp-for="SecondaryAttributes.Noise" class="attr-select">
                                    <option value="">-- Select --</option>
                                    <option>Freeway</option>
                                    <option>Major Road</option>
                                    <option>Side Street</option>
                                    <option>Cul-de-sac</option>
                                    <option>Entertainment</option>
                                </select>
                            </td>

                            <td class="attr-label">Topography</td>
                            <td>
                                <select asp-for="SecondaryAttributes.Topography" class="attr-select">
                                    <option value="">-- Select --</option>
                                    <option>Level</option>
                                    <option>Average</option>
                                    <option>Slope</option>
                                    <option>Steep</option>
                                </select>
                            </td>
                        </tr>

                        <tr>
                            <td class="attr-label">Quality</td>
                            <td>
                                <select asp-for="SecondaryAttributes.Quality" class="attr-select">
                                    <option value="">-- Select --</option>
                                    <option>Excellent</option>
                                    <option>Good</option>
                                    <option>Average</option>
                                    <option>Poor</option>
                                </select>
                            </td>

                            <td class="attr-label">Condition</td>
                            <td>
                                <select asp-for="SecondaryAttributes.Condition" class="attr-select">
                                    <option value="">-- Select --</option>
                                    <option>Excellent</option>
                                    <option>Good</option>
                                    <option>Average</option>
                                    <option>Poor</option>
                                </select>
                            </td>
                        </tr>

                        <tr>
                            <td class="attr-label">Swimming Pool</td>
                            <td>
                                <div class="attr-radio-row">
                                    <label><input type="radio" asp-for="SecondaryAttributes.SwimmingPool" value="true" /> Yes</label>
                                    <label><input type="radio" asp-for="SecondaryAttributes.SwimmingPool" value="false" /> No</label>
                                </div>
                            </td>

                            <td class="attr-label">Tennis Court</td>
                            <td>
                                <div class="attr-radio-row">
                                    <label><input type="radio" asp-for="SecondaryAttributes.TennisCourt" value="true" /> Yes</label>
                                    <label><input type="radio" asp-for="SecondaryAttributes.TennisCourt" value="false" /> No</label>
                                </div>
                            </td>
                        </tr>
                    }

                    @if (isSt)
                    {
                        <tr>
                            <td class="attr-label">ST Condition</td>
                            <td>
                                <select asp-for="SecondaryAttributes.STCondition" class="attr-select">
                                    <option value="">-- Select --</option>
                                    <option value="1">1 - Excellent</option>
                                    <option value="2">2 - Good</option>
                                    <option value="3">3 - Average</option>
                                    <option value="4">4 - Fair</option>
                                    <option value="5">5 - Poor</option>
                                </select>
                            </td>

                            <td class="attr-label">ST Floor</td>
                            <td>
                                <input asp-for="SecondaryAttributes.STFloor" class="attr-input" />
                            </td>
                        </tr>

                        <tr>
                            <td class="attr-label">Quality</td>
                            <td colspan="3">
                                <div class="attr-radio-row">
                                    <label><input type="radio" asp-for="SecondaryAttributes.Quality" value="Excellent" /> Excellent</label>
                                    <label><input type="radio" asp-for="SecondaryAttributes.Quality" value="Good" /> Good</label>
                                    <label><input type="radio" asp-for="SecondaryAttributes.Quality" value="Average" /> Average</label>
                                    <label><input type="radio" asp-for="SecondaryAttributes.Quality" value="Poor" /> Poor</label>
                                </div>
                            </td>
                        </tr>
                    }
                </table>
            </div>
        }

        @if (isBusiness)
        {
            <!-- BUSINESS BUILDINGS — 2 rows + Add Row -->
            <div class="attr-card">
                <div class="attr-section-title">Buildings</div>
                <div class="table-responsive">
                    <table class="attr-table" id="tbl-bus-buildings">
                        <thead>
                            <tr>
                                <th style="min-width:80px;">Building Nr</th>
                                <th style="min-width:90px;">Quality</th>
                                <th style="min-width:90px;">Condition</th>
                                <th style="min-width:80px;">Year Built</th>
                                <th style="min-width:70px;">Storeys</th>
                                <th style="min-width:90px;">Depreciation</th>
                                <th style="min-width:70px;">GBA</th>
                                <th style="min-width:80px;">Cost</th>
                                <th style="min-width:80px;">DRC</th>
                                <th style="width:36px;"></th>
                            </tr>
                        </thead>
                        <tbody id="body-bus-buildings">
                            @for (int i = 0; i < 2; i++)
                            {
                                <tr>
                                    <td><input name="BusinessBuildings[@i].BuildingNr" class="attr-input" /></td>
                                    <td><input name="BusinessBuildings[@i].Quality" class="attr-input" /></td>
                                    <td><input name="BusinessBuildings[@i].Condition" class="attr-input" /></td>
