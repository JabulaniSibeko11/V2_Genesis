        <!-- EVIDENCE FILES -->
        <!-- EVIDENCE FILES -->
        <div class="attr-card ev-card">
            <div class="attr-section-title">
                Evidence Uploads
                <span style="font-weight:400; font-size:11px; text-transform:none; margin-left:8px;">
                    Maximum 10 files
                </span>
            </div>

            @* ── Representative authorisation letter (shown only when IsRepresentative) ── *@
            @if (ViewBag.RepRequired == true)
            {
                <div class="ev-rep-notice">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <div>
                        <strong>Authorisation Letter Required</strong> —
                        Upload the signed letter from the registered owner
                        authorising you to act as their representative.
                    </div>
                </div>
                <div class="ev-rep-upload">
                    <div class="ev-rep-label">
                        <i class="fa-solid fa-file-signature"></i>
                        Authorisation Letter
                        <span style="color:#e53e3e;">*</span>
                    </div>
                    <input asp-for="Files.RepLetter"
                           type="file"
                           class="ev-rep-input"
                           accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                           required />
                </div>
            }
            else
            {
                @* Optional rep letter even for owners *@
                <div class="ev-rep-upload" style="background:#f7fbfb; border-bottom:1px solid #e8e8e8;">
                    <div class="ev-rep-label" style="color:#555;">
                        <i class="fa-solid fa-file-signature" style="color:#6b6b6b;"></i>
                        Authorisation Letter <span style="font-weight:400;">(optional)</span>
                    </div>
                    <input asp-for="Files.RepLetter"
                           type="file"
                           class="ev-rep-input"
                           style="border-color:#d0d0d0;"
                           accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                </div>
            }

            @* ── Hidden file inputs — populated by JS ── *@
            @* These bind EvidenceFiles list to the form POST *@
            <div id="evHiddenInputs" style="display:none;"></div>

            @* ── Drag and drop zone ── *@
            <div class="ev-dropzone" id="evDropzone"
                 onclick="document.getElementById('evFileInput').click()">
                <div class="ev-dropzone-icon">
                    <i class="fa-solid fa-cloud-arrow-up"></i>
                </div>
                <div class="ev-dropzone-title">Drag files here to upload</div>
                <div class="ev-dropzone-sub">
                    PDF, Word, Images, Plans, Rates Information, Title Documents
                </div>
                <button type="button" class="ev-browse-btn"
                        onclick="event.stopPropagation();
                    document.getElementById('evFileInput').click()">
                    <i class="fa-solid fa-folder-open"></i> Browse Files
                </button>
            </div>

            @* Real hidden input — multiple *@
            <input type="file"
                   id="evFileInput"
                   name="Files.EvidenceFiles"
                   multiple
                   accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.xls,.xlsx" />

            @* Counter bar *@
            <div class="ev-counter">
                <span id="evCountText">0 / 10 files selected</span>
                <div class="ev-counter-bar">
                    <div class="ev-counter-fill" id="evCountFill"></div>
                </div>
            </div>

            @* File list *@
            <div class="ev-file-list" id="evFileList"></div>

            <div class="ev-note">
                <i class="fa-solid fa-circle-info"></i>
                Supported: PDF, Word, Excel, JPG, PNG &nbsp;|&nbsp;
                Max 10 files &nbsp;|&nbsp;
                Max 20MB per file
            </div>
        </div>

        <!-- DECLARATION AND SIGNATURE -->
        <div class="attr-card">
            <div class="attr-section-title">Declaration and Signature</div>

            @* Hidden input — canvas writes Base64 here on submit *@
            <input asp-for="Declaration.SignaturePicture" type="hidden" id="signatureData" />

            <table class="attr-table">

                @* Declaration text *@
                <tr>
                    <td class="attr-label">Declaration</td>
                    <td colspan="3">
                        <textarea asp-for="Declaration.DeclarationText"
                                  class="attr-textarea" readonly
                                  style="min-height:80px; background:#f7fbfb;
                        color:#333; font-size:12px;">I declare that the information submitted is true and correct to the best of my knowledge. I understand that submitting this information does not mean it is automatically accepted and that it is subject to review by the City of Johannesburg valuation team.</textarea>
                    </td>
                </tr>

                @* Accept checkbox *@
                <tr>
                    <td class="attr-label">I Accept <span style="color:#e53e3e;">*</span></td>
                    <td colspan="3">
                        <label style="display:flex; align-items:center; gap:10px;
                            font-size:13px; cursor:pointer;">
                            <input asp-for="Declaration.DeclarationAccepted"
                                   type="checkbox"
                                   id="declAccepted"
                                   style="width:18px; height:18px; accent-color:#e6b000;"
                                   required />
                            <span>
                                I confirm that I have read, understood and accept this declaration.
                            </span>
                        </label>
                    </td>
                </tr>

                @* Capacity *@
                <tr>
                    <td class="attr-label">Capacity</td>
                    <td colspan="3">
                        <input class="attr-input"
                               value="@(ViewBag.Declaration?.ToString() ?? "Owner")"
                               readonly
                               style="background:#f7fbfb; font-weight:700;
                        color:#e6b000;" />
                    </td>
                </tr>

                @* Typed name *@
                <tr>
                    <td class="attr-label">
                        Full Name <span style="color:#e53e3e;">*</span>
                    </td>
                    <td>
                        <input asp-for="Declaration.SignatureName"
                               class="attr-input"
                               placeholder="Type your full name"
                               required />
                        <span asp-validation-for="Declaration.SignatureName"
                              style="color:#e53e3e; font-size:12px;"></span>
                    </td>

                    @* Date auto-populated *@
                    <td class="attr-label">Date</td>
                    <td>
                        <input id="declDate"
                               class="attr-input"
                               readonly
                               style="background:#f7fbfb; font-weight:600;" />
                    </td>
                </tr>

            </table>

            @* ── Canvas signature ──────────────────────────────────────── *@
            <div style="padding:14px;">

                <div style="font-weight:700; font-size:12px; text-transform:uppercase;
                    letter-spacing:.4px; color:#1a1a1a; margin-bottom:8px;
                    display:flex; align-items:center; gap:8px;">
                    <i class="fa-solid fa-pen-nib" style="color:#e6b000;"></i>
                    Draw Signature Below
                    <span style="color:#e53e3e; font-weight:400;">*</span>
                    <span style="font-weight:400; text-transform:none; font-size:11px;
                        color:#6b6b6b; margin-left:4px;">
                        (use mouse or finger on touchscreen)
                    </span>
                </div>

                <div style="position:relative; border:2px solid #d0d0d0;
                    border-radius:6px; background:#fff;
                    max-width:600px;">

                    <canvas id="sigCanvas"
                            width="598" height="160"
                            style="display:block; width:100%; height:160px;
                        border-radius:4px; cursor:crosshair;
                        touch-action:none;">
                    </canvas>

                    @* Watermark line *@
                    <div style="position:absolute; bottom:40px; left:20px; right:20px;
                        border-bottom:1px dashed #d0d0d0; pointer-events:none;">
                    </div>
                    <div style="position:absolute; bottom:20px; left:20px;
                        font-size:11px; color:#ccc; pointer-events:none;">
                        Sign here
                    </div>
                </div>

                @* Controls *@
                <div style="margin-top:8px; display:flex; gap:10px; align-items:center;">
                    <button type="button"
                            id="sigClearBtn"
                            onclick="clearSignature()"
                            style="padding:6px 16px; border-radius:4px;
                        background:#f7f7f7; border:1px solid #d0d0d0;
                        font-size:12px; font-weight:700; cursor:pointer;
                        font-family:inherit; color:#1a1a1a;">
                        <i class="fa-solid fa-rotate-left"></i> Clear
                    </button>
                    <span id="sigStatus"
                          style="font-size:12px; color:#6b6b6b;">
                        No signature drawn
                    </span>
                </div>

            </div>
        </div>


        <div class="attr-actions">
            <a asp-action="Create"
                   asp-controller="AttributeSubmission"
                   asp-route-formType="@Model.FormType"
                   class="btn-attr-secondary">
                Clear
            </a>

            <button type="submit" class="btn-attr-primary">
                Submit Attribute Information
            </button>
        </div>
    </form>
</div>

