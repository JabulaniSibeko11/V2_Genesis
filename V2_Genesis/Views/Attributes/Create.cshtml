@model V2_Genesis.Models.ViewModels.Attributes.AttributeSubmissionViewModel
@{
    ViewData["Title"] = "Attribute Property Submission";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    bool isRes  = Model.FormType == "Residential";
    bool isSt   = Model.FormType == "ResidentialST";
    bool isBus  = Model.FormType == "BusinessCommercial";
    bool isDrc  = Model.FormType == "DRCMethod";

    string formLabel = Model.FormType switch
    {
        "Residential"       => "Form A — Residential",
        "ResidentialST"     => "Form B — Residential Sectional Title",
        "BusinessCommercial"=> "Form C — Business &amp; Commercial",
        "DRCMethod"         => "Form D — DRC Method",
        _                   => "Attribute Submission"
    };
    string formIcon = Model.FormType switch
    {
        "Residential"        => "fa-house",
        "ResidentialST"      => "fa-building",
        "BusinessCommercial" => "fa-store",
        "DRCMethod"          => "fa-calculator",
        _                    => "fa-clipboard-list"
    };
}
<link href="~/css/views/attribute-create.css" rel="stylesheet" asp-append-version="true" />

@* ── HERO ────────────────────────────────────────────────────────── *@
<div class="attr-hero">
    <div class="attr-hero-inner">
        <div class="attr-hero-left">
            <div class="attr-hero-logo">
                <img src="~/images/joburg_logo.png" alt="City of Johannesburg" />
            </div>
            <div>
                <div class="attr-hero-org">City of Johannesburg · Valuation Services</div>
                <div class="attr-hero-eyebrow">
                    <span></span>
                    Property Attributes · GV23 / Supplementary Valuation Roll
                </div>
                <h1 class="attr-hero-title">
                    Property Attribute <em>Submission</em>
                </h1>
                <p class="attr-hero-sub">
                    <i class="fa-solid fa-@formIcon" style="font-size:11px;"></i>
                    @Html.Raw(formLabel)
                    <span class="attr-hero-sub-dot"></span>
                    Complete all visible fields accurately
                </p>
            </div>
        </div>
        <div class="attr-hero-right">
            <span class="attr-hero-badge">
                <i class="fa-solid fa-@formIcon"></i>
                @Html.Raw(formLabel)
            </span>
            @if (!string.IsNullOrWhiteSpace(Model.PropertyDetails?.PropertyDesc))
            {
                <div class="attr-hero-prop">
                    <div class="attr-hero-prop-icon"><i class="fa-solid fa-location-dot"></i></div>
                    <div>
                        <span class="attr-hero-prop-label">Property</span>
                        <span class="attr-hero-prop-value">@Model.PropertyDetails.PropertyDesc</span>
                    </div>
                </div>
            }
        </div>
    </div>
    <div class="attr-form-head">
        <span class="attr-form-head-label">Form Type</span>
        <span class="attr-form-head-title">@Html.Raw(formLabel) — Property Valuation Roll 1 July 2023 to 30 June 2027</span>
    </div>
</div>

@* ── FORM ─────────────────────────────────────────────────────────── *@
<div class="attr-page">
<form asp-action="Create" asp-controller="Attributes"
      method="post" enctype="multipart/form-data">

    @Html.AntiForgeryToken()

    @* ── Hidden system fields — never shown to client ── *@
    <input asp-for="FormType"                        type="hidden" />
    <input asp-for="AttrId"                          type="hidden" />
    <input asp-for="AttrNo"                          type="hidden" />
    <input asp-for="PropertyDetails.PropertyId"      type="hidden" />
    <input asp-for="PropertyDetails.PremiseId"       type="hidden" />
    <input asp-for="PropertyDetails.UnitKey"         type="hidden" />
    <input asp-for="PropertyDetails.ValuationKey"    type="hidden" />
    <input asp-for="PropertyDetails.Sector"          type="hidden" />
    <input asp-for="PropertyDetails.RollType"        type="hidden" />
    <input asp-for="PropertyDetails.RollDescription" type="hidden" />
    <input asp-for="PropertyDetails.HArea"           type="hidden" />
    <input asp-for="PropertyDetails.CollectionBlock" type="hidden" />
    <input asp-for="PropertyDetails.DataController"  type="hidden" />
    <input asp-for="PropertyDetails.DataCollector"   type="hidden" />
    <input asp-for="PropertyDetails.Centroid"        type="hidden" />
    <input asp-for="PropertyDetails.LandUseFinancials" type="hidden" />
    <input asp-for="PropertyDetails.Sources"         type="hidden" />
    <input asp-for="ValuationDetails.OwnersTitleDeeds"  type="hidden" />
    <input asp-for="ValuationDetails.OwnersFinancials"  type="hidden" />
    <input asp-for="PrimaryAttributes.AdjustmentFactor" type="hidden" />
    <input asp-for="Calculations.CalcUpdateTla"      type="hidden" />
    <input asp-for="Calculations.Tla"                type="hidden" />
    <input asp-for="Calculations.CalcUpdateWgba"     type="hidden" />
    <input asp-for="Calculations.AdjustedWgba"       type="hidden" />
    <input asp-for="Calculations.TotalValueNonRes"   type="hidden" />
    <input asp-for="Calculations.TotalValueUnutilisedLand" type="hidden" />
    <input asp-for="Calculations.DRCFinalValue"      type="hidden" />
    <input asp-for="Calculations.CalculationStatus"  type="hidden" />
    <input asp-for="BusinessGeneral.UnutilisedLandRate"   type="hidden" />
    <input asp-for="DrcMarketValueDemolition.DemolitionRate"            type="hidden" />
    <input asp-for="DrcMarketValueDemolition.MarketValue"               type="hidden" />
    <input asp-for="DrcMarketValueDemolition.MarketValueAfterDemolition" type="hidden" />

    <div asp-validation-summary="All" style="max-width:1100px;margin:12px auto;color:#dc2626;font-family:'Poppins',sans-serif;font-size:13px;"></div>

    @* ════════════════════════════════════════════════
       SECTION 1 — PROPERTY DETAILS (same on all forms)
    ════════════════════════════════════════════════ *@
    <div class="attr-card">
        <div class="attr-title">
            <i class="fa-solid fa-map-pin" style="color:var(--at-gold);margin-right:8px;"></i>
            Section 1: Property Details
        </div>
        <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>

        @if (!string.IsNullOrWhiteSpace(Model.PropertyDetails?.PropertyDesc))
        {
            <div class="attr-prop-banner">
                <div class="attr-prop-banner-icon"><i class="fa-solid fa-location-dot"></i></div>
                <div>
                    <span class="attr-prop-banner-label">Property Description</span>
                    <span class="attr-prop-banner-value">@Model.PropertyDetails.PropertyDesc</span>
                </div>
            </div>
        }

        <div class="attr-section-title"><span class="num">1.1</span> Property Identification</div>
        <table class="attr-table">
            <tr>
                <td class="attr-label">Municipality</td>
                <td class="attr-input-cell">
                    <input asp-for="PropertyDetails.Municipality" class="attr-input"
                           value="City of Johannesburg" readonly />
                </td>
                <td class="attr-label">Township</td>
                <td class="attr-input-cell">
                    <input asp-for="PropertyDetails.Township" class="attr-input" />
                </td>
            </tr>
            <tr>
                <td class="attr-label">Erf</td>
                <td><input asp-for="PropertyDetails.Erf" class="attr-input" /></td>
                <td class="attr-label">SG Number</td>
                <td><input asp-for="PropertyDetails.SGNumber" class="attr-input" /></td>
            </tr>
            <tr>
                <td class="attr-label">Sectional Title</td>
                <td><input asp-for="PropertyDetails.SectionalTitle" class="attr-input" /></td>
                <td class="attr-label">Extent</td>
                <td><input asp-for="PropertyDetails.Extent" class="attr-input" /></td>
            </tr>
            <tr>
                <td class="attr-label">Ward</td>
                <td><input asp-for="PropertyDetails.Ward" class="attr-input" /></td>
                <td class="attr-label">Zoning</td>
                <td><input asp-for="PropertyDetails.Zoning" class="attr-input" /></td>
            </tr>
            <tr>
                <td class="attr-label">Address</td>
                <td colspan="3"><input asp-for="PropertyDetails.Address" class="attr-input" /></td>
            </tr>
        </table>

        <div class="attr-section-title"><span class="num">1.2</span> Property Details</div>
        <table class="attr-table">
            <tr>
                <td class="attr-label">Valuation Category on Roll</td>
                <td colspan="3">
                    <select asp-for="ValuationDetails.ValuationCategoryOnRoll" class="attr-select">
                        <option value="">-- Select --</option>
                        <option>Residential</option>
                        <option>Residential with Consent Use</option>
                        <option>Business and Commercial</option>
                        <option>Multiple Purposes</option>
                        <option>Public Service Purposes</option>
                        <option>Public Service Infrastructure</option>
                        <option>Agricultural</option>
                        <option>Mining</option>
                        <option>Municipal</option>
                        <option>Private Open Space</option>
                        <option>Public Open Space</option>
                        <option>Religious</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td class="attr-label">Actual Use</td>
                <td colspan="3"><input asp-for="ValuationDetails.ActualUse" class="attr-input" /></td>
            </tr>
            <tr>
                <td class="attr-label">Mixed Use?</td>
                <td>
                    <div class="attr-radio-row">
                        <label><input type="radio" asp-for="ValuationDetails.IsMixedUse" value="true" /> Yes</label>
                        <label><input type="radio" asp-for="ValuationDetails.IsMixedUse" value="false" /> No</label>
                    </div>
                </td>
                <td class="attr-label">If mixed use, specify</td>
                <td><input asp-for="ValuationDetails.AlternateUsages" class="attr-input" placeholder="e.g. Residential + Commercial" /></td>
            </tr>
        </table>
    </div>

    @* ════════════════════════════════════════════════
       SECTION 2 — ACCESS (same on all forms, Comments hidden)
    ════════════════════════════════════════════════ *@
    <div class="attr-card">
        <div class="attr-title">
            <i class="fa-solid fa-door-open" style="color:var(--at-gold);margin-right:8px;"></i>
            Section 2: Access
        </div>
        <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>

        <table class="attr-table">
            <tr>
                <td class="attr-label">Access Type</td>
                <td colspan="3">
                    <div class="attr-radio-row">
                        <label><input type="radio" asp-for="Access.AccessType" value="None" /> None</label>
                        <label><input type="radio" asp-for="Access.AccessType" value="Garden Only" /> Garden Only</label>
                        <label><input type="radio" asp-for="Access.AccessType" value="House Only" /> House Only</label>
                        <label><input type="radio" asp-for="Access.AccessType" value="Partial" /> Partial</label>
                        <label><input type="radio" asp-for="Access.AccessType" value="Full" /> Full</label>
                    </div>
                </td>
            </tr>
            <tr>
                <td class="attr-label">Permission</td>
                <td colspan="3">
                    <div class="attr-radio-row">
                        <label><input type="radio" asp-for="Access.PermissionStatus" value="Granted" /> Granted</label>
                        <label><input type="radio" asp-for="Access.PermissionStatus" value="Refused" /> Refused</label>
                        <label><input type="radio" asp-for="Access.PermissionStatus" value="No-one home" /> No-one home</label>
                        <label><input type="radio" asp-for="Access.PermissionStatus" value="Unoccupied" /> Unoccupied</label>
                    </div>
                </td>
            </tr>
        </table>
        @* Access.Comments — stored as hidden, not shown *@
        <input asp-for="Access.Comments" type="hidden" />
    </div>

    @* ════════════════════════════════════════════════
       SECTION 3 — CONTACT INFO (same on all forms)
       Hidden: Maiden Name, ID Number, Date of Birth, Marital Status, Citizenship, Fax
    ════════════════════════════════════════════════ *@
    <div class="attr-card">
        <div class="attr-title">
            <i class="fa-solid fa-address-book" style="color:var(--at-gold);margin-right:8px;"></i>
            Section 3: Contact Information
        </div>
        <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>

        @for (int i = 0; i < Model.ContactInfos.Count; i++)
        {
            <div class="attr-section-title">
                <span class="num">@(i + 1)</span> @(i == 0 ? "Primary Contact" : $"Contact {i + 1}")
            </div>

            @* Hidden fields *@
            <input asp-for="ContactInfos[i].MaidenName"      type="hidden" />
            <input asp-for="ContactInfos[i].IDNumber"        type="hidden" />
            <input asp-for="ContactInfos[i].DateOfBirth"     type="hidden" />
            <input asp-for="ContactInfos[i].MaritalStatus"   type="hidden" />
            <input asp-for="ContactInfos[i].Citizenship"     type="hidden" />
            <input asp-for="ContactInfos[i].FaxNo"           type="hidden" />
            <input asp-for="ContactInfos[i].Interviewed"     type="hidden" />
            <input asp-for="ContactInfos[i].Comments"        type="hidden" />

            <table class="attr-table">
                <tr>
                    <td class="attr-label">Contact Type</td>
                    <td>
                        <select asp-for="ContactInfos[i].ContactType" class="attr-select">
                            <option>Owner</option>
                            <option>Representative</option>
                            <option>Company</option>
                            <option>Tenant</option>
                            <option>Other</option>
                        </select>
                    </td>
                    <td class="attr-label">Is Company?</td>
                    <td>
                        <div class="attr-radio-row">
                            <label><input type="radio" asp-for="ContactInfos[i].IsCompany" value="true" /> Yes</label>
                            <label><input type="radio" asp-for="ContactInfos[i].IsCompany" value="false" /> No</label>
                        </div>
                    </td>
                </tr>
                <tr>
                    <td class="attr-label">Company Name</td>
                    <td><input asp-for="ContactInfos[i].CompanyName" class="attr-input" /></td>
                    <td class="attr-label">Registration No.</td>
                    <td><input asp-for="ContactInfos[i].CompanyRegistrationNumber" class="attr-input" /></td>
                </tr>
                <tr>
                    <td class="attr-label">First Names</td>
                    <td><input asp-for="ContactInfos[i].FirstNames" class="attr-input" /></td>
                    <td class="attr-label">Last Name</td>
                    <td><input asp-for="ContactInfos[i].LastName" class="attr-input" /></td>
                </tr>
                <tr>
                    <td class="attr-label">Gender</td>
                    <td>
                        <div class="attr-radio-row">
                            <label><input type="radio" asp-for="ContactInfos[i].Gender" value="Male" /> Male</label>
                            <label><input type="radio" asp-for="ContactInfos[i].Gender" value="Female" /> Female</label>
                        </div>
                    </td>
                    <td class="attr-label">Email</td>
                    <td><input asp-for="ContactInfos[i].Email" type="email" class="attr-input" /></td>
                </tr>
                <tr>
                    <td class="attr-label">Physical Address</td>
                    <td colspan="3"><textarea asp-for="ContactInfos[i].PhysicalAddress" class="attr-textarea"></textarea></td>
                </tr>
                <tr>
                    <td class="attr-label">Postal Address</td>
                    <td colspan="3"><textarea asp-for="ContactInfos[i].PostalAddress" class="attr-textarea"></textarea></td>
                </tr>
                <tr>
                    <td class="attr-label">Home Phone</td>
                    <td><input asp-for="ContactInfos[i].HomePhoneNo" class="attr-input" placeholder="0112345678" /></td>
                    <td class="attr-label">Work Phone</td>
                    <td><input asp-for="ContactInfos[i].WorkPhoneNo" class="attr-input" placeholder="0112345678" /></td>
                </tr>
                <tr>
                    <td class="attr-label">Cell No</td>
                    <td colspan="3"><input asp-for="ContactInfos[i].CellNo" class="attr-input" placeholder="0712345678" /></td>
                </tr>
            </table>
        }
    </div>

    @* ════════════════════════════════════════════════
       SECTION 4 — FORM-SPECIFIC ATTRIBUTES
    ════════════════════════════════════════════════ *@
    @if (isRes || isSt)
    {
        <div class="attr-card">
            <div class="attr-title">
                <i class="fa-solid fa-house-chimney-window" style="color:var(--at-gold);margin-right:8px;"></i>
                Section 4: @(isSt ? "Sectional Title" : "Residential") Attributes
            </div>
            <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>

            <div class="attr-section-title"><span class="num">4.1</span> Primary Attributes</div>
            <table class="attr-table">
                @if (isRes)
                {
                    <tr>
                        <td class="attr-label">TLA 1</td>
                        <td><input asp-for="PrimaryAttributes.Tla1" class="attr-input" /></td>
                        <td class="attr-label">TLA 2</td>
                        <td><input asp-for="PrimaryAttributes.Tla2" class="attr-input" /></td>
                    </tr>
                    <tr>
                        <td class="attr-label">TLA 3</td>
                        <td><input asp-for="PrimaryAttributes.Tla3" class="attr-input" /></td>
                        <td class="attr-label">Garage</td>
                        <td><input asp-for="PrimaryAttributes.Garage" class="attr-input" /></td>
                    </tr>
                    <tr>
                        <td class="attr-label">Carport</td>
                        <td><input asp-for="PrimaryAttributes.CarportCp" class="attr-input" /></td>
                        <td class="attr-label">Granny Flat</td>
                        <td><input asp-for="PrimaryAttributes.GrannyFlatGf" class="attr-input" /></td>
                    </tr>
                    <tr>
                        <td class="attr-label">Staff Quarters</td>
                        <td><input asp-for="PrimaryAttributes.StaffQuartersSq" class="attr-input" /></td>
                        <td class="attr-label">Storage</td>
                        <td><input asp-for="PrimaryAttributes.Storage" class="attr-input" /></td>
                    </tr>
                }
                @if (isSt)
                {
                    <tr>
                        <td class="attr-label">ST Main</td>
                        <td><input asp-for="PrimaryAttributes.STMain" class="attr-input" /></td>
                        <td class="attr-label">Garage</td>
                        <td><input asp-for="PrimaryAttributes.Garage" class="attr-input" /></td>
                    </tr>
                    <tr>
                        <td class="attr-label">Carport</td>
                        <td><input asp-for="PrimaryAttributes.CarportCp" class="attr-input" /></td>
                        <td class="attr-label">Storage</td>
                        <td><input asp-for="PrimaryAttributes.Storage" class="attr-input" /></td>
                    </tr>
                }
            </table>

            <div class="attr-section-title"><span class="num">4.2</span> Secondary Attributes</div>
            <table class="attr-table">
                @if (isRes)
                {
                    <tr>
                        <td class="attr-label">Storeys</td>
                        <td>
                            <select asp-for="SecondaryAttributes.Storeys" class="attr-select">
                                <option value="">-- Select --</option>
                                <option value="1">1</option><option value="2">2</option>
                                <option value="3">3</option><option value="4">4</option>
                            </select>
                        </td>
                        <td class="attr-label">Security</td>
                        <td>
                            <select asp-for="SecondaryAttributes.Security" class="attr-select">
                                <option value="">-- Select --</option>
                                <option>High</option><option>Medium</option>
                                <option>Low</option><option>None</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td class="attr-label">Noise</td>
                        <td>
                            <select asp-for="SecondaryAttributes.Noise" class="attr-select">
                                <option value="">-- Select --</option>
                                <option>Freeway</option><option>Major Road</option>
                                <option>Side Street</option><option>Cul-de-sac</option>
                                <option>Entertainment</option>
                            </select>
                        </td>
                        <td class="attr-label">Topography</td>
                        <td>
                            <select asp-for="SecondaryAttributes.Topography" class="attr-select">
                                <option value="">-- Select --</option>
                                <option>Level</option><option>Average</option>
                                <option>Slope</option><option>Steep</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td class="attr-label">Quality</td>
                        <td>
                            <select asp-for="SecondaryAttributes.Quality" class="attr-select">
                                <option value="">-- Select --</option>
                                <option>Excellent</option><option>Good</option>
                                <option>Average</option><option>Poor</option>
                            </select>
                        </td>
                        <td class="attr-label">Condition</td>
                        <td>
                            <select asp-for="SecondaryAttributes.Condition" class="attr-select">
                                <option value="">-- Select --</option>
                                <option>Excellent</option><option>Good</option>
                                <option>Average</option><option>Poor</option>
                            </select>
                        </td>
                    </tr>
                    <tr>
                        <td class="attr-label">Swimming Pool</td>
                        <td>
                            <div class="attr-radio-row">
                                <label><input type="radio" asp-for="SecondaryAttributes.SwimmingPool" value="true" /> Yes</label>
                                <label><input type="radio" asp-for="SecondaryAttributes.SwimmingPool" value="false" /> No</label>
                            </div>
                        </td>
                        <td class="attr-label">Tennis Court</td>
                        <td>
                            <div class="attr-radio-row">
                                <label><input type="radio" asp-for="SecondaryAttributes.TennisCourt" value="true" /> Yes</label>
                                <label><input type="radio" asp-for="SecondaryAttributes.TennisCourt" value="false" /> No</label>
                            </div>
                        </td>
                    </tr>
                }
                @if (isSt)
                {
                    <tr>
                        <td class="attr-label">ST Condition</td>
                        <td>
                            <select asp-for="SecondaryAttributes.STCondition" class="attr-select">
                                <option value="">-- Select --</option>
                                <option value="1">Excellent</option><option value="2">Good</option>
                                <option value="3">Average</option><option value="4">Fair</option>
                                <option value="5">Poor</option>
                            </select>
                        </td>
                        <td class="attr-label">ST Floor</td>
                        <td><input asp-for="SecondaryAttributes.STFloor" class="attr-input" /></td>
                    </tr>
                    <tr>
                        <td class="attr-label">Quality</td>
                        <td colspan="3">
                            <div class="attr-radio-row">
                                <label><input type="radio" asp-for="SecondaryAttributes.Quality" value="Excellent" /> Excellent</label>
                                <label><input type="radio" asp-for="SecondaryAttributes.Quality" value="Good" /> Good</label>
                                <label><input type="radio" asp-for="SecondaryAttributes.Quality" value="Average" /> Average</label>
                                <label><input type="radio" asp-for="SecondaryAttributes.Quality" value="Poor" /> Poor</label>
                            </div>
                        </td>
                    </tr>
                }
            </table>
        </div>
    }

    @if (isBus)
    {
        <div class="attr-card">
            <div class="attr-title">
                <i class="fa-solid fa-store" style="color:var(--at-gold);margin-right:8px;"></i>
                Section 4: Buildings &amp; Sections
            </div>
            <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>

            <div class="attr-section-title"><span class="num">4.1</span> Buildings</div>
            <div class="table-responsive">
                <table class="attr-dyn-table" id="tbl-bus-buildings">
                    <thead>
                        <tr>
                            <th>Building Nr</th>
                            <th>Quality</th>
                            <th>Condition</th>
                            <th>Year Built</th>
                            <th>Storeys</th>
                            <th>GBA (m²)</th>
                            <th style="width:36px;"></th>
                        </tr>
                    </thead>
                    <tbody id="body-bus-buildings">
                        @for (int i = 0; i < 2; i++)
                        {
                            <tr>
                                <td><input name="BusinessBuildings[@i].BuildingNr" class="attr-input" /></td>
                                <td>
                                    <select name="BusinessBuildings[@i].Quality" class="attr-input attr-select">
                                        <option value="">--</option>
                                        <option>Excellent</option><option>Good</option>
                                        <option>Average</option><option>Fair</option><option>Poor</option>
                                    </select>
                                </td>
                                <td>
                                    <select name="BusinessBuildings[@i].Condition" class="attr-input attr-select">
                                        <option value="">--</option>
                                        <option>Excellent</option><option>Good</option>
                                        <option>Average</option><option>Fair</option><option>Poor</option>
                                    </select>
                                </td>
                                <td><input name="BusinessBuildings[@i].YearBuilt" class="attr-input" type="number" placeholder="e.g. 2005" /></td>
                                <td><input name="BusinessBuildings[@i].Storeys" class="attr-input" type="number" /></td>
                                <td><input name="BusinessBuildings[@i].GBA" class="attr-input" type="number" step="0.01" /></td>
                                @* Hidden: Depreciation, Cost, DRC *@
                                <input type="hidden" name="BusinessBuildings[@i].Depreciation" />
                                <input type="hidden" name="BusinessBuildings[@i].Cost" />
                                <input type="hidden" name="BusinessBuildings[@i].DRC" />
                                <td><button type="button" class="dyn-del-btn" onclick="delRow(this)" title="Remove"><i class="fa-solid fa-xmark"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dyn-add-bar">
                <button type="button" class="dyn-add-btn" onclick="addRow('body-bus-buildings', busBuildingTemplate)">
                    <i class="fa-solid fa-plus"></i> Add Building
                </button>
            </div>

            <div class="attr-section-title"><span class="num">4.2</span> Sections <small>— provide details of registered leases</small></div>
            <div class="table-responsive">
                <table class="attr-dyn-table" id="tbl-bus-sections">
                    <thead>
                        <tr>
                            <th>Building Nr</th>
                            <th>Usage</th>
                            <th>GBA (m²)</th>
                            <th>NLA (m²)</th>
                            <th>Rental (R/m²)</th>
                            <th style="width:36px;"></th>
                        </tr>
                    </thead>
                    <tbody id="body-bus-sections">
                        @for (int i = 0; i < 2; i++)
                        {
                            <tr>
                                <td><input name="BusinessSections[@i].BuildingNr" class="attr-input" /></td>
                                <td><input name="BusinessSections[@i].Usage" class="attr-input" /></td>
                                <td><input name="BusinessSections[@i].GBA" class="attr-input" type="number" step="0.01" /></td>
                                <td><input name="BusinessSections[@i].NLA" class="attr-input" type="number" step="0.01" /></td>
                                <td><input name="BusinessSections[@i].Rental" class="attr-input" type="number" step="0.01" /></td>
                                @* Hidden: MarketGroup, Quality, CostRate, Cost, Vac, Exp, Cap, Gross, Normalised, Nett, Value *@
                                <input type="hidden" name="BusinessSections[@i].MarketGroup" />
                                <input type="hidden" name="BusinessSections[@i].Quality" />
                                <input type="hidden" name="BusinessSections[@i].CostRate" />
                                <input type="hidden" name="BusinessSections[@i].Cost" />
                                <input type="hidden" name="BusinessSections[@i].Vac" />
                                <input type="hidden" name="BusinessSections[@i].Exp" />
                                <input type="hidden" name="BusinessSections[@i].Cap" />
                                <input type="hidden" name="BusinessSections[@i].Gross" />
                                <input type="hidden" name="BusinessSections[@i].Normalised" />
                                <input type="hidden" name="BusinessSections[@i].Nett" />
                                <input type="hidden" name="BusinessSections[@i].Value" />
                                <td><button type="button" class="dyn-del-btn" onclick="delRow(this)" title="Remove"><i class="fa-solid fa-xmark"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dyn-add-bar">
                <button type="button" class="dyn-add-btn" onclick="addRow('body-bus-sections', busSectionTemplate)">
                    <i class="fa-solid fa-plus"></i> Add Section
                </button>
            </div>

            <div class="attr-section-title"><span class="num">4.3</span> General</div>
            <table class="attr-table">
                <tr>
                    <td class="attr-label">Unutilised Land Extent (m²)</td>
                    <td colspan="3"><input asp-for="BusinessGeneral.UnutilisedLandExtent" class="attr-input" /></td>
                </tr>
            </table>
        </div>
    }

    @if (isDrc)
    {
        <div class="attr-card">
            <div class="attr-title">
                <i class="fa-solid fa-calculator" style="color:var(--at-gold);margin-right:8px;"></i>
                Section 4: DRC Method — Buildings &amp; Land
            </div>
            <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>

            <div class="attr-section-title"><span class="num">4.1</span> Buildings</div>
            <div class="table-responsive">
                <table class="attr-dyn-table" id="tbl-drc-buildings">
                    <thead>
                        <tr>
                            <th>Building Description</th>
                            <th>Quality</th>
                            <th>GBA (m²)</th>
                            <th>Condition</th>
                            <th style="width:36px;"></th>
                        </tr>
                    </thead>
                    <tbody id="body-drc-buildings">
                        @for (int i = 0; i < 2; i++)
                        {
                            <tr>
                                <td><input name="DrcBuildings[@i].BuildingDescription" class="attr-input" /></td>
                                <td>
                                    <select name="DrcBuildings[@i].Quality" class="attr-input attr-select">
                                        <option value="">--</option>
                                        <option>Excellent</option><option>Good</option>
                                        <option>Average</option><option>Fair</option><option>Poor</option>
                                    </select>
                                </td>
                                <td><input name="DrcBuildings[@i].GrossBuildingArea" class="attr-input" type="number" step="0.01" /></td>
                                <td>
                                    <select name="DrcBuildings[@i].Condition" class="attr-input attr-select">
                                        <option value="">--</option>
                                        <option>Excellent</option><option>Good</option>
                                        <option>Average</option><option>Fair</option><option>Poor</option>
                                    </select>
                                </td>
                                @* Hidden: DepreciationPercentage, RatePerSQM, DepreciatedRate, ReplacementCost *@
                                <input type="hidden" name="DrcBuildings[@i].DepreciationPercentage" />
                                <input type="hidden" name="DrcBuildings[@i].RatePerSQM" />
                                <input type="hidden" name="DrcBuildings[@i].DepreciatedRate" />
                                <input type="hidden" name="DrcBuildings[@i].ReplacementCost" />
                                <td><button type="button" class="dyn-del-btn" onclick="delRow(this)"><i class="fa-solid fa-xmark"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dyn-add-bar">
                <button type="button" class="dyn-add-btn" onclick="addRow('body-drc-buildings', drcBuildingTemplate)">
                    <i class="fa-solid fa-plus"></i> Add Building
                </button>
            </div>

            <div class="attr-section-title"><span class="num">4.2</span> Improvements</div>
            <div class="table-responsive">
                <table class="attr-dyn-table" id="tbl-drc-improvements">
                    <thead>
                        <tr>
                            <th>Improvement Description</th>
                            <th>Quality</th>
                            <th>Area / Unit</th>
                            <th>Condition</th>
                            <th style="width:36px;"></th>
                        </tr>
                    </thead>
                    <tbody id="body-drc-improvements">
                        @for (int i = 0; i < 2; i++)
                        {
                            <tr>
                                <td><input name="DrcImprovements[@i].ImprovementDescription" class="attr-input" /></td>
                                <td>
                                    <select name="DrcImprovements[@i].Quality" class="attr-input attr-select">
                                        <option value="">--</option>
                                        <option>Excellent</option><option>Good</option>
                                        <option>Average</option><option>Fair</option><option>Poor</option>
                                    </select>
                                </td>
                                <td><input name="DrcImprovements[@i].AreaUnit" class="attr-input" type="number" step="0.01" /></td>
                                <td>
                                    <select name="DrcImprovements[@i].Condition" class="attr-input attr-select">
                                        <option value="">--</option>
                                        <option>Excellent</option><option>Good</option>
                                        <option>Average</option><option>Fair</option><option>Poor</option>
                                    </select>
                                </td>
                                <input type="hidden" name="DrcImprovements[@i].DepreciationPercentage" />
                                <input type="hidden" name="DrcImprovements[@i].RatePerSQM" />
                                <input type="hidden" name="DrcImprovements[@i].DepreciatedRate" />
                                <input type="hidden" name="DrcImprovements[@i].ReplacementCost" />
                                <td><button type="button" class="dyn-del-btn" onclick="delRow(this)"><i class="fa-solid fa-xmark"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dyn-add-bar">
                <button type="button" class="dyn-add-btn" onclick="addRow('body-drc-improvements', drcImprovementTemplate)">
                    <i class="fa-solid fa-plus"></i> Add Improvement
                </button>
            </div>

            <div class="attr-section-title"><span class="num">4.3</span> Vacant Land</div>
            <div class="table-responsive">
                <table class="attr-dyn-table" id="tbl-drc-vacant">
                    <thead>
                        <tr>
                            <th>Region</th>
                            <th>Area (m²)</th>
                            <th style="width:36px;"></th>
                        </tr>
                    </thead>
                    <tbody id="body-drc-vacant">
                        @for (int i = 0; i < 2; i++)
                        {
                            <tr>
                                <td><input name="DrcVacantLands[@i].Region" class="attr-input" /></td>
                                <td><input name="DrcVacantLands[@i].Area" class="attr-input" type="number" step="0.01" /></td>
                                <input type="hidden" name="DrcVacantLands[@i].MinRatePerSQM" />
                                <input type="hidden" name="DrcVacantLands[@i].MidRatePerSQM" />
                                <input type="hidden" name="DrcVacantLands[@i].MaxRatePerSQM" />
                                <input type="hidden" name="DrcVacantLands[@i].Rate" />
                                <input type="hidden" name="DrcVacantLands[@i].VacantLandCost" />
                                <td><button type="button" class="dyn-del-btn" onclick="delRow(this)"><i class="fa-solid fa-xmark"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="dyn-add-bar">
                <button type="button" class="dyn-add-btn" onclick="addRow('body-drc-vacant', drcVacantTemplate)">
                    <i class="fa-solid fa-plus"></i> Add Land Entry
                </button>
            </div>
        </div>
    }

    @* ════════════════════════════════════════════════
       SECTION 5 — COMMENT
    ════════════════════════════════════════════════ *@
    <div class="attr-card">
        <div class="attr-title">
            <i class="fa-solid fa-comment" style="color:var(--at-gold);margin-right:8px;"></i>
            Section 5: Additional Comments
        </div>
        <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>
        <textarea asp-for="ClientComment" class="attr-textarea" rows="4"
                  placeholder="Please provide any additional information relevant to this property..."></textarea>
    </div>

    @* ════════════════════════════════════════════════
       SECTION 6 — EVIDENCE FILES
    ════════════════════════════════════════════════ *@
    <div class="attr-card ev-card">
        <div class="attr-title">
            <i class="fa-solid fa-paperclip" style="color:var(--at-gold);margin-right:8px;"></i>
            Section 6: Supporting Documents
            <span style="font-size:11px;font-weight:400;text-transform:none;margin-left:8px;">Maximum 10 files · 20 MB each</span>
        </div>
        <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>

        @if (ViewBag.RepRequired == true)
        {
            <div class="ev-rep-notice">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div><strong>Authorisation Letter Required</strong> — Upload the signed letter from the registered owner authorising you as their representative.</div>
            </div>
        }
        <div class="ev-rep-upload" style="@(ViewBag.RepRequired == true ? "" : "background:#f7fbfb;")">
            <div class="ev-rep-label">
                <i class="fa-solid fa-file-signature"></i>
                Authorisation Letter @(ViewBag.RepRequired == true ? "" : "(optional)")
                @if (ViewBag.RepRequired == true) { <span style="color:#e53e3e;">*</span> }
            </div>
                @if (ViewBag.RepRequired == true)
                {
                    <input asp-for="Files.RepLetter"
                           type="file"
                           class="ev-rep-input"
                           accept=".pdf,.doc,.docx,.jpg,.jpeg,.png"
                           required />
                }
                else
                {
                    <input asp-for="Files.RepLetter"
                           type="file"
                           class="ev-rep-input"
                           accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" />
                }
        </div>

        <div class="ev-dropzone" id="evDropzone"
             onclick="document.getElementById('evFileInput').click()">
            <div class="ev-dropzone-icon"><i class="fa-solid fa-cloud-arrow-up"></i></div>
            <div class="ev-dropzone-title">Drag files here to upload</div>
            <div class="ev-dropzone-sub">PDF, Word, Excel, Images, Title Deeds, Plans</div>
            <button type="button" class="ev-browse-btn"
                    onclick="event.stopPropagation();document.getElementById('evFileInput').click()">
                <i class="fa-solid fa-folder-open"></i> Browse Files
            </button>
        </div>
        <input type="file" id="evFileInput" name="Files.EvidenceFiles"
               multiple accept=".pdf,.doc,.docx,.jpg,.jpeg,.png,.xls,.xlsx" />

        <div class="ev-counter">
            <span id="evCountText">0 / 10 files selected</span>
            <div class="ev-counter-bar"><div class="ev-counter-fill" id="evCountFill"></div></div>
        </div>
        <div class="ev-file-list" id="evFileList"></div>
        <div class="ev-note">
            <i class="fa-solid fa-circle-info"></i>
            Supported: PDF, Word, Excel, JPG, PNG &nbsp;|&nbsp; Max 10 files &nbsp;|&nbsp; Max 20 MB per file
        </div>
    </div>

    @* ════════════════════════════════════════════════
       SECTION 7 — DECLARATION & SIGNATURE
    ════════════════════════════════════════════════ *@
    <div class="attr-card">
        <div class="attr-title">
            <i class="fa-solid fa-signature" style="color:var(--at-gold);margin-right:8px;"></i>
            Section 7: Declaration &amp; Signature
        </div>
        <div class="attr-divider"><div class="line"></div><div class="dot"></div><div class="line"></div></div>

        <div class="attr-legal-box">
            <p>I declare that the information submitted is true and correct to the best of my knowledge. I understand that submitting this information does not mean it is automatically accepted and that it is subject to review by the City of Johannesburg valuation team.</p>
        </div>

        <input asp-for="Declaration.SignaturePicture" type="hidden" id="signatureData" />

        <table class="attr-table">
            <tr>
                <td class="attr-label">I Accept <span style="color:#e53e3e;">*</span></td>
                <td colspan="3">
                    <label style="display:flex;align-items:center;gap:10px;font-size:13px;cursor:pointer;font-family:'Poppins',sans-serif;">
                        <input asp-for="Declaration.DeclarationAccepted" type="checkbox" id="declAccepted"
                               style="width:18px;height:18px;accent-color:#e6b000;" required />
                        I confirm that I have read, understood and accept this declaration.
                    </label>
                </td>
            </tr>
            <tr>
                <td class="attr-label">Capacity</td>
                <td colspan="3">
                    <input class="attr-input" value="@(ViewBag.Declaration?.ToString() ?? "Owner")" readonly
                           style="background:var(--at-teal-pale);font-weight:700;color:var(--at-gold);" />
                </td>
            </tr>
            <tr>
                <td class="attr-label">Full Name <span style="color:#e53e3e;">*</span></td>
                <td>
                    <input asp-for="Declaration.SignatureName" class="attr-input"
                           placeholder="Type your full name" required />
                    <span asp-validation-for="Declaration.SignatureName" style="color:#e53e3e;font-size:12px;"></span>
                </td>
                <td class="attr-label">Date</td>
                <td><input id="declDate" class="attr-input" readonly style="background:var(--at-teal-pale);" /></td>
            </tr>
        </table>

        <div style="padding:14px;">
            <div style="font-weight:700;font-size:11px;text-transform:uppercase;letter-spacing:.5px;
                color:#1a1a1a;margin-bottom:10px;display:flex;align-items:center;gap:8px;
                font-family:'Poppins',sans-serif;">
                <i class="fa-solid fa-pen-nib" style="color:var(--at-gold);"></i>
                Draw Signature Below <span style="color:#e53e3e;font-weight:400;">*</span>
                <span style="font-weight:400;text-transform:none;font-size:11px;color:#888;margin-left:4px;">(mouse or finger)</span>
            </div>
            <div class="attr-sig-canvas-wrap">
                <canvas id="sigCanvas" width="598" height="160" style="width:100%;height:160px;"></canvas>
                <div class="attr-sig-line"></div>
                <div class="attr-sig-hint">Sign here</div>
            </div>
            <div class="attr-sig-controls">
                <button type="button" id="sigClearBtn" onclick="clearSignature()"
                        style="padding:6px 16px;border-radius:6px;background:#f7f7f7;
                        border:1px solid #d0d0d0;font-size:12px;font-weight:700;
                        cursor:pointer;font-family:inherit;">
                    <i class="fa-solid fa-rotate-left"></i> Clear
                </button>
                <span id="sigStatus" style="font-size:12px;color:#6b6b6b;font-family:'Poppins',sans-serif;">No signature drawn</span>
            </div>
        </div>
    </div>

    @* ── Submit actions ── *@
    <div class="attr-actions">
        <a asp-action="Create" asp-controller="Attributes"
           asp-route-formType="@Model.FormType"
           class="btn-attr-secondary">
            <i class="fa-solid fa-rotate-left"></i> Reset Form
        </a>
        <button type="submit" class="btn-attr-primary">
            <i class="fa-solid fa-paper-plane"></i> Submit Attribute Information
        </button>
    </div>

</form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/attribute-create.js"></script>

    <script>
        // ── Auto-populate date ───────────────────────────────────────
        document.getElementById('declDate').value =
            new Date().toLocaleDateString('en-ZA', { day:'2-digit', month:'long', year:'numeric' });

        // ── Dynamic row templates ────────────────────────────────────
        function delRow(btn) { btn.closest('tr').remove(); reIndex(); }

        function reIndex() {
            ['bus-buildings','bus-sections','drc-buildings','drc-improvements','drc-vacant'].forEach(function(id) {
                var tbody = document.getElementById('body-' + id);
                if (!tbody) return;
                Array.from(tbody.rows).forEach(function(row, i) {
                    row.querySelectorAll('[name]').forEach(function(el) {
                        el.name = el.name.replace(/\[\d+\]/, '[' + i + ']');
                    });
                });
            });
        }

        function addRow(bodyId, templateFn) {
            var tbody = document.getElementById(bodyId);
            var idx   = tbody ? tbody.rows.length : 0;
            var tr    = document.createElement('tr');
            tr.innerHTML = templateFn(idx);
            if (tbody) tbody.appendChild(tr);
        }

        // ── Row templates ────────────────────────────────────────────
        function qualitySelect(name) {
            return '<select name="' + name + '" class="attr-input attr-select">' +
                '<option value="">--</option><option>Excellent</option><option>Good</option>' +
                '<option>Average</option><option>Fair</option><option>Poor</option></select>';
        }
        function condSelect(name) { return qualitySelect(name); }
        function delBtn() {
            return '<td><button type="button" class="dyn-del-btn" onclick="delRow(this)" title="Remove">' +
                '<i class="fa-solid fa-xmark"></i></button></td>';
        }

        var busBuildingTemplate = function(i) {
            return '<td><input name="BusinessBuildings['+i+'].BuildingNr" class="attr-input"/></td>' +
                '<td>' + qualitySelect('BusinessBuildings['+i+'].Quality') + '</td>' +
                '<td>' + condSelect('BusinessBuildings['+i+'].Condition') + '</td>' +
                '<td><input name="BusinessBuildings['+i+'].YearBuilt" class="attr-input" type="number"/></td>' +
                '<td><input name="BusinessBuildings['+i+'].Storeys" class="attr-input" type="number"/></td>' +
                '<td><input name="BusinessBuildings['+i+'].GBA" class="attr-input" type="number" step="0.01"/></td>' +
                '<input type="hidden" name="BusinessBuildings['+i+'].Depreciation"/>' +
                '<input type="hidden" name="BusinessBuildings['+i+'].Cost"/>' +
                '<input type="hidden" name="BusinessBuildings['+i+'].DRC"/>' + delBtn();
        };
        var busSectionTemplate = function(i) {
            return '<td><input name="BusinessSections['+i+'].BuildingNr" class="attr-input"/></td>' +
                '<td><input name="BusinessSections['+i+'].Usage" class="attr-input"/></td>' +
                '<td><input name="BusinessSections['+i+'].GBA" class="attr-input" type="number" step="0.01"/></td>' +
                '<td><input name="BusinessSections['+i+'].NLA" class="attr-input" type="number" step="0.01"/></td>' +
                '<td><input name="BusinessSections['+i+'].Rental" class="attr-input" type="number" step="0.01"/></td>' +
                '<input type="hidden" name="BusinessSections['+i+'].MarketGroup"/>' +
                '<input type="hidden" name="BusinessSections['+i+'].Quality"/>' +
                '<input type="hidden" name="BusinessSections['+i+'].CostRate"/>' +
                '<input type="hidden" name="BusinessSections['+i+'].Cost"/>' +
                '<input type="hidden" name="BusinessSections['+i+'].Vac"/>' +
                '<input type="hidden" name="BusinessSections['+i+'].Exp"/>' +
                '<input type="hidden" name="BusinessSections['+i+'].Cap"/>' +
                '<input type="hidden" name="BusinessSections['+i+'].Gross"/>' +
                '<input type="hidden" name="BusinessSections['+i+'].Normalised"/>' +
                '<input type="hidden" name="BusinessSections['+i+'].Nett"/>' +
                '<input type="hidden" name="BusinessSections['+i+'].Value"/>' + delBtn();
        };
        var drcBuildingTemplate = function(i) {
            return '<td><input name="DrcBuildings['+i+'].BuildingDescription" class="attr-input"/></td>' +
                '<td>' + qualitySelect('DrcBuildings['+i+'].Quality') + '</td>' +
                '<td><input name="DrcBuildings['+i+'].GrossBuildingArea" class="attr-input" type="number" step="0.01"/></td>' +
                '<td>' + condSelect('DrcBuildings['+i+'].Condition') + '</td>' +
                '<input type="hidden" name="DrcBuildings['+i+'].DepreciationPercentage"/>' +
                '<input type="hidden" name="DrcBuildings['+i+'].RatePerSQM"/>' +
                '<input type="hidden" name="DrcBuildings['+i+'].DepreciatedRate"/>' +
                '<input type="hidden" name="DrcBuildings['+i+'].ReplacementCost"/>' + delBtn();
        };
        var drcImprovementTemplate = function(i) {
            return '<td><input name="DrcImprovements['+i+'].ImprovementDescription" class="attr-input"/></td>' +
                '<td>' + qualitySelect('DrcImprovements['+i+'].Quality') + '</td>' +
                '<td><input name="DrcImprovements['+i+'].AreaUnit" class="attr-input" type="number" step="0.01"/></td>' +
                '<td>' + condSelect('DrcImprovements['+i+'].Condition') + '</td>' +
                '<input type="hidden" name="DrcImprovements['+i+'].DepreciationPercentage"/>' +
                '<input type="hidden" name="DrcImprovements['+i+'].RatePerSQM"/>' +
                '<input type="hidden" name="DrcImprovements['+i+'].DepreciatedRate"/>' +
                '<input type="hidden" name="DrcImprovements['+i+'].ReplacementCost"/>' + delBtn();
        };
        var drcVacantTemplate = function(i) {
            return '<td><input name="DrcVacantLands['+i+'].Region" class="attr-input"/></td>' +
                '<td><input name="DrcVacantLands['+i+'].Area" class="attr-input" type="number" step="0.01"/></td>' +
                '<input type="hidden" name="DrcVacantLands['+i+'].MinRatePerSQM"/>' +
                '<input type="hidden" name="DrcVacantLands['+i+'].MidRatePerSQM"/>' +
                '<input type="hidden" name="DrcVacantLands['+i+'].MaxRatePerSQM"/>' +
                '<input type="hidden" name="DrcVacantLands['+i+'].Rate"/>' +
                '<input type="hidden" name="DrcVacantLands['+i+'].VacantLandCost"/>' + delBtn();
        };
    </script>
}
