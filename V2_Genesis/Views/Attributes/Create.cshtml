   Root cause of null files:
   fileInput.value = '' clears the input AFTER DataTransfer assigns files,
   so the form always submits with zero files.
   
   Fix: intercept form submit → manually append from selectedFiles array
════════════════════════════════════════════════════════════════ *@

    <script>
        (function () {
            const MAX_FILES = 10;
            const MAX_MB    = 20;
            let selectedFiles = [];   // JS File objects — ground truth

            const dropzone  = document.getElementById('evDropzone');
            const fileInput = document.getElementById('evFileInput');
            const fileList  = document.getElementById('evFileList');
            const countText = document.getElementById('evCountText');
            const countFill = document.getElementById('evCountFill');
            const form      = fileInput?.closest('form');

            if (!fileInput) return;

            // ── Drag events ──────────────────────────────────────────────
            dropzone.addEventListener('dragover', function (e) {
                e.preventDefault();
                if (selectedFiles.length < MAX_FILES)
                    dropzone.classList.add('dragover');
            });

            dropzone.addEventListener('dragleave', function () {
                dropzone.classList.remove('dragover');
            });

            dropzone.addEventListener('drop', function (e) {
                e.preventDefault();
                dropzone.classList.remove('dragover');
                addFiles(Array.from(e.dataTransfer.files));
            });

            // ── Browse click ─────────────────────────────────────────────
            fileInput.addEventListener('change', function () {
                addFiles(Array.from(this.files));
                // DO NOT clear this.value — we need files to stay accessible
                // DataTransfer is rebuilt here to keep input in sync
                syncInputFiles();
            });

            // ── Add files ────────────────────────────────────────────────
            function addFiles(newFiles) {
                const remaining = MAX_FILES - selectedFiles.length;
                if (remaining <= 0) {
                    alert('Maximum 10 files allowed. Remove a file first.');
                    return;
                }

                const toAdd     = newFiles.slice(0, remaining);
                const oversized = toAdd.filter(f => f.size > MAX_MB * 1024 * 1024);

                if (oversized.length) {
                    alert(
                        oversized.map(f => f.name).join(', ') +
                        (oversized.length === 1 ? ' exceeds' : ' exceed') +
                        ' the 20 MB limit and was skipped.'
                    );
                }

                const valid = toAdd.filter(f => f.size <= MAX_MB * 1024 * 1024);
                selectedFiles = [...selectedFiles, ...valid];

                renderList();
                syncInputFiles();
            }

            // ── Remove file ──────────────────────────────────────────────
            window.removeFile = function (index) {
                selectedFiles.splice(index, 1);
                renderList();
                syncInputFiles();
            };

            // ── Sync fileInput.files via DataTransfer ────────────────────
            // Keeps the native input in sync so it shows correct file count
            // BUT we also use FormData on submit as a safety fallback
            function syncInputFiles() {
                try {
                    const dt = new DataTransfer();
                    selectedFiles.forEach(f => dt.items.add(f));
                    fileInput.files = dt.files;
                } catch (e) {
                    // DataTransfer not supported — FormData submit handles it
                }
            }

            // ── Intercept form submit — RELIABLE file injection ──────────
            // This is the definitive fix: regardless of DataTransfer support,
            // we inject files into FormData manually before sending.
            if (form) {
                form.addEventListener('submit', function (e) {
                    // Let standard validation run first
                    if (!form.checkValidity()) return;

                    e.preventDefault();

                    // Build FormData from the whole form
                    const fd = new FormData(form);

                    // Remove any Files.EvidenceFiles entries the browser may have
                    // added (could be empty or stale) and re-add from selectedFiles
                    fd.delete('Files.EvidenceFiles');
                    selectedFiles.forEach(function (file) {
                        fd.append('Files.EvidenceFiles', file);
                    });

                    // Disable submit button to prevent double-submit
                    var submitBtn = form.querySelector('[type="submit"]');
                    if (submitBtn) {
                        submitBtn.disabled = true;
                        submitBtn.innerHTML =
                            '<i class="fa-solid fa-spinner fa-spin"></i> Submitting…';
                    }

                    fetch(form.action || window.location.href, {
                        method : 'POST',
                        body   : fd,
                        headers: { 'X-Requested-With': 'XMLHttpRequest' }
                    })
                    .then(function (response) {
                        // ASP.NET redirects after success — follow the redirect
                        if (response.redirected) {
                            window.location.href = response.url;
                            return;
                        }
                        // Validation error — replace page content
                        return response.text().then(function (html) {
                            document.open();
                            document.write(html);
                            document.close();
                        });
                    })
                    .catch(function (err) {
                        console.error('Submit error:', err);
                        if (submitBtn) {
                            submitBtn.disabled = false;
                            submitBtn.innerHTML =
                                'Submit Attribute Information';
                        }
                        alert('Submission failed. Please try again.');
                    });
                });
            }

            // ── Render file list UI ──────────────────────────────────────
            function renderList() {
                fileList.innerHTML = '';

                selectedFiles.forEach(function (file, index) {
                    const item = document.createElement('div');
                    item.className = 'ev-file-item';
                    item.innerHTML =
                        '<i class="fa-solid ' + getFileIcon(file.name) +
                        ' ev-file-icon"></i>' +
                        '<span class="ev-file-name" title="' + escHtml(file.name) + '">' +
                            escHtml(file.name) +
                        '</span>' +
                        '<span class="ev-file-size">' + formatSize(file.size) + '</span>' +
                        '<button type="button" class="ev-file-remove" ' +
                            'onclick="removeFile(' + index + ')" title="Remove">' +
                            '<i class="fa-solid fa-xmark"></i>' +
                        '</button>';
                    fileList.appendChild(item);
                });

                const count  = selectedFiles.length;
                const pct    = (count / MAX_FILES) * 100;
                const isFull = count >= MAX_FILES;

                countText.textContent   = count + ' / ' + MAX_FILES + ' files selected';
                countFill.style.width   = pct + '%';
                countFill.classList.toggle('full', isFull);
                dropzone.classList.toggle('full', isFull);
            }

            // ── Helpers ──────────────────────────────────────────────────
            function getFileIcon(name) {
                const ext = (name.split('.').pop() || '').toLowerCase();
                const map = {
                    pdf: 'fa-file-pdf', doc: 'fa-file-word', docx: 'fa-file-word',
                    xls: 'fa-file-excel', xlsx: 'fa-file-excel',
                    jpg: 'fa-file-image', jpeg: 'fa-file-image', png: 'fa-file-image'
                };
                return map[ext] || 'fa-file';
            }

            function formatSize(bytes) {
                if (bytes < 1024)     return bytes + ' B';
                if (bytes < 1048576)  return (bytes / 1024).toFixed(1) + ' KB';
                return (bytes / 1048576).toFixed(1) + ' MB';
            }

            function escHtml(str) {
                return str.replace(/&/g,'&amp;').replace(/</g,'&lt;')
                          .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
            }
        })();
    </script>
}