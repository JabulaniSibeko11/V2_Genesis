                <div class="attr-section-title"><span class="num">3.1</span> Buildings</div>
                <div class="table-responsive">
                    <table class="attr-dyn-table" id="tbl-drc-buildings">
                        <thead>
                            <tr>
                                <th>Building Description</th>
                                <th>Quality</th>
                                <th>GBA (m²)</th>
