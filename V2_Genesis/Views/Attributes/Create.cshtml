                            {
                                <tr>
                                    <td><input name="DrcBuildings[@i].BuildingDescription" class="attr-input" /></td>
                                    <td>
                                        <select name="DrcBuildings[@i].Quality" class="attr-input attr-select">
                                            <option value="">--</option>
                                            <option>Excellent</option>
                                            <option>Good</option>
                                            <option>Average</option>
