@model V2_Genesis.Models.ViewModels.Attributes.AttributeAcknowledgementVm

@{
    ViewData["Title"] = "Attribute Submission Acknowledgement";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    var submitted = Model.SubmissionDate.ToString("dd MMMM yyyy HH:mm");

    var deadline = Model.EvidenceDeadline.HasValue
        ? Model.EvidenceDeadline.Value.ToString("dd MMMM yyyy HH:mm")
        : "";

    var isExpired = Model.EvidenceDeadline.HasValue &&
                    DateTime.Now > Model.EvidenceDeadline.Value;

    var formType = Model.Submission?.FormType;

    string FormLabel(string? value) => value switch
    {
        "Residential" => "Residential",
        "ResidentialST" => "Residential — Sectional Title",
        "BusinessCommercial" => "Non-Residential / Business and Commercial",
        "DRCMethod" => "DRC Method",
        _ => value ?? "Property Attribute Submission"
    };
}

<link href="~/css/views/attribute-create.css" rel="stylesheet" asp-append-version="true" />

<link href="~/css/views/attribute-ackn.css" rel="stylesheet" />
<div class="aa-page">

    @* ── Hero ─────────────────────────────────────── *@
    <div class="aa-hero">
        <div class="aa-hero-inner">
            <div class="aa-hero-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>
            <div>
                <div class="aa-hero-eyebrow">City of Johannesburg · Valuation Services</div>
                <h1 class="aa-hero-title">Attribute Submission Acknowledgement</h1>
                <p class="aa-hero-sub">Your property attribute information was submitted successfully.</p>
            </div>
        </div>
    </div>

    <div class="aa-body">

        @* ── Success alert ──────────────────────────── *@
        <div class="aa-alert aa-alert-success">
            <i class="fa-solid fa-circle-check"></i>
            <div>Submission received. Please keep your reference number and evidence upload PIN safely.</div>
        </div>

        @* ── Evidence deadline alert ─────────────────── *@
        <div class="aa-alert @(isExpired ? "aa-alert-danger" : "aa-alert-warning")">
            <i class="fa-solid fa-clock"></i>
            <div>
                @if (isExpired)
                {
                    <span>
                        The 48-hour evidence upload period has expired.
                        Please contact the Valuation team if you still need to submit supporting documents.
                    </span>
                }
                else
                {
                    <span>
                        You have <strong>48 hours</strong> from the time of submission to upload supporting evidence.
                        Evidence upload deadline: <strong>@deadline</strong>.
                    </span>
                }
            </div>
        </div>

        @* ── Reference + PIN ─────────────────────────── *@
        <div class="aa-ref-card">
            <div class="aa-ref-grid">
                <div class="aa-ref-box">
                    <div class="aa-ref-label">Reference Number</div>
                    <div class="aa-ref-value">@Model.AttrNo</div>
                </div>
                <div class="aa-ref-box">
                    <div class="aa-ref-label">Evidence Upload PIN</div>
                    <div class="aa-ref-value pin">@Model.Pin</div>
                </div>
            </div>
        </div>

        @* ── Submission details ──────────────────────── *@
        <div class="aa-card">
            <div class="aa-card-bar">
                <i class="fa-solid fa-clipboard-list"></i>
                <h3>Submission Details</h3>
            </div>
            <div class="aa-card-body">
                <div class="aa-field-grid">

                    <div class="aa-field">
                        <span class="aa-field-label">Status</span>
                        <div class="aa-field-value">Submitted</div>
                    </div>

                    <div class="aa-field">
                        <span class="aa-field-label">Form Type</span>
                        <div class="aa-field-value">@FormLabel(formType)</div>
                    </div>

                    <div class="aa-field">
                        <span class="aa-field-label">Submitted Date</span>
                        <div class="aa-field-value">@submitted</div>
                    </div>

                    <div class="aa-field full">
                        <span class="aa-field-label">Property Description</span>
                        <div class="aa-field-value">@(Model.PropertyDescription ?? "–")</div>
                    </div>

                    <div class="aa-field full">
                        <span class="aa-field-label">Physical Address</span>
                        <div class="aa-field-value">@(Model.PhysicalAddress ?? "–")</div>
                    </div>

                    <div class="aa-field">
                        <span class="aa-field-label">Property Category</span>
                        <div class="aa-field-value">@(Model.PropertyCategory ?? "–")</div>
                    </div>

                    <div class="aa-field">
                        <span class="aa-field-label">Extent</span>
                        <div class="aa-field-value">@(Model.Extent ?? "–")</div>
                    </div>

                    <div class="aa-field">
                        <span class="aa-field-label">Evidence Deadline</span>
                        <div class="aa-field-value">@deadline</div>
                    </div>

                    <div class="aa-field">
                        <span class="aa-field-label">Evidence Files Uploaded</span>
                        <div class="aa-field-value">@Model.EvidenceCount</div>
                    </div>

                    <div class="aa-field">
                        <span class="aa-field-label">Acknowledgement File</span>
                        <div class="aa-field-value">@(Model.AcknowledgementFileName ?? "Generated")</div>
                    </div>

                </div>
            </div>
        </div>

        @* ── Submitted form data (partial) ───────────── *@
        @if (Model.Submission != null)
        {
            @await Html.PartialAsync("_AttributeSubmittedDisplay", Model.Submission)
        }
        else
        {
            <div class="aa-alert aa-alert-danger">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>Submitted form details could not be loaded. The acknowledgement PDF can still be downloaded.</div>
            </div>
        }

        @* ── Actions ──────────────────────────────────── *@
        <div class="aa-actions">
            <a class="aa-btn aa-btn-primary"
               href="/attributes/acknowledgement/download?attrNo=@Model.AttrNo">
                <i class="fa-solid fa-download"></i> Download Acknowledgement
            </a>

            @if (!isExpired)
            {
                <a class="aa-btn aa-btn-gold"
                   href="/attributes/evidence?attrNo=@Model.AttrNo">
                    <i class="fa-solid fa-upload"></i> Upload Evidence
                </a>
            }

            <a class="aa-btn aa-btn-light"
               href="/dashboard?openRoll=attributes">
                <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
            </a>
        </div>

        @* ── Note ─────────────────────────────────────── *@
        <div class="aa-note">
            <strong>Important:</strong>
            This acknowledgement confirms that your information was submitted.
            It does not mean that the submitted information has been accepted or approved.
            The City of Johannesburg Valuation team will review the submission.
        </div>

    </div>
</div>
