@model V2_Genesis.Models.ViewModels.ValuerInspectionEvidence.ValuerInspectionTodayVm
@{
    ViewData["Title"] = "Today's Inspections";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var today = DateTime.Now.ToString("dddd, dd MMMM yyyy");
    var total = Model.Inspections?.Count ?? 0;
    var done = Model.Inspections?.Count(i => i.EvidenceUploaded) ?? 0;
    var remaining = total - done;
    int pct = total > 0 ? (int)Math.Round(done * 100.0 / total) : 0;
}

<link href="~/css/views/today-page.css" rel="stylesheet" asp-append-version="true" />

<div class="vie-today-page">

    @* ── Hero ──────────────────────────────────────── *@
    <div class="vt-hero">
        <div class="vt-hero-inner">

            <div class="vt-hero-top">
                <div class="vt-hero-brand">
                    <img src="~/images/joburg_logo.png" alt="COJ" />
                    <span class="vt-hero-brand-text">Valuation Services</span>
                </div>
                <div class="vt-hero-badge">
                    <span class="live-dot"></span> Live
                </div>
            </div>

            <div class="vt-hero-name">
                Good @(DateTime.Now.Hour < 12 ? "morning" : DateTime.Now.Hour < 17 ? "afternoon" : "evening"),
                <strong>@Model.ValuerName</strong>
            </div>
            <div class="vt-hero-date">
                <i class="fa-solid fa-calendar-day"></i>
                @today
            </div>

            <div class="vt-progress-strip">
                <div class="vt-prog-nums">
                    <div class="vt-prog-num">
                        <span class="vt-prog-num-val">@total</span>
                        <span class="vt-prog-num-label">Total</span>
                    </div>
                    <div class="vt-prog-divider"></div>
                    <div class="vt-prog-num">
                        <span class="vt-prog-num-val gold">@done</span>
                        <span class="vt-prog-num-label">Done</span>
                    </div>
                    <div class="vt-prog-divider"></div>
                    <div class="vt-prog-num">
                        <span class="vt-prog-num-val">@remaining</span>
                        <span class="vt-prog-num-label">Remaining</span>
                    </div>
                </div>

                <div class="vt-prog-bar-wrap">
                    <div class="vt-prog-bar-label">
                        Progress <span>@pct%</span>
                    </div>
                    <div class="vt-prog-bar">
                        <div class="vt-prog-fill" style="width:@pct%"></div>
                    </div>
                </div>
            </div>

        </div>
    </div>

    @* ── Body ───────────────────────────────────────── *@
    <div class="vt-body">

        @* Alerts *@
        @if (TempData["Success"] != null)
        {
            <div class="vt-alert vt-alert-success">
                <i class="fa-solid fa-circle-check"></i>
                <span>@TempData["Success"]</span>
            </div>
        }
        @if (TempData["Error"] != null)
        {
            <div class="vt-alert vt-alert-error">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span>@TempData["Error"]</span>
            </div>
        }

        @* Empty state *@
        @if (total == 0)
        {
            <div class="vt-empty">
                <i class="fa-solid fa-calendar-xmark"></i>
                <h3>No inspections scheduled today</h3>
                <p>You have no inspections assigned for @DateTime.Now.ToString("dd MMMM yyyy").</p>
            </div>
        }
        else
        {
            @* Pending *@
            var pending = Model.Inspections?.Where(i => !i.EvidenceUploaded).ToList();
            @if (pending.Any())
            {
                <div class="vt-section-label">Pending — @pending.Count remaining</div>

                @for (int i = 0; i < pending.Count; i++)
                {
                    var insp = pending[i];
                    <div class="vt-card">

                        <div class="vt-card-head">
                            <div class="vt-card-num">@(i + 1)</div>
                            <div class="vt-card-addr">
                                <div class="vt-card-prop">@insp.PropertyAddress</div>
                                <div class="vt-card-desc">@insp.PropertyDescription</div>
                            </div>
                            <span class="vt-status-pill vt-pill-pending">
                                <i class="fa-solid fa-clock"></i> Pending
                            </span>
                        </div>

                        <div class="vt-card-meta">
                            <div class="vt-meta-field">
                                <span class="vt-meta-label">Inspection Time</span>
                                <span class="vt-meta-value">
                                    <i class="fa-solid fa-clock"></i>
                                    @insp.ScheduledTime.ToString("HH:mm")
                                </span>
                            </div>
                            <div class="vt-meta-field">
                                <span class="vt-meta-label">Property Ref</span>
                                <span class="vt-meta-value">
                                    <i class="fa-solid fa-hashtag"></i>
                                    @insp.PropertyRef
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(insp.OwnerName))
                            {
                                <div class="vt-meta-field">
                                    <span class="vt-meta-label">Owner</span>
                                    <span class="vt-meta-value">
                                        <i class="fa-solid fa-user"></i>
                                        @insp.OwnerName
                                    </span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(insp.ContactNumber))
                            {
                                <div class="vt-meta-field">
                                    <span class="vt-meta-label">Contact</span>
                                    <span class="vt-meta-value">
                                        <i class="fa-solid fa-phone"></i>
                                        <a href="tel:@insp.ContactNumber"
                                               style="color:inherit;text-decoration:none;">
                                            @insp.ContactNumber
                                        </a>
                                    </span>
                                </div>
                            }
                            @if (!string.IsNullOrWhiteSpace(insp.Notes))
                            {
                                <div class="vt-meta-field" style="grid-column:1/-1;">
                                    <span class="vt-meta-label">Notes</span>
                                    <span class="vt-meta-value" style="font-weight:500;color:#555;">
                                        @insp.Notes
                                    </span>
                                </div>
                            }
                        </div>

                        <div class="vt-card-actions">
                            @if (!string.IsNullOrWhiteSpace(insp.MapUrl))
                            {
                                <a href="@insp.MapUrl" target="_blank"
                                       class="vt-btn vt-btn-outline">
                                    <i class="fa-solid fa-map-location-dot"></i> Map
                                </a>
                            }
                            <a asp-controller="ValuerInspectionEvidence"
                                   asp-action="Upload"
                                   asp-route-inspectionId="@insp.InspectionId"
                                   asp-route-sapNumber="@Model.SapNumber"
                                   class="vt-btn vt-btn-gold">
                                <i class="fa-solid fa-camera"></i> Upload Evidence
                            </a>
                        </div>

                    </div>
                }
            }

            @* Completed *@
            var completed = Model.Inspections.Where(i => i.EvidenceUploaded).ToList();
            @if (completed.Any())
            {
                <div class="vt-section-label">Completed — @completed.Count done</div>

                @for (int i = 0; i < completed.Count; i++)
                {
                    var insp = completed[i];
                    <div class="vt-card done">

                        <div class="vt-card-head">
                            <div class="vt-card-num done-num">
                                <i class="fa-solid fa-check"></i>
                            </div>
                            <div class="vt-card-addr">
                                <div class="vt-card-prop">@insp.PropertyAddress</div>
                                <div class="vt-card-desc">@insp.PropertyDescription</div>
                            </div>
                            <span class="vt-status-pill vt-pill-done">
                                <i class="fa-solid fa-circle-check"></i> Done
                            </span>
                        </div>

                        <div class="vt-card-meta">
                            <div class="vt-meta-field">
                                <span class="vt-meta-label">Inspection Time</span>
                                <span class="vt-meta-value">
                                    <i class="fa-solid fa-clock"></i>
                                    @insp.ScheduledTime.ToString("HH:mm")
                                </span>
                            </div>
                            <div class="vt-meta-field">
                                <span class="vt-meta-label">Property Ref</span>
                                <span class="vt-meta-value">
                                    <i class="fa-solid fa-hashtag"></i>
                                    @insp.PropertyRef
                                </span>
                            </div>
                        </div>

                        <div class="vt-card-actions">
                            <div class="vt-evidence-done">
                                <i class="fa-solid fa-circle-check"></i>
                                Evidence uploaded
                                @if (insp.EvidenceCount > 0)
                                {
                                    <span>(@insp.EvidenceCount photo@(insp.EvidenceCount == 1 ? "" : "s"))</span>
                                }
                            </div>
                        </div>

                    </div>
                }
            }
        }

    </div>

    @* ── Sticky bottom bar ──────────────────────────── *@
    <div class="vt-sticky-bar">
        <div class="vt-sticky-info">
            <span class="vt-sticky-name">@Model.ValuerName</span>
            <span class="vt-sticky-date">@done / @total inspections complete</span>
        </div>
        <a asp-controller="ValuerInspectionEvidence"
               asp-action="Verify"
               class="vt-sticky-btn">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
    </div>

</div>
