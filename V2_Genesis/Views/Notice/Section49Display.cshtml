@using V2_Genesis.Services.PropertySearch
@model List<V2_Genesis.Models.Results.PropertyDetailResult>
@{
    ViewData["Title"] = "Section 49 Notice";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    var roll = ViewBag.Roll as V2_Genesis.Models.GvList;
    var rollSource = ViewData["RollSource"]?.ToString();
    var unitKey = ViewData["UnitKey"]?.ToString();
    var valuationKey = ViewData["ValuationKey"]?.ToString();
    var main = Model?.FirstOrDefault();
}
@{
    var dates = ViewBag.Dates as RollDateEntry;
    var periodText = dates is not null
        ? $"{dates.OpenDate:dd MMMM yyyy} – {dates.VisibleUntil:dd MMMM yyyy} until 15:00"
        : "the inspection period";
    var closingDate = dates is not null
        ? dates.VisibleUntil.ToString("dd MMMM yyyy")
        : "16 February 2026";
    var extendedText = dates?.ExtendedPeriodText;
}
@section Styles {
    <link href="~/css/views/section49.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
}

<div class="s49-page">
    <div class="s49-inner">

        <!-- ── Top bar ─────────────────────────────────────────────── -->
        <div class="s49-topbar">
            <a href="javascript:history.back()" class="s49-back">
                <i class="fa-solid fa-arrow-left"></i> Back to Property
            </a>
            <a href="/notice/section49/download?rollSource=@rollSource&unitKey=@unitKey&valuationKey=@valuationKey"
                   class="s49-download-btn">
                <i class="fa-solid fa-download"></i> Download PDF
            </a>
        </div>

        <!-- ── Notice container ────────────────────────────────────── -->
        <div class="s49-notice">

            <!-- Header -->
            <div class="s49-header">
                <img src="~/Images/Obj_Header.PNG" alt="City of Johannesburg" class="s49-logo" />
            </div>

            <!-- Title -->
            <div class="s49-title-block">
                <h1>CITY OF JOHANNESBURG</h1>
                <h2>
                    PUBLIC NOTICE CALLING FOR INSPECTION OF THE
                    @(roll?.Name?.ToUpper() ?? "VALUATION ROLL")
                    AND LODGING OF OBJECTIONS
                </h2>
            </div>

            <hr class="s49-divider" />

            <!-- Notice text -->
            <div class="s49-body">
                <!-- REPLACE the first notice paragraph -->
                <p>
                    Notice is hereby given in terms of Section 49(1)(a)(i) read together with section 78(2) of the
                    <strong>Local Government: Municipal Property Rates Act No. 6 of 2004</strong>
                    as amended, that the valuation roll is open for public inspection from
                    <strong>@periodText</strong>.
                    @if (!string.IsNullOrEmpty(extendedText))
                    {
                        <strong>@extendedText</strong>
                    }
                    In addition, the valuation roll is available on the City's website
                    <a href="http://www.joburg.org.za" target="_blank">www.joburg.org.za</a>,
                    under the GVR Online tile on the home page.
                </p>
                <p>
                    An invitation is hereby made in terms of section 49(1)(a)(ii) of the Act to any owner of property
                    or other person who so desires to lodge an objection with the Municipal Manager in respect of any
                    matter reflected in, or omitted from, the valuation roll within the above mentioned inspection period.
                </p>
                <p>
                    Attention is specifically drawn to the fact that in terms of section 50(2) of the Act an objection
                    must be in relation to a <strong>specific individual property</strong> and not against the valuation
                    roll as such. Kindly bring along this Section 49 notice when lodging your objection.
                </p>
                <p>
                    The acknowledgement letter will be generated by the online system and should be kept as proof that
                    the objection was submitted.
                </p>
            </div>

            <hr class="s49-divider" />

            <!-- Property details -->
            @if (main is not null)
            {
                <div class="s49-property-box">
                    <div class="s49-property-header">
                        <i class="fa-solid fa-building"></i>
                        PROPERTY DETAILS AS LISTED IN @(roll?.Name?.ToUpper() ?? "VALUATION ROLL")
                    </div>
                    <div class="s49-property-info">
                        <div class="s49-info-item">
                            <span class="s49-info-label">Property Description</span>
                            <span class="s49-info-value">@(main.PropertyDesc ?? "–")</span>
                        </div>
                        <div class="s49-info-item">
                            <span class="s49-info-label">Physical Address</span>
                            <span class="s49-info-value">@(main.LisStreetAddress ?? "–")</span>
                        </div>
                    </div>
                </div>

                <!-- Valuation table -->
                <div class="s49-table-wrap">
                    <table class="s49-table">
                        <thead>
                            <tr>
                                <th><i class="fa-solid fa-money-bill-wave"></i> Market Value</th>
                                <th><i class="fa-solid fa-ruler-combined"></i> Extent</th>
                                <th><i class="fa-solid fa-tag"></i> Property Category</th>
                                <th><i class="fa-solid fa-comment"></i> Remarks</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model!)
                            {
                                <tr>
                                    <td class="s49-mv">@(item.MarketValue ?? "–")</td>
                                    <td>@(item.RateableArea ?? "–")</td>
                                    <td>@(item.CatDesc ?? "–")</td>
                                    <td>@(item.Reason ?? "–")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <!-- Closing date banner -->
            <div class="s49-closing-date">
                <i class="fa-solid fa-calendar-xmark"></i>
                CLOSING DATE FOR OBJECTIONS IS 15:00 ON
                @(ViewBag.VisibleUntil is DateTime d ? d.ToString("dd MMMM yyyy") : "16 February 2026")
            </div>

            <!-- Two-column requirements -->
            <div class="s49-requirements">
                <div class="s49-req-col s49-req-res">
                    <h4><i class="fa-solid fa-house"></i> Residential Properties</h4>
                    <ul>
                        <li>Market evidence (sold properties in immediate area)</li>
                        <li>Number of bedrooms and bathrooms</li>
                        <li>Improvements (swimming pool, etc.)</li>
                        <li>Age of improvements</li>
                        <li>Any adverse conditions affecting value</li>
                        <li>Building sizes and types (garage, granny flat)</li>
                        <li>Any other additional information</li>
                    </ul>
                    <p><strong>OR</strong> Motivated valuation report from registered Valuer</p>
                </div>
                <div class="s49-req-col s49-req-bus">
                    <h4><i class="fa-solid fa-briefcase"></i> Business Properties</h4>
                    <ul>
                        <li>Rent Roll (if there are tenants)</li>
                        <li>Size of building (if no tenants)</li>
                        <li>Actual use of building</li>
                        <li>Income / Expenditure</li>
                        <li>Number of parking bays</li>
                        <li>Condition of building (attach photos)</li>
                        <li>Any other additional information</li>
                    </ul>
                    <p><strong>OR</strong> Motivated valuation report from registered Valuer</p>
                </div>
            </div>

            <!-- Representatives warning -->
            <div class="s49-rep-warning">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>
                    <strong>REPRESENTATIVES:</strong>
                    Letter of authorisation MUST be signed by the registered owner and attached to the objection form.
                </div>
            </div>

            <!-- Contact -->
            <div class="s49-contact">
                <h4><i class="fa-solid fa-user-tie"></i> MUNICIPAL MANAGER</h4>
                <p>For further enquiries please contact:</p>
                <p>
                    <i class="fa-solid fa-phone"></i> Tel. 011 407-6622 or 011 407-6597 &nbsp;|&nbsp;
                    <i class="fa-solid fa-envelope"></i>
                    <a href="mailto:valuationenquiries@joburg.org.za">valuationenquiries@joburg.org.za</a>
                </p>
            </div>

        </div>

        <!-- ── Action buttons ───────────────────────────────────────── -->
        <div class="s49-actions">
            <a href="javascript:history.back()" class="s49-btn s49-btn-outline">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
            <a href="/notice/section49/download?rollSource=@rollSource&unitKey=@unitKey&valuationKey=@valuationKey"
                   class="s49-btn s49-btn-primary">
                <i class="fa-solid fa-file-pdf"></i> Download PDF
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <script>
        // Format market values
        document.querySelectorAll('.s49-mv').forEach(function(el) {
            var raw = parseFloat(el.textContent.replace(/[^0-9.-]+/g, ''));
            if (!isNaN(raw) && raw > 0) {
                el.textContent = raw.toLocaleString('en-ZA', {
                    style: 'currency', currency: 'ZAR',
                    minimumFractionDigits: 0, maximumFractionDigits: 0
                });
            }
        });

        // Preloader
        window.addEventListener('load', function() {
            setTimeout(function() {
                var p = document.getElementById('preloader');
                if (p) p.style.display = 'none';
            }, 800);
        });
    </script>
}