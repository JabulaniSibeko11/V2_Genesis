@model V2_Genesis.Models.Notice.Section49ViewModel
@{
    // Same layout and wording as the Section 49 PDF
    // (NoticeService.GenerateSection49Pdf): page 1 = notice, page 2 = NB guidance.
    // No signature on screen — the signed notice is the PDF only.
    ViewData["Title"] = "Section 49 Notice";
    Layout = "~/Views/Shared/_Legend_Layout.cshtml";

    var m = Model;
    var titleUpper = m.RollTitle.ToUpperInvariant();
    var downloadUrl = $"/notice/section49/download?rollSource={Uri.EscapeDataString(m.RollSource)}&unitKey={Uri.EscapeDataString(m.UnitKey)}&valuationKey={Uri.EscapeDataString(m.ValuationKey)}";
    var openText = m.OpenDate.HasValue ? m.OpenDate.Value.ToString("dd MMMM yyyy") : "";
    var closeText = m.ClosingDate.HasValue ? m.ClosingDate.Value.ToString("dd MMMM yyyy") : "";
    var noticeError = TempData["NoticeError"] as string;
}

@section Styles {
    <link href="~/css/Views/section49.css" rel="stylesheet" asp-append-version="true" />
}

<div class="s49">

    <!-- ── Toolbar ───────────────────────────────────────────────── -->
    <div class="s49-toolbar">
        <div class="s49-toolbar-inner">
            <a href="javascript:history.back()" class="s49-tb-btn">
                <i class="fa-solid fa-arrow-left"></i> Back to property
            </a>
            <div class="s49-tb-title">
                <i class="fa-solid fa-file-lines"></i>
                <span>Section 49 Notice</span>
                <small>@m.PropertyDescription</small>
            </div>
            <a href="@downloadUrl" class="s49-tb-btn s49-tb-primary">
                <i class="fa-solid fa-file-pdf"></i> Download PDF
            </a>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(noticeError))
    {
        <div class="s49-alert"><i class="fa-solid fa-circle-exclamation"></i> @noticeError</div>
    }

    <!-- ══════════════ PAGE 1 — NOTICE ══════════════ -->
    <article class="s49-sheet">
        <img src="~/Images/Obj_Header.PNG" alt="City of Johannesburg" class="s49-header-img" />

        <div class="s49-address-row">
            <div class="s49-postal">
                @foreach (var line in m.PostalLines)
                {
                    <div>@line</div>
                }
            </div>
            <div class="s49-letter-date">@m.LetterDate</div>
        </div>

        <h1 class="s49-h1">CITY OF JOHANNESBURG</h1>
        <h2 class="s49-h2">PUBLIC NOTICE CALLING FOR INSPECTION OF THE @titleUpper AND LODGING OF OBJECTIONS</h2>
        <hr class="s49-rule" />

        <p class="s49-greeting">Dear Property Owner</p>

        <p>
            Notice is hereby given in terms of Section 49(1)(a)(i) read together with section 78(2) of the
            <strong>Local Government: Municipal Property Rates Act No. 6 of 2004</strong>
            as amended hereinafter referred to as the "Act", that the @m.RollTitle for the financial years
            <strong>@m.FinancialYears</strong> is open for public inspection on the website
            <strong>@m.PortalUrl</strong> and at the address listed below from
            <strong>@openText - @closeText until 15:00 pm</strong>.
            @if (!string.IsNullOrWhiteSpace(m.ExtendedPeriodText))
            {
                <strong>@m.ExtendedPeriodText</strong>
            }
        </p>

        <p class="s49-justify">
            An invitation is hereby made in terms of section 49(1)(a)(ii) read together with section 78(2) of the Act
            to any owner of property or other person who so desires that may wish to lodge an objection with the
            Municipal Manager in respect of any matter reflected in, or omitted from, the @m.RollTitle. The objection
            must be submitted within the above mentioned inspection period.
        </p>

        <p>
            Attention is specifically drawn to the fact that in terms of section 50(2) of the Act an objection must be
            in relation to a <strong>specific individual property</strong> and not against the @m.RollTitle as such.
            The lodging of objections in terms of Chapter 4(d) of the Regulations to the Act can be done at the address
            below or preferably online at <strong>@m.PortalUrl</strong>.
        </p>

        <p>
            The completed forms could be returned to the following address or preferably submitted online on the
            online objection system.
        </p>

        <div class="s49-office">
            <strong>Valuation Services: Administration -</strong>
            1st Floor, East Wing, 66 Jorissen Street, Braamfontein, Johannesburg, South Africa
        </div>

        <p>
            The acknowledgement letter will be generated by the online system and should be kept as proof that the
            objection was submitted.
        </p>

        <hr class="s49-rule" />

        <h3 class="s49-h3">PROPERTY DETAILS AS LISTED IN @titleUpper</h3>

        <div class="s49-details">
            <div><strong>Property Description:</strong> @m.PropertyDescription</div>
            <div><strong>Physical Address:</strong> @m.PhysicalAddress</div>
        </div>

        <div class="s49-table-wrap">
            <table class="s49-table">
                <thead>
                    <tr>
                        <th>Property Category</th>
                        <th class="s49-num">Area/m²</th>
                        <th class="s49-num">Market Value</th>
                        <th class="s49-center">With Effective Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in m.Rows)
                    {
                        <tr>
                            <td data-label="Property Category">@row.Category</td>
                            <td class="s49-num" data-label="Area/m²">@row.Area</td>
                            <td class="s49-num" data-label="Market Value">@row.MarketValue</td>
                            <td class="s49-center" data-label="With Effective Date">@row.EffectiveDate</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (m.ClosingDate.HasValue)
        {
            <p class="s49-closing">CLOSING DATE FOR OBJECTIONS IS 15:00 PM ON @closeText.ToUpperInvariant()</p>
        }

        <footer class="s49-footer">
            <div class="s49-footer-line"></div>
            <div>This is an official document generated by the City of Johannesburg Valuation Services Department</div>
            <div>Generated on: @DateTime.Now.ToString("dd MMMM yyyy")</div>
            @if (!string.IsNullOrWhiteSpace(m.ValuationKey))
            {
                <div class="s49-key">@m.ValuationKey</div>
            }
        </footer>
    </article>

    <!-- ══════════════ PAGE 2 — NB GUIDANCE ══════════════ -->
    <article class="s49-sheet s49-sheet-short">
        <table class="s49-nb">
            <tr>
                <th colspan="2">NB.</th>
            </tr>
            <tr>
                <td>
                    <p>Residential properties information that will assist the Municipal Valuer to reach a reasonable decision is as follows:</p>
                    <ul>
                        <li>Market evidence (list of sold properties within the immediate area as at the valuation date 1 July 2022)</li>
                        <li>Details of the property:</li>
                        <li>Number of bedrooms and bathrooms</li>
                        <li>Improvements</li>
                        <li>Swimming pool, etc.</li>
                        <li>The age of the improvements</li>
                        <li>Any adverse conditions that might affect the value</li>
                        <li>Building sizes</li>
                        <li>Building types (garage, granny flat) etc</li>
                        <li>Any other additional information</li>
                    </ul>
                    <p class="s49-or">OR</p>
                    <ul>
                        <li>Motivated valuation report from registered Valuer</li>
                    </ul>
                </td>
                <td>
                    <p>Business properties information that will assist the Appeal Board to reach a reasonable decision is as follows:</p>
                    <ul>
                        <li>Rent Roll (if there are tenants)</li>
                        <li>Size of building (if there are no tenants in the building)</li>
                        <li>Actual use of building</li>
                        <li>Income / Expenditure</li>
                        <li>Number of parking bays</li>
                        <li>Condition of the building (attach photos)</li>
                        <li>Any other additional information</li>
                    </ul>
                    <p class="s49-or">OR</p>
                    <ul>
                        <li>Motivated valuation report from registered Valuer</li>
                    </ul>
                </td>
            </tr>
            <tr>
                <th colspan="2">REPRESENTATIVES:</th>
            </tr>
            <tr>
                <td colspan="2" class="s49-rep">
                    Letter of authorisation MUST be signed by the registered owner and attached to the objection form.
                </td>
            </tr>
        </table>

        <p class="s49-enq"><strong>For further enquiries please contact:</strong></p>
        <ul class="s49-enq-list">
            <li><a href="mailto:valuationenquiries@joburg.org.za">valuationenquiries@joburg.org.za</a></li>
        </ul>

        <footer class="s49-footer">
            <div class="s49-footer-line"></div>
            <div>This is an official document generated by the City of Johannesburg Valuation Services Department</div>
            <div>Generated on: @DateTime.Now.ToString("dd MMMM yyyy")</div>
            @if (!string.IsNullOrWhiteSpace(m.ValuationKey))
            {
                <div class="s49-key">@m.ValuationKey</div>
            }
        </footer>
    </article>

    <div class="s49-bottom-actions">
        <a href="javascript:history.back()" class="s49-tb-btn">
            <i class="fa-solid fa-arrow-left"></i> Back
        </a>
        <a href="@downloadUrl" class="s49-tb-btn s49-tb-primary">
            <i class="fa-solid fa-file-pdf"></i> Download PDF
        </a>
    </div>
</div>
