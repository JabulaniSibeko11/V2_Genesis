@model V2_Genesis.Models.ViewModels.Dashboard.AppointmentValuerDetailsVm

@{
    ViewData["Title"] = "Valuer Details";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    var watermarkText =
        $"CONFIDENTIAL • {Model.AttrNo} • {Model.ValuerName} • {DateTime.Now:yyyy-MM-dd HH:mm}";
}
<link href="~/css/views/valuer-details.css" rel="stylesheet" asp-append-version="true"/>

@* ── Watermark (unchanged) ────────────────────────── *@
<div class="secure-watermark"
     style="background-image:url('data:image/svg+xml;utf8,<svg xmlns=&quot;http://www.w3.org/2000/svg&quot; width=&quot;460&quot; height=&quot;220&quot;><text x=&quot;20&quot; y=&quot;110&quot; transform=&quot;rotate(-25 230 110)&quot; font-size=&quot;20&quot; font-family=&quot;Arial&quot; font-weight=&quot;700&quot; fill=&quot;%23000000&quot;>@Uri.EscapeDataString(watermarkText)</text></svg>');">
</div>

@* ── Timeout overlay (unchanged behaviour, redesigned) ── *@
<div class="secure-timeout-overlay" id="secureTimeoutOverlay">
    <div class="secure-timeout-box">
        <div class="secure-timeout-icon">
            <i class="fa-solid fa-lock"></i>
        </div>
        <h2>Valuer details hidden</h2>
        <p>
            For security, valuer details are only displayed for a short time.
            Please contact Valuation Services if you need assistance.
        </p>
        <a href="/dashboard?openRoll=attributes" class="vv-back-btn" style="align-self:center;">
            <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
        </a>
    </div>
</div>

<div class="vv-page secure-page" id="secureValuerDetails">

    @* ── Hero ─────────────────────────────────────── *@
    <div class="vv-hero">
        <div class="vv-hero-inner">
            <div class="vv-hero-icon">
                <i class="fa-solid fa-shield-halved"></i>
            </div>
            <div>
                <div class="vv-hero-eyebrow">City of Johannesburg · Valuation Services</div>
                <h1 class="vv-hero-title">Verified Valuer Details</h1>
                <p class="vv-hero-sub">
                    Only allow the inspection to continue if the person and vehicle match the details below.
                </p>
            </div>
        </div>
    </div>

    <div class="vv-body">

        @* ── Security notice ─────────────────────────── *@
        <div class="vv-notice">
            <i class="fa-solid fa-circle-info"></i>
            <div>
                <strong>Security notice:</strong>
                These valuer details are shown for safety verification only.
                Do not share, save, distribute, or screenshot this information.
            </div>
        </div>

        @* ── Appointment card ────────────────────────── *@
        <div class="vv-card">
            <div class="vv-card-bar">
                <i class="fa-solid fa-calendar-check"></i>
                <h3>Appointment</h3>
            </div>
            <div class="vv-card-body">
                <div class="vv-field-grid">
                    <div class="vv-field">
                        <span class="vv-field-label">Reference</span>
                        <div class="vv-field-value">@Model.AttrNo</div>
                    </div>
                    <div class="vv-field full">
                        <span class="vv-field-label">Property</span>
                        <div class="vv-field-value">@Model.PropertyDescription</div>
                    </div>
                    <div class="vv-field">
                        <span class="vv-field-label">Confirmed Date</span>
                        <div class="vv-field-value">@Model.ConfirmedDateTime?.ToString("dd MMM yyyy HH:mm")</div>
                    </div>
                </div>
            </div>
        </div>

        @* ── Valuer identity card ────────────────────── *@
        <div class="vv-card">
            <div class="vv-card-bar">
                <i class="fa-solid fa-user-shield"></i>
                <h3>Valuer Identity</h3>
            </div>
            <div class="vv-card-body">
                <div class="vv-identity">

                    <div class="vv-photo-col">
                        @if (Model.HasPhoto)
                        {
                            <img src="@Url.Action("ValuerPhoto", "Dashboard", new { inspectionRequestId = Model.InspectionRequestId })"
                                 alt="Valuer photo"
                                 class="vv-photo"
                                 onerror="this.style.display='none'; document.getElementById('noValuerPhoto').style.display='flex';" />

                            <div id="noValuerPhoto" class="vv-photo-placeholder" style="display:none;">
                                <i class="fa-solid fa-image-slash"></i>
                                <span>Photo Not Found</span>
                            </div>
                        }
                        else
                        {
                            <div class="vv-photo-placeholder">
                                <i class="fa-solid fa-user"></i>
                                <span>No Photo</span>
                            </div>
                        }
                    </div>

                    <div class="vv-identity-fields">
                        <div class="vv-identity-field">
                            <span class="vv-identity-label">Valuer Name</span>
                            <div class="vv-identity-value">@Model.ValuerName</div>
                        </div>
                        <div class="vv-identity-field">
                            <span class="vv-identity-label">Email</span>
                            <div class="vv-identity-value">@Model.EmailAddress</div>
                        </div>
                        <div class="vv-identity-field">
                            <span class="vv-identity-label">Cell Number</span>
                            <div class="vv-identity-value">@Model.CellNumber</div>
                        </div>
                        <div class="vv-identity-field">
                            <span class="vv-identity-label">Vehicle Registration</span>
                            <div class="vv-identity-value accent">@Model.VehicleRegistration</div>
                        </div>
                        <div class="vv-identity-field">
                            <span class="vv-identity-label">Vehicle Make</span>
                            <div class="vv-identity-value">@Model.VehicleMake</div>
                        </div>
                        <div class="vv-identity-field">
                            <span class="vv-identity-label">Vehicle Colour</span>
                            <div class="vv-identity-value">@Model.VehicleColour</div>
                        </div>
                    </div>

                </div>
            </div>
        </div>

        @* ── Safety check alert ───────────────────────── *@
        <div class="vv-safety">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <div>
                <strong>Safety check:</strong>
                Do not allow the inspection to proceed if the person, vehicle registration, or photo does not match.
            </div>
        </div>

        @* ── Back button ──────────────────────────────── *@
        <a href="/dashboard?openRoll=attributes" class="vv-back-btn">
            <i class="fa-solid fa-arrow-left"></i> Back to Dashboard
        </a>

    </div>
</div>

<script>
    function hideSecureDetails() {
        const details = document.getElementById("secureValuerDetails");
        const overlay = document.getElementById("secureTimeoutOverlay");

        if (details) {
            details.classList.add("secure-hidden");
        }

        if (overlay) {
            overlay.style.display = "flex";
        }
    }

    // Hide details after 2 minutes.
    setTimeout(hideSecureDetails, 120000);

    // Hide details when user switches tab or minimises browser.
    document.addEventListener("visibilitychange", function () {
        if (document.hidden) {
            hideSecureDetails();
        }
    });

    // Hide details when browser loses focus.
    window.addEventListener("blur", function () {
        hideSecureDetails();
    });

    // Reduce right-click copying.
    document.addEventListener("contextmenu", function (e) {
        e.preventDefault();
    });
</script>
