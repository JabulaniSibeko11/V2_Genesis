@using System.Security.Claims
@using System.Net
@using V2_Genesis.Helpers
@using V2_Genesis.Services.Interfaces
@using V2_Genesis.Services.Implementations
@using V2_Genesis.Services.PropertySearch
@inject INotificationService NotificationService
@model V2_Genesis.Models.ViewModels.Dashboard.ClientDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    var ann = Model.Announcement;

    var dashboardUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var dashboardUserEmail =
        User.FindFirstValue(ClaimTypes.Email)
        ?? User.FindFirstValue(ClaimTypes.Name)
        ?? User.Identity?.Name
        ?? "";

    var isDashboardAdmin =
        User.IsInRole("Admin")
        || dashboardUserEmail.Equals("AdministrationEnquiries@Joburg.org.za", StringComparison.OrdinalIgnoreCase)
        || System.Text.RegularExpressions.Regex.IsMatch(
            dashboardUserEmail,
            @"^val\.admin(1[0-9]?|[1-9])@joburg\.org\.za$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    var unreadNotificationCount = await NotificationService.GetUnreadCountAsync(
        dashboardUserId,
        dashboardUserEmail,
        isDashboardAdmin);

    var latestNotifications = await NotificationService.GetLatestAsync(
        dashboardUserId,
        dashboardUserEmail,
        isDashboardAdmin,
        10);
}
@functions {

    string FormatZAR(string? val)
    {
        if (string.IsNullOrWhiteSpace(val))
            return "–";

        // Remove currency symbols and spaces only
        var clean = val.Replace("R", "")
                       .Replace(",", "")
                       .Trim();

        if (!decimal.TryParse(clean,
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out var num) || num <= 0)
        {
            return "–";
        }

        return "R " + num.ToString("N0",
            new System.Globalization.CultureInfo("en-ZA"));


      
    }

   RollDateEntry? GetDates(string rollSource)
    {
        Model.RollDates.TryGetValue(rollSource, out var d);
        return d;
    }

    string PeriodStatus(RollDateEntry? d)
    {
        if (d is null) return "unknown";
        var now = DateTime.Now;
        if (now < d.OpenDate) return "upcoming";
        if (now <= d.VisibleUntil) return "active";
        return "closed";
    }

    string GetAttrStatusPill(string? status) => status switch
    {
        "Pending" => "<span class='cd-pill cd-pill-pending'>Pending</span>",
        "Under Review" => "<span class='cd-pill cd-pill-inprogress'>Under Review</span>",
        "Approved" => "<span class='cd-pill cd-pill-completed'>Approved</span>",
        "Rejected" => "<span class='cd-pill cd-pill-lodging'>Rejected</span>",
        _ => $"<span class='cd-pill cd-pill-pending'>{status}</span>"
    };

    string GetApptStatusPill(string? status) => status switch
    {
        "Scheduled" => "<span class='cd-pill cd-pill-inprogress'>Scheduled</span>",
        "Completed" => "<span class='cd-pill cd-pill-completed'>Completed</span>",
        "Cancelled" => "<span class='cd-pill cd-pill-lodging'>Cancelled</span>",
        _ => $"<span class='cd-pill cd-pill-pending'>{status}</span>"
    };

    string GetRebateStatusPill(string? status) => status switch
    {
        "Acknowledge" => "<span class='cd-pill cd-pill-lodging'>Acknowledged</span>",
        "Auto Reject" => "<span class='cd-pill cd-pill-rejected'>Auto Rejected</span>",
        "Under Review" => "<span class='cd-pill cd-pill-inprogress'>Under Review</span>",
        "Approved" => "<span class='cd-pill cd-pill-completed'>Approved</span>",
        "Rejected" => "<span class='cd-pill cd-pill-rejected'>Rejected</span>",
        _ => $"<span class='cd-pill cd-pill-pending'>{status ?? "Pending"}</span>"
    };
}



@section Styles {
   
