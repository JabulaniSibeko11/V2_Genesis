            <!-- Roll header (click to collapse the whole roll) -->
            <div class="cd-roll-header @(roll.IsQuery ? "cd-roll-query" : "") @(roll.HasObjection == false && !roll.IsQuery ? "cd-roll-inactive" : "")"
                 onclick="toggleRoll('@rollKey')">
                <div class="cd-roll-header-left">
                    <div class="cd-roll-icon">
                        @if (roll.IsQuery)
                        {
                            <i class="fa-solid fa-magnifying-glass-chart"></i>
                        }
                        else if (roll.IsGv)
                        {

                            <i class="fa-solid fa-landmark"></i>
                        }
                        else
                        {

                            <i class="fa-solid fa-scroll"></i>
                        }
                    </div>
                    <div>
                        <h2 class="cd-roll-name">@roll.Name</h2>
                        <span class="cd-roll-short">@roll.Short &nbsp;·&nbsp; @roll.Main_Roll</span>
                    </div>
                </div>
                <div class="cd-roll-header-right">
                    @if (!roll.IsQuery)
                    {
                        @* Change this line in the roll header (was: /@roll.ControllerName/PropertyIndex) *@
                        <a href="/search/@roll.Source"
                               class="cd-roll-search-btn"
                               onclick="event.stopPropagation()">
                            <i class="fa-solid fa-magnifying-glass"></i> Search Property
                        </a>
                    }
                    @{
                        var dates = GetDates(roll.Source);   // ← was Model.DatesFor(roll.Source)
                        var status = PeriodStatus(dates);
                    }
                    @if (!roll.IsQuery && dates is not null)
                    {
                        <div class="cd-period-wrap">
                            <span class="cd-period-dates">
                                <i class="fa-solid fa-calendar-range"></i>
                                @dates.OpenDate.ToString("dd MMM yyyy")
                                –
                                @dates.VisibleUntil.ToString("dd MMM yyyy")
                            </span>
                            <span class="cd-roll-badge cd-badge-@status">
                                @(status == "active"   ? "Objection Open"   :
                                  status == "upcoming" ? "Opening Soon"      :
                                                         "Period Closed")
                            </span>
                        </div>
                    }
else if (roll.IsQuery)
{
                        <a href="/search/@roll.Source"
                               class="cd-roll-search-btn"
                               onclick="event.stopPropagation()">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            @(roll.IsQuery ? "Search Property" : "Search Property")
                        </a>
    <span class="cd-roll-badge cd-badge-open">OPEN</span>
}
                    <i class="fa-solid fa-chevron-down cd-roll-chevron" id="chevron-@rollKey"></i>
                </div>
            </div>

            <!-- Roll body (collapsible) -->
            <div class="cd-roll-body @(isActive ? "open" : "")" id="rollbody-@rollKey">

                @if (roll.IsQuery)
                {
                    <!-- ── 1. Linked Properties ─────────────────────────────── -->
                    <div class="cd-widget">
                        <div class="cd-widget-toggle"
                             onclick="toggleWidget('@rollKey-linked')">
                            <div class="cd-widget-toggle-left">
                                <i class="fa-solid fa-link"></i>
                                <h3>Linked Properties</h3>
                                <span class="cd-count-badge">@rd.LinkedCount</span>
                            </div>
                            <i class="fa-solid fa-chevron-down cd-widget-chevron"
                               id="wchev-@rollKey-linked"></i>
                        </div>
                        <div class="cd-widget-body" id="widget-@rollKey-linked">
                            <div class="cd-widget-toolbar">
                                <a href="/search/@roll.Source" class="cd-add-btn">
                                    <i class="fa-solid fa-plus"></i> Link New Property
                                </a>
                            </div>
                            <div class="table-responsive">
                                <table class="cd-table table table-bordered"
                                       id="tbl-@rollKey-linked">
                                    <thead>
                                        <tr>
                                            <th>Property Description</th>
                                            <th>Category</th>
                                            <th>Town</th>
                                            <th>Market Value</th>
                                            <th>WEF Date</th>
                                            <th>Options</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var item in rd.LinkedProperties)
                                        {
                                            <tr>
                                                <td>@item.PropertyDesc</td>
                                                <td>@item.CatDesc</td>
                                                <td>@item.TownNameDesc</td>
                                                <td>@FormatZAR(item.MarketValue)</td>
                                                <td>@item.WefDate</td>
                                                <td>
