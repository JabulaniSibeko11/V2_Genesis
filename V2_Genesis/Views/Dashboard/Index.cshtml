@functions {
    string Enc(string? value)
    {
        return WebUtility.HtmlEncode(value ?? "");
    }

    string GetStatusDisplayText(string? status) => status switch
    {
        "Obj-Unallocated" or "Obj-Section51" => "Obj-Pending",
        "Obj-Inprogress" or "Obj-Pending-Approval" or "Obj-Rejected" => "Obj-InProgress",
        "Obj-Lodging" => "Obj-Lodging",
        "Obj-PenTest" => "Invalid",

        "App-Unallocated" => "App-Unallocated",
        "App-Lodging" => "App-Lodging",
        "App-Finalized" => "App-Finalized",

        "Query-Lodging" => "Query-Lodging",
        "Query-Unallocated" => "Query-Pending",
        "Query-Inprogress" => "Query-InProgress",
        "Query-Finalized" or "Notice-Sent" => "Finalised",
        "Query-Withdrawn" => "Withdrawn",

        null or "" => "Pending",
        _ => status
    };

    string GetStatusPill(string? status)
    {
        var title = StatusExplanationHelper.GetTitle(status);
        var description = StatusExplanationHelper.GetDescription(status);
        var badgeClass = StatusExplanationHelper.GetBadgeClass(status);
        var displayText = GetStatusDisplayText(status);

        return $@"
<span class='client-status-badge cd-pill {Enc(badgeClass)}'
      title='{Enc(description)}'
      data-status-title='{Enc(title)}'
      data-status-message='{Enc(description)}'>
    {Enc(displayText)}
    <i class='fa-solid fa-circle-question status-help-icon'></i>
</span>";
    }
}

@section Scripts {
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>

    <script>
        // ============================================================
        // Dashboard JS - Combined
        // ============================================================

        // ── Family tiles + persistent tab strip ──────────────────────
        const detailCache = {};
        let familyLookup = [];
        const dashboardOpenRollKey = 'v2genesis.dashboard.openRoll';

        function rememberDashboardRoll(source) {
        if (!source) return;

        try {
        window.sessionStorage.setItem(dashboardOpenRollKey, source);
        } catch (e) {
        // The dashboard still works when browser storage is unavailable.
        }
        }

        function getRememberedDashboardRoll() {
        try {
        return window.sessionStorage.getItem(dashboardOpenRollKey);
        } catch (e) {
        return null;
        }
        }

        function clearRememberedDashboardRoll() {
        try {
        window.sessionStorage.removeItem(dashboardOpenRollKey);
        } catch (e) {
        }
        }

        try {
        familyLookup = JSON.parse(document.getElementById('cdFamilyLookupData').textContent);
        } catch (e) {
        familyLookup = [];
        }

        function openFamily(tileEl) {
        let members;
        try {
        members = JSON.parse(tileEl.dataset.members);
        } catch (e) {
        return;
        }

        const context = document.getElementById('cdFamilyContext');
        if (context && members.length) {
        context.style.display = 'flex';
        context.innerHTML =
        '<i class="fa-solid fa-landmark"></i>' +
        '<div><strong>' + members[0].name + '</strong>' +
        '<span>' + members.length + ' roll' + (members.length === 1 ? '' : 's') + ' in this family &middot; pick one below</span></div>';
        }

        renderFamilyTabs(members, tileEl.dataset.headSource);
        showDetailArea();
        selectFamilyTab(tileEl.dataset.headSource, members);
        prefetchFamilyMembers(members, tileEl.dataset.headSource);
        }

        // ── Warm the cache for every OTHER roll in this family right
        //    away, quietly, in the background (the head roll is already
        //    being fetched by selectFamilyTab above, so it's skipped
        //    here to avoid a duplicate request). By the time the client
        //    clicks a Sup tab, it's already sitting in detailCache —
        //    instant switch, no spinner, same feel as the Admin
        //    dashboard. ───────────────────────────────────────────────
        function prefetchFamilyMembers(members, skipSource) {
        members.forEach(function (m) {
        if (m.source === skipSource) return;

        const url = '/dashboard/roll-detail/' + encodeURIComponent(m.source);
        if (detailCache[url]) return;

        fetch(url)
        .then(function (res) {
        if (!res.ok) throw new Error('prefetch failed');
        return res.text();
        })
        .then(function (html) {
        detailCache[url] = html;
        })
        .catch(function () {
        // Silent — a failed prefetch just means that tab
        // falls back to the normal fetch-on-click path.
        });
        });
        }

        function renderFamilyTabs(members, activeSource) {
        const wrap = document.getElementById('cdFamilyTabs');
        if (!wrap) return;

        wrap.dataset.members = JSON.stringify(members);
        wrap.style.display = 'flex';

        wrap.innerHTML = members.map(function (m) {
        const isActive = m.source === activeSource;
        return '<button type="button" class="cd-fam-tab' + (isActive ? ' active' : '') + '" ' +
        'data-source="' + m.source + '" onclick="selectFamilyTabFromEl(this)">' +
        '<span class="cd-fam-tab-name">' + m.shortName + '</span>' +
        (isActive ? '<span class="cd-fam-tab-current"><i class="fa-solid fa-circle-check"></i> Viewing</span>' : '') +
        '</button>';
        }).join('');
        }

        function selectFamilyTabFromEl(el) {
        const wrap = document.getElementById('cdFamilyTabs');
        let members = [];
        try {
        members = JSON.parse(wrap.dataset.members || '[]');
        } catch (e) {}
        selectFamilyTab(el.dataset.source, members);
        }

        function selectFamilyTab(source, members) {
        rememberDashboardRoll(source);

        const wrap = document.getElementById('cdFamilyTabs');

        if (wrap) {
        wrap.querySelectorAll('.cd-fam-tab').forEach(function (tab) {
        const isActive = tab.dataset.source === source;
        tab.classList.toggle('active', isActive);

        const marker = tab.querySelector('.cd-fam-tab-current');
        if (isActive && !marker) {
        const span = document.createElement('span');
        span.className = 'cd-fam-tab-current';
        span.innerHTML = '<i class="fa-solid fa-circle-check"></i> Viewing';
        tab.appendChild(span);
        } else if (!isActive && marker) {
        marker.remove();
        }
        });
        }

        loadIntoDetail('/dashboard/roll-detail/' + encodeURIComponent(source));
        }

        function openStandalone(tileEl) {
        const drawerUrl = tileEl.dataset.drawerUrl || '';
        const rollDetailPrefix = '/dashboard/roll-detail/';

        if (drawerUrl.startsWith(rollDetailPrefix)) {
        rememberDashboardRoll(
        decodeURIComponent(drawerUrl.substring(rollDetailPrefix.length))
        );
        } else if (drawerUrl === '/dashboard/attributes-detail') {
        rememberDashboardRoll('attributes');
        } else if (drawerUrl === '/dashboard/rebates-detail') {
        rememberDashboardRoll('rebates');
        }

        const wrap = document.getElementById('cdFamilyTabs');
        if (wrap) {
        wrap.style.display = 'none';
        wrap.innerHTML = '';
        }

        const context = document.getElementById('cdFamilyContext');
        if (context) {
        context.style.display = 'none';
        context.innerHTML = '';
        }

        showDetailArea();
        loadIntoDetail(tileEl.dataset.drawerUrl);
        }

        function showDetailArea() {
        const tileGrid = document.getElementById('cdTileGrid');
        const detailArea = document.getElementById('cdDetailArea');
        if (!tileGrid || !detailArea) return;

        tileGrid.style.display = 'none';
        detailArea.style.display = '';
        window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function closeDetail() {
        const tileGrid = document.getElementById('cdTileGrid');
        const detailArea = document.getElementById('cdDetailArea');
        if (!tileGrid || !detailArea) return;

        detailArea.style.display = 'none';
        tileGrid.style.display = '';
        clearRememberedDashboardRoll();
        }

        function loadIntoDetail(url) {
        const body = document.getElementById('cdDetailBody');
        if (!body || !url) return;

        body.innerHTML =
        '<div class="cd-roll-loading"><i class="fa-solid fa-circle-notch fa-spin"></i> Loading…</div>';

        if (detailCache[url]) {
        body.innerHTML = detailCache[url];
        initTablesWithin(body);
        reparentFixedModals(body);
        return;
        }

        fetch(url)
        .then(function (res) {
        if (!res.ok) throw new Error('Failed to load (' + res.status + ')');
        return res.text();
        })
        .then(function (html) {
        detailCache[url] = html;
        body.innerHTML = html;
        initTablesWithin(body);
        reparentFixedModals(body);
        })
        .catch(function (err) {
        body.innerHTML =
        '<div class="cd-roll-error">' +
        '<i class="fa-solid fa-triangle-exclamation"></i> ' +
        'Could not load these details. Please try again.' +
        '</div>';
        console.error('[Dashboard] detail fetch failed:', err);
        });
        }

        function initTablesWithin(container) {
        container.querySelectorAll('.cd-table').forEach(function (t) {
        if (t.id) initDataTable('#' + t.id);
        });
        }

        // ── Move full-screen modals out of the detail area ───────────
        //    Same reasoning as before: if the detail area ever gets a
        //    CSS transform applied to it, position:fixed children would
        //    be constrained to its box instead of the full screen.
        function reparentFixedModals(container) {
        container
        .querySelectorAll('.pin-backdrop, .attr-insp-modal-backdrop')
        .forEach(function (modal) {
        document.body.appendChild(modal);
        });
        }

        // ── Widget sub-section toggle ───────────────────────────────
        function toggleWidget(key) {
        const body = document.getElementById('widget-' + key);
        const chevron = document.getElementById('wchev-' + key);

        if (!body) return;

        const isOpen = body.classList.toggle('open');

        if (chevron) {
        chevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
        }
        }

        // ── Init DataTables ─────────────────────────────────────────
        function initDataTable(selector) {
        if (!selector || !$(selector).length) return;
        if ($.fn.DataTable.isDataTable(selector)) return;

        const colCount = $(selector + ' thead th').length;

        $(selector).DataTable({
        responsive: {
        // Default breakpoints start collapsing columns below
        // 1024px, which also catches ordinary desktop/laptop
        // windows that just aren't maximised. Only a true
        // smartphone width should get the "+" expander.
        breakpoints: [
        { name: 'desktop', width: Infinity },
        { name: 'phone', width: 640 }
        ]
        },
        dom: '\u003C"cd-dt-top"lf\u003Ert\u003C"cd-dt-bottom"ip\u003E',
        lengthMenu: [[5, 10, 25, -1], [5, 10, 25, 'All']],
        // The Options/Actions column is always last and must
        // never collapse behind the "+" expander — that's the
        // whole reason someone opens the row on a phone.
        columnDefs: colCount ? [
        { targets: -1, className: 'all' },
        { targets: 0, className: 'all' }
        ] : [],
        language: {
        search: '_INPUT_',
        searchPlaceholder: 'Search...',
        lengthMenu: '_MENU_ per page'
        }
        });
        }

        // ── Open roll after redirect ────────────────────────────────
        function openLinkedRollFromQueryString() {
        const params = new URLSearchParams(window.location.search);
        const requestedRoll = params.get('openRoll');
        const openRoll = requestedRoll || getRememberedDashboardRoll();

        if (!openRoll) return;

        rememberDashboardRoll(openRoll);

        const lower = openRoll.toLowerCase();

        if (lower === 'attributes' || lower === 'rebates') {
        const tile = document.querySelector(
        '.cd-tile[data-drawer-url="/dashboard/' + lower + '-detail"]'
        );
        if (tile) openStandalone(tile);
        if (requestedRoll) {
        window.history.replaceState({}, document.title, window.location.pathname);
        }
        return;
        }

        const family = familyLookup.find(function (f) {
        return f.members.some(function (m) { return m.source === openRoll; });
        });

        if (family) {
        const tile = document.querySelector(
        '.cd-tile-family[data-head-source="' + family.headSource + '"]'
        );
        if (tile) {
        openFamily(tile);
        selectFamilyTab(openRoll, family.members);
        }
        if (requestedRoll) {
        window.history.replaceState({}, document.title, window.location.pathname);
        }
        return;
        }

        const queryTile = document.querySelector(
        '.cd-tile-query[data-drawer-url="/dashboard/roll-detail/' + openRoll + '"]'
        );
        if (queryTile) {
        openStandalone(queryTile);
        } else {
        console.warn('Roll not found for openRoll:', openRoll);
        }

        if (requestedRoll) {
        window.history.replaceState({}, document.title, window.location.pathname);
        }
        }

        // ── Inspection date response modal ──────────────────────────
        function openInspectionResponseModal(id) {
        const modal = document.getElementById('inspectionModal_' + id);

        if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        }
        }

        function closeInspectionResponseModal(id) {
        const modal = document.getElementById('inspectionModal_' + id);

        if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
        }
        }

        // ── Returned correction / resubmission modal ────────────────
        function openReturnedCorrectionModal(id) {
        const modal = document.getElementById('returnedCorrectionModal_' + id);

        if (modal) {
        modal.style.display = 'flex';
        document.body.style.overflow = 'hidden';
        }
        }

        function closeReturnedCorrectionModal(id) {
        const modal = document.getElementById('returnedCorrectionModal_' + id);

        if (modal) {
        modal.style.display = 'none';
        document.body.style.overflow = '';
        }
        }

        // ── PIN modal keypad ────────────────────────────────────────
        const pinValues = {};
        const PIN_LEN = 4;

        function openPinModal(id) {
        pinValues[id] = '';

        const modal = document.getElementById('pinModal_' + id);
        const input = document.getElementById('pinHiddenInput_' + id);
        const error = document.getElementById('pinError_' + id);
        const submit = document.getElementById('pinSubmitBtn_' + id);

        if (!modal || !input || !submit) {
        console.warn('PIN modal elements missing for appointment:', id);
        return;
        }

        input.value = '';

        if (error) {
        error.classList.remove('show');
        }

        submit.disabled = true;

        updatePinDots(id);

        modal.style.display = 'flex';
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';

        setTimeout(function () {
        input.focus();
        }, 100);
        }

        function closePinModal(id) {
        const modal = document.getElementById('pinModal_' + id);
        const input = document.getElementById('pinHiddenInput_' + id);
        const error = document.getElementById('pinError_' + id);
        const submit = document.getElementById('pinSubmitBtn_' + id);

        if (modal) {
        modal.classList.remove('open');
        modal.style.display = 'none';
        }

        pinValues[id] = '';

        if (input) {
        input.value = '';
        }

        if (error) {
        error.classList.remove('show');
        }

        if (submit) {
        submit.disabled = true;
        }

        updatePinDots(id);

        document.body.style.overflow = '';
        }

        function pinKey(id, digit) {
        let value = pinValues[id] || '';

        if (value.length >= PIN_LEN) return;

        value += digit;
        pinValues[id] = value;

        const input = document.getElementById('pinHiddenInput_' + id);
        const error = document.getElementById('pinError_' + id);
        const submit = document.getElementById('pinSubmitBtn_' + id);

        if (input) {
        input.value = value;
        }

        if (error) {
        error.classList.remove('show');
        }

        if (submit) {
        submit.disabled = value.length < PIN_LEN;
        }

        updatePinDots(id);
        }

        function pinDelete(id) {
        let value = pinValues[id] || '';

        if (value.length === 0) return;

        value = value.slice(0, -1);
        pinValues[id] = value;

        const input = document.getElementById('pinHiddenInput_' + id);
        const error = document.getElementById('pinError_' + id);
        const submit = document.getElementById('pinSubmitBtn_' + id);

        if (input) {
        input.value = value;
        }

        if (error) {
        error.classList.remove('show');
        }

        if (submit) {
        submit.disabled = value.length < PIN_LEN;
        }

        updatePinDots(id);
        }

        function updatePinDots(id) {
        const value = pinValues[id] || '';

        for (let i = 0; i < PIN_LEN; i++) {
        const dot = document.getElementById('dot_' + id + '_' + i);

        if (!dot) continue;

        dot.classList.remove('filled', 'gold', 'error');

        if (i < value.length) {
        dot.classList.add('filled');
        }

        if (value.length === PIN_LEN && i === PIN_LEN - 1) {
        dot.classList.add('gold');
        }
        }
        }

        // ── Status modal ────────────────────────────────────────────
        function initStatusExplanationModal() {
        const modal = document.getElementById("statusExplainModal");
        const title = document.getElementById("statusExplainTitle");
        const message = document.getElementById("statusExplainMessage");

        document.querySelectorAll(".client-status-badge").forEach(badge => {
        badge.addEventListener("click", function () {
        if (!modal || !title || !message) return;

        title.innerText = this.dataset.statusTitle || "Status Information";
        message.innerText = this.dataset.statusMessage || "No explanation available.";

        modal.style.display = "flex";
        document.body.style.overflow = "hidden";
        });
        });

        function closeStatusModal() {
        if (modal) {
        modal.style.display = "none";
        }

        document.body.style.overflow = "";
        }

        document.getElementById("closeStatusExplainModal")
        ?.addEventListener("click", closeStatusModal);

        document.getElementById("okayStatusExplainModal")
        ?.addEventListener("click", closeStatusModal);

        modal?.addEventListener("click", function (e) {
        if (e.target === modal) {
        closeStatusModal();
        }
        });
        }

        // ── Notification bell ───────────────────────────────────────
        function initNotificationBell() {
        const bellBtn = document.getElementById("notificationBellBtn");
        const panel = document.getElementById("notificationPanel");

        bellBtn?.addEventListener("click", function (e) {
        e.stopPropagation();
        panel?.classList.toggle("open");
        });

        panel?.addEventListener("click", function (e) {
        e.stopPropagation();
        });

        document.addEventListener("click", function () {
        panel?.classList.remove("open");
        });
        }

        // ── Global click handlers ───────────────────────────────────
        document.addEventListener('click', function (e) {
        // Close PIN modal when backdrop is clicked.
        const pinBackdrop = e.target.closest('.pin-backdrop');

        if (pinBackdrop && e.target === pinBackdrop) {
        const id = pinBackdrop.id.replace('pinModal_', '');
        closePinModal(id);
        return;
        }

        // Close normal inspection / correction modals on backdrop click.
        if (e.target.classList.contains('attr-insp-modal-backdrop')) {
        e.target.style.display = 'none';
        document.body.style.overflow = '';
        }
        });

        // ── Keyboard handlers ──────────────────────────────────────
        document.addEventListener('keydown', function (e) {
        if (e.key !== 'Escape') return;

        document.querySelectorAll('.pin-backdrop.open').forEach(function (modal) {
        const id = modal.id.replace('pinModal_', '');
        closePinModal(id);
        });

        document.querySelectorAll('.attr-insp-modal-backdrop').forEach(function (modal) {
        if (modal.style.display === 'flex') {
        modal.style.display = 'none';
        document.body.style.overflow = '';
        }
        });

        const detailArea = document.getElementById('cdDetailArea');
        if (detailArea && detailArea.style.display !== 'none') {
        closeDetail();
        }
        });

        // ── Physical keyboard / pasted PIN input ───────────────────
        document.addEventListener('input', function (e) {
        if (!e.target || !e.target.id || !e.target.id.startsWith('pinHiddenInput_')) {
        return;
        }

        const id = e.target.id.replace('pinHiddenInput_', '');
        const value = e.target.value.replace(/\D/g, '').slice(0, PIN_LEN);

        e.target.value = value;
        pinValues[id] = value;

        const error = document.getElementById('pinError_' + id);
        const submit = document.getElementById('pinSubmitBtn_' + id);

        if (error) {
        error.classList.remove('show');
        }

        if (submit) {
        submit.disabled = value.length < PIN_LEN;
        }

        updatePinDots(id);
        });

        // ── Init everything once page loads ────────────────────────
        // Tables are initialised right after each AJAX fetch completes
        // (see initTablesWithin), so nothing needs eager wiring here —
        // the tile grid has no tables in the DOM until a tile is clicked.
        $(document).ready(function () {
        openLinkedRollFromQueryString();
        initNotificationBell();
        initStatusExplanationModal();
        });

        // ── Re-open PIN modal if server returned PIN error ─────────
        // ── Re-open PIN modal if server returned PIN error ─────────
        const serverPinError = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["PinError"]?.ToString()));

        document.addEventListener('DOMContentLoaded', function () {
        if (!serverPinError) {
        return;
        }

        const firstPinModal = document.querySelector('.pin-backdrop[id^="pinModal_"]');

        if (!firstPinModal) {
        return;
        }

        const id = firstPinModal.id.replace('pinModal_', '');

        openPinModal(id);

        const error = document.getElementById('pinError_' + id);
        const errorMsg = document.getElementById('pinErrorMsg_' + id);

        if (errorMsg) {
        errorMsg.textContent = serverPinError;
        }

        if (error) {
        error.classList.add('show');
        }

        for (let i = 0; i < PIN_LEN; i++) {
        const dot = document.getElementById('dot_' + id + '_' + i);

        if (dot) {
        dot.classList.add('error');
        }
        }

        setTimeout(function () {
        for (let i = 0; i < PIN_LEN; i++) {
        const dot = document.getElementById('dot_' + id + '_' + i);

        if (dot) {
        dot.classList.remove('error');
        }
        }
        }, 600);
        });
    </script>
}

