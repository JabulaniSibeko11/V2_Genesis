                                                                           href="/section78/verify?queryNo=@item.Objection_No">
                                                                        <i class="fa-solid fa-paperclip"></i> Add Evidence
                                                                    </a>
                                                                </li>
                                                            }
                                                            @if (item.objection_Status is "Obj-Lodging" or "Obj-Unallocated")
                                                            {
                                                                <li>
                                                                    <a class="dropdown-item"
                                                                           href="/@roll.ControllerName/Withdrawal?ObjectionNum=@item.Objection_No&Withdraw=O">
                                                                        <i class="fa-solid fa-ban"></i> Withdraw
                                                                    </a>
                                                                </li>
                                                            }
                                                        </ul>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <!-- ─── 1. Linked Properties ─────────────────────────── -->
                    <div class="cd-widget">
                        <div class="cd-widget-toggle" onclick="toggleWidget('@rollKey-linked')">
                            <div class="cd-widget-toggle-left">
                                <i class="fa-solid fa-link"></i>
                                <h3>Linked Properties</h3>
                                <span class="cd-count-badge">@rd.LinkedCount</span>
                            </div>
                            <i class="fa-solid fa-chevron-down cd-widget-chevron" id="wchev-@rollKey-linked"></i>
                        </div>

                        <div class="cd-widget-body" id="widget-@rollKey-linked">
