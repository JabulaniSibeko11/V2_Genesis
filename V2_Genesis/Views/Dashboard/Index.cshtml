                            var noteType = string.IsNullOrWhiteSpace(note.NotificationType) ? "Info" : note.NotificationType;
                            <a class="cd-notification-item @(note.IsRead ? "" : "unread")"
                                   href="@(string.IsNullOrWhiteSpace(note.Url) ? "javascript:void(0)" : note.Url)">
