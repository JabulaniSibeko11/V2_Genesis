                        <i class="fa-solid fa-link"></i> @rd.LinkedCount
                    </span>
                    @if (roll.HasObjection)
                    {
                        <span title="Objections">
                            <i class="fa-solid fa-file-pen"></i> @rd.ObjectedCount
                        </span>
                    }
                    @if (roll.HasAppeal)
                    {
                        <span title="Appeals">
                            <i class="fa-solid fa-gavel"></i> @rd.AppealsCount
                        </span>
                    }
                </div>
            </div>
        }

        @foreach (var roll in Model.Rolls.Where(r => r.IsQuery))
        {
            var rd = Model.RollData.GetValueOrDefault(roll.Source) ?? new();
            <div class="cd-stat-card">
                <div class="cd-stat-label">
                    <i class="fa-solid fa-magnifying-glass-chart" style="margin-right:4px;color:var(--p-gold);"></i>
                    @roll.Short
                </div>
                <div class="cd-stat-nums">
                    <span title="Linked Properties">
                        <i class="fa-solid fa-link"></i> @rd.LinkedCount
                    </span>
                    <span title="Queries">
                        <i class="fa-solid fa-file-magnifying-glass"></i> @rd.ObjectedCount
                    </span>
                </div>
            </div>
        }

</div>
</div>
