                                    <i class="fa-solid @(noteType == "Success" ? "fa-circle-check" : noteType == "Warning" ? "fa-triangle-exclamation" : noteType == "Error" ? "fa-circle-xmark" : "fa-circle-info")"></i>
                                </div>
