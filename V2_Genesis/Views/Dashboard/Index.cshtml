                                                                    data-bs-toggle="dropdown">
                                                                Actions
                                                            </button>
                                                            <ul class="dropdown-menu">
                                                                <li><a class="dropdown-item" href="/Home/FormData@(roll.ControllerName)?propertyID=@item.Property_Type&objectionNo=@item.Objection_No&AppealStatus=False">👁️ View Form</a></li>
                                                                <li><a class="dropdown-item" href="/@roll.ControllerName/DownloadAcknowledgement?objectionNo=@item.Objection_No"> Acknowledgement</a></li>
