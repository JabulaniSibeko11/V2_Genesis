@using System.Security.Claims
@using System.Net
@using V2_Genesis.Helpers
@using V2_Genesis.Services.Interfaces
@using V2_Genesis.Services.Implementations
@using V2_Genesis.Services.PropertySearch
@inject INotificationService NotificationService
@inject IObjectionService ObjectionRules
@model V2_Genesis.Models.ViewModels.Dashboard.ClientDashboardViewModel

@{
    ViewData["Title"] = "My Dashboard";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    var ann = Model.Announcement;

    var dashboardUserId = User.FindFirstValue(ClaimTypes.NameIdentifier);
    var dashboardUserEmail =
        User.FindFirstValue(ClaimTypes.Email)
        ?? User.FindFirstValue(ClaimTypes.Name)
        ?? User.Identity?.Name
        ?? "";

    var isDashboardAdmin =
        User.IsInRole("Admin")
        || dashboardUserEmail.Equals("AdministrationEnquiries@Joburg.org.za", StringComparison.OrdinalIgnoreCase)
        || System.Text.RegularExpressions.Regex.IsMatch(
            dashboardUserEmail,
            @"^val\.admin(1[0-9]?|[1-9])@joburg\.org\.za$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    var unreadNotificationCount = await NotificationService.GetUnreadCountAsync(
        dashboardUserId,
        dashboardUserEmail,
        isDashboardAdmin);

    var latestNotifications = await NotificationService.GetLatestAsync(
        dashboardUserId,
        dashboardUserEmail,
        isDashboardAdmin,
        10);
}
