@using System.Globalization
@using V2_Genesis.Models.ViewModels.Dashboard
@model ClientDashboardViewModel

@{
    ViewData["Title"] = "Property Services Dashboard";
   // Layout = "~/Views/Shared/_ClientLayout.cshtml";
    Layout = "~/Views/Shared/_Legend_Layout.cshtml";

    var sup4 = Model.Rolls.FirstOrDefault(x =>
        string.Equals(x.Source, "Objection_Supp4", StringComparison.OrdinalIgnoreCase));

    var query = Model.Rolls.FirstOrDefault(x =>
        x.IsQuery ||
        string.Equals(x.Source, "Objection_Query", StringComparison.OrdinalIgnoreCase));

    var closedSources = new[]
    {
        "Objection",
        "Objection_Supp1",
        "Objection_Supp2",
        "Objection_Supp3"
    };

    var closedRolls = Model.Rolls
        .Where(x => closedSources.Contains(x.Source, StringComparer.OrdinalIgnoreCase))
        .OrderBy(x => Array.FindIndex(
            closedSources,
            source => source.Equals(x.Source, StringComparison.OrdinalIgnoreCase)))
        .ToList();

    RollData DataFor(string source) =>
        Model.RollData.TryGetValue(source, out var data)
            ? data
            : new RollData();

    string StatusFor(string source)
    {
        if (!Model.RollDates.TryGetValue(source, out var dates))
            return "OPEN";

        var now = DateTime.Now;

        if (now < dates.OpenDate)
            return "OPENING SOON";

        return now <= dates.VisibleUntil
            ? "OPEN"
            : "CLOSED";
    }

    string RollSubtitle(string source) => source switch
    {
        "Objection" => "General Valuation Roll 2023",
        "Objection_Supp1" => "Supplementary Roll 1",
        "Objection_Supp2" => "Supplementary Roll 2",
        "Objection_Supp3" => "Supplementary Roll 3",
        "Objection_Supp4" => "Supplementary Roll 4",
        _ => source
    };
}

<link rel="stylesheet"
      href="~/css/Views/legacy-client-dashboard.css"
      asp-append-version="true" />

<div class="legacy-dashboard">

    <div class="legacy-dashboard-announcement">
        <i class="fa-solid fa-bullhorn"></i>
        <span>@Model.Announcement.Message</span>
    </div>

    <section class="legacy-dashboard-heading">
        <span class="legacy-dashboard-kicker">CITY OF JOHANNESBURG · VALUATION SERVICES</span>
        <h1>Property Services – Supplementary Rolls and Rebates</h1>
        <span class="legacy-dashboard-heading-line"></span>
    </section>

    <div class="legacy-dashboard-grid">

        @if (sup4 is not null)
        {
            var data = DataFor(sup4.Source);
            var status = StatusFor(sup4.Source);

            <article class="legacy-service-card legacy-service-card-teal">
                <div class="legacy-service-status @(status == "OPEN" ? "is-open" : "is-closed")">
                    @status
                </div>

                <div class="legacy-service-icon">
                    <i class="fa-solid fa-scroll"></i>
                </div>

                <h2>Supplementary Roll 4</h2>

                <p>
                    Search, link and manage properties for the current
                    supplementary valuation roll.
                </p>

                <div class="legacy-service-stats">
                    <span><i class="fa-solid fa-link"></i> @data.LinkedCount Linked</span>
                    <span><i class="fa-solid fa-file-pen"></i> @data.ObjectedCount Objections</span>
                    <span><i class="fa-solid fa-gavel"></i> @data.AppealsCount Appeals</span>
                </div>

                <div class="legacy-service-actions">
                    @if (status == "OPEN")
                    {
                        <a href="/search/Objection_Supp4"
                           class="legacy-btn legacy-btn-primary">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            Search Property
                        </a>
                    }

                    <button type="button"
                            class="legacy-btn legacy-btn-secondary"
                            onclick="openLegacyRoll('Objection_Supp4', 'Supplementary Roll 4')">
                        <i class="fa-solid fa-table-list"></i>
                        Dashboard
                    </button>
                </div>
            </article>
        }

        @if (query is not null)
        {
            var data = DataFor(query.Source);

            <article class="legacy-service-card legacy-service-card-teal">
                <div class="legacy-service-status is-open">OPEN</div>

                <div class="legacy-service-icon">
                    <i class="fa-solid fa-magnifying-glass-chart"></i>
                </div>

                <h2>Section 78 Query / Review</h2>

                <p>
                    Lodge or track a Section 78 Query and, where available,
                    continue with the Review process.
                </p>

                <div class="legacy-service-stats">
                    <span><i class="fa-solid fa-link"></i> @data.LinkedCount Linked</span>
                    <span><i class="fa-solid fa-file-circle-question"></i> @data.ObjectedCount Submissions</span>
                </div>

                <div class="legacy-service-actions">
                    <a href="/search/Objection_Query"
                       class="legacy-btn legacy-btn-primary">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Search Property
                    </a>

                    <button type="button"
                            class="legacy-btn legacy-btn-secondary"
                            onclick="openLegacyRoll('@query.Source', 'Section 78 Query / Review')">
                        <i class="fa-solid fa-table-list"></i>
                        Dashboard
                    </button>
                </div>
            </article>
        }

        <article class="legacy-service-card legacy-service-card-gold">
            <div class="legacy-service-status is-open">OPEN</div>

            <div class="legacy-service-icon">
                <i class="fa-solid fa-percent"></i>
            </div>

            <h2>Rebates Process</h2>

            <p>
                Apply for and track City of Johannesburg property rate rebate applications.
            </p>

            <div class="legacy-service-stats">
                <span>
                    <i class="fa-solid fa-file-pen"></i>
                    @(Model.Rebates?.Count ?? 0) Applications
                </span>
            </div>

            <div class="legacy-service-actions">
                <a href="/Rebates/Index"
                   class="legacy-btn legacy-btn-primary legacy-btn-gold">
                    <i class="fa-solid fa-file-signature"></i>
                    Apply for Rebates
                </a>

                <button type="button"
                        class="legacy-btn legacy-btn-secondary"
                        onclick="openLegacyService('/dashboard/rebates-detail', 'Rebates')">
                    <i class="fa-solid fa-table-list"></i>
                    Dashboard
                </button>
            </div>
        </article>

        <article class="legacy-service-card legacy-service-card-gold">
            <div class="legacy-service-status is-open">OPEN</div>

            <div class="legacy-service-icon">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>

            <h2>Property Attributes</h2>

            <p>
                Submit updated property attribute information and track
                inspections, corrections and approvals.
            </p>

            <div class="legacy-service-stats">
                <span>
                    <i class="fa-solid fa-link"></i>
                    @Model.AttributesLinked.Count Linked
                </span>
                <span>
                    <i class="fa-solid fa-file-pen"></i>
                    @Model.AttributesData.SubmissionCount Submissions
                </span>
            </div>

            <div class="legacy-service-actions">
                <a href="/attributes/search"
                   class="legacy-btn legacy-btn-primary legacy-btn-gold">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Search Property
                </a>

                <button type="button"
                        class="legacy-btn legacy-btn-secondary"
                        onclick="openLegacyService('/dashboard/attributes-detail', 'Property Attributes')">
                    <i class="fa-solid fa-table-list"></i>
                    Dashboard
                </button>
            </div>
        </article>

    </div>

    <section class="legacy-archive">
        <button type="button"
                class="legacy-archive-toggle"
                id="legacyArchiveToggle"
                aria-expanded="false"
                onclick="toggleLegacyArchive()">
            <span>
                <i class="fa-solid fa-bolt"></i>
                <strong>Quick Access – Previous Valuation Rolls</strong>
                <small>View GV23 and closed supplementary rolls</small>
            </span>

            <i class="fa-solid fa-chevron-down legacy-archive-chevron"
               id="legacyArchiveChevron"></i>
        </button>

        <div class="legacy-archive-body"
             id="legacyArchiveBody"
             hidden>

            @foreach (var roll in closedRolls)
            {
                var data = DataFor(roll.Source);

                <article class="legacy-archive-card">
                    <div>
                        <span class="legacy-archive-badge">CLOSED</span>
                        <h3>@RollSubtitle(roll.Source)</h3>
                        <p>
                            @data.LinkedCount linked ·
                            @data.ObjectedCount objections ·
                            @data.AppealsCount appeals
                        </p>
                    </div>

                    <button type="button"
                            class="legacy-btn legacy-btn-secondary"
                            onclick="openLegacyRoll('@roll.Source', '@RollSubtitle(roll.Source)')">
                        <i class="fa-solid fa-table-list"></i>
                        Dashboard
                    </button>
                </article>
            }

        </div>
    </section>

    <section class="legacy-detail"
             id="legacyDetail"
             hidden>

        <div class="legacy-detail-head">
            <div>
                <span>MY PROPERTY SERVICES</span>
                <h2 id="legacyDetailTitle">Dashboard</h2>
            </div>

            <button type="button"
                    class="legacy-btn legacy-btn-secondary"
                    onclick="closeLegacyDetail()">
                <i class="fa-solid fa-arrow-left"></i>
                Back
            </button>
        </div>

        <div id="legacyDetailBody">
            <div class="legacy-loading">
                <i class="fa-solid fa-circle-notch fa-spin"></i>
                Loading…
            </div>
        </div>
    </section>

</div>

@section Scripts {
<script>
    const legacyDetailCache = {};

    function toggleLegacyArchive() {
        const body = document.getElementById('legacyArchiveBody');
        const button = document.getElementById('legacyArchiveToggle');
        const chevron = document.getElementById('legacyArchiveChevron');

        if (!body || !button) return;

        const willOpen = body.hidden;
        body.hidden = !willOpen;
        button.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
        chevron?.classList.toggle('is-open', willOpen);
    }

    function openLegacyRoll(source, title) {
        openLegacyService(
            '/dashboard/roll-detail/' + encodeURIComponent(source),
            title
        );
    }

    async function openLegacyService(url, title) {
        const detail = document.getElementById('legacyDetail');
        const body = document.getElementById('legacyDetailBody');
        const titleElement = document.getElementById('legacyDetailTitle');

        if (!detail || !body) return;

        titleElement.textContent = title || 'Dashboard';
        detail.hidden = false;
        detail.scrollIntoView({ behavior: 'smooth', block: 'start' });

        if (legacyDetailCache[url]) {
            body.innerHTML = legacyDetailCache[url];
            initialiseLegacyTables(body);
            return;
        }

        body.innerHTML =
            '<div class="legacy-loading">' +
            '<i class="fa-solid fa-circle-notch fa-spin"></i> Loading…' +
            '</div>';

        try {
            const response = await fetch(url, {
                credentials: 'same-origin',
                headers: { 'X-Requested-With': 'XMLHttpRequest' }
            });

            if (!response.ok) {
                throw new Error('HTTP ' + response.status);
            }

            const html = await response.text();
            legacyDetailCache[url] = html;
            body.innerHTML = html;
            initialiseLegacyTables(body);
        }
        catch (error) {
            console.error('[Legacy dashboard demo]', error);

            body.innerHTML =
                '<div class="legacy-error">' +
                '<i class="fa-solid fa-triangle-exclamation"></i>' +
                '<strong>Could not load the dashboard information.</strong>' +
                '<span>Please try again.</span>' +
                '</div>';
        }
    }

    function closeLegacyDetail() {
        const detail = document.getElementById('legacyDetail');

        if (!detail) return;

        detail.hidden = true;
        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // Existing _RollDetailPartial calls this function.
    function toggleWidget(key) {
        const body = document.getElementById('widget-' + key);
        const chevron = document.getElementById('wchev-' + key);

        if (!body) return;

        const isOpen = body.classList.toggle('open');

        if (chevron) {
            chevron.style.transform =
                isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
        }

        if (isOpen) {
            initialiseLegacyTables(body);
        }
    }

    // Existing roll partial uses logAction on some links.
    function logAction(action, roll, reference) {
        console.debug(
            '[Dashboard action]',
            action,
            roll,
            reference
        );
    }

    function initialiseLegacyTables(container) {
        if (!window.jQuery ||
            !jQuery.fn ||
            !jQuery.fn.DataTable) {
            return;
        }

        container
            .querySelectorAll('.cd-table')
            .forEach(function(table) {
                if (!table.id) return;

                const selector = '#' + table.id;

                if (jQuery.fn.DataTable.isDataTable(selector)) {
                    jQuery(selector).DataTable().columns.adjust();
                    return;
                }

                if (!table.closest('.cd-widget-body.open')) {
                    return;
                }

                jQuery(selector).DataTable({
                    responsive: {
                        details: {
                            type: 'inline',
                            target: 'td.dtr-control'
                        }
                    },
                    autoWidth: false,
                    pageLength: 5,
                    lengthMenu: [
                        [5, 10, 25, 50, -1],
                        [5, 10, 25, 50, 'All']
                    ],
                    columnDefs: [
                        {
                            targets: 0,
                            className: 'dtr-control all',
                            responsivePriority: 1
                        },
                        {
                            targets: -1,
                            className: 'none',
                            orderable: false
                        }
                    ]
                });
            });
    }
</script>
}
