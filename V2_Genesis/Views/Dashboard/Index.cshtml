@using V2_Genesis.Services.PropertySearch
@model V2_Genesis.Models.ViewModels.Dashboard.ClientDashboardViewModel
@{
    ViewData["Title"] = "My Dashboard";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    var ann = Model.Announcement;
}
@functions {

    string FormatZAR(string? val)
    {
        if (string.IsNullOrWhiteSpace(val))
            return "–";

        // Remove currency symbols and spaces only
        var clean = val.Replace("R", "")
                       .Replace(",", "")
                       .Trim();

        if (!decimal.TryParse(clean,
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out var num) || num <= 0)
        {
            return "–";
        }

        return "R " + num.ToString("N0",
            new System.Globalization.CultureInfo("en-ZA"));
    }

   RollDateEntry? GetDates(string rollSource)
    {
        Model.RollDates.TryGetValue(rollSource, out var d);
        return d;
    }

    string PeriodStatus(RollDateEntry? d)
    {
        if (d is null) return "unknown";
        var now = DateTime.Now;
        if (now < d.OpenDate) return "upcoming";
        if (now <= d.VisibleUntil) return "active";
        return "closed";
    }

    string GetAttrStatusPill(string? status) => status switch
    {
        "Pending" => "<span class='cd-pill cd-pill-pending'>Pending</span>",
        "Under Review" => "<span class='cd-pill cd-pill-inprogress'>Under Review</span>",
        "Approved" => "<span class='cd-pill cd-pill-completed'>Approved</span>",
        "Rejected" => "<span class='cd-pill cd-pill-lodging'>Rejected</span>",
        _ => $"<span class='cd-pill cd-pill-pending'>{status}</span>"
    };

    string GetApptStatusPill(string? status) => status switch
    {
        "Scheduled" => "<span class='cd-pill cd-pill-inprogress'>Scheduled</span>",
        "Completed" => "<span class='cd-pill cd-pill-completed'>Completed</span>",
        "Cancelled" => "<span class='cd-pill cd-pill-lodging'>Cancelled</span>",
        _ => $"<span class='cd-pill cd-pill-pending'>{status}</span>"
    };
}

@section Styles {
   
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true"/>
}

<!-- ── Welcome strip ──────────────────────────────────────────────────── -->
<div class="ann-bar @ann.BadgeCss">
    <div class="ann-inner">
        <span class="ann-badge @ann.BadgeCss">
            <span class="ann-dot"></span>@ann.BadgeText
        </span>
        <span class="ann-text">@ann.Message</span>
        @if (ann.DaysLeft > 0)
        {
            <span class="ann-days @ann.DaysCss">
                <i class="fa-solid fa-calendar-days"></i>
                @ann.DaysLeft @(ann.DaysLeft == 1 ? "day" : "days") remaining
            </span>
        }
    </div>
</div>

<div class="cd-welcome">
    <div class="cd-welcome-inner">
        <div>
            <h1 class="cd-welcome-name">
                Welcome back, <span>@Model.DisplayName</span> 👋
            </h1>
            <p class="cd-welcome-sub">
                @(Model.IsCompany ? "Company Account" : "Individual Account") &nbsp;·&nbsp;
                Property Dashboard
            </p>
        </div>
        <div class="cd-ann-pill @ann.BadgeCss">
            <span class="cd-ann-dot"></span>
            <span>@ann.Message</span>
        </div>
    </div>
</div>

<!-- ── Quick stats row ────────────────────────────────────────────────── -->
<div class="cd-stats-row">
    @foreach (var roll in Model.Rolls.Where(r => !r.IsQuery))
    {
        var rd = Model.RollData.GetValueOrDefault(roll.Source) ?? new();
        <div class="cd-stat-card">
            <div class="cd-stat-label">@roll.Short</div>
            <div class="cd-stat-nums">
                <span title="Linked"><i class="fa-solid fa-link"></i> @rd.LinkedCount</span>
                @if (roll.HasObjection)
                {
                    <span title="Objections"><i class="fa-solid fa-file-pen"></i> @rd.ObjectedCount</span>
                }
                @if (roll.HasAppeal)
                {
                    <span title="Appeals"><i class="fa-solid fa-gavel"></i> @rd.AppealsCount</span>
                }
            </div>
        </div>
    }
</div>

@if (TempData["LinkSuccess"] != null)
{
    <div class="dash-link-alert dash-link-success">
        <i class="fa-solid fa-circle-check"></i>
        <div>
            <strong>Property Linked!</strong>
            @TempData["LinkSuccess"]
        </div>
        <button onclick="this.closest('.dash-link-alert').remove()">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}

@if (TempData["LinkError"] != null)
{
    <div class="dash-link-alert dash-link-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <div>
            <strong>Could Not Link Property</strong>
            @TempData["LinkError"]
        </div>
        <button onclick="this.closest('.dash-link-alert').remove()">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
}
<!-- ── Per-roll collapsible sections ──────────────────────────────────── -->
<div class="cd-body">
    @foreach (var roll in Model.Rolls)
    {
        var rd = Model.RollData.GetValueOrDefault(roll.Source) ?? new();
        var rollKey = roll.Source.Replace("_", "");
        var isActive = roll == Model.Rolls.First();

