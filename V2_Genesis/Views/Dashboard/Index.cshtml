<!-- ── Welcome strip ──────────────────────────────────────────────────── -->
<div class="ann-bar @ann.BadgeCss">
    <div class="ann-inner">

        <span class="ann-badge @ann.BadgeCss">
            <span class="ann-dot"></span>
            @ann.BadgeText
        </span>

       
        <span class="ann-text">
            <span>
                @ann.Message
                @if (ann.DaysLeft > 0)
                {
                    <span style="margin-left:24px;opacity:.75;">
                        &nbsp;·&nbsp;
                        <i class="fa-solid fa-calendar-days"></i>
                        @ann.DaysLeft @(ann.DaysLeft == 1 ? "day" : "days") remaining
                    </span>
                }
               
                &nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
                @ann.Message
            </span>
        </span>

        
        @if (ann.DaysLeft > 0)
        {
            <span class="ann-days @ann.DaysCss">
                <i class="fa-solid fa-calendar-days"></i>
                @ann.DaysLeft @(ann.DaysLeft == 1 ? "day" : "days") remaining
            </span>
        }

    </div>
</div>


<div class="cd-hero">
    <div class="cd-welcome-inner">
        <div class="cd-welcome-left">

            <!-- Avatar initial box -->
            <div class="cd-hero-avatar">
                @(Model.DisplayName?.Substring(0, 1).ToUpper() ?? "U")
            </div>

            <div>
                <div class="cd-welcome-eyebrow">
                    <span></span>
                    @(Model.IsCompany ? "Company Account" : "Individual Account") &nbsp;·&nbsp; Property Dashboard
                </div>
                <h1 class="cd-welcome-name">
                    Welcome back,&nbsp;<em>@Model.DisplayName</em>
                    <span class="cd-welcome-wave">👋</span>
                </h1>
                <p class="cd-welcome-sub">
                    City of Johannesburg
                    <span class="cd-welcome-dot"></span>
                    Valuation Portal
                </p>
            </div>
        </div>

        <!-- Notification bell -->
        <div class="cd-notification-wrap">
            <button type="button" class="cd-notification-btn" id="notificationBellBtn">
                <i class="fa-solid fa-bell"></i>
                @if (unreadNotificationCount > 0)
                {
                    <span class="cd-notification-count">@unreadNotificationCount</span>
                }
            </button>

            <div class="cd-notification-panel" id="notificationPanel">
                <div class="cd-notification-head">
                    <strong>Notifications</strong>
                    <span>@unreadNotificationCount unread</span>
                </div>
                @if (!latestNotifications.Any())
                {
                    <div class="cd-notification-empty">
                        <i class="fa-solid fa-bell-slash" style="font-size:24px;color:#ddd;display:block;margin-bottom:8px;"></i>
                        No notifications yet.
                    </div>
                }
                else
                {
                    <div class="cd-notification-list">
                        @foreach (var note in latestNotifications)
                        {
                            var noteType = string.IsNullOrWhiteSpace(note.NotificationType) ? "Info" : note.NotificationType;
                            <a class="cd-notification-item @(note.IsRead ? "" : "unread")"
                                   href="@(string.IsNullOrWhiteSpace(note.Url) ? "#" : note.Url)">
                                <div class="cd-note-icon cd-note-@noteType.ToLower()">
                                    <i class="fa-solid @(noteType == "Success" ? "fa-circle-check" : noteType == "Warning" ? "fa-triangle-exclamation" : noteType == "Error" ? "fa-circle-xmark" : "fa-circle-info")"></i>
                                </div>
                                <div class="cd-note-body">
                                    <strong>@(note.Title ?? "Notification")</strong>
                                    <p>@note.Message</p>
                                    @if (!string.IsNullOrWhiteSpace(note.ReferenceNumber))
                                    {
                                        <span class="cd-note-ref">@note.ReferenceNumber</span>
                                    }
                                    <small>@note.CreatedDate.ToString("dd MMM yyyy HH:mm")</small>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
<!-- ── Quick stats row ────────────────────────────────────────────────── -->
<div class="cd-stats-strip">
        @foreach (var roll in Model.Rolls.Where(r => !r.IsQuery))
        {
            var rd = Model.RollData.GetValueOrDefault(roll.Source) ?? new();
            <div class="cd-stat-card">
                <div class="cd-stat-label">@roll.Short</div>
                <div class="cd-stat-nums">
