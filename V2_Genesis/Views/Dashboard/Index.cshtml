@functions {

    string FormatZAR(string? val)
    {
        if (string.IsNullOrWhiteSpace(val))
            return "–";

        // Remove currency symbols and spaces only
        var clean = val.Replace("R", "")
                       .Replace(",", "")
                       .Trim();

        if (!decimal.TryParse(clean,
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out var num) || num <= 0)
        {
            return "–";
        }

        return "R " + num.ToString("N0",
            new System.Globalization.CultureInfo("en-ZA"));


      
    }

   RollDateEntry? GetDates(string rollSource)
    {
        Model.RollDates.TryGetValue(rollSource, out var d);
        return d;
    }

    string PeriodStatus(RollDateEntry? d)
    {
        if (d is null) return "unknown";
        var now = DateTime.Now;
        if (now < d.OpenDate) return "upcoming";
        if (now <= d.VisibleUntil) return "active";
        return "closed";
    }

    string GetAttrStatusPill(string? status)
    {
        var displayText = AttributeStatusDisplayHelper.GetDisplayStatus(status);
        var cssClass = AttributeStatusDisplayHelper.GetStatusCssClass(status);

        return $@"
<span class='cd-status-pill {Enc(cssClass)}'>
    {Enc(displayText)}
</span>";
    }

    string GetApptStatusPill(string? status)
    {
        var displayText = AttributeStatusDisplayHelper.GetDisplayStatus(status);
        var cssClass = AttributeStatusDisplayHelper.GetStatusCssClass(status);

        return $@"
<span class='cd-status-pill {Enc(cssClass)}'>
    {Enc(displayText)}
</span>";
    }

    string GetRebateStatusPill(string? status) => status switch
    {
        "Acknowledge" => "<span class='cd-pill cd-pill-lodging'>Acknowledged</span>",
        "Auto Reject" => "<span class='cd-pill cd-pill-rejected'>Auto Rejected</span>",
        "Under Review" => "<span class='cd-pill cd-pill-inprogress'>Under Review</span>",
        "Approved" => "<span class='cd-pill cd-pill-completed'>Approved</span>",
        "Rejected" => "<span class='cd-pill cd-pill-rejected'>Rejected</span>",
        _ => $"<span class='cd-pill cd-pill-pending'>{status ?? "Pending"}</span>"
    };
}



