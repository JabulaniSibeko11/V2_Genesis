    </div>

    @* ── Property Attributes ───────────────────────────────────────────────── *@
    <div class="cd-roll-section">
        <div class="cd-roll-header cd-roll-attributes" onclick="toggleRoll('attributes')">
            <div class="cd-roll-header-left">
                <div class="cd-roll-icon">
                    <i class="fa-solid fa-clipboard-list"></i>
                </div>
                <div>
                    <h2 class="cd-roll-name">Property Attributes</h2>
                    <span class="cd-roll-short">
                        Submit updated property information for valuation roll preparation
                    </span>
                </div>
            </div>
            <div class="cd-roll-header-right">
                <a href="/attributes/about"
                       class="cd-roll-search-btn cd-roll-learn-btn"
                       onclick="event.stopPropagation()">
                    <i class="fa-solid fa-circle-info"></i> Learn How It Works
                </a>
                <a href="/attributes/search"
                       class="cd-roll-search-btn"
                       onclick="event.stopPropagation()">
                    <i class="fa-solid fa-magnifying-glass"></i> Search Property
                </a>
                <span class="cd-roll-badge cd-badge-open">NEW</span>
                <i class="fa-solid fa-chevron-down cd-roll-chevron"
                   id="chevron-attributes"></i>
            </div>
        </div>

        <div class="cd-roll-body" id="rollbody-attributes">

            @{
                var attrData = Model.AttributesData;
            }

            <!-- ── 1. Linked Properties ──────────────────────────── -->
            <div class="cd-widget">
                <div class="cd-widget-toggle"
                     onclick="toggleWidget('attr-linked')">
                    <div class="cd-widget-toggle-left">
                        <i class="fa-solid fa-link"></i>
                        <h3>Linked Properties</h3>
                        <span class="cd-count-badge">@Model.AttributesLinked.Count</span>
                    </div>
                    <i class="fa-solid fa-chevron-down cd-widget-chevron"
                       id="wchev-attr-linked"></i>
                </div>
                <div class="cd-widget-body" id="widget-attr-linked">
                    <div class="cd-widget-toolbar">
                        <a href="/attributes/search" class="cd-add-btn">
                            <i class="fa-solid fa-plus"></i> Link New Property
                        </a>
                    </div>
                    <div class="table-responsive">
                        <table class="cd-table table table-bordered"
                               id="tbl-attr-linked">
                            <thead>
                                <tr>
                                    <th>Property Description</th>
                                    <th>Category</th>
                                    <th>Town</th>
                                    <th>Market Value</th>
                                    <th>Form Type</th>
                                    <th>Options</th>
                                </tr>
                            </thead>
                            <tbody>
                                @* Replace attrData.LinkedProperties with Model.AttributesLinked *@
                                @foreach (var item in Model.AttributesLinked)
                                {
                                    <tr>
                                        <td>@item.PropertyDesc</td>
                                        <td>@item.CatDesc</td>
                                        <td>@item.TownNameDesc</td>
                                        <td>@item.MarketValue</td>
                                        <td>
                                            <span class="attr-form-pill attr-pill-@(item.FormType.ToLower()
                                                                                        .Replace(" ", "").Replace("&", "").Replace("/", ""))">
                                                @item.FormType
                                            </span>
                                        </td>
                                        <td>
                                            <div class="dropdown">
                                                <button class="cd-action-btn dropdown-toggle"
                                                        data-bs-toggle="dropdown">
                                                    Actions
                                                </button>
                                                <ul class="dropdown-menu">
                                                    @if (!item.HasSubmission)
                                                    {
                                                    @*     <li>
                                                            <a class="dropdown-item"
                                                                   href="/attributes/form?id=@item.IDProperty&formType=@item.FormType">
                                                                Submit Attributes
                                                            </a>
                                                        </li> *@


                                                                    <li>
                                                                       <a class="dropdown-item"
                                                                           asp-controller="Attributes"
                                                                   asp-action="Check"
                                                                   asp-route-idProperty="@item.IDProperty"
                                                                           asp-route-formType="@item.FormType">
                                                                            Submit Attributes
                                                                        </a>
                                                                    </li>
                                                    }
                                                    else
                                                    {
                                                        <li>
                                                            <a class="dropdown-item"
                                                                   href="/attributes/submission?propertyId=@item.IDProperty">
                                                                View Submission
                                                            </a>
                                                        </li>
                                                    }
                                                    <li>
                                                        <a class="dropdown-item"
                                                               href="/attributes/unlink?id=@item.Id">
                                                            Unlink
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ── 2. My Submissions ──────────────────────────────── -->
            <div class="cd-widget">
                <div class="cd-widget-toggle"
                     onclick="toggleWidget('attr-submissions')">
                    <div class="cd-widget-toggle-left">
                        <i class="fa-solid fa-file-pen"></i>
                        <h3>My Submissions</h3>
                        <span class="cd-count-badge cd-count-orange">
                            @attrData.SubmissionCount
                        </span>
                        @if (attrData.PendingCount > 0)
                        {
                            <span class="cd-count-badge cd-count-amber">
                                @attrData.PendingCount pending
                            </span>
                        }
                    </div>
                    <i class="fa-solid fa-chevron-down cd-widget-chevron"
                       id="wchev-attr-submissions"></i>
                </div>
                <div class="cd-widget-body" id="widget-attr-submissions">
                    <div class="table-responsive">
                        <table class="cd-table table table-bordered"
                               id="tbl-attr-submissions">
                            <thead>
                                <tr>
                                    <th> Reference</th>
                                    <th>Property Description</th>
                                    <th>Form Type</th>
                                    <th> Submitted</th>
                                    <th>Edit Window</th>
                                    <th> Status</th>
                                    <th> Options</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in attrData.Submissions)
                                {
                                    <tr>
                                        <td><strong>@item.SubmissionRef</strong></td>
                                        <td>@item.PropertyDesc</td>
                                        <td>@item.FormType</td>
                                        <td>@item.SubmittedAt.ToString("dd MMM yyyy HH:mm")</td>
                                        <td>
                                            @if (item.IsEditable && item.EditTimeLeft.HasValue)
                                            {
                                                var tl = item.EditTimeLeft.Value;
                                                <span class="attr-edit-window attr-edit-open"
                                                      data-deadline="@item.SubmittedAt.AddHours(48).ToString("o")">
                                                    <i class="fa-solid fa-clock"></i>
                                                    @tl.Hours h @tl.Minutes m left
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="attr-edit-window attr-edit-locked">
                                                    <i class="fa-solid fa-lock"></i> Locked
                                                </span>
                                            }
                                        </td>
                                        <td>@Html.Raw(GetAttrStatusPill(item.Status))</td>
                                        <td>
                                            <div class="dropdown">
                                                <button class="cd-action-btn dropdown-toggle"
                                                        data-bs-toggle="dropdown">
                                                    Actions
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li>
                                                        <a class="dropdown-item"
                                                               href="/attributes/submission/@item.Id">
                                                            👁️ View Submission
                                                        </a>
                                                    </li>
                                                    <li>
                                                        <a class="dropdown-item"
                                                               href="/attributes/acknowledgement/download?attrNo=@item.SubmissionRef"
                                                               target="_blank">
                                                            <i class="fa-solid fa-file-pdf" style="color:#dc2626;"></i>
                                                            Download Acknowledgement
                                                        </a>
                                                    </li>
                                                    @if (item.IsEditable)
                                                    {
                                                       @*  <li>
                                                            <a class="dropdown-item"
                                                                   href="/attributes/edit/@item.Id">
                                                                ✏️ Edit Submission
                                                            </a>
                                                        </li> *@
                                                        <li>
                                                            <a class="dropdown-item"
                                                                   href="/attributes/evidence?attrNo=@item.SubmissionRef">
                                                                📎 Add Evidence
                                                            </a>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- ── 3. My Appointments with Valuer ─────────────────── -->
            <div class="cd-widget">
                <div class="cd-widget-toggle"
                     onclick="toggleWidget('attr-appointments')">
                    <div class="cd-widget-toggle-left">
                        <i class="fa-solid fa-calendar-check"></i>
                        <h3>My Appointments with Valuer</h3>
                        <span class="cd-count-badge cd-count-blue">
                            @attrData.AppointmentCount
                        </span>
                    </div>
                    <i class="fa-solid fa-chevron-down cd-widget-chevron"
                       id="wchev-attr-appointments"></i>
                </div>
                <div class="cd-widget-body" id="widget-attr-appointments">
                    <div class="table-responsive">
                        <table class="cd-table table table-bordered"
                               id="tbl-attr-appointments">
                            <thead>
                                <tr>
                                    <th>🆔 Reference</th>
                                    <th>Property</th>
                                    <th>👤 Valuer</th>
                                    <th>📅 Date</th>
                                    <th>🕐 Time</th>
                                    <th>📊 Status</th>
                                    <th>⚙️ Options</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in attrData.Appointments)
                                {
                                    <tr>
                                        <td><strong>@item.AppointmentRef</strong></td>
                                        <td>@item.PropertyDesc</td>
                                        <td>@item.ValuerName</td>
                                        <td>@item.AppointmentDate.ToString("dd MMM yyyy")</td>
                                        <td>@item.TimeSlot</td>
                                        <td>@Html.Raw(GetApptStatusPill(item.Status))</td>
                                        <td>
                                            <div class="dropdown">
                                                <button class="cd-action-btn dropdown-toggle"
                                                        data-bs-toggle="dropdown">
                                                    Actions
                                                </button>
                                                <ul class="dropdown-menu">
                                                    <li>
                                                        <a class="dropdown-item"
                                                               href="/attributes/appointment/@item.Id">
                                                            👁️ View Details
                                                        </a>
                                                    </li>
                                                </ul>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

        </div>
    </div>

</div>


@functions {
    string GetStatusPill(string? status) => status switch
    {
        "Obj-Unallocated" or "Obj-Section51"
            => "<span class='cd-pill cd-pill-pending'>Obj-Pending</span>",
        "Obj-Inprogress" or "Obj-Pending-Approval" or "Obj-Rejected"
            => "<span class='cd-pill cd-pill-inprogress'>Obj-InProgress</span>",
        "Obj-Lodging"
            => "<span class='cd-pill cd-pill-lodging'>Obj-Lodging</span>",
        "Obj-PenTest"
            => "<span class='cd-pill cd-pill-rejected'>Invalid</span>",
        "App-Unallocated" or "App-Lodging"
            => "<span class='cd-pill cd-pill-pending'>@status</span>",
        "App-Finalized"
            => "<span class='cd-pill cd-pill-completed'>App-Finalized</span>",
        null or ""
            => "<span class='cd-pill cd-pill-pending'>Pending</span>",
        _ => $"<span class='cd-pill cd-pill-completed'>{status}</span>"
    };
}

@section Scripts {
    <script>
        // ── Roll section toggle ────────────────────────────────────────────
        function toggleRoll(key) {
            const body    = document.getElementById('rollbody-' + key);
            const chevron = document.getElementById('chevron-' + key);
            if (!body) return;
            const isOpen = body.classList.toggle('open');
            if (chevron) chevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
        }

        // ── Widget sub-section toggle ──────────────────────────────────────
        function toggleWidget(key) {
            const body    = document.getElementById('widget-' + key);
            const chevron = document.getElementById('wchev-' + key);
            if (!body) return;
            const isOpen = body.classList.toggle('open');
            if (chevron) chevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
        }

        // ── Init DataTables on visible tables ─────────────────────────────
        function initDataTable(selector) {
            if ($.fn.DataTable.isDataTable(selector)) return;
            $(selector).DataTable({
                responsive : true,
                dom        : '<"cd-dt-top"lBf>rt<"cd-dt-bottom"ip>',
                lengthMenu : [[5, 10, 25, -1], [5, 10, 25, 'All']],
                buttons    : [
                    { extend:'excel', text:'<i class="fa-solid fa-file-excel"></i> Excel', className:'cd-dt-btn' },
                    { extend:'pdf',   text:'<i class="fa-solid fa-file-pdf"></i> PDF',     className:'cd-dt-btn' }
                ],
                language: {
                    search: '_INPUT_', searchPlaceholder: 'Search...',
                    lengthMenu: '_MENU_ per page'
                }
            });
        }

        // Init tables inside open sections on load
        $(document).ready(function () {
            // Auto-init tables already visible
            document.querySelectorAll('.cd-widget-body.open .cd-table').forEach(t => {
                initDataTable('#' + t.id);
            });

            // Init when widget opens
            document.querySelectorAll('.cd-widget-toggle').forEach(toggle => {
                toggle.addEventListener('click', function () {
                    const bodyId = this.nextElementSibling?.id;
                    if (!bodyId) return;
                    setTimeout(() => {
                        const table = document.querySelector('#' + bodyId + ' .cd-table');
                        if (table) initDataTable('#' + table.id);
                    }, 100);
                });
            });

           
        });
    </script>
}