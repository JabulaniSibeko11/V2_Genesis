@functions {
    string Enc(string? value)
    {
        return WebUtility.HtmlEncode(value ?? "");
    }

    string GetStatusDisplayText(string? status) => status switch
    {
        "Obj-Unallocated" or "Obj-Section51" => "Obj-Pending",
        "Obj-Inprogress" or "Obj-Pending-Approval" or "Obj-Rejected" => "Obj-InProgress",
        "Obj-Lodging" => "Obj-Lodging",
        "Obj-PenTest" => "Invalid",

        "App-Unallocated" => "App-Unallocated",
        "App-Lodging" => "App-Lodging",
        "App-Finalized" => "App-Finalized",

        "Query-Lodging" => "Query-Lodging",
        "Query-Unallocated" => "Query-Pending",
        "Query-Inprogress" => "Query-InProgress",
        "Query-Finalized" or "Notice-Sent" => "Finalised",
        "Query-Withdrawn" => "Withdrawn",

        null or "" => "Pending",
        _ => status
    };

    string GetStatusPill(string? status)
    {
        var title = StatusExplanationHelper.GetTitle(status);
        var description = StatusExplanationHelper.GetDescription(status);
        var badgeClass = StatusExplanationHelper.GetBadgeClass(status);
        var displayText = GetStatusDisplayText(status);

        return $@"
<span class='client-status-badge cd-pill {Enc(badgeClass)}'
      title='{Enc(description)}'
      data-status-title='{Enc(title)}'
      data-status-message='{Enc(description)}'>
    {Enc(displayText)}
    <i class='fa-solid fa-circle-question status-help-icon'></i>
</span>";
    }
}

@section Scripts {
 
    <script>
        // ============================================================
        // Dashboard JS - Combined
        // ============================================================

        // ── Roll section toggle ─────────────────────────────────────
        function toggleRoll(key) {
            const body = document.getElementById('rollbody-' + key);
            const chevron = document.getElementById('chevron-' + key);

            if (!body) return;

            const isOpen = body.classList.toggle('open');

            if (chevron) {
                chevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        }

        // ── Widget sub-section toggle ───────────────────────────────
        function toggleWidget(key) {
            const body = document.getElementById('widget-' + key);
            const chevron = document.getElementById('wchev-' + key);

            if (!body) return;

            const isOpen = body.classList.toggle('open');

            if (chevron) {
                chevron.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
            }
        }

        // ── Init DataTables ─────────────────────────────────────────
        function initDataTable(selector) {
            if (!selector || !$(selector).length) return;
            if ($.fn.DataTable.isDataTable(selector)) return;

            $(selector).DataTable({
                responsive: true,
                dom: '\u003C"cd-dt-top"lBf\u003Ert\u003C"cd-dt-bottom"ip\u003E',
                lengthMenu: [[5, 10, 25, -1], [5, 10, 25, 'All']],
                buttons: [
                    {
                        extend: 'excel',
                        text: '<i class="fa-solid fa-file-excel"></i> Excel',
                        className: 'cd-dt-btn'
                    },
                    {
                        extend: 'pdf',
                        text: '<i class="fa-solid fa-file-pdf"></i> PDF',
                        className: 'cd-dt-btn'
                    }
                ],
                language: {
                    search: '_INPUT_',
                    searchPlaceholder: 'Search...',
                    lengthMenu: '_MENU_ per page'
                }
            });
        }

        // ── Open roll after redirect ────────────────────────────────
        function openLinkedRollFromQueryString() {
            const params = new URLSearchParams(window.location.search);
            const openRoll = params.get('openRoll');

            if (!openRoll) return;

            let rollSection = document.querySelector(
                `.cd-roll-section[data-roll-source="${openRoll}"]`
            );

            if (!rollSection && openRoll.toLowerCase() === "attributes") {
                rollSection = document.getElementById("roll-attributes");
            }

            if (!rollSection && openRoll.toLowerCase() === "rebates") {
                rollSection = document.getElementById("roll-rebates");
            }

            if (!rollSection) {
                console.warn('Roll section not found for:', openRoll);
                return;
            }

            const rollKey = rollSection.id.replace('roll-', '');

            document.querySelectorAll('.cd-roll-body.open').forEach(body => {
                if (body.id !== 'rollbody-' + rollKey) {
                    body.classList.remove('open');
                }
            });

            document.querySelectorAll('.cd-roll-chevron').forEach(icon => {
                icon.style.transform = 'rotate(0deg)';
            });

            const rollBody = document.getElementById('rollbody-' + rollKey);
            const rollChevron = document.getElementById('chevron-' + rollKey);

            if (rollBody) {
                rollBody.classList.add('open');
            }

            if (rollChevron) {
                rollChevron.style.transform = 'rotate(180deg)';
            }

            const linkedWidget = document.getElementById('widget-' + rollKey + '-linked');
            const linkedChevron = document.getElementById('wchev-' + rollKey + '-linked');

            if (linkedWidget) {
                linkedWidget.classList.add('open');
            }

            if (linkedChevron) {
                linkedChevron.style.transform = 'rotate(180deg)';
            }

            setTimeout(function () {
                const linkedTable = document.querySelector(
                    '#widget-' + rollKey + '-linked .cd-table'
                );

                if (linkedTable && linkedTable.id) {
                    initDataTable('#' + linkedTable.id);
                }
            }, 150);

            rollSection.classList.add('linked-roll-active');

            setTimeout(function () {
                rollSection.scrollIntoView({
                    behavior: 'smooth',
                    block: 'start'
                });
            }, 250);

            window.history.replaceState({}, document.title, window.location.pathname);
        }

        // ── Inspection date response modal ──────────────────────────
        function openInspectionResponseModal(id) {
            const modal = document.getElementById('inspectionModal_' + id);

            if (modal) {
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            }
        }

        function closeInspectionResponseModal(id) {
            const modal = document.getElementById('inspectionModal_' + id);

            if (modal) {
                modal.style.display = 'none';
                document.body.style.overflow = '';
            }
        }

        // ── Returned correction / resubmission modal ────────────────
        function openReturnedCorrectionModal(id) {
            const modal = document.getElementById('returnedCorrectionModal_' + id);

            if (modal) {
                modal.style.display = 'flex';
                document.body.style.overflow = 'hidden';
            }
        }

        function closeReturnedCorrectionModal(id) {
            const modal = document.getElementById('returnedCorrectionModal_' + id);

            if (modal) {
                modal.style.display = 'none';
                document.body.style.overflow = '';
            }
        }

        // ── PIN modal keypad ────────────────────────────────────────
        const pinValues = {};
        const PIN_LEN = 4;

        function openPinModal(id) {
            pinValues[id] = '';

            const modal = document.getElementById('pinModal_' + id);
            const input = document.getElementById('pinHiddenInput_' + id);
            const error = document.getElementById('pinError_' + id);
            const submit = document.getElementById('pinSubmitBtn_' + id);

            if (!modal || !input || !submit) {
                console.warn('PIN modal elements missing for appointment:', id);
                return;
            }

            input.value = '';

            if (error) {
                error.classList.remove('show');
            }

            submit.disabled = true;

            updatePinDots(id);

            modal.style.display = 'flex';
            modal.classList.add('open');
            document.body.style.overflow = 'hidden';

            setTimeout(function () {
                input.focus();
            }, 100);
        }

        function closePinModal(id) {
            const modal = document.getElementById('pinModal_' + id);
            const input = document.getElementById('pinHiddenInput_' + id);
            const error = document.getElementById('pinError_' + id);
            const submit = document.getElementById('pinSubmitBtn_' + id);

            if (modal) {
                modal.classList.remove('open');
                modal.style.display = 'none';
            }

            pinValues[id] = '';

            if (input) {
                input.value = '';
            }

            if (error) {
                error.classList.remove('show');
            }

            if (submit) {
                submit.disabled = true;
            }

            updatePinDots(id);

            document.body.style.overflow = '';
        }

        function pinKey(id, digit) {
            let value = pinValues[id] || '';

            if (value.length >= PIN_LEN) return;

            value += digit;
            pinValues[id] = value;

            const input = document.getElementById('pinHiddenInput_' + id);
            const error = document.getElementById('pinError_' + id);
            const submit = document.getElementById('pinSubmitBtn_' + id);

            if (input) {
                input.value = value;
            }

            if (error) {
                error.classList.remove('show');
            }

            if (submit) {
                submit.disabled = value.length < PIN_LEN;
            }

            updatePinDots(id);
        }

        function pinDelete(id) {
            let value = pinValues[id] || '';

            if (value.length === 0) return;

            value = value.slice(0, -1);
            pinValues[id] = value;

            const input = document.getElementById('pinHiddenInput_' + id);
            const error = document.getElementById('pinError_' + id);
            const submit = document.getElementById('pinSubmitBtn_' + id);

            if (input) {
                input.value = value;
            }

            if (error) {
                error.classList.remove('show');
            }

            if (submit) {
                submit.disabled = value.length < PIN_LEN;
            }

            updatePinDots(id);
        }

        function updatePinDots(id) {
            const value = pinValues[id] || '';

            for (let i = 0; i < PIN_LEN; i++) {
                const dot = document.getElementById('dot_' + id + '_' + i);

                if (!dot) continue;

                dot.classList.remove('filled', 'gold', 'error');

                if (i < value.length) {
                    dot.classList.add('filled');
                }

                if (value.length === PIN_LEN && i === PIN_LEN - 1) {
                    dot.classList.add('gold');
                }
            }
        }

        // ── Status modal ────────────────────────────────────────────
        function initStatusExplanationModal() {
            const modal = document.getElementById("statusExplainModal");
            const title = document.getElementById("statusExplainTitle");
            const message = document.getElementById("statusExplainMessage");

            document.querySelectorAll(".client-status-badge").forEach(badge => {
                badge.addEventListener("click", function () {
                    if (!modal || !title || !message) return;

                    title.innerText = this.dataset.statusTitle || "Status Information";
                    message.innerText = this.dataset.statusMessage || "No explanation available.";

                    modal.style.display = "flex";
                    document.body.style.overflow = "hidden";
                });
            });

            function closeStatusModal() {
                if (modal) {
                    modal.style.display = "none";
                }

                document.body.style.overflow = "";
            }

            document.getElementById("closeStatusExplainModal")
                ?.addEventListener("click", closeStatusModal);

            document.getElementById("okayStatusExplainModal")
                ?.addEventListener("click", closeStatusModal);

            modal?.addEventListener("click", function (e) {
                if (e.target === modal) {
                    closeStatusModal();
                }
            });
        }

        // ── Notification bell ───────────────────────────────────────
        function initNotificationBell() {
            const bellBtn = document.getElementById("notificationBellBtn");
            const panel = document.getElementById("notificationPanel");

            bellBtn?.addEventListener("click", function (e) {
                e.stopPropagation();
                panel?.classList.toggle("open");
            });

            panel?.addEventListener("click", function (e) {
                e.stopPropagation();
            });

            document.addEventListener("click", function () {
                panel?.classList.remove("open");
            });
        }

        // ── Global click handlers ───────────────────────────────────
        document.addEventListener('click', function (e) {
            // Close PIN modal when backdrop is clicked.
            const pinBackdrop = e.target.closest('.pin-backdrop');

            if (pinBackdrop && e.target === pinBackdrop) {
                const id = pinBackdrop.id.replace('pinModal_', '');
                closePinModal(id);
                return;
            }

            // Close normal inspection / correction modals on backdrop click.
            if (e.target.classList.contains('attr-insp-modal-backdrop')) {
                e.target.style.display = 'none';
                document.body.style.overflow = '';
            }
        });

        // ── Keyboard handlers ──────────────────────────────────────
        document.addEventListener('keydown', function (e) {
            if (e.key !== 'Escape') return;

            document.querySelectorAll('.pin-backdrop.open').forEach(function (modal) {
                const id = modal.id.replace('pinModal_', '');
                closePinModal(id);
            });

            document.querySelectorAll('.attr-insp-modal-backdrop').forEach(function (modal) {
                if (modal.style.display === 'flex') {
                    modal.style.display = 'none';
                    document.body.style.overflow = '';
                }
            });
        });

        // ── Physical keyboard / pasted PIN input ───────────────────
        document.addEventListener('input', function (e) {
            if (!e.target || !e.target.id || !e.target.id.startsWith('pinHiddenInput_')) {
                return;
            }

            const id = e.target.id.replace('pinHiddenInput_', '');
            const value = e.target.value.replace(/\D/g, '').slice(0, PIN_LEN);

            e.target.value = value;
            pinValues[id] = value;

            const error = document.getElementById('pinError_' + id);
            const submit = document.getElementById('pinSubmitBtn_' + id);

            if (error) {
                error.classList.remove('show');
            }

            if (submit) {
                submit.disabled = value.length < PIN_LEN;
            }

            updatePinDots(id);
        });

        // ── Init everything once page loads ────────────────────────
        $(document).ready(function () {
            document.querySelectorAll('.cd-widget-body.open .cd-table').forEach(t => {
                if (t.id) {
                    initDataTable('#' + t.id);
                }
            });

            document.querySelectorAll('.cd-widget-toggle').forEach(toggle => {
                toggle.addEventListener('click', function () {
                    const bodyId = this.nextElementSibling?.id;

                    if (!bodyId) return;

                    setTimeout(() => {
                        const table = document.querySelector('#' + bodyId + ' .cd-table');

                        if (table && table.id) {
                            initDataTable('#' + table.id);
                        }
                    }, 100);
                });
            });

            openLinkedRollFromQueryString();
            initNotificationBell();
            initStatusExplanationModal();
        });

        // ── Re-open PIN modal if server returned PIN error ─────────
               // ── Re-open PIN modal if server returned PIN error ─────────
        const serverPinError = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(TempData["PinError"]?.ToString()));

        document.addEventListener('DOMContentLoaded', function () {
            if (!serverPinError) {
                return;
            }

            const firstPinModal = document.querySelector('.pin-backdrop[id^="pinModal_"]');

            if (!firstPinModal) {
                return;
            }

            const id = firstPinModal.id.replace('pinModal_', '');

            openPinModal(id);

            const error = document.getElementById('pinError_' + id);
            const errorMsg = document.getElementById('pinErrorMsg_' + id);

            if (errorMsg) {
                errorMsg.textContent = serverPinError;
            }

            if (error) {
                error.classList.add('show');
            }

            for (let i = 0; i < PIN_LEN; i++) {
                const dot = document.getElementById('dot_' + id + '_' + i);

                if (dot) {
                    dot.classList.add('error');
                }
            }

            setTimeout(function () {
                for (let i = 0; i < PIN_LEN; i++) {
                    const dot = document.getElementById('dot_' + id + '_' + i);

                    if (dot) {
                        dot.classList.remove('error');
                    }
                }
            }, 600);
        });
    </script>
}
