@model V2_Genesis.Models.ViewModels.Submissions.SubmissionViewModel
@{
    var returnUrl = ViewData["ReturnUrl"]?.ToString() ?? "/Dashboard";
}
<div class="submission-toolbar">
    <a href="@returnUrl" class="submission-back-link">
        <i class="fa-solid fa-arrow-left"></i>
        Back to dashboard
    </a>
    <div class="submission-toolbar-actions">
        <span class="submission-readonly-badge">
            <i class="fa-solid fa-lock"></i>
            Read-only submission
        </span>
        <button type="button" class="submission-print-button" onclick="window.print()">
            <i class="fa-solid fa-print"></i>
            Print submission
        </button>
    </div>
</div>
