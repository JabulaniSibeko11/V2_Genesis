            marketValueElements.forEach(function (element) {
                var marketValueText = element.textContent.trim();
                if (marketValueText && marketValueText !== 'null') {
                    var marketValue = parseFloat(marketValueText.replace(/[^0-9.-]+/g, ""));
                    if (!isNaN(marketValue)) {
                        var formattedValue = marketValue.toLocaleString('en-ZA', {
                            style: 'currency',
                            currency: 'ZAR',
                            minimumFractionDigits: 0,
                            maximumFractionDigits: 0
                        });
                        element.textContent = formattedValue;
                    }
                }
            });
        }

        // ========================= VALIDATE MARKET VALUES =========================
        function validateAllMarketValues() {
            var marketValueElements = document.querySelectorAll('.MarketValue');
            var allValid = true;
            var invalidCount = 0;

            marketValueElements.forEach(function (element, index) {
                var originalText = element.textContent.trim();
                var cleanValue = originalText.replace(/[^0-9.-]+/g, "");
                var marketValue = parseFloat(cleanValue);

                if (!cleanValue || cleanValue === '' || isNaN(marketValue)) {
                    return;
                }

                element.style.backgroundColor = '';

                if (marketValue < 0) {
                    invalidCount++;
                    element.style.backgroundColor = '#ffebee';
                    allValid = false;
                }
                else if (marketValue > 1000000000) {
                    invalidCount++;
                    element.style.backgroundColor = '#fff3e0';
                    allValid = false;
                }
            });

            if (!allValid) {
                showToaster('Validation Error ❌', `Found ${invalidCount} invalid market values. Please contact support.`, 6000);
                return false;
            } else {
                console.log(`✅ Validation Success: All ${marketValueElements.length} market values are valid!`);
                return true;
            }
        }

        // ========================= PRELOADER HANDLING =========================
        function done() {
            document.body.classList.add('loading');

            setTimeout(function() {
                const preloader = document.getElementById("preloader");
                if (preloader) {
                    preloader.classList.add('fade-out');
                    document.body.classList.remove('loading');

                    setTimeout(() => {
                        preloader.style.display = "none";
                        showToaster('Acknowledgement Ready ✅', 'Your objection has been successfully processed!', 5000);
                    }, 600);
                }
                formatValues();
                validateAllMarketValues();
            }, 1000);
        }

        // ========================= INITIALIZE ON PAGE LOAD =========================
        document.addEventListener('DOMContentLoaded', function () {
            formatValues();
            validateAllMarketValues();

            setTimeout(() => {
                showToaster('Welcome 👋', 'Review your objection details below', 4000);
            }, 1500);

            const style = document.createElement('style');
            style.textContent = `
                .table-row-active {
                    background: linear-gradient(90deg, #b8ecf1 0%, white 100%) !important;
                    transition: background 0.3s ease;
                }
                .action-button:active {
                    transform: scale(0.98);
                }
            `;
            document.head.appendChild(style);
        });

        // ========================= OTHER SCRIPTS =========================
        function toggleCompensationDetails(show) {
            document.getElementById('compensationDetails').style.display = show ? 'block' : 'none';
        }

        window.onload = function () {
            const yesChecked = document.querySelector('input[name="CompensationPaid"][value="Yes"]').checked;
            toggleCompensationDetails(yesChecked);
        };

        document.addEventListener("DOMContentLoaded", function () {
            const fenceInput = document.getElementById("fenceInput");
            const fenceTable = document.getElementById("fencetable");

            function toggleFenceTable() {
                if (fenceInput.value === "1") {
                    fenceTable.style.display = "block";
                } else {
                    fenceTable.style.display = "none";
                }
            }

            if (fenceInput) {
                fenceInput.addEventListener("input", toggleFenceTable);
                toggleFenceTable();
            }
        });

        function onlyNumberKey(evt) {
            var charCode = (evt.which) ? evt.which : evt.keyCode;
            if (charCode > 31 && (charCode < 48 || charCode > 57))
                return false;
            return true;
        }
    </script>

