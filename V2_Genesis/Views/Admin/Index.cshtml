                                                                    @{
                                                                        var viewFormUrl =
                                                                            "/admin/enquiry/form-view"
                                                                            + "?referenceNo=" + Uri.EscapeDataString(item.Objection_No ?? "")
                                                                            + "&rollSource=" + Uri.EscapeDataString(roll.Source ?? "")
                                                                            + "&propertyType=" + Uri.EscapeDataString(item.Property_Type ?? "")
                                                                            + "&appealStatus=False"
