                                                                    @if (item.EvidenceExpiresAt.HasValue)
                                                                    {
                                                                        <li>
                                                                            <span class="dropdown-item-text text-muted"
                                                                                  style="font-size:11px;">
                                                                                Closed:
                                                                                @item.EvidenceExpiresAt.Value.ToString(
                                                                                    "dd MMM yyyy HH:mm")
                                                                            </span>
                                                                        </li>
                                                                    }
                                                                }

                                                                @if (item.objection_Status == "App-Finalized")
