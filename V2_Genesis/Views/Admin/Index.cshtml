                                                                        <a class="dropdown-item cd-action-danger"
                                                                           href="/objection/withdraw?objectionNo=@appealReference&withdrawType=Appeal&rollSource=@roll.Source&returnUrl=/admin">
                                                                            <i class="fa-solid fa-ban"></i>
                                                                            <span>Withdraw Appeal</span>
                                                                        </a>
                                                                    </li>
                                                                }
                                                            </ul>
                                                        </div>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    }
                }
            </div>
