<!-- ── Per-roll sections ───────────────────────────────────────────── -->

@{
    var adminFamilies = Model.Rolls.Where(r => !r.IsQuery)
                                    .GroupBy(r => r.Main_Roll)
                                    .ToList();
    var adminQueryRolls = Model.Rolls.Where(r => r.IsQuery).ToList();

    var adminFamilyLookup = adminFamilies.Select(fam =>
    {
        var head = fam.FirstOrDefault(r => r.IsGv) ?? fam.First();
        var membersOrdered = fam.OrderBy(r => r.Source == head.Source ? 0 : 1)
                                 .ThenBy(r => r.Source)
                                 .Select(r => new { source = r.Source, name = r.Name, shortName = r.Short })
                                 .ToList();
        return new { headSource = head.Source, members = membersOrdered };
    }).ToList();
}

<!-- ── Admin dashboard: family tiles + persistent tab strip ───────────── -->
<div class="cd-body" id="cdTileBody">

    <p class="cd-intro-note">
        <i class="fa-solid fa-circle-info"></i>
        Select a card below to review linked properties, objections and appeals for that roll.
    </p>

    <div class="cd-tile-grid" id="cdTileGrid">
        @foreach (var fam in adminFamilies)
        {
            var head = fam.FirstOrDefault(r => r.IsGv) ?? fam.First();
            var members = fam.OrderBy(r => r.Source == head.Source ? 0 : 1).ThenBy(r => r.Source).ToList();
            var totalLinked = fam.Sum(r => Model.DataFor(r.Source).LinkedCount);
            var totalObjected = fam.Sum(r => Model.DataFor(r.Source).ObjectedCount);
            var totalAppeals = fam.Sum(r => Model.DataFor(r.Source).AppealsCount);
            var dates = Model.DatesFor(head.Source);
            var periodStatus = Model.GetPeriodStatus(head.Source);
            var membersJson = System.Text.Json.JsonSerializer.Serialize(
                members.Select(m => new { source = m.Source, name = m.Name, shortName = m.Short }));

            <div class="cd-tile cd-tile-family"
                 data-head-source="@head.Source"
                 data-members="@membersJson"
                 onclick="openAdminFamily(this)">

                @if (members.Count > 1)
                {
                    <span class="cd-tile-family-count">
                        <i class="fa-solid fa-layer-group"></i> @members.Count rolls
                    </span>
                }

                <div class="cd-tile-icon"><i class="fa-solid fa-landmark"></i></div>
                <h3 class="cd-tile-name">@head.Name</h3>

                @if (members.Count > 1)
                {
                    <span class="cd-tile-cta">
                        <i class="fa-solid fa-arrow-turn-down-right"></i>
                        Click to open @head.Short and all @(members.Count - 1) supplementary rolls
                    </span>
                }
                else
                {
                    <span class="cd-tile-short">@head.Short</span>
                }

                <div class="cd-tile-stats">
                    <span title="Linked"><i class="fa-solid fa-link"></i> @totalLinked</span>
                    <span title="Objections"><i class="fa-solid fa-file-pen"></i> @totalObjected</span>
                    @if (totalAppeals > 0)
                    {
                        <span title="Appeals"><i class="fa-solid fa-gavel"></i> @totalAppeals</span>
                    }
                </div>

                @if (dates is not null)
                {
                    <span class="cd-tile-badge cd-badge-@periodStatus">
                        @(periodStatus == "active" ? "Objection Open" :
                          periodStatus == "upcoming" ? "Opening Soon" :
                          "Objection Closed")
                    </span>
                }

                <span class="cd-tile-open-hint">
                    View Details <i class="fa-solid fa-arrow-right"></i>
                </span>
            </div>
        }

        @foreach (var roll in adminQueryRolls)
        {
            var rollKey = roll.Source.Replace("_", "");
            var rd = Model.DataFor(roll.Source);

            <div class="cd-tile cd-tile-query"
                 data-standalone-key="@rollKey"
                 data-roll-name="@roll.Name"
                 onclick="openAdminStandalone(this)">
                <div class="cd-tile-icon"><i class="fa-solid fa-magnifying-glass-chart"></i></div>
                <h3 class="cd-tile-name">@roll.Name</h3>
                <span class="cd-tile-short">@roll.Short</span>
                <div class="cd-tile-stats">
                    <span title="Linked"><i class="fa-solid fa-link"></i> @rd.LinkedCount</span>
                    <span title="Queries"><i class="fa-solid fa-file-magnifying-glass"></i> @rd.ObjectedCount</span>
                </div>
                <span class="cd-tile-badge cd-badge-open">OPEN</span>
                <span class="cd-tile-open-hint">View Details <i class="fa-solid fa-arrow-right"></i></span>
            </div>
        }

        <div class="cd-tile cd-tile-rebates" data-standalone-key="rebates" data-roll-name="Rebates" onclick="openAdminStandalone(this)">
            <div class="cd-tile-icon"><i class="fa-solid fa-percent"></i></div>
            <h3 class="cd-tile-name">Rebates</h3>
            <span class="cd-tile-short">Apply for or track rebate applications captured by you</span>
            <div class="cd-tile-stats">
                <span title="Applications"><i class="fa-solid fa-file-pen"></i> @(Model.Rebates?.Count ?? 0)</span>
            </div>
            <span class="cd-tile-badge cd-badge-open">OPEN</span>
            <span class="cd-tile-open-hint">View Details <i class="fa-solid fa-arrow-right"></i></span>
        </div>

        <div class="cd-tile cd-tile-attributes" data-standalone-key="attributes" data-roll-name="Property Attributes" onclick="openAdminStandalone(this)">
            <div class="cd-tile-icon"><i class="fa-solid fa-clipboard-list"></i></div>
            <h3 class="cd-tile-name">Property Attributes</h3>
            <span class="cd-tile-short">Submit or track property attributes captured by you</span>
            <div class="cd-tile-stats">
                <span title="Linked"><i class="fa-solid fa-link"></i> @Model.AttributesLinked.Count</span>
                <span title="Submissions"><i class="fa-solid fa-file-pen"></i> @Model.AttributesData.SubmissionCount</span>
            </div>
            <span class="cd-tile-badge cd-badge-open">NEW</span>
            <span class="cd-tile-open-hint">View Details <i class="fa-solid fa-arrow-right"></i></span>
        </div>

        <a class="cd-tile cd-tile-enquiries"
           asp-controller="Admin"
           asp-action="Search"
           style="text-decoration:none;color:inherit;">
            <div class="cd-tile-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
            <h3 class="cd-tile-name">Search Enquiries</h3>
            <span class="cd-tile-short">Find a property, objection, appeal, query or review</span>
            <div class="cd-tile-stats">
                <span><i class="fa-solid fa-file-lines"></i> All Rolls</span>
            </div>
            <span class="cd-tile-badge cd-badge-open">SEARCH</span>
            <span class="cd-tile-open-hint">Open Search <i class="fa-solid fa-arrow-right"></i></span>
        </a>
    </div>
</div>

