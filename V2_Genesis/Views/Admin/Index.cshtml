        </div>
    </div>
}

<!-- ══════════════════════════════════════════════════════════════
     ADMIN COMMAND BAR
     Deliberately distinct from Views/Dashboard/Index.cshtml (the
     client dashboard) — this is an internal tool, not a client-facing
     welcome screen. No lodgement-window countdown here on purpose:
     admin access to a roll is never gated by whether the public
     objection window is open or closed.
════════════════════════════════════════════════════════════════ -->
<div class="adm-command-bar">
    <div class="adm-command-bar-inner">
        <span class="adm-mode-tag">
            <i class="fa-solid fa-shield-halved"></i> Admin Mode
        </span>

        <div class="adm-command-identity">
            @if (!string.IsNullOrWhiteSpace(_adminFullName))
            {
                <strong>@_adminFullName</strong>
            }
            @if (!string.IsNullOrWhiteSpace(_adminPosition))
            {
                <span class="adm-command-role">@_adminPosition</span>
            }
            @if (!string.IsNullOrWhiteSpace(_sapNumeric))
            {
                <span class="adm-command-sap">SAP @_sapNumeric</span>
            }
            <span class="adm-command-email">@Model.AdminEmail</span>
        </div>

        <div class="adm-command-actions">
            <a href="/admin/search" class="adm-command-btn adm-command-btn--gold">
                <i class="fa-solid fa-magnifying-glass"></i> Search Enquiry
            </a>
            <a href="/admin/audit" class="adm-command-btn">
                <i class="fa-solid fa-clock-rotate-left"></i> Audit Trail
            </a>
            <a href="/admin/notices" class="adm-command-btn">
                <i class="fa-solid fa-bell"></i> Client Notices
            </a>
        </div>
    </div>
</div>

<!-- ── Console heading ──────────────────────────────────────────────── -->
@{
    var totalObj = Model.Rolls.Where(r => !r.IsQuery).Sum(r => Model.DataFor(r.Source).ObjectedCount);
    var totalApp = Model.Rolls.Where(r => !r.IsQuery).Sum(r => Model.DataFor(r.Source).AppealsCount);
    var totalQry = Model.Rolls.Where(r => r.IsQuery).Sum(r => Model.DataFor(r.Source).ObjectedCount);
    var rollCount = Model.Rolls.Count();
}
<div class="adm-console-hero">
    <div class="adm-console-hero-inner">
        <div class="adm-console-hero-icon">
            <i class="fa-solid fa-building-shield"></i>
        </div>
        <div>
            <h1 class="adm-console-title">Objections, Appeals &amp; Queries Workspace</h1>
            <p class="adm-console-sub">
                <strong>@totalObj</strong> objections &middot;
                <strong>@totalApp</strong> appeals &middot;
                <strong>@totalQry</strong> queries
                across @rollCount rolls
            </p>
        </div>
    </div>
</div>

<!-- ── Quick stats row ────────────────────────────────────────────── -->
<div class="adm-kpi-strip">
    @foreach (var roll in Model.Rolls.Where(r => !r.IsQuery))
    {
        var rd = Model.DataFor(roll.Source);
        <div class="adm-kpi">
            <div class="adm-kpi-label">@roll.Short</div>
            <div class="adm-kpi-value">@rd.LinkedCount</div>
            <div class="adm-kpi-sub">
                @if (roll.HasObjection)
                {
                    <i class="fa-solid fa-file-pen"></i>
                    <span>@rd.ObjectedCount obj</span>
                }
                @if (roll.HasAppeal)
                {
                    <span style="margin-left:4px;">·</span>
                    <i class="fa-solid fa-gavel"></i>
                    <span>@rd.AppealsCount app</span>
                }
            </div>
            <div class="adm-kpi-accent"></div>
        </div>
    }
    @foreach (var roll in Model.Rolls.Where(r => r.IsQuery))
    {
        var rd = Model.DataFor(roll.Source);
        <div class="adm-kpi">
            <div class="adm-kpi-label">
                <i class="fa-solid fa-magnifying-glass-chart" style="margin-right:4px;"></i>
                @roll.Short
            </div>
            <div class="adm-kpi-value">@rd.LinkedCount</div>
            <div class="adm-kpi-sub">
                <i class="fa-solid fa-file-magnifying-glass"></i>
                <span>@rd.ObjectedCount queries</span>
            </div>
            <div class="adm-kpi-accent"></div>
        </div>
    }
</div>

