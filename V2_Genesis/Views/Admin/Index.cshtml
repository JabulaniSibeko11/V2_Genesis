@functions {
      string FormatZAR(string? val)
    {
        if (string.IsNullOrWhiteSpace(val))
            return "–";

        // Remove currency symbols and spaces only
        var clean = val.Replace("R", "")
                       .Replace(",", "")
                       .Trim();

        if (!decimal.TryParse(clean,
            System.Globalization.NumberStyles.Any,
            System.Globalization.CultureInfo.InvariantCulture,
            out var num) || num <= 0)
        {
            return "–";
        }

        return "R " + num.ToString("N0",
            new System.Globalization.CultureInfo("en-ZA"));


      
    }

    string GetAttrStatusPill(string? status) => status switch
    {
        "Pending" => "<span class='cd-pill cd-pill-pending'>Pending</span>",
        "Under Review" => "<span class='cd-pill cd-pill-inprogress'>Under Review</span>",
        "Approved" => "<span class='cd-pill cd-pill-completed'>Approved</span>",
        "Rejected" => "<span class='cd-pill cd-pill-lodging'>Rejected</span>",
        _ => $"<span class='cd-pill cd-pill-pending'>{status}</span>"
    };

    string GetApptStatusPill(string? status) => status switch
    {
        "Scheduled" => "<span class='cd-pill cd-pill-inprogress'>Scheduled</span>",
        "Completed" => "<span class='cd-pill cd-pill-completed'>Completed</span>",
        "Cancelled" => "<span class='cd-pill cd-pill-lodging'>Cancelled</span>",
        _ => $"<span class='cd-pill cd-pill-pending'>{status}</span>"
    };

    string GetRebateStatusPill(string? status) => status switch
    {
        "Acknowledge" => "<span class='cd-pill cd-pill-lodging'>Acknowledged</span>",
        "Auto Reject" => "<span class='cd-pill cd-pill-rejected'>Auto Rejected</span>",
        "Under Review" => "<span class='cd-pill cd-pill-inprogress'>Under Review</span>",
        "Approved" => "<span class='cd-pill cd-pill-completed'>Approved</span>",
        "Rejected" => "<span class='cd-pill cd-pill-rejected'>Rejected</span>",
        _ => $"<span class='cd-pill cd-pill-pending'>{status ?? "Pending"}</span>"
    };

    string GetStatusPill(string? status)
    {
        var normalisedStatus = string.IsNullOrWhiteSpace(status)
            ? "Pending"
            : status.Trim();

        return normalisedStatus switch
        {
            "Obj-Unallocated" or "Obj-Section51"
                => "<span class='cd-pill cd-pill-pending'>Obj-Pending</span>",
            "Obj-Inprogress" or "Obj-Pending-Approval"
                => "<span class='cd-pill cd-pill-inprogress'>Obj-InProgress</span>",
            "Obj-Lodging"
                => "<span class='cd-pill cd-pill-lodging'>Obj-Lodging</span>",
            "App-Unallocated" or "App-Lodging"
                => $"<span class='cd-pill cd-pill-pending'>{normalisedStatus}</span>",
            "App-Finalized" or "App-Finalised"
                => "<span class='cd-pill cd-pill-completed'>App-Finalized</span>",
            _ => $"<span class='cd-pill cd-pill-completed'>{normalisedStatus}</span>"
        };
    }

    bool IsLisPropertySource(string? propertyFrom) =>
        string.Equals(propertyFrom?.Trim(), "LIS", StringComparison.OrdinalIgnoreCase);

    bool IsOmissionPropertySource(string? propertyFrom)
    {
        var value = propertyFrom?.Trim() ?? string.Empty;
        return value.Equals("Omission", StringComparison.OrdinalIgnoreCase) ||
               value.Equals("Omitted", StringComparison.OrdinalIgnoreCase) ||
               value.StartsWith("Omission_", StringComparison.OrdinalIgnoreCase) ||
               value.StartsWith("Omitted_", StringComparison.OrdinalIgnoreCase);
    }

    string GetPropertySourceLabel(string? propertyFrom, string currentRollName)
    {
        var value = propertyFrom?.Trim() ?? string.Empty;
        var normalised = value.Replace("-", "_").ToUpperInvariant();

        if (IsLisPropertySource(value))
            return "LIS";

        if (IsOmissionPropertySource(value))
            return $"Omitted from {currentRollName}";

        if (normalised.Contains("SUP1")) return "Supplementary Valuation Roll 1";
        if (normalised.Contains("SUP2")) return "Supplementary Valuation Roll 2";
        if (normalised.Contains("SUP3")) return "Supplementary Valuation Roll 3";
        if (normalised.Contains("SUP4")) return "Supplementary Valuation Roll 4";

        if (normalised is "GV23" or "OBJECTION" or "VALUATION_ROLL")
            return "Valuation Roll";

        return string.IsNullOrWhiteSpace(value) ? currentRollName : value;
    }
}
