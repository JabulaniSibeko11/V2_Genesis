}

@if (TempData["LodgementWindowError"] != null)
{
    <div class="modal fade"
         id="appealBlockedModal"
         tabindex="-1"
         aria-labelledby="appealBlockedModalLabel"
         aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content"
                 style="border-radius:16px; overflow:hidden; border:none;">

                <div class="modal-header"
                     style="background:#173b43; color:#fff; border-bottom:3px solid #e6b000;">
                    <h5 class="modal-title"
                        id="appealBlockedModalLabel">
                        Appeal Cannot Be Lodged Online
                    </h5>

                    <button type="button"
                            class="btn-close btn-close-white"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

