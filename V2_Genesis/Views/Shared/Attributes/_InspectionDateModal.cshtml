@model V2_Genesis.Models.ViewModels.Attributes.InspectionDateModalVm

@{
    var availableSlots = Model.Slots
        .OrderBy(x => x.ProposedDateTime)
        .ToList();

    var dayGroups = availableSlots
        .GroupBy(x => x.ProposedDateTime.Date)
        .OrderBy(x => x.Key)
        .ToList();

    var modalId = $"inspectionModal_{Model.InstanceKey}";
    var formId = $"inspectionCalendarModalForm_{Model.InstanceKey}";
    var selectedSlotId = $"selectedInspectionSlot_{Model.InstanceKey}";
    var selectedLabelId = $"selectedInspectionLabel_{Model.InstanceKey}";
    var confirmButtonId = $"confirmInspectionModal_{Model.InstanceKey}";
}
<link href="~/css/views/calendar-modal.css" rel="stylesheet" asp-append-version="true"/>
<div id="@modalId"
     class="attr-insp-modal-backdrop"
     data-instance-key="@Model.InstanceKey"
     style="display:@(Model.AutoOpen ? "flex" : "none");">

    <div class="attr-insp-modal attr-insp-calendar-modal"
         role="dialog"
         aria-modal="true"
         aria-labelledby="inspectionModalTitle_@Model.InstanceKey">

        <div class="attr-insp-modal-head">
            <div id="inspectionModalTitle_@Model.InstanceKey">
                Choose Inspection Date &amp; Time
            </div>

            <button type="button"
                    aria-label="Close inspection calendar"
                    onclick="closeInspectionResponseModal('@Model.InstanceKey')">
                ×
            </button>
        </div>

        <form action="@Model.FormAction"
              method="post"
              autocomplete="off"
              id="@formId"
              onsubmit="return submitInspectionCalendarModal(this);">

            @Html.AntiForgeryToken()

            @if (Model.InspectionRequestId.HasValue)
            {
                <input type="hidden"
                       name="InspectionRequestId"
                       value="@Model.InspectionRequestId.Value" />
            }

            <input type="hidden"
                   name="@Model.SlotFieldName"
                   id="@selectedSlotId"
                   class="js-selected-inspection-slot" />

            <div class="attr-insp-modal-body">
                <p>
                    Select a suitable available inspection date and time.
                    The system will verify the appointment again before confirmation.
                </p>

                @if (!string.IsNullOrWhiteSpace(Model.RequestComment))
                {
                    <div class="alert alert-info">
                        @Model.RequestComment
                    </div>
                }

                @if (availableSlots.Any())
                {
                    <div class="attr-cal-mobile-list">
                        @foreach (var dayGroup in dayGroups)
                        {
                            <section class="attr-cal-day-card">
                                <h4>
                                    @dayGroup.Key.ToString("dddd, dd MMMM yyyy")
                                </h4>

                                <div class="attr-cal-time-grid">
                                    @foreach (var slot in dayGroup)
                                    {
                                        <button type="button"
                                                class="attr-cal-time"
                                                data-slot-id="@slot.Id"
                                                data-label="@slot.ProposedDateTime.ToString("dddd, dd MMMM yyyy 'at' HH:mm")"
                                                onclick="selectInspectionCalendarSlot(this)">
                                            @slot.ProposedDateTime.ToString("HH:mm")
                                        </button>
                                    }
                                </div>
                            </section>
                        }
                    </div>

                    <div class="attr-cal-selected js-selected-inspection-label"
                         id="@selectedLabelId"
                         style="display:none;">
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">
                        No inspection appointments are currently available.
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(Model.CommentFieldName))
                {
                    <label class="fw-bold">Comment</label>
                    <textarea name="@Model.CommentFieldName"
                              class="form-control"
                              maxlength="500"
                              placeholder="Optional comment..."></textarea>
                }
            </div>

            <div class="attr-insp-modal-footer">
                <button type="button"
                        class="btn btn-light"
                        onclick="closeInspectionResponseModal('@Model.InstanceKey')">
                    Cancel
                </button>

                <button type="submit"
                        class="btn btn-warning fw-bold js-confirm-inspection"
                        id="@confirmButtonId"
                        disabled>
                    Confirm Appointment
                </button>
            </div>
        </form>
    </div>
</div>



<script>
    function selectInspectionCalendarSlot(button) {
        const modal = button.closest('.attr-insp-modal-backdrop');

        if (!modal) {
            return;
        }

        modal.querySelectorAll('.attr-cal-time.selected')
            .forEach(x => x.classList.remove('selected'));

        button.classList.add('selected');

        const hidden = modal.querySelector('.js-selected-inspection-slot');
        const label = modal.querySelector('.js-selected-inspection-label');
        const confirmButton = modal.querySelector('.js-confirm-inspection');

        if (hidden) {
            hidden.value = button.dataset.slotId || '';
        }

        if (label) {
            label.textContent =
                'Selected: ' + (button.dataset.label || '');
            label.style.display = 'block';
        }

        if (confirmButton) {
            confirmButton.disabled = false;
        }
    }

    function submitInspectionCalendarModal(form) {
        const hidden = form.querySelector('.js-selected-inspection-slot');
        const confirmButton = form.querySelector('.js-confirm-inspection');

        if (!hidden || !hidden.value) {
            alert('Please select an inspection date and time.');
            return false;
        }

        if (confirmButton) {
            confirmButton.disabled = true;
            confirmButton.textContent = 'Confirming...';
        }

        return true;
    }
</script>
