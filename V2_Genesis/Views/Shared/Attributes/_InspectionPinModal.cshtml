@model V2_Genesis.Models.ViewModels.Attributes.InspectionPinModalVm

@*
    Inspection PIN modal (secure inspection link + dashboard).
    Four PIN boxes - the phone shows its own number keyboard; there is no
    on-screen keypad. On a phone the modal opens as a bottom sheet.
    Behaviour: ~/js/inspection-pin.js   Styles: ~/css/Views/inspection-pin.css
    The posted field (Model.PinFieldName) is the hidden input #pinHiddenInput_{key}.
*@
@{
    var key = Model.InstanceKey;
    var modalId = $"pinModal_{key}";
    var inputId = $"pinHiddenInput_{key}";
    var submitId = $"pinSubmitBtn_{key}";
    var errorId = $"pinError_{key}";
    var errorMsgId = $"pinErrorMsg_{key}";
    var titleId = $"pinContextTitle_{key}";
    var formId = $"pinForm_{key}";
    var hasError = !string.IsNullOrWhiteSpace(Model.ErrorMessage);
}

<link href="~/css/Views/inspection-pin.css" rel="stylesheet" asp-append-version="true" />

<div class="pin-backdrop ipin-backdrop @(Model.AutoOpen ? "open" : "")"
     id="@modalId"
     data-pin-instance="@key"
     aria-hidden="@(Model.AutoOpen ? "false" : "true")"
     style="display:@(Model.AutoOpen ? "flex" : "none");">

    <div class="ipin" role="dialog" aria-modal="true" aria-labelledby="@titleId">

        <div class="ipin-grab" aria-hidden="true"></div>

        <button type="button"
                class="ipin-close"
                onclick="GsPin.close('@key')"
                aria-label="Close">
            <i class="fa-solid fa-xmark"></i>
        </button>

        <div class="ipin-icon" aria-hidden="true">
            <i class="fa-solid fa-user-shield"></i>
        </div>

        <h2 class="ipin-title" id="@titleId">Enter your inspection PIN</h2>

        <p class="ipin-sub">
            Type the <strong>4-digit PIN</strong> from the City e-mail to see the
            authorised valuer for <strong>@Model.AppointmentRef</strong>.
        </p>

        @if (Model.ConfirmedDateTime.HasValue)
        {
            <div class="ipin-date">
                <i class="fa-solid fa-calendar-check" aria-hidden="true"></i>
                <span>
                    Inspection
                    <strong>@Model.ConfirmedDateTime.Value.ToString("dddd, dd MMMM yyyy 'at' HH:mm")</strong>
                </span>
            </div>
        }

        <form action="@Model.FormAction"
              method="post"
              autocomplete="off"
              id="@formId"
              novalidate
              onsubmit="return GsPin.submit('@key', this);">

            @Html.AntiForgeryToken()

            @if (Model.InspectionRequestId.HasValue)
            {
                <input type="hidden"
                       name="InspectionRequestId"
                       value="@Model.InspectionRequestId.Value" />
            }

            <input type="hidden" id="@inputId" name="@Model.PinFieldName" value="" />

            <div class="ipin-boxes" data-pin-boxes="@key" role="group" aria-label="4-digit inspection PIN">
                @for (var i = 0; i < 4; i++)
                {
                    <input type="password"
                           class="ipin-box"
                           inputmode="numeric"
                           pattern="[0-9]*"
                           maxlength="1"
                           autocomplete="@(i == 0 ? "one-time-code" : "off")"
                           aria-label="PIN digit @(i + 1) of 4"
                           data-index="@i" />
                }
            </div>

            <div class="ipin-error @(hasError ? "show" : "")" id="@errorId" role="alert">
                <i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i>
                <span id="@errorMsgId">
                    @(hasError ? Model.ErrorMessage : "Incorrect PIN. Please try again.")
                </span>
            </div>

            <button type="submit" class="ipin-submit" id="@submitId" disabled>
                <i class="fa-solid fa-unlock-keyhole" aria-hidden="true"></i>
                Unlock valuer details
            </button>

            <p class="ipin-foot">
                <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                This PIN works only for this inspection. After 5 incorrect attempts it is locked.
            </p>
        </form>
    </div>
</div>

<script src="~/js/inspection-pin.js" asp-append-version="true"></script>
