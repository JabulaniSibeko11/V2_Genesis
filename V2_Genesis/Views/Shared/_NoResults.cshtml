@* ═══════════════════════════════════════════════════════════════
   Views/Shared/_NoResults.cshtml  — FIXED
   Fix 1: Field names match PropertySearchParams (TownName, Stand…)
   Fix 2: Re-execute scripts after LIS results injection
═══════════════════════════════════════════════════════════════ *@
@model V2_Genesis.Models.GvList
@{
    var originalSearch = ViewBag.Params as V2_Genesis.Models.PropertySearchParams;
    var searchMessage = ViewBag.SearchMessage as string;
}
<link href="~/css/views/lis-noresult.css" rel="stylesheet" asp-append-version="true" />
<div class="ps-card ps-no-results-card" id="rollNoResults">
    <div class="ps-no-results-body">

        <div class="ps-no-results-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
        </div>

        @if (!string.IsNullOrWhiteSpace(searchMessage))
        {
            <h3>More Search Information Required</h3>
            <p>@searchMessage</p>
        }
        else
        {
            <h3>No Properties Found on Roll</h3>
            <p>
                No properties matched your search on
                <strong>@Model?.Name</strong>.
                We can search the Land Information System (LIS)
                using the same values — no need to type them again.
            </p>
        }

        <div class="ps-no-results-tips">
            <p><strong>Before searching LIS, also try:</strong></p>
            <ul>
                <li>Removing some search filters</li>
                <li>Checking the spelling of your address or scheme name</li>
                <li>Searching by Township only</li>
            </ul>
        </div>

        <button type="button"
                id="searchLisBtn"
                class="ps-btn-lis"
                data-roll="@Model?.Source"
                data-town="@originalSearch?.TownName"
                data-stand="@originalSearch?.Stand"
                data-address="@originalSearch?.Address"
                data-scheme="@originalSearch?.Scheme"
                data-unit="@originalSearch?.Unit"
                onclick="triggerLisSearch(this)">
            <i class="fa-solid fa-database"></i>
            Search on LIS
        </button>

        <div id="lisSearching" class="lis-searching" style="display:none;">
            <i class="fa-solid fa-spinner fa-spin"></i>
            Searching Land Information System…
        </div>

    </div>
</div>

<div id="lisResultsContainer"></div>

<script>
    function triggerLisSearch(btn) {
        var rollSource = btn.getAttribute('data-roll');

        // ── FIX 1: Match actual form field names from PropertySearchParams ──
        function getVal(name) {
            var el = document.querySelector(
                'input[name="' + name + '"], select[name="' + name + '"]');
            return el ? el.value.trim() : '';
        }

        // Prefer the server-bound values from the original roll search. The DOM
        // lookup remains only as a compatibility fallback for older callers.
        function getPreservedValue(dataName, formName) {
            var preserved = btn.getAttribute('data-' + dataName);
            return preserved !== null ? preserved.trim() : getVal(formName);
        }

        var params = new URLSearchParams({
            SearchTownName : getPreservedValue('town', 'TownName'),
            SearchStand    : getPreservedValue('stand', 'Stand'),
            SearchAddress  : getPreservedValue('address', 'Address'),
            SearchScheme   : getPreservedValue('scheme', 'Scheme'),
            SearchUnit     : getPreservedValue('unit', 'Unit'),
            SearchOwner    : getVal('Owner'),       // form field = Owner (if present)
        });

        btn.style.display = 'none';
        document.getElementById('lisSearching').style.display = 'flex';

        var token = document.querySelector(
            'input[name="__RequestVerificationToken"]')?.value ?? '';

        fetch('/search/' + rollSource + '/lis', {
            method : 'POST',
            headers: {
                'Content-Type'             : 'application/x-www-form-urlencoded',
                'RequestVerificationToken' : token,
                'X-Requested-With'         : 'XMLHttpRequest'
            },
            body: params.toString()
        })
        .then(function(r) { return r.text(); })
        .then(function(html) {
            document.getElementById('lisSearching').style.display = 'none';
            document.getElementById('rollNoResults').style.display = 'none';

            var container = document.getElementById('lisResultsContainer');
            container.innerHTML = html;

            // ── FIX 2: Re-execute scripts in the injected LIS partial ──────
            // Without this, openOmissionModal / closeOmissionModal are undefined
            container.querySelectorAll('script').forEach(function(oldScript) {
                var newScript = document.createElement('script');
                newScript.textContent = oldScript.textContent;
                document.body.appendChild(newScript);
                document.body.removeChild(newScript);
            });

            container.scrollIntoView({ behavior: 'smooth', block: 'start' });
        })
        .catch(function(err) {
            document.getElementById('lisSearching').style.display = 'none';
            btn.style.display = 'inline-flex';
            document.getElementById('lisResultsContainer').innerHTML =
                '<div class="lis-fetch-error">' +
                '<i class="fa-solid fa-circle-xmark"></i> ' +
                'LIS search failed. Please try again.</div>';
            console.error('[LIS]', err);
        });
    }
</script>
