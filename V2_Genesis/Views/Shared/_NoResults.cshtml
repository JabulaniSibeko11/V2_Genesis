@* ═══════════════════════════════════════════════════════════════
   Views/Shared/_NoResults.cshtml
   When Roll search returns 0 results → auto-trigger LIS search
   No manual click needed
═══════════════════════════════════════════════════════════════ *@
@model V2_Genesis.Models.GvList
<link href="~/css/views/lis-noresult.css" rel="stylesheet" asp-append-version="true" />

<div class="ps-card ps-no-results-card" id="rollNoResults">
    <div class="ps-no-results-body">
        <div class="ps-no-results-icon">
            <i class="fa-solid fa-magnifying-glass"></i>
        </div>
        <h3>No Properties Found on Roll</h3>
        <p>
            No properties matched your search on
            <strong>@Model?.Name</strong>.
            Searching the Land Information System automatically…
        </p>

       
        <div id="lisSearching" class="lis-searching">
            <i class="fa-solid fa-spinner fa-spin"></i>
            Searching Land Information System…
        </div>

     
        <button type="button"
                id="searchLisBtn"
                class="ps-btn-lis"
                data-roll="@Model?.Source"
                style="display:none;"
                onclick="triggerLisSearch(this)">
            <i class="fa-solid fa-database"></i>
            Retry LIS Search
        </button>
    </div>
</div>

@* LIS results injected here *@
<div id="lisResultsContainer"></div>

<script>
    // ── Auto-trigger as soon as this partial renders ───────────────────
    (function autoLis() {
        var btn = document.getElementById('searchLisBtn');
        if (!btn) return;

        var rollSource = btn.getAttribute('data-roll');

        function getVal(name) {
            var el = document.querySelector(
                'input[name="' + name + '"], select[name="' + name + '"]');
            return el ? el.value.trim() : '';
        }

        var params = new URLSearchParams({
            SearchTownName : getVal('SearchTownName'),
            SearchStand    : getVal('SearchStand'),
            SearchAddress  : getVal('SearchAddress'),
            SearchScheme   : getVal('SearchScheme'),
            SearchUnit     : getVal('SearchUnit'),
            SearchOwner    : getVal('SearchOwner'),
        });

        var token = document.querySelector(
            'input[name="__RequestVerificationToken"]')?.value ?? '';

        fetch('/search/' + rollSource + '/lis', {
            method : 'POST',
            headers: {
                'Content-Type'             : 'application/x-www-form-urlencoded',
                'RequestVerificationToken' : token,
                'X-Requested-With'         : 'XMLHttpRequest'
            },
            body: params.toString()
        })
        .then(function(res) { return res.text(); })
        .then(function(html) {
            document.getElementById('lisSearching').style.display = 'none';
            document.getElementById('rollNoResults').style.display = 'none';
            document.getElementById('lisResultsContainer').innerHTML = html;
            document.getElementById('lisResultsContainer')
                .scrollIntoView({ behavior: 'smooth', block: 'start' });
        })
        .catch(function(err) {
            document.getElementById('lisSearching').style.display = 'none';
            btn.style.display = 'inline-flex';   // show retry button
            console.error('[AutoLIS]', err);
        });
    })();

    // ── triggerLisSearch still needed for the retry button ────────────
    function triggerLisSearch(btn) {
        btn.style.display = 'none';
        document.getElementById('lisSearching').style.display = 'flex';

        var rollSource = btn.getAttribute('data-roll');
        function getVal(name) {
            var el = document.querySelector(
                'input[name="' + name + '"], select[name="' + name + '"]');
            return el ? el.value.trim() : '';
        }
        var params = new URLSearchParams({
            SearchTownName : getVal('SearchTownName'),
            SearchStand    : getVal('SearchStand'),
            SearchAddress  : getVal('SearchAddress'),
            SearchScheme   : getVal('SearchScheme'),
            SearchUnit     : getVal('SearchUnit'),
            SearchOwner    : getVal('SearchOwner'),
        });
        var token = document.querySelector(
            'input[name="__RequestVerificationToken"]')?.value ?? '';

        fetch('/search/' + rollSource + '/lis', {
            method : 'POST',
            headers: {
                'Content-Type'             : 'application/x-www-form-urlencoded',
                'RequestVerificationToken' : token,
                'X-Requested-With'         : 'XMLHttpRequest'
            },
            body: params.toString()
        })
        .then(function(res) { return res.text(); })
        .then(function(html) {
            document.getElementById('lisSearching').style.display = 'none';
            document.getElementById('lisResultsContainer').innerHTML = html;
            document.getElementById('lisResultsContainer')
                .scrollIntoView({ behavior: 'smooth', block: 'start' });
        })
        .catch(function(err) {
            document.getElementById('lisSearching').style.display = 'none';
            btn.style.display = 'inline-flex';
            document.getElementById('lisResultsContainer').innerHTML =
                '<div class="lis-fetch-error">' +
                '<i class="fa-solid fa-circle-xmark"></i> ' +
                'LIS search failed. Please try again.</div>';
        });
    }
</script>


