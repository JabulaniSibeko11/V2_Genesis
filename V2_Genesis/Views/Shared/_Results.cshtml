@model List<V2_Genesis.Models.PropertySearchResult>
@{
    var roll       = ViewBag.Roll as V2_Genesis.Models.GvList;
    var isLis      = ViewBag.IsLisSearch as bool? ?? false;
    var propFrom   = isLis ? "LIS" : (roll?.Source ?? "");

    string[] headers = {
        "TOWNSHIP", "ADDRESS", "ERF", "PTN", "RE",
        "CATEGORY", "EXTENT", "MARKET VALUE",
        "SCHEME NAME", "SCHEME NO.", "SCHEME YEAR",
        "LEASE (Y/N)", "UNIT NO.", "REMARKS"
    };


}


@if (isLis)
{
    <!-- LIS results banner -->
    <div class="lis-results-banner">
        <i class="fa-solid fa-database"></i>
        Results from the <strong>Land Information System (LIS)</strong>
        — @Model.Count propert@(Model.Count == 1 ? "y" : "ies") found
    </div>
}

<table id="psResultsTable" class="display table ps-table">
    <thead>
        <tr>
            @foreach (var h in headers)
            {
                <th>@h</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @* LIS search: pass PropertyFrom=LIS so CheckProperty
                       knows this came from the Land Information System   *@

                     @{
                    // var viewUrl = $"/property/view?rollSource={roll?.Source?.Trim()}" +
                    //               $"&unitKey={item.UnitKey}" +
                    //               $"&valuationKey={item.ValuationKey}" +
                    //               $"&propertyFrom={propFrom?.Trim()}";

                   
    var rollSource = roll?.Source?.Trim() ?? "";
    var propertyFrom = propFrom?.Trim() ?? "";

    var viewUrl = Url.Action("ViewProperty", "PropertySearch", new
    {
        rollSource = rollSource,
        unitKey = item.UnitKey,
        valuationKey = item.ValuationKey,
        propertyFrom = propertyFrom
    });
}
                        

                    <a  class="ps-town-link" href="@viewUrl">
                  
                     
                        @item.TownNameDesc
                    </a>
                </td>
                <td>@(item.LisStreetAddress ?? "–")</td>
                <td>@item.Erf</td>
                <td>@item.Ptn</td>
                <td>@(item.Re ?? "–")</td>
                <td>@(item.CatDesc ?? "–")</td>
                <td>@(item.RateableArea ?? "–")</td>
                <td class="ps-market-val">@item.MarketValue</td>
                <td>@(item.SchemeName ?? "–")</td>
                <td>@(item.SchemeNumber ?? "–")</td>
                <td>@(item.SchemeYear ?? "–")</td>
                <td>@(item.Lease ?? "–")</td>
                <td>@(item.UnitNo > 0 ? item.UnitNo.ToString() : "–")</td>
                <td>@(item.Reason ?? "–")</td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        if (!$.fn.DataTable.isDataTable('#psResultsTable')) {
            $('#psResultsTable').DataTable({
                responsive : {
                    details: {
                        type: 'column',
                        target: 'tr'
                    }
                },
                autoWidth  : false,
                destroy    : true,
                dom        : '<"ps-dt-top"lBf>rt<"ps-dt-bottom"ip>',
                lengthMenu : [[10, 25, 50, -1], [10, 25, 50, 'All']],
                pageLength : 10,
                buttons: [
                    {
                        extend   : 'excel',
                        text     : '<i class="fa-solid fa-file-excel"></i> Excel',
                        className: 'ps-dt-btn'
                    },
                    {
                        extend   : 'pdf',
                        text     : '<i class="fa-solid fa-file-pdf"></i> PDF',
                        className: 'ps-dt-btn'
                    }
                ],
                language: {
                    search           : '_INPUT_',
                    searchPlaceholder: 'Search results…',
                    lengthMenu       : 'Show _MENU_ entries',
                    info             : 'Showing _START_ to _END_ of _TOTAL_',
                    infoEmpty        : 'No properties found',
                    infoFiltered     : '(filtered from _MAX_ total)',
                    emptyTable       : 'No properties found'
                },
                columnDefs: [
                    { width: '160px', targets: 0  },
                    { width: '190px', targets: 1  },
                    { width: '65px',  targets: [2, 3, 4] },
                    { width: '120px', targets: 5  },
                    // Property description and the action button always
                    // stay visible on a phone — everything else collapses
                    // behind the "+" control instead of forcing a
                    // horizontal scroll to reach the button.
                    { className: 'all', targets: [0, 13] },
                    { orderable: false, targets: 13 }
                ],
                drawCallback : function () { formatMarketValues(); },
                initComplete : function () {
                    formatMarketValues();
                    var count = this.api().rows().count();
                    var badge = document.getElementById('psmCount');
                    if (badge)
                        badge.textContent =
                            count + ' ' + (count === 1 ? 'property' : 'properties');
                    showSearchToaster(
                        '@(isLis ? "LIS Search Complete 🗄️" : "Search Complete 🎉")',
                        'Found ' + count + ' matching ' +
                        (count === 1 ? 'property' : 'properties'),
                        4000
                    );
                }
            });
        }
    });

    function formatMarketValues() {
        document.querySelectorAll('.ps-market-val').forEach(function (el) {
            var raw = parseFloat(el.textContent.replace(/[^0-9.-]+/g, ''));
            if (!isNaN(raw) && raw > 0) {
                el.textContent = raw.toLocaleString('en-ZA', {
                    style: 'currency', currency: 'ZAR',
                    minimumFractionDigits: 0, maximumFractionDigits: 0
                });
            }
        });
    }

    function showSearchToaster(title, message, duration) {
        var c = document.querySelector('.toaster-container');
        if (!c) {
            c = document.createElement('div');
            c.className = 'toaster-container';
            document.body.appendChild(c);
        }
        var t = document.createElement('div');
        t.className = 'toaster';
        t.innerHTML =
            '<div class="toaster-icon">🎉</div>' +
            '<div class="toaster-content">' +
                '<div class="toaster-title">' + title + '</div>' +
                '<div class="toaster-message">' + message + '</div>' +
            '</div>' +
            '<button class="toaster-close" ' +
            'onclick="this.closest(\'.toaster\').remove()">×</button>';
        c.appendChild(t);
        setTimeout(function () { t.remove(); }, duration);
    }
</script>

<style>
.lis-results-banner {
    display: flex; align-items: center; gap: 8px;
    padding: 10px 16px; margin-bottom: 12px;
    background: #f0fdf4; border: 1.5px solid #bbf7d0;
    border-radius: 8px; font-size: 13px; color: #15803d;
}
.lis-results-banner i { font-size: 15px; }
</style>
