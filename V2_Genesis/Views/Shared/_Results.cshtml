@model List<V2_Genesis.Models.PropertySearchResult>
@{
    var roll = ViewBag.Roll as V2_Genesis.Models.GvList;

    string[] headers = {
        "TOWNSHIP", "ADDRESS", "ERF", "PTN", "RE",
        "CATEGORY", "EXTENT", "MARKET VALUE",
        "SCHEME NAME", "SCHEME NO.", "SCHEME YEAR",
        "LEASE (Y/N)", "UNIT NO.", "REMARKS"
    };
}

<table id="psResultsTable" class="display table ps-table">
    <thead>
        <tr>
            @foreach (var h in headers)
            {
                <th>@h</th>
            }
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <!-- Township — clickable link to view & link property -->
               @*  <td>
                    <a class="ps-town-link"
                           href="/@roll?.ControllerName/CheckProperty?sourceTable=@roll?.Source&UnitKey=@item.UnitKey&ValuationKey=@item.ValuationKey&AppealStatus=False">
                        @item.TownNameDesc
                    </a>
                </td>
 *@
                @* Change the township <td> to point to /property/view *@
                <td>
                    <a class="ps-town-link"
                           href="/property/view?rollSource=@roll?.Source&unitKey=@item.UnitKey&valuationKey=@item.ValuationKey">
                        @item.TownNameDesc
                    </a>
                </td>
                <td>@(item.LisStreetAddress ?? "–")</td>
                <td>@item.Erf</td>
                <td>@item.Ptn</td>
                <td>@(item.Re ?? "–")</td>
                <td>@(item.CatDesc ?? "–")</td>
                <td>@(item.RateableArea ?? "–")</td>
                <td class="ps-market-val">@item.MarketValue</td>
                <td>@(item.SchemeName ?? "–")</td>
                <td>@(item.SchemeNumber ?? "–")</td>
                <td>@(item.SchemeYear ?? "–")</td>
                <td>@(item.Lease ?? "–")</td>
                <td>@(item.UnitNo > 0 ? item.UnitNo.ToString() : "–")</td>
                <td>@(item.Reason ?? "–")</td>
            </tr>
        }
    </tbody>
</table>

<script>
    $(document).ready(function () {
        if (!$.fn.DataTable.isDataTable('#psResultsTable')) {
            var table = $('#psResultsTable').DataTable({
                responsive : false,   // off — horizontal scroll handles mobile
                scrollX    : true,
                autoWidth  : false,
                dom        : '<"ps-dt-top"lBf>rt<"ps-dt-bottom"ip>',
                lengthMenu : [[10, 25, 50, -1], [10, 25, 50, 'All']],
                pageLength : 10,
                buttons: [
                    {
                        extend   : 'excel',
                        text     : '<i class="fa-solid fa-file-excel"></i> Excel',
                        className: 'ps-dt-btn'
                    },
                    {
                        extend   : 'pdf',
                        text     : '<i class="fa-solid fa-file-pdf"></i> PDF',
                        className: 'ps-dt-btn'
                    }
                ],
                language: {
                    search           : '_INPUT_',
                    searchPlaceholder: 'Search results…',
                    lengthMenu       : 'Show _MENU_ entries',
                    info             : 'Showing _START_ to _END_ of _TOTAL_',
                    infoEmpty        : 'No properties found',
                    infoFiltered     : '(filtered from _MAX_ total)'
                },
                columnDefs: [
                    { width: '160px', targets: 0  },  // Township
                    { width: '190px', targets: 1  },  // Address
                    { width: '65px',  targets: [2,3,4] },
                    { width: '120px', targets: 5  },  // Category
                    { orderable: false, targets: 13 }
                ],
                drawCallback : function () { formatMarketValues(); },
                initComplete : function () {
                    formatMarketValues();
                    const count = this.api().rows().count();
                    // Update the modal header count badge
                    const badge = document.getElementById('psmCount');
                    if (badge) badge.textContent = count + ' ' + (count === 1 ? 'property' : 'properties');
                    showSearchToaster(
                        'Search Complete 🎉',
                        'Found ' + count + ' matching ' + (count === 1 ? 'property' : 'properties'),
                        4000
                    );
                }
            });
        }
    });

    function formatMarketValues() {
        document.querySelectorAll('.ps-market-val').forEach(function (el) {
            const raw = parseFloat(el.textContent.replace(/[^0-9.-]+/g, ''));
            if (!isNaN(raw) && raw > 0) {
                el.textContent = raw.toLocaleString('en-ZA', {
                    style: 'currency', currency: 'ZAR',
                    minimumFractionDigits: 0, maximumFractionDigits: 0
                });
            }
        });
    }

    function showSearchToaster(title, message, duration) {
        let c = document.querySelector('.toaster-container');
        if (!c) {
            c = document.createElement('div');
            c.className = 'toaster-container';
            document.body.appendChild(c);
        }
        const t = document.createElement('div');
        t.className = 'toaster';
        t.innerHTML = `
            <div class="toaster-icon">🎉</div>
            <div class="toaster-content">
                <div class="toaster-title">${title}</div>
                <div class="toaster-message">${message}</div>
            </div>
            <button class="toaster-close" onclick="this.closest('.toaster').remove()">×</button>`;
        c.appendChild(t);
        setTimeout(() => t.remove(), duration);
    }
</script>