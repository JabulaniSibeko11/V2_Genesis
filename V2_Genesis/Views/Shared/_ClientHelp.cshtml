@model string
@*
    _ClientHelp.cshtml
    ─────────────────────────────────────────────────────────────────────
    "Need help?" box for a client who is stopped by a closed period.
    The rules stay the same for everyone (the admin team cannot reopen a
    48-hour evidence window, a Section 51 period or a Section 78 review
    period). This box tells the client what is still possible and how to
    contact Valuation Services.

    Model (kind):
      "evidence"   48-hour evidence window closed
      "section51"  Section 51 upload closed / already submitted
      "objection"  objection period closed  (contact details only)
      "appeal"     appeal period closed     (contact details only)
    Late objections (CLO) are NOT mentioned to clients; they are handled
    internally by the admin team. Appeals close on the appeal close date
    for everyone.
      "review"     Section 78 review period closed

    Usage:  <partial name="_ClientHelp" model="@("evidence")" />
    Styles: inline below (self-contained).
    ─────────────────────────────────────────────────────────────────────
*@
@{
    var kind = (Model ?? string.Empty).Trim().ToLowerInvariant();

    var (title, text) = kind switch
    {
        "evidence" => (
            "Need to send more information?",
            "The 48-hour upload window cannot be reopened online, also not by the City’s admin team. "
            + "If you have important new information, contact Valuation Services and quote your reference number. "
            + "The valuer handling your submission will decide if it can be considered."),

        "section51" => (
            "Need help with the Section 51 notice?",
            "Section 51 representations can only be submitted once, and only within the period stated in the notice. "
            + "If you have a question about the notice or the objection against your property, contact Valuation Services "
            + "and quote the objection number on the notice."),

        "objection" => (
            "Missed the objection period?",
            "New objections can no longer be lodged online for this roll. If you have a question, "
            + "contact Valuation Services and quote your property description."),

        "appeal" => (
            "Missed the appeal period?",
            "An appeal can no longer be lodged online for this objection. If you have a question, "
            + "contact Valuation Services and quote your objection number."),

        "review" => (
            "Need help with your Section 78 review?",
            "The review period for this property has closed and a review can no longer be lodged online. "
            + "If you have a question about the Section 78 decision, contact Valuation Services and quote your "
            + "Query number."),

        _ => (
            "Need help?",
            "Contact Valuation Services and quote your reference number.")
    };
}

<style>
    .gs-help {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        margin: 14px 0;
        padding: 14px 16px;
        border: 1px solid #c7e3e6;
        border-left: 5px solid #006570;
        border-radius: 12px;
        background: #f0f9fa;
        font-family: 'Poppins', sans-serif;
        color: #1f2937;
        text-align: left;
    }

    .gs-help-icon {
        flex: 0 0 38px;
        width: 38px;
        height: 38px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #006570;
        color: #ffffff;
        font-size: 16px;
    }

    .gs-help h4 {
        margin: 0 0 4px;
        font-size: 15px;
        font-weight: 800;
        color: #004f58;
    }

    .gs-help p {
        margin: 0 0 8px;
        font-size: 14px;
        line-height: 1.55;
    }

    .gs-help-contacts {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 16px;
        font-size: 14px;
        font-weight: 700;
    }

        .gs-help-contacts a {
            color: #006570;
            text-decoration: none;
            white-space: nowrap;
        }

            .gs-help-contacts a:hover {
                text-decoration: underline;
            }

        .gs-help-contacts i {
            margin-right: 5px;
        }
</style>

<div class="gs-help" role="note">
    <div class="gs-help-icon"><i class="fa-solid fa-headset" aria-hidden="true"></i></div>
    <div>
        <h4>@title</h4>
        <p>@text</p>
        <div class="gs-help-contacts">
            <a href="tel:0114076622"><i class="fa-solid fa-phone"></i>011 407 6622</a>
            <a href="mailto:valuationenquiries@joburg.org.za"><i class="fa-solid fa-envelope"></i>valuationenquiries@joburg.org.za</a>
        </div>
    </div>
</div>
