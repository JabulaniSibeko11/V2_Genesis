
<link href="~/css/views/nohomeresults.css" rel="stylesheet" asp-append-version="true" />
<div class="hs-noresults">

    <!-- Icon + heading -->
    <div class="hs-noresults-icon">
        <i class="fa-solid fa-magnifying-glass"></i>
    </div>
    <h3 class="hs-noresults-title">Property Not Found</h3>
    <p class="hs-noresults-sub">
        We searched all active valuation rolls — General Valuation Roll,
        Supplementary Roll 1, 2 and 3 — and could not find a property
        matching your search criteria.
    </p>

    <!-- Tips -->
    <div class="hs-noresults-tips">
        <p class="hs-tips-heading">
            <i class="fa-solid fa-lightbulb"></i> Before contacting us, try:
        </p>
        <ul class="hs-tips-list">
            <li>Removing some search filters and searching by township only</li>
            <li>Checking the spelling of your address or scheme name</li>
            <li>Using a partial address instead of the full street name</li>
            <li>Searching by ERF / stand number instead of address</li>
        </ul>
    </div>

    <!-- Divider -->
    <div class="hs-noresults-divider">
        <span>Still can't find it? Contact the Admin Office</span>
    </div>

    <!-- Contact cards -->
    <div class="hs-contact-grid">

        <div class="hs-contact-card">
            <div class="hs-contact-icon">
                <i class="fa-solid fa-phone"></i>
            </div>
            <div class="hs-contact-info">
                <span class="hs-contact-label">Telephone</span>
                <a href="tel:0114076622" class="hs-contact-value">
                    011 407-6622
                </a>
                <a href="tel:0114076597" class="hs-contact-value">
                    011 407-6597
                </a>
            </div>
        </div>

        <div class="hs-contact-card">
            <div class="hs-contact-icon">
                <i class="fa-solid fa-envelope"></i>
            </div>
            <div class="hs-contact-info">
                <span class="hs-contact-label">Email</span>
                <a href="mailto:valuationenquiries@joburg.org.za"
                   class="hs-contact-value">
                    valuationenquiries@joburg.org.za
                </a>
            </div>
        </div>

        <div class="hs-contact-card">
            <div class="hs-contact-icon">
                <i class="fa-solid fa-location-dot"></i>
            </div>
            <div class="hs-contact-info">
