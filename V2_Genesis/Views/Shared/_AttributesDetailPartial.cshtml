@using V2_Genesis.Helpers
@model V2_Genesis.Models.ViewModels.Dashboard.AttributesDetailViewModel


@{
    var attrData = Model.AttrData;
}

<!-- ── 1. Linked Properties ──────────────────────────── -->
<div class="cd-widget">
    <div class="cd-widget-toggle"
         onclick="toggleWidget('attr-linked')">
        <div class="cd-widget-toggle-left">
            <i class="fa-solid fa-link"></i>
            <h3>Linked Properties</h3>
            <span class="cd-count-badge">@Model.AttributesLinked.Count</span>
        </div>
        <i class="fa-solid fa-chevron-down cd-widget-chevron"
           id="wchev-attr-linked"></i>
    </div>
    <div class="cd-widget-body" id="widget-attr-linked">
        @*  <div class="cd-widget-toolbar">
                        <a href="/attributes/search" class="cd-add-btn">
                            <i class="fa-solid fa-plus"></i> Link New Property
                        </a>
                    </div> *@
        <div class="table-responsive">
            <table class="cd-table table table-bordered"
                   id="tbl-attr-linked">
                <thead>
                    <tr>
                        <th>Property Description</th>
                        <th>Category</th>
                        <th>Town</th>
                        <th>Market Value</th>
                        <th>Form Type</th>
                        <th>Options</th>
                    </tr>
                </thead>
                <tbody>
                    @* Replace attrData.LinkedProperties with Model.AttributesLinked *@
                    @foreach (var item in Model.AttributesLinked)
                    {
                        <tr>
                            <td>@item.PropertyDesc</td>
                            <td>@item.CatDesc</td>
                            <td>@item.TownNameDesc</td>
                            <td>@item.MarketValue</td>
                            <td>
                                <span class="attr-form-pill attr-pill-@(item.FormType.ToLower()
                                                                                                                                                                              .Replace(" ", "").Replace("&", "").Replace("/", ""))">
                                    @item.FormType
                                </span>
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button class="cd-action-btn dropdown-toggle"
                                            data-bs-toggle="dropdown">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu">
                                        @if (!item.HasSubmission)
                                        {
                                            @*     <li>
                                                            <a class="dropdown-item"
                                                                   href="/attributes/form?id=@item.IDProperty&formType=@item.FormType">
                                                                Submit Attributes
                                                            </a>
                                                        </li> *@


                                            <li>
                                                @*  <a class="dropdown-item"
                                                                           asp-controller="Attributes"
                                                                   asp-action="Check"
                                                                   asp-route-idProperty="@item.IDProperty"
                                                                           asp-route-formType="@item.FormType">
                                                                            Submit Attributes
                                                                        </a> *@
                                                <a class="dropdown-item"
                                                       href="/attributes/select-form?unitKey=@item.IDProperty">
                                                    <i class="fa-solid fa-file-pen"></i> Submit Attributes
                                                </a>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <a class="dropdown-item"
                                                       href="/attributes/submission?propertyId=@item.IDProperty">
                                                    View Submission
                                                </a>
                                            </li>
                                        }
                                        <li>
                                            <a class="dropdown-item"
                                                   href="/attributes/unlink?id=@item.Id">
                                                Unlink
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ── 2. My Submissions ──────────────────────────────── -->
<div class="cd-widget">
    <div class="cd-widget-toggle"
         onclick="toggleWidget('attr-submissions')">
        <div class="cd-widget-toggle-left">
            <i class="fa-solid fa-file-pen"></i>
            <h3>My Submissions</h3>
            <span class="cd-count-badge cd-count-orange">
                @attrData.SubmissionCount
            </span>
            @if (attrData.PendingCount > 0)
            {
                <span class="cd-count-badge cd-count-amber">
                    @attrData.PendingCount pending
                </span>
            }
        </div>
        <i class="fa-solid fa-chevron-down cd-widget-chevron"
           id="wchev-attr-submissions"></i>
    </div>
    <div class="cd-widget-body" id="widget-attr-submissions">
        <div class="table-responsive">
            <table class="cd-table table table-bordered"
                   id="tbl-attr-submissions">
                <thead>
                    <tr>
                        <th> Reference</th>
                        <th>Property Description</th>
                        <th>Form Type</th>
                        <th> Submitted</th>
                        <th>Edit Window</th>
                        <th> Status</th>
                        <th> Options</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in attrData.Submissions)
                    {
                        <tr>
                            <td><strong>@item.SubmissionRef</strong></td>
                            <td>@item.PropertyDesc</td>
                            <td>@item.FormType</td>
                            <td>@item.SubmittedAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                @if (item.IsEditable && item.EditTimeLeft.HasValue)
                                {
                                    var tl = item.EditTimeLeft.Value;
                                    <span class="attr-edit-window attr-edit-open"
                                          data-deadline="@item.SubmittedAt.AddHours(48).ToString("o")">
                                        <i class="fa-solid fa-clock"></i>
                                        @tl.Hours h @tl.Minutes m left
                                    </span>
                                }
                                else
                                {
                                    <span class="attr-edit-window attr-edit-locked">
                                        <i class="fa-solid fa-lock"></i> Locked
                                    </span>
                                }
                            </td>
                            <td>@Html.Raw(DashboardDisplayHelpers.GetAttrStatusPill(item.Status))</td>
                            <td>
                                <div class="dropdown">
                                    <button class="cd-action-btn dropdown-toggle"
                                            data-bs-toggle="dropdown">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu">
                                        <li>
                                            <a class="dropdown-item"
                                                   href="/attributes/submission/@item.Id">
                                                👁️ View Submission
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                                   href="/attributes/acknowledgement/download?attrNo=@item.SubmissionRef"
                                                   target="_blank">
                                                <i class="fa-solid fa-file-pdf" style="color:#dc2626;"></i>
                                                Download Acknowledgement
                                            </a>
                                        </li>
                                        @if (item.IsEditable)
                                        {
                                            @*  <li>
                                                            <a class="dropdown-item"
                                                                   href="/attributes/edit/@item.Id">
                                                                ✏️ Edit Submission
                                                            </a>
                                                        </li> *@
                                            <li>
                                                <a class="dropdown-item"
                                                       href="/attributes/evidence?attrNo=@item.SubmissionRef">
                                                    📎 Add Evidence
                                                </a>
                                            </li>
                                        }
                                        @if (item.Status == "ReturnedToClient")
                                        {
                                            <li>
                                                <button type="button"
                                                        class="dropdown-item"
                                                        onclick="openReturnedCorrectionModal('@item.Id')">
                                                    <i class="fa-solid fa-rotate-right"></i>
                                                    Correct / Resubmit
                                                </button>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@* ── Returned Attribute Correction / Resubmission Modals ─────────────────── *@
@foreach (var item in attrData.Submissions.Where(x => x.Status == "ReturnedToClient"))
{
    <div id="returnedCorrectionModal_@item.Id"
         class="attr-insp-modal-backdrop"
         style="display:none;">

        <div class="attr-insp-modal">
            <div class="attr-insp-modal-head">
                <div>
                    Correct Returned Submission - @item.SubmissionRef
                </div>

                <button type="button"
                        onclick="closeReturnedCorrectionModal('@item.Id')">
                    ×
                </button>
            </div>

            <form asp-controller="Dashboard"
                  asp-action="ResubmitReturnedAttribute"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="AttrId"
                       value="@item.Id" />

                <input type="hidden"
                       name="AttrNo"
                       value="@item.SubmissionRef" />

                <input type="hidden"
                       name="PropertyDescription"
                       value="@item.PropertyDesc" />

                <div class="attr-insp-modal-body">
                    <p>
                        Your attribute submission was returned for correction.
                        Please review the reason below, upload any required evidence,
                        and resubmit your corrections.
                    </p>

                    @if (!string.IsNullOrWhiteSpace(item.RevisionReason))
                    {
                        <div class="alert alert-warning">
                            <strong>Reason returned:</strong><br />
                            @item.RevisionReason
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-warning">
                            <strong>Reason returned:</strong><br />
                            The valuer requested corrections to this attribute submission.
                        </div>
                    }

                    <div class="alert alert-info">
                        <strong>Evidence:</strong>
                        If the valuer requested updated evidence, upload it before resubmitting.
                        <br />

                        <a href="/attributes/evidence?attrNo=@item.SubmissionRef"
                               target="_blank"
                               class="btn btn-sm btn-dark mt-2">
                            <i class="fa-solid fa-paperclip"></i>
                            Upload Evidence
                        </a>
                    </div>

                    <label class="fw-bold">Correction Comment</label>

                    <textarea name="RevisionComment"
                              class="form-control"
                              rows="4"
                              placeholder="Explain what you corrected..."
                              required></textarea>
                </div>

                <div class="attr-insp-modal-footer">
                    <button type="button"
                            class="btn btn-light"
                            onclick="closeReturnedCorrectionModal('@item.Id')">
                        Cancel
                    </button>

                    <button type="submit"
                            class="btn btn-warning fw-bold">
                        Resubmit Corrections
                    </button>
                </div>
            </form>
        </div>
    </div>
}
          
@* ── 3. My Appointments with Valuer ─────────────────── *@
<div class="cd-widget">
    <div class="cd-widget-toggle"
         onclick="toggleWidget('attr-appointments')">
        <div class="cd-widget-toggle-left">
            <i class="fa-solid fa-calendar-check"></i>
            <h3>My Appointments with Valuer</h3>
            <span class="cd-count-badge cd-count-blue">
                @attrData.AppointmentCount
            </span>
        </div>

        <i class="fa-solid fa-chevron-down cd-widget-chevron"
           id="wchev-attr-appointments"></i>
    </div>

    <div class="cd-widget-body" id="widget-attr-appointments">
        <div class="table-responsive">
            <table class="cd-table table table-bordered"
                   id="tbl-attr-appointments">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Property</th>
                        <th>Date Options</th>
                        <th>Status</th>
                        <th>Options</th>
                    </tr>
                </thead>

                <tbody>
                    @if (attrData.Appointments == null || !attrData.Appointments.Any())
                    {
                        <tr>
                            <td colspan="5"
                                style="text-align:center;font-weight:700;color:#777;">
                                No inspection appointment requests found.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in attrData.Appointments)
                        {
                            <tr>
                                <td>
                                    <strong>@item.AppointmentRef</strong>
                                </td>

                                <td>
                                    @item.PropertyDesc
                                </td>

                                <td>
                                    @if ((item.Status == "Confirmed" || item.Status == "InspectionDetailsSent")
                                         && item.ConfirmedDateTime != null)
                                    {
                                        <strong>
                                            Confirmed:
                                            @item.ConfirmedDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                        </strong>
                                    }
                                    else if (item.Status == "Expired")
                                    {
                                        <span style="font-weight:700;color:#b91c1c;">
                                            Date options expired
                                        </span>
                                    }
                                    else if (item.Slots != null && item.Slots.Any())
                                    {
                                        <ul style="margin:0;padding-left:18px;">
                                            @foreach (var slot in item.Slots)
                                            {
                                                <li>
                                                    Option @slot.SlotNo:
                                                    @slot.ProposedDateTime.ToString("dd MMM yyyy HH:mm")
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span>–</span>
                                    }
                                </td>

                                <td>
                                    @Html.Raw(DashboardDisplayHelpers.GetApptStatusPill(item.Status))
                                </td>

                                <td>
                                    @if (item.Status == "PendingClientResponse")
                                    {
                                        <button type="button"
                                                class="cd-action-btn"
                                                onclick="openInspectionResponseModal('@item.Id')">
                                            Select Date
                                        </button>
                                    }
                                    else if (item.Status == "InspectionDetailsSent")
                                    {
                                        <button type="button"
                                                class="cd-action-btn"
                                                onclick="openPinModal('@item.Id')">
                                            Enter PIN
                                        </button>
                                    }
                                    else if (item.Status == "Confirmed")
                                    {
                                        <span style="font-weight:700;color:#64748b;">
                                            Waiting for PIN
                                        </span>
                                    }
                                    else if (item.Status == "Expired")
                                    {
                                        <span style="font-weight:700;color:#b91c1c;">
                                            No action
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-weight:700;color:#64748b;">
                                            No action
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* Date selection modals *@
        @foreach (var appointment in attrData.Appointments.Where(x => x.Status == "PendingClientResponse"))
        {
            <div id="inspectionModal_@appointment.Id"
                 class="attr-insp-modal-backdrop"
                 style="display:none;">

                <div class="attr-insp-modal">
                    <div class="attr-insp-modal-head">
                        <div>
                            Choose Inspection Date - @appointment.AppointmentRef
                        </div>

                        <button type="button"
                                onclick="closeInspectionResponseModal('@appointment.Id')">
                            ×
                        </button>
                    </div>

                    <form asp-controller="Dashboard"
                          asp-action="RespondToInspectionAppointment"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               name="InspectionRequestId"
                               value="@appointment.Id" />

                        <div class="attr-insp-modal-body">
                            <p>
                                The valuer has requested a physical inspection.
                                Please choose one of the proposed dates below.
                            </p>

                            @if (!string.IsNullOrWhiteSpace(appointment.RequestComment))
                            {
                                <div class="alert alert-info">
                                    @appointment.RequestComment
                                </div>
                            }

                            @if (appointment.Slots != null && appointment.Slots.Any())
                            {
                                @foreach (var slot in appointment.Slots)
                                {
                                    <label class="attr-insp-option">
                                        <input type="radio"
                                               name="SelectedSlotId"
                                               value="@slot.Id"
                                               required />

                                        <span>
                                            Option @slot.SlotNo:
                                            <strong>@slot.ProposedDateTime.ToString("dd MMM yyyy HH:mm")</strong>
                                        </span>
                                    </label>
                                }
                            }
                            else
                            {
                                <div class="alert alert-warning">
                                    No proposed inspection date options were found.
                                </div>
                            }

                            <label class="fw-bold">Comment</label>

                            <textarea name="ClientResponseComment"
                                      class="form-control"
                                      placeholder="Optional comment..."></textarea>
                        </div>

                        <div class="attr-insp-modal-footer">
                            <button type="button"
                                    class="btn btn-light"
                                    onclick="closeInspectionResponseModal('@appointment.Id')">
                                Cancel
                            </button>

                            <button type="submit"
                                    class="btn btn-warning fw-bold">
                                Confirm Selected Date
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        }

        @* PIN verification modals - full backend verification comes next *@
        @* PIN verification modals *@
        @foreach (var appointment in attrData.Appointments
            .Where(x => x.Status == "InspectionDetailsSent"))
        {
            var modalId = $"pinModal_{appointment.Id}";
            var inputId = $"pinHiddenInput_{appointment.Id}";
            var formId = $"pinForm_{appointment.Id}";
            var submitId = $"pinSubmitBtn_{appointment.Id}";
            var errorId = $"pinError_{appointment.Id}";
            var errorMsgId = $"pinErrorMsg_{appointment.Id}";
            var contextTitleId = $"pinContextTitle_{appointment.Id}";

            <div class="pin-backdrop" id="@modalId" style="display:none;">
                <div class="pin-modal" role="dialog" aria-modal="true" aria-labelledby="@contextTitleId">

                    <div class="pin-handle"></div>

                    <div class="pin-head">
                        <div class="pin-head-icon">
                            <i class="fa-solid fa-lock"></i>
                        </div>
                        <div class="pin-head-text">
                            <div class="pin-head-title">Enter Inspection PIN</div>
                            <div class="pin-head-sub">@appointment.AppointmentRef</div>
                        </div>
                        <button type="button" class="pin-head-close"
                                onclick="closePinModal('@appointment.Id')" aria-label="Close">
                            <i class="fa-solid fa-xmark"></i>
                        </button>
                    </div>

                    <form asp-controller="Dashboard"
                          asp-action="VerifyInspectionPin"
                          method="post"
                          id="@formId"
                          autocomplete="off">

                        @Html.AntiForgeryToken()
                        <input type="hidden" name="InspectionRequestId" value="@appointment.Id" />

                        <div class="pin-body">
                            <div class="pin-lock-ring">
                                <i class="fa-solid fa-shield-halved"></i>
                            </div>

                            <div class="pin-context">
                                <div class="pin-context-title" id="@contextTitleId">
                                    Verify your inspection appointment
                                </div>
                                <div class="pin-context-sub">
                                    Enter the PIN sent to you by email.
                                </div>
                            </div>

                            @if (appointment.ConfirmedDateTime != null)
                            {
                                <div class="pin-confirmed-date">
                                    <i class="fa-solid fa-calendar-check"></i>
                                    <div>
                                        <span class="pin-confirmed-label">Confirmed inspection date</span>
                                        <span class="pin-confirmed-value">
                                            @appointment.ConfirmedDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                        </span>
                                    </div>
                                </div>
                            }

                            @* ── Dot display — BUG FIXED: @(appointment.Id) wrapped in parens ── *@
                            <div class="pin-dots">
                                <div class="pin-dot" id="dot_@(appointment.Id)_0"></div>
                                <div class="pin-dot" id="dot_@(appointment.Id)_1"></div>
                                <div class="pin-dot" id="dot_@(appointment.Id)_2"></div>
                                <div class="pin-dot" id="dot_@(appointment.Id)_3"></div>
                            </div>

                            <input type="password"
                                   id="@inputId"
                                   name="Pin"
                                   class="pin-input-hidden"
                                   maxlength="4"
                                   inputmode="numeric"
                                   pattern="[0-9]{4}"
                                   autocomplete="off"
                                   required />

                            <div class="pin-error" id="@errorId">
                                <i class="fa-solid fa-circle-exclamation"></i>
                                <span id="@errorMsgId">Incorrect PIN. Please try again.</span>
                            </div>

                            <div class="pin-keypad">
                                <button type="button" class="pin-key" onclick="pinKey('@appointment.Id', '1')">
                                    <span class="pin-key-num">1</span>
                                </button>
                                <button type="button" class="pin-key" onclick="pinKey('@appointment.Id', '2')">
                                    <span class="pin-key-num">2</span>
                                    <span class="pin-key-alpha">ABC</span>
                                </button>
                                <button type="button" class="pin-key" onclick="pinKey('@appointment.Id', '3')">
                                    <span class="pin-key-num">3</span>
                                    <span class="pin-key-alpha">DEF</span>
                                </button>
                                <button type="button" class="pin-key" onclick="pinKey('@appointment.Id', '4')">
                                    <span class="pin-key-num">4</span>
                                    <span class="pin-key-alpha">GHI</span>
                                </button>
                                <button type="button" class="pin-key" onclick="pinKey('@appointment.Id', '5')">
                                    <span class="pin-key-num">5</span>
                                    <span class="pin-key-alpha">JKL</span>
                                </button>
                                <button type="button" class="pin-key" onclick="pinKey('@appointment.Id', '6')">
                                    <span class="pin-key-num">6</span>
                                    <span class="pin-key-alpha">MNO</span>
                                </button>
                                <button type="button" class="pin-key" onclick="pinKey('@appointment.Id', '7')">
                                    <span class="pin-key-num">7</span>
                                    <span class="pin-key-alpha">PQRS</span>
                                </button>
                                <button type="button" class="pin-key" onclick="pinKey('@appointment.Id', '8')">
                                    <span class="pin-key-num">8</span>
                                    <span class="pin-key-alpha">TUV</span>
                                </button>
                                <button type="button" class="pin-key" onclick="pinKey('@appointment.Id', '9')">
                                    <span class="pin-key-num">9</span>
                                    <span class="pin-key-alpha">WXYZ</span>
                                </button>
                                <button type="button" class="pin-key" style="border:none;background:none;box-shadow:none;cursor:default;" disabled></button>
                                <button type="button" class="pin-key pin-key-zero" onclick="pinKey('@appointment.Id', '0')">
                                    <span class="pin-key-num">0</span>
                                </button>
                                <button type="button" class="pin-key pin-key-del" onclick="pinDelete('@appointment.Id')" aria-label="Delete">
                                    <i class="fa-solid fa-delete-left pin-key-icon"></i>
                                </button>
                            </div>
                        </div>

                        <div class="pin-foot">
                            <button type="submit" class="pin-submit-btn" id="@submitId" disabled>
                                <i class="fa-solid fa-unlock"></i> Confirm
                            </button>
                            <div class="pin-forgot">
                                PIN only works during the inspection security window.
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        }

                
    </div>
</div>

