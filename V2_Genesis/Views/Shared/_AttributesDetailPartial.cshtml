@using V2_Genesis.Helpers
@model V2_Genesis.Models.ViewModels.Dashboard.AttributesDetailViewModel


@{
    var attrData = Model.AttrData;
    var isAdminDashboard = Context.Request.Path.StartsWithSegments("/admin");
    var attributesReturnUrl = isAdminDashboard
        ? Url.Action(
            "Index",
            "Admin",
            new { openRoll = "Attributes" }) ?? "/Admin?openRoll=Attributes"
        : Url.Action(
            "Index",
            "Dashboard",
            new { openRoll = "Attributes" }) ?? "/Dashboard?openRoll=Attributes";
}

@if (!isAdminDashboard)
{
    <div class="cd-detail-roll-info">
        <div class="cd-detail-roll-info-left">
            <div class="cd-detail-roll-icon">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>
            <div>
                <h2 class="cd-detail-roll-name">Property Attributes</h2>
                <span class="cd-detail-roll-short">Submit or track your property attribute information</span>
            </div>
        </div>

        <div class="cd-detail-roll-info-right">
            <span class="cd-roll-badge cd-badge-open">OPEN</span>
            <a href="/attributes/search" class="cd-detail-search-btn">
                <i class="fa-solid fa-magnifying-glass"></i> Search Property
            </a>
        </div>
    </div>
}

<!-- ── 1. Linked Properties ──────────────────────────── -->
<div class="cd-widget">
    <div class="cd-widget-toggle"
         onclick="toggleWidget('attr-linked')">
        <div class="cd-widget-toggle-left">
            <i class="fa-solid fa-link"></i>
            <h3>Linked Properties</h3>
            <span class="cd-count-badge">@Model.AttributesLinked.Count</span>
        </div>
        <i class="fa-solid fa-chevron-down cd-widget-chevron"
           id="wchev-attr-linked"></i>
    </div>
    <div class="cd-widget-body" id="widget-attr-linked">
        <div class="table-responsive">
            <table class="display table hs-table cd-table nowrap"
                   id="tbl-attr-linked">
                <thead>
                    <tr>
                        <th>Property Description</th>
                        <th>Category</th>
                        <th>Town</th>
                        <th>Market Value (R)</th>
                        <th>Form Type</th>
                        <th>Options</th>
                    </tr>
                </thead>
                <tbody>
                    @* Replace attrData.LinkedProperties with Model.AttributesLinked *@
                    @foreach (var item in Model.AttributesLinked)
                    {
                        <tr>
                            <td>@item.PropertyDesc</td>
                            <td>@item.CatDesc</td>
                            <td>@item.TownNameDesc</td>
                            <td>@DashboardDisplayHelpers.FormatZAR(item.MarketValue)</td>
                            <td>
                                <span class="attr-form-pill attr-pill-@(item.FormType.ToLower()
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                .Replace(" ", "").Replace("&", "").Replace("/", ""))">
                                    @item.FormType
                                </span>
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button class="cd-action-btn dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            data-bs-display="static"
                                            aria-expanded="false">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu cd-action-menu">
                                        @if (!item.HasSubmission)
                                        {
                                            @*     <li>
                                                            <a class="dropdown-item"
                                                                   href="/attributes/form?id=@item.IDProperty&formType=@item.FormType">
                                                                Submit Attributes
                                                            </a>
                                                        </li> *@


                                            <li>
                                                @*  <a class="dropdown-item"
                                                                           asp-controller="Attributes"
                                                                   asp-action="Check"
                                                                   asp-route-idProperty="@item.IDProperty"
                                                                           asp-route-formType="@item.FormType">
                                                                            Submit Attributes
                                                                        </a> *@
                                                <a class="dropdown-item"
                                                       href="/attributes/select-form?unitKey=@item.IDProperty">
                                                    <i class="fa-solid fa-file-pen"></i> Submit Attributes
                                                </a>
                                            </li>
                                        }
                                        else
                                        {
                                            <li>
                                                <a class="dropdown-item"
                                                       asp-route="ViewSubmission"
                                                       asp-route-submissionType="Attribute"
                                                       asp-route-referenceNumber="@item.SubmissionRef"
                                                       asp-route-rollSource="Attributes"
                                                       asp-route-returnUrl="@attributesReturnUrl">
                                                    View Submission
                                                </a>
                                            </li>
                                        }
                                        <li>
                                            <a class="dropdown-item"
                                                   asp-controller="Attributes"
                                                   asp-action="Unlink"
                                                   asp-route-id="@item.Id">
                                                Unlink
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- ── 2. My Submissions ──────────────────────────────── -->
<div class="cd-widget">
    <div class="cd-widget-toggle"
         onclick="toggleWidget('attr-submissions')">
        <div class="cd-widget-toggle-left">
            <i class="fa-solid fa-file-pen"></i>
            <h3>My Submissions</h3>
            <span class="cd-count-badge cd-count-orange">
                @attrData.SubmissionCount
            </span>
            @if (attrData.PendingCount > 0)
            {
                <span class="cd-count-badge cd-count-amber">
                    @attrData.PendingCount pending
                </span>
            }
        </div>
        <i class="fa-solid fa-chevron-down cd-widget-chevron"
           id="wchev-attr-submissions"></i>
    </div>
    <div class="cd-widget-body" id="widget-attr-submissions">
        <div class="table-responsive">
            <table class="display table hs-table cd-table nowrap"
                   id="tbl-attr-submissions">
                <thead>
                    <tr>
                        <th> Reference</th>
                        <th>Property Description</th>
                        <th>Form Type</th>
                        <th> Submitted</th>
                        <th>Edit Window</th>
                        <th> Status</th>
                        <th> Options</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in attrData.Submissions)
                    {
                        var nonWithdrawableStatuses = new[]
                        {
                            "Withdrawn",
                            "Approved",
                            "Rejected",
                            "Finalized",
                            "Finalised",
                            "Extracted",
                            "Extracted to OVVIO",
                            "OvvioExtracted"
                        };
                        var withdrawableStatuses = new[]
                        {
                            "EvidenceOpen",
                            "SectorInbox",
                            "Awaiting Valuer Assignment",
                            "Pending",
                            "Submitted"
                        };
                        var canWithdraw =
                            !nonWithdrawableStatuses.Contains(
                                item.Status ?? string.Empty,
                                StringComparer.OrdinalIgnoreCase) &&
                            withdrawableStatuses.Contains(
                                item.Status ?? string.Empty,
                                StringComparer.OrdinalIgnoreCase);

                        <tr>
                            <td><strong>@item.SubmissionRef</strong></td>
                            <td>@item.PropertyDesc</td>
                            <td>@item.FormType</td>
                            <td>@item.SubmittedAt.ToString("dd MMM yyyy HH:mm")</td>
                            <td>
                                @if (item.IsEditable && item.EditTimeLeft.HasValue)
                                {
                                    var tl = item.EditTimeLeft.Value;
                                    <span class="attr-edit-window attr-edit-open"
                                          data-deadline="@item.SubmittedAt.AddHours(48).ToString("o")">
                                        <i class="fa-solid fa-clock"></i>
                                        @tl.Hours h @tl.Minutes m left
                                    </span>
                                }
                                else
                                {
                                    <span class="attr-edit-window attr-edit-locked">
                                        <i class="fa-solid fa-lock"></i> Locked
                                    </span>
                                }
                            </td>
                            <td>@Html.Raw(DashboardDisplayHelpers.GetAttrStatusPill(item.Status))</td>
                            <td>
                                <div class="dropdown">
                                    <button class="cd-action-btn dropdown-toggle"
                                            type="button"
                                            data-bs-toggle="dropdown"
                                            data-bs-display="static"
                                            aria-expanded="false">
                                        Actions
                                    </button>
                                    <ul class="dropdown-menu cd-action-menu">
                                        <li>
                                            <a class="dropdown-item"
                                                   asp-route="ViewSubmission"
                                                   asp-route-submissionType="Attribute"
                                                   asp-route-referenceNumber="@item.SubmissionRef"
                                                   asp-route-rollSource="Attributes"
                                                   asp-route-returnUrl="@attributesReturnUrl">
                                                👁️ View Submission
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item"
                                                   href="/attributes/acknowledgement/download?attrNo=@item.SubmissionRef"
                                                   data-no-loader
                                                   target="_blank"
                                                   rel="noopener">
                                                <i class="fa-solid fa-file-pdf" style="color:#dc2626;"></i>
                                                Download Acknowledgement
                                            </a>
                                        </li>
                                        @if (item.IsEditable)
                                        {
                                            @*  <li>
                                                            <a class="dropdown-item"
                                                                   href="/attributes/edit/@item.Id">
                                                                ✏️ Edit Submission
                                                            </a>
                                                        </li> *@
                                            <li>
                                                <a class="dropdown-item"
                                                       href="/attributes/evidence?attrNo=@item.SubmissionRef">
                                                    📎 Add Evidence
                                                </a>
                                            </li>
                                        }
                                        @if (item.Status == "ReturnedToClient")
                                        {
                                            <li>
                                                <a class="dropdown-item"
                                                       asp-controller="Attributes"
                                                       asp-action="CorrectReturned"
                                                       asp-route-attrId="@item.Id">
                                                    <i class="fa-solid fa-rotate-right"></i>
                                                    Correct / Resubmit
                                                </a>
                                            </li>
                                        }
                                        @if (canWithdraw)
                                        {
                                            <li><hr class="dropdown-divider" /></li>
                                            <li>
                                                <a class="dropdown-item text-danger"
                                                       asp-route="AttributeWithdrawalGet"
                                                       asp-route-attrId="@item.Id"
                                                       asp-route-returnUrl="@attributesReturnUrl">
                                                    <i class="fa-solid fa-file-circle-xmark"></i>
                                                    Withdraw Submission
                                                </a>
                                            </li>
                                        }
                                    </ul>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>


@* ── 3. My Appointments with Valuer ─────────────────── *@
<div class="cd-widget">
    <div class="cd-widget-toggle"
         onclick="toggleWidget('attr-appointments')">
        <div class="cd-widget-toggle-left">
            <i class="fa-solid fa-calendar-check"></i>
            <h3>My Appointments with Valuer</h3>
            <span class="cd-count-badge cd-count-blue">
                @attrData.AppointmentCount
            </span>
        </div>

        <i class="fa-solid fa-chevron-down cd-widget-chevron"
           id="wchev-attr-appointments"></i>
    </div>

    <div class="cd-widget-body" id="widget-attr-appointments">
        <div class="table-responsive">
            <table class="display table hs-table cd-table nowrap"
                   id="tbl-attr-appointments">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Property</th>
                        <th>Date Options</th>
                        <th>Status</th>
                        <th>Options</th>
                    </tr>
                </thead>

                <tbody>
                    @if (attrData.Appointments != null && attrData.Appointments.Any())
                    {
                        @foreach (var item in attrData.Appointments)
                        {
                            <tr>
                                <td>
                                    <strong>@item.AppointmentRef</strong>
                                </td>

                                <td>
                                    @item.PropertyDesc
                                </td>

                                <td>
                                    @if ((item.Status == "Confirmed" || item.Status == "InspectionDetailsSent")
                                         && item.ConfirmedDateTime != null)
                                    {
                                        <strong>
                                            Confirmed:
                                            @item.ConfirmedDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                        </strong>
                                    }
                                    else if (item.Status == "Expired")
                                    {
                                        <span style="font-weight:700;color:#b91c1c;">
                                            Date options expired
                                        </span>
                                    }
                                    else if (item.Slots != null && item.Slots.Any())
                                    {
                                        <ul style="margin:0;padding-left:18px;">
                                            @foreach (var slot in item.Slots)
                                            {
                                                <li>
                                                    Option @slot.SlotNo:
                                                    @slot.ProposedDateTime.ToString("dd MMM yyyy HH:mm")
                                                </li>
                                            }
                                        </ul>
                                    }
                                    else
                                    {
                                        <span>–</span>
                                    }
                                </td>

                                <td>
                                    @Html.Raw(DashboardDisplayHelpers.GetApptStatusPill(item.Status))
                                </td>

                                <td>
                                    @if (item.Status == "PendingClientResponse")
                                    {
                                        <button type="button"
                                                class="cd-action-btn"
                                                onclick="openInspectionResponseModal('@item.Id')">
                                            Select Date
                                        </button>
                                    }
                                    else if (item.Status == "InspectionDetailsSent")
                                    {
                                        <button type="button"
                                                class="cd-action-btn"
                                                onclick="openPinModal('@item.Id')">
                                            Enter PIN
                                        </button>
                                    }
                                    else if (item.Status == "Confirmed")
                                    {
                                        <span style="font-weight:700;color:#64748b;">
                                            Waiting for PIN
                                        </span>
                                    }
                                    else if (item.Status == "Expired")
                                    {
                                        <span style="font-weight:700;color:#b91c1c;">
                                            No action
                                        </span>
                                    }
                                    else
                                    {
                                        <span style="font-weight:700;color:#64748b;">
                                            No action
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        @* Date selection modals *@
        @foreach (var appointment in attrData.Appointments.Where(x => x.Status == "PendingClientResponse"))
        {
            var dateModal = new V2_Genesis.Models.ViewModels.Attributes.InspectionDateModalVm
            {
                InstanceKey = appointment.Id.ToString(),
                AppointmentRef = appointment.AppointmentRef ?? $"ATTR-{appointment.AttrId}",
                FormAction = Url.Action("RespondToInspectionAppointment", "Dashboard") ?? "/Dashboard/RespondToInspectionAppointment",
                SlotFieldName = "SelectedSlotId",
                CommentFieldName = "ClientResponseComment",
                RequestComment = appointment.RequestComment,
                InspectionRequestId = appointment.Id,
                Slots = appointment.Slots.Select(slot =>
                    new V2_Genesis.Models.ViewModels.Attributes.InspectionDateModalSlotVm
                    {
                        Id = slot.Id,
                        SlotNo = slot.SlotNo,
                        ProposedDateTime = slot.ProposedDateTime
                    }).ToList()
            };
            <partial name="Attributes/_InspectionDateModal" model="dateModal" />
        }

        @foreach (var appointment in attrData.Appointments.Where(x => x.Status == "InspectionDetailsSent"))
        {
            var pinModal = new V2_Genesis.Models.ViewModels.Attributes.InspectionPinModalVm
            {
                InstanceKey = appointment.Id.ToString(),
                AppointmentRef = appointment.AppointmentRef ?? $"ATTR-{appointment.AttrId}",
                FormAction = Url.Action("VerifyInspectionPin", "Dashboard") ?? "/Dashboard/VerifyInspectionPin",
                PinFieldName = "Pin",
                InspectionRequestId = appointment.Id,
                ConfirmedDateTime = appointment.ConfirmedDateTime
            };
            <partial name="Attributes/_InspectionPinModal" model="pinModal" />
        }

                
    </div>
</div>

