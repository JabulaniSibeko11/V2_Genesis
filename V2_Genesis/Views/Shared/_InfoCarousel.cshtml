                    </a>
                    <span class="ic-counter">02 / 04</span>
                </div>
            </div>
            <div class="ic-right">
                <div class="ic-deco" style="background:rgba(137,183,178,.1); color:#89b7b2;">
                    <i class="fa-solid fa-magnifying-glass-chart"></i>
                </div>
                <div class="ic-ring-1" style="border-color:#89b7b2;"></div>
                <div class="ic-ring-2" style="border-color:#89b7b2;"></div>
            </div>
        </div>

      
        <div class="ic-slide ic-slide-3">
            <div class="ic-left">
                <div class="ic-eyebrow" style="color:#bb4722;">
                    <span class="ic-eyebrow-line" style="background:#bb4722;"></span>
                    Reduce Your Rates
                </div>
