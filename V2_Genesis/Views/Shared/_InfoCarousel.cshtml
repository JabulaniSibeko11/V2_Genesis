    </div>
    <button class="ic-arrow ic-prev" id="icPrev" aria-label="Previous slide">&#8592;</button>
    <button class="ic-arrow ic-next" id="icNext" aria-label="Next slide">&#8594;</button>

   
    <div class="ic-nav" id="icNav">
        <button class="ic-pause-btn" id="icPause" aria-label="Pause carousel">
            <i class="fa-solid fa-pause"></i>
        </button>
        <button class="ic-dot active" aria-label="Slide 1 — Objection &amp; Appeal"></button>
        <button class="ic-dot"        aria-label="Slide 2 — Section 78"></button>
        <button class="ic-dot"        aria-label="Slide 3 — Rebates"></button>
        <button class="ic-dot"        aria-label="Slide 4 — Attributes"></button>
    </div>

   
    <div class="ic-progress"><div class="ic-bar" id="icBar"></div></div>

</div>



<script>
    (function () {
        var track       = document.getElementById('icSlides');
        var bar         = document.getElementById('icBar');
        var dots        = document.querySelectorAll('.ic-dot');
        var pauseBtn    = document.getElementById('icPause');
        var root        = document.getElementById('icRoot');
        var TOTAL       = 4;
        var DELAY       = 6000;
        var current     = 0;
        var startTs     = null;
        var paused      = false;
        var manualPause = false;
        var rafId;

        function go(n) {
            current = ((n % TOTAL) + TOTAL) % TOTAL;
            track.style.transform = 'translateX(-' + (current * 100) + '%)';
            dots.forEach(function (d, i) {
                d.classList.toggle('active', i === current);
            });
            resetBar();
        }

        function resetBar() {
            startTs = null;
            bar.style.transition = 'none';
            bar.style.width = '0%';
            requestAnimationFrame(function () {
                requestAnimationFrame(function () {
                    bar.style.transition = 'width ' + DELAY + 'ms linear';
                    bar.style.width = '100%';
                });
            });
        }

        function tick(ts) {
            if (!paused) {
                if (!startTs) startTs = ts;
                if (ts - startTs >= DELAY) go(current + 1);
            }
            rafId = requestAnimationFrame(tick);
        }

        // ── Dot clicks ──────────────────────────────────────
        dots.forEach(function (d, i) {
            d.addEventListener('click', function () { go(i); });
        });

        // ── Arrow clicks ────────────────────────────────────
        document.getElementById('icPrev').addEventListener('click', function () { go(current - 1); });
        document.getElementById('icNext').addEventListener('click', function () { go(current + 1); });

        // ── Pause / Play button ─────────────────────────────
        pauseBtn.addEventListener('click', function () {
            manualPause = !manualPause;
            paused = manualPause;

            if (manualPause) {
                pauseBtn.innerHTML = '<i class="fa-solid fa-play"></i>';
                pauseBtn.classList.add('is-paused');
                bar.style.transition = 'none';   // freeze bar in place
            } else {
                pauseBtn.innerHTML = '<i class="fa-solid fa-pause"></i>';
                pauseBtn.classList.remove('is-paused');
                startTs = null;
                resetBar();
            }
        });

        // ── Hover pause (only when not manually paused) ─────
        root.addEventListener('mouseenter', function () {
            if (!manualPause) paused = true;
        });
        root.addEventListener('mouseleave', function () {
            if (!manualPause) {
                paused  = false;
                startTs = null;
                resetBar();
            }
        });

        // ── Swipe support ───────────────────────────────────
        var touchX = null;
        root.addEventListener('touchstart', function (e) {
            touchX = e.changedTouches[0].screenX;
        }, { passive: true });
        root.addEventListener('touchend', function (e) {
            if (touchX === null) return;
            var diff = e.changedTouches[0].screenX - touchX;
            if (Math.abs(diff) > 40) go(diff < 0 ? current + 1 : current - 1);
            touchX = null;
        }, { passive: true });

        // ── Keyboard nav ────────────────────────────────────
        root.addEventListener('keydown', function (e) {
            if (e.key === 'ArrowRight') go(current + 1);
            if (e.key === 'ArrowLeft')  go(current - 1);
        });

        resetBar();
        rafId = requestAnimationFrame(tick);
    })();
</script>
