@{
    var reqPath  = Context.Request.Path.Value?.ToLower() ?? "";
    bool isAttr  = reqPath.StartsWith("/attributes");
    bool isAuth  = User?.Identity?.IsAuthenticated ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – City of Johannesburg Portal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16x16.png" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/css/dataTables.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/datatables.net-responsive-bs5@2.4.1/css/responsive.bootstrap5.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.bootstrap5.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/views/client-dashboard.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/views/client-dashboard-light.css" asp-append-version="true" />
    <style>
        .nav-brand {
            display: flex; align-items: center; gap: 10px;
            text-decoration: none; flex-shrink: 0; margin-right: 24px;
        }
        .nav-brand-mark {
            width: 44px; height: 44px; background: #fff;
            border-radius: 8px; display: flex; align-items: center;
            justify-content: center; overflow: hidden; padding: 4px; flex-shrink: 0;
        }
        .brand-logo { width: 100%; height: 100%; object-fit: contain; }
        .nav-brand-text { display: flex; flex-direction: column; line-height: 1.2; }
        .nav-brand-name { font-size: 13px; font-weight: 700; color: #1a1a1a; letter-spacing: 1.5px; }
        .nav-brand-sub  { font-size: 9.5px; color: rgba(0,0,0,.5); letter-spacing: .5px; }
        .cl-nav-link.active {
            background: rgba(0,0,0,.1);
            border-bottom: 2px solid #1a1a1a;
        }
        .cl-drawer-section-title {
            padding: 10px 20px 4px;
            font-size: 10px; font-weight: 700;
            letter-spacing: 1.5px; color: #999;
            text-transform: uppercase;
        }
    </style>

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

    <!-- ══ NAVBAR ══════════════════════════════════════════════════ -->
    <nav class="cl-navbar" id="clientNav">
        <div class="cl-nav-inner">

            <!-- Brand -->
            <a href="/" class="nav-brand">
                <div class="nav-brand-mark">
                    <img src="~/images/joburg_logo.png" class="brand-logo" alt="City of Johannesburg" />
                </div>
                <div class="nav-brand-text">
                    <span class="nav-brand-name">City of Johannesburg</span>
                    <span class="nav-brand-sub">@(isAttr ? "Property Attributes" : "Valuation Portal")</span>
                </div>
            </a>

            <!-- Desktop links -->
            <ul class="cl-nav-links" id="clNavLinks">

                <li class="cl-nav-item">
                    <a class="cl-nav-link @(reqPath == "/dashboard" ? "active" : "")" href="/dashboard">
                        <i class="fa-solid fa-gauge-high"></i> Dashboard
                    </a>
                </li>

                <li class="cl-nav-item">
                    <a class="cl-nav-link cl-nav-evidence @(reqPath.StartsWith("/evidence") || reqPath.StartsWith("/attributes/evidence") ? "active" : "")"
                       href="@(isAttr ? "/attributes/evidence" : "/evidence/verifyObj")">
                        <i class="fa-solid fa-paperclip"></i> Add Evidence
                    </a>
                </li>

                <li class="cl-nav-item">
                    <a class="cl-nav-link @(reqPath.StartsWith("/rebates") ? "active" : "")" href="/Rebates/Index">
                        <i class="fa-solid fa-percent"></i> Rebates
                    </a>
                </li>

                <li class="cl-nav-item cl-dropdown">
                    <button class="cl-nav-link cl-dropdown-toggle">
                        <i class="fa-solid fa-circle-question"></i> Help
                        <i class="fa-solid fa-chevron-down cl-dd-chevron"></i>
                    </button>
                    <ul class="cl-dropdown-menu">
                        <li>
                            <a class="cl-dd-item" href="/Sup1/ViewGuide">
                                <i class="fa-solid fa-book-open"></i> User Guidelines
                            </a>
                        </li>
                        <li class="cl-dd-divider"></li>
                        <li>
                            <a class="cl-dd-item" href="/Sup1/viewFAQ">
                                <i class="fa-solid fa-comments"></i> FAQ
                            </a>
                        </li>
                        <li class="cl-dd-divider"></li>
                        <li>
                            <a class="cl-dd-item" href="/Home/ContactUs">
                                <i class="fa-solid fa-headset"></i> Contact Support
                            </a>
                        </li>
                    </ul>
                </li>

                <li class="cl-nav-item">
                    <a class="cl-nav-link @(reqPath == "/home/privacy" ? "active" : "")" href="/Home/Privacy">
                        <i class="fa-solid fa-shield-halved"></i> Privacy
                    </a>
                </li>

            </ul>

            <!-- User pill -->
            @if (isAuth)
            {
                <div class="cl-user" id="clUser">
                    <button class="cl-user-btn" id="clUserBtn">
                        <div class="cl-avatar">@(User.Identity?.Name?.Substring(0,1).ToUpper() ?? "?")</div>
                        <span class="cl-user-name d-none d-lg-inline">@User.Identity?.Name?.Split('@')[0]</span>
                        <i class="fa-solid fa-chevron-down" style="font-size:11px;"></i>
                    </button>
                    <div class="cl-user-menu" id="clUserMenu">
                        <div style="padding:12px 16px 8px; border-bottom:1px solid #f0f0f0;">
                            <div style="font-size:11px; color:#888;">Signed in as</div>
                            <div style="font-size:13px; font-weight:600; color:#1a1a1a;
                                        white-space:nowrap; overflow:hidden;
                                        text-overflow:ellipsis; max-width:180px;">
                                @User.Identity?.Name
                            </div>
                        </div>
                        <a href="/my-profile" class="cl-user-item"><i class="fa-solid fa-user"></i> My Profile</a>
                        <a href="/dashboard"  class="cl-user-item"><i class="fa-solid fa-gauge-high"></i> Dashboard</a>
                        <div class="cl-dd-divider"></div>
                        <form asp-action="Logout" asp-controller="Account" method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="cl-user-item cl-logout">
                                <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div style="display:flex; gap:6px; margin-left:auto; flex-shrink:0;">
                    <a href="/account/login?returnUrl=@Context.Request.Path@Context.Request.QueryString" class="cl-nav-link">
                        <i class="fa-solid fa-right-to-bracket"></i> Sign In
                    </a>
                    <a href="/account/register" class="cl-nav-link cl-nav-evidence">
                        <i class="fa-solid fa-user-plus"></i> Register
                    </a>
                </div>
            }

            <!-- Hamburger -->
            <button class="cl-hamburger" id="clHamburger" aria-label="Open menu">
                <span></span><span></span><span></span>
            </button>

        </div>
    </nav>

    <!-- ══ MOBILE DRAWER ═══════════════════════════════════════════ -->
    <div class="cl-mobile-backdrop" id="clBackdrop"></div>
    <div class="cl-mobile-drawer" id="clDrawer">

        <div class="cl-drawer-header">
            <div style="display:flex; align-items:center; gap:10px;">
                <img src="~/images/joburg_logo.png"
                     style="width:32px; height:32px; object-fit:contain;
                            background:#e6b000; border-radius:6px; padding:3px;" />
                <span style="font-weight:700; font-size:12px; letter-spacing:1.5px; color:#fff;">
                    CITY OF JOHANNESBURG
                </span>
            </div>
            <button id="clDrawerClose" aria-label="Close menu">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        @if (isAuth)
        {
            <div style="padding:14px 20px; background:#f7f5f2; border-bottom:1px solid #ede9e3;">
                <div style="font-size:11px; color:#888; margin-bottom:2px;">Signed in as</div>
                <div style="font-size:13px; font-weight:600; color:#1a1a1a; word-break:break-all;">
                    @User.Identity?.Name
                </div>
            </div>
        }

        <div class="cl-drawer-section-title">Navigation</div>
        <a href="/dashboard" class="cl-drawer-link @(reqPath == "/dashboard" ? "active" : "")">
            <i class="fa-solid fa-gauge-high"></i> Dashboard
        </a>

        <div class="cl-drawer-section-title">Services</div>
        <a href="@(isAttr ? "/attributes/evidence" : "/evidence/verifyObj")"
           class="cl-drawer-link cl-drawer-evidence">
            <i class="fa-solid fa-paperclip"></i> Add Evidence
        </a>
        <a href="/Rebates/Index" class="cl-drawer-link">
            <i class="fa-solid fa-percent"></i> Rebates
        </a>

        <div class="cl-drawer-section-title">Support</div>
        <a href="/Sup1/ViewGuide"  class="cl-drawer-link"><i class="fa-solid fa-book-open"></i> User Guidelines</a>
        <a href="/Sup1/viewFAQ"    class="cl-drawer-link"><i class="fa-solid fa-comments"></i> FAQ</a>
        <a href="/Home/ContactUs"  class="cl-drawer-link"><i class="fa-solid fa-headset"></i> Contact Support</a>
        <a href="/Home/Privacy"    class="cl-drawer-link"><i class="fa-solid fa-shield-halved"></i> Privacy Policy</a>

        <div class="cl-dd-divider" style="margin:8px 0;"></div>

        @if (isAuth)
        {
            <a href="/my-profile" class="cl-drawer-link"><i class="fa-solid fa-user"></i> My Profile</a>
            <form asp-action="Logout" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="cl-drawer-link cl-drawer-logout">
                    <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                </button>
            </form>
        }
        else
        {
            <a href="/account/login"    class="cl-drawer-link"><i class="fa-solid fa-right-to-bracket"></i> Sign In</a>
            <a href="/account/register" class="cl-drawer-link cl-drawer-evidence"><i class="fa-solid fa-user-plus"></i> Register</a>
        }

    </div>

    <!-- ══ MAIN ════════════════════════════════════════════════════ -->
    <main class="cl-main">@RenderBody()</main>

    <!-- ══ FOOTER ══════════════════════════════════════════════════ -->
    <footer class="cl-footer">
        <div class="cl-footer-inner">
            <span class="cl-footer-brand">
                <i class="fa-solid fa-city" style="margin-right:6px;"></i>
                City of Johannesburg Valuation Portal
            </span>
            <span class="cl-footer-copy">© @DateTime.Now.Year City of Johannesburg. All rights reserved.</span>
        </div>
    </footer>

    <!-- ══ SCRIPTS ═════════════════════════════════════════════════ -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net@1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-bs5@1.13.6/js/dataTables.bootstrap5.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-responsive@2.4.1/js/dataTables.responsive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-buttons@2.4.1/js/dataTables.buttons.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/datatables.net-buttons-bs5@2.4.1/js/buttons.bootstrap5.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>

    <script>
    // ── Dropdowns ──────────────────────────────────────────────────
    document.querySelectorAll('.cl-dropdown').forEach(dd => {
        const toggle = dd.querySelector('.cl-dropdown-toggle');
        const menu   = dd.querySelector('.cl-dropdown-menu');
        if (!toggle || !menu) return;
        toggle.addEventListener('click', e => {
            e.stopPropagation();
            document.querySelectorAll('.cl-dropdown-menu.open').forEach(m => {
                if (m !== menu) m.classList.remove('open');
            });
            document.querySelectorAll('.cl-dd-chevron').forEach(c => {
                if (c !== toggle.querySelector('.cl-dd-chevron')) c.style.transform = '';
            });
            menu.classList.toggle('open');
            const chev = toggle.querySelector('.cl-dd-chevron');
            if (chev) chev.style.transform = menu.classList.contains('open') ? 'rotate(180deg)' : '';
        });
    });

    // ── Close on outside click ──────────────────────────────────────
    document.addEventListener('click', () => {
        document.querySelectorAll('.cl-dropdown-menu.open').forEach(m => m.classList.remove('open'));
        document.querySelectorAll('.cl-dd-chevron').forEach(c => c.style.transform = '');
        document.getElementById('clUserMenu')?.classList.remove('open');
    });

    // ── User pill ───────────────────────────────────────────────────
    document.getElementById('clUserBtn')?.addEventListener('click', e => {
        e.stopPropagation();
        document.getElementById('clUserMenu')?.classList.toggle('open');
    });

    // ── Mobile drawer ───────────────────────────────────────────────
    const drawer   = document.getElementById('clDrawer');
    const backdrop = document.getElementById('clBackdrop');

    function openDrawer()  { drawer?.classList.add('open'); backdrop?.classList.add('open'); document.body.style.overflow = 'hidden'; }
    function closeDrawer() { drawer?.classList.remove('open'); backdrop?.classList.remove('open'); document.body.style.overflow = ''; }

    document.getElementById('clHamburger')?.addEventListener('click', openDrawer);
    document.getElementById('clDrawerClose')?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);
    document.addEventListener('keydown', e => { if (e.key === 'Escape') closeDrawer(); });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
