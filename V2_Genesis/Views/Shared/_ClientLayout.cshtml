@using System.Security.Claims
@using Microsoft.Extensions.Options
@using V2_Genesis.Services.PropertySearch
@inject IOptions<RollDatesSettings> RollDatesOptions
@{
    var reqPath = Context.Request.Path.Value?.ToLower() ?? "";
    var openRoll = Context.Request.Query["openRoll"].ToString();

    bool isAttr = reqPath.StartsWith("/attributes");
    bool isAuth = User?.Identity?.IsAuthenticated ?? false;

    var currentEmail = User?.FindFirstValue(ClaimTypes.Name) ?? "";

    bool isAdmin = !string.IsNullOrEmpty(currentEmail) && (
        currentEmail.Equals("AdministrationEnquiries@Joburg.org.za",
            StringComparison.OrdinalIgnoreCase) ||
        System.Text.RegularExpressions.Regex.IsMatch(
            currentEmail,
            @"^val\.admin(1[0-9]?|[1-9])@joburg\.org\.za$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase));

    bool isAdminArea =
        reqPath.StartsWith("/admin");
    var rollDates = RollDatesOptions.Value;
    var periodNow = DateTime.Now;

    var objectionSearchRolls = new[]
    {
    new { Source = "Objection",       Label = "General Valuation Roll", Icon = "fa-landmark" },
    new { Source = "Objection_Supp1", Label = "Supplementary Roll 1",   Icon = "fa-scroll" },
    new { Source = "Objection_Supp2", Label = "Supplementary Roll 2",   Icon = "fa-scroll" },
    new { Source = "Objection_Supp3", Label = "Supplementary Roll 3",   Icon = "fa-scroll" },
    new { Source = "Objection_Supp4", Label = "Supplementary Roll 4",   Icon = "fa-scroll" }
};
    Func<string, bool> canSearchRoll = source =>
    {
        if (isAdmin)
            return true;

        var dates = rollDates.For(source);

        if (dates is null)
            return true;

        return
            periodNow >= dates.OpenDate &&
            periodNow <= dates.VisibleUntil;
    };

    Func<string, string, string> searchPeriodMessage =
        (source, label) =>
        {
            var dates = rollDates.For(source);

            if (dates is null)
                return $"Property search is currently closed for {label}.";

            if (periodNow < dates.OpenDate)
            {
                return
                    $"The objection period for {label} opens on " +
                    $"{dates.OpenDate:dd MMMM yyyy 'at' HH:mm}. " +
                    $"You cannot search and link a property before the period opens.";
            }

            return
                $"The objection period for {label} closed on " +
                $"{dates.VisibleUntil:dd MMMM yyyy 'at' HH:mm}. " +
                $"You can no longer search and link a property for this roll.";
        };

    bool isPropertySearchArea =
        reqPath.StartsWith("/search")
        || reqPath.StartsWith("/attributes/search")
        || !string.IsNullOrWhiteSpace(openRoll);

    bool isServiceArea =
        reqPath.StartsWith("/evidence")
        || reqPath.StartsWith("/attributes")
        || reqPath.StartsWith("/rebates")
        || reqPath.StartsWith("/notices");

    bool isSupportArea =
     reqPath.StartsWith("/help/user-manual")
     || reqPath.StartsWith("/home/faq")
     || reqPath.StartsWith("/home/contact")
     || reqPath.StartsWith("/home/privacy");
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] – City of Johannesburg Portal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16x16.png" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.dataTables.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/views/client-dashboard.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/global-action-loader.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/form-submission-loader.css"
          asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)

    <link rel="stylesheet"
          href="~/css/genesis-responsive.css"
          asp-append-version="true" />


    
</head>

<body>
    <partial name="_GlobalActionLoader" />
    <partial name="_SubmissionActionLoader" />

    <!-- ══ NAVBAR ══════════════════════════════════════════════════ -->
    <nav class="cl-navbar" id="clientNav">
        <div class="cl-nav-inner">

            <!-- Brand -->
            <a href="/" class="nav-brand">
                <div class="nav-brand-mark">
                    <img src="~/images/joburg_logo.png"
                         class="brand-logo"
                         alt="City of Johannesburg" />
                </div>

                <div class="nav-brand-text">
                    <span class="nav-brand-name">City of Johannesburg</span>
                    <span class="nav-brand-sub">
                        @(isAttr ? "Property Attributes" : "Valuation Portal")
                    </span>
                </div>
            </a>

            <!-- Desktop links -->
            <ul class="cl-nav-links" id="clNavLinks">

                <!-- Dashboard -->
                <li class="cl-nav-item">
                    <a class="cl-nav-link @(isAdmin ? (reqPath == "/admin" ? "active" : "") : (reqPath == "/dashboard" ? "active" : ""))"
                           href="@(isAdmin ? "/admin" : "/dashboard")">
                        <i class="fa-solid fa-gauge-high"></i>
                        @(isAdmin ? "Admin Dashboard" : "Dashboard")
                    </a>
                </li>

                @if (isAdmin)
                {
                    <!-- Admin Tools Dropdown -->
                    <li class="cl-nav-item cl-dropdown">
                        <button type="button"
                                class="cl-nav-link cl-dropdown-toggle @(isAdminArea ? "active" : "")">
                            <i class="fa-solid fa-shield-halved"></i>
                            Admin Tools
                            <i class="fa-solid fa-chevron-down cl-dd-chevron"></i>
                        </button>

                        <ul class="cl-dropdown-menu">
                            <li>
                                <a class="cl-dd-item" href="/admin">
                                    <i class="fa-solid fa-gauge-high"></i>
                                    Admin Dashboard
                                </a>
                            </li>

                            <li class="cl-dd-divider"></li>

                            <li>
                                <a class="cl-dd-item" href="/admin/search">
                                    <i class="fa-solid fa-magnifying-glass"></i>
                                    Search Enquiry
                                </a>
                            </li>

                            <li class="cl-dd-divider"></li>

                            <li>
                                <a class="cl-dd-item" href="/admin/notices">
                                    <i class="fa-solid fa-bell"></i>
                                    Client Notices
                                </a>
                            </li>
                        </ul>
                    </li>
                }

                <!-- Property Search Dropdown: shown to clients and Admin.
                     Admin bypasses roll-date restrictions through canSearchRoll(). -->

                <li class="cl-nav-item cl-dropdown">
                    <button type="button"
                            class="cl-nav-link cl-dropdown-toggle @(isPropertySearchArea ? "active" : "")">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        Property Search
                        <i class="fa-solid fa-chevron-down cl-dd-chevron"></i>
                    </button>

                    <ul class="cl-dropdown-menu">
                        @foreach (var roll in objectionSearchRolls)
                        {
                            var enabled = canSearchRoll(roll.Source);

                            <li>
                                @if (enabled)
                                {
                                    <a class="cl-dd-item" href="/search/@roll.Source">
                                        <i class="fa-solid @roll.Icon"></i>
                                        <span>@roll.Label</span>
                                    </a>
                                }
                                else
                                {
                                    <a class="cl-dd-item cl-dd-item-disabled"
                                           href="/Dashboard?openRoll=@roll.Source"
                                           title="The objection period is closed. Open the roll dashboard to view your linked properties and submissions.">
                                        <i class="fa-solid @roll.Icon"></i>
                                        <span>@roll.Label</span>
                                        <span class="roll-period-status">Objection Period Closed</span>
                                    </a>
                                }
                            </li>
                        }

                        <li class="cl-dd-divider"></li>

                        <li>
                            <a class="cl-dd-item" href="/search/Objection_Query">
                                <i class="fa-solid fa-magnifying-glass-chart"></i>
                                Section 78 Query / Review
                            </a>
                        </li>

                        <li>
                            <a class="cl-dd-item" href="/attributes/search">
                                <i class="fa-solid fa-clipboard-list"></i>
                                Property Attributes
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Services Dropdown -->
                <li class="cl-nav-item cl-dropdown cl-dropdown-end">
                    <button type="button"
                            class="cl-nav-link cl-dropdown-toggle @(isServiceArea ? "active" : "")">
                        <i class="fa-solid fa-briefcase"></i>
                        Services
                        <i class="fa-solid fa-chevron-down cl-dd-chevron"></i>
                    </button>

                    <ul class="cl-dropdown-menu">
                        @if (!isAdmin)
                        {
                            <li>
                                <a class="cl-dd-item" href="/notices">
                                    <i class="fa-solid fa-bell"></i>
                                    Notices
                                </a>
                            </li>

                            <li class="cl-dd-divider"></li>
                        }

                        <li>
                            <a class="cl-dd-item" href="@(isAttr ? "/attributes/evidence" : "/evidence/verifyObj")">
                                <i class="fa-solid fa-paperclip"></i>
                                Add Evidence
                            </a>
                        </li>

                        <li class="cl-dd-divider"></li>

                        <li>
                            <a class="cl-dd-item" href="/Rebates/Index">
                                <i class="fa-solid fa-percent"></i>
                                Rebates
                            </a>
                        </li>

                        <li>
                            <a class="cl-dd-item" href="/attributes/about">
                                <i class="fa-solid fa-clipboard-list"></i>
                                Property Attributes
                            </a>
                        </li>
                    </ul>
                </li>

                <!-- Help Dropdown -->
                <li class="cl-nav-item cl-dropdown cl-dropdown-end">
                    <button type="button"
                            class="cl-nav-link cl-dropdown-toggle @(isSupportArea ? "active" : "")">
                        <i class="fa-solid fa-circle-question"></i>
                        Help
                        <i class="fa-solid fa-chevron-down cl-dd-chevron"></i>
                    </button>

                    <ul class="cl-dropdown-menu">

                        <li>
                            <a class="cl-dd-item"
                                   href="/help/user-manual">
                                <i class="fa-solid fa-book"></i>
                                User Manual
                            </a>
                        </li>

                        <li class="cl-dd-divider"></li>

                        <li>
                            <a class="cl-dd-item"
                                   href="/Home/FAQ">
                                <i class="fa-solid fa-comments"></i>
                                FAQ
                            </a>
                        </li>

                        <li class="cl-dd-divider"></li>

                        <li>
                            <a class="cl-dd-item"
                                   href="/Home/Contact">
                                <i class="fa-solid fa-headset"></i>
                                Contact Support
                            </a>
                        </li>

                        <li class="cl-dd-divider"></li>

                        <li>
                            <a class="cl-dd-item"
                                   href="/Home/Privacy">
                                <i class="fa-solid fa-shield-halved"></i>
                                Privacy Policy
                            </a>
                        </li>

                    </ul>
                </li>

                <!-- Privacy -->
                <li class="cl-nav-item">
                    <a class="cl-nav-link @(reqPath == "/home/privacy" ? "active" : "")"
                           href="/Home/Privacy">
                        <i class="fa-solid fa-shield-halved"></i>
                        Privacy
                    </a>
                </li>
            </ul>

            <!-- User pill -->
            @if (isAuth)
            {
                <div class="cl-user" id="clUser">
                    <button type="button" class="cl-user-btn" id="clUserBtn">
                        <div class="cl-avatar">
                            @(User.Identity?.Name?.Substring(0, 1).ToUpper() ?? "?")
                        </div>

                        <span class="cl-user-name d-none d-lg-inline">
                            @User.Identity?.Name?.Split('@')[0]
                        </span>

                        <i class="fa-solid fa-chevron-down" style="font-size:11px;"></i>
                    </button>

                    <div class="cl-user-menu" id="clUserMenu">
                        <div style="padding:12px 16px 8px; border-bottom:1px solid #f0f0f0;">
                            <div style="font-size:11px; color:#888;">Signed in as</div>

                            <div style="font-size:13px; font-weight:600; color:#1a1a1a;
                                white-space:nowrap; overflow:hidden;
                                text-overflow:ellipsis; max-width:180px;">
                                @User.Identity?.Name
                            </div>
                        </div>

                        <a href="/my-profile" class="cl-user-item">
                            <i class="fa-solid fa-user"></i>
                            My Profile
                        </a>

                        <a href="@(isAdmin ? "/admin" : "/dashboard")" class="cl-user-item">
                            <i class="fa-solid fa-gauge-high"></i>
                            @(isAdmin ? "Admin Dashboard" : "Dashboard")
                        </a>

                        @if (isAdmin)
                        {
                            <div class="cl-dd-divider"></div>

                            <a href="/admin" class="cl-user-item">
                                <i class="fa-solid fa-shield-halved"></i>
                                Admin Panel
                            </a>
                        }

                        <div class="cl-dd-divider"></div>

                        <form asp-action="Logout" asp-controller="Account" method="post">
                            @Html.AntiForgeryToken()

                            <button type="submit" class="cl-user-item cl-logout">
                                <i class="fa-solid fa-right-from-bracket"></i>
                                Sign Out
                            </button>
                        </form>
                    </div>
                </div>
            }
            else
            {
                <div style="display:flex; gap:6px; margin-left:auto; flex-shrink:0;">
                    <a href="/account/login?returnUrl=@Context.Request.Path@Context.Request.QueryString"
                           class="cl-nav-link">
                        <i class="fa-solid fa-right-to-bracket"></i>
                        Sign In
                    </a>

                    <a href="/account/register" class="cl-nav-link cl-nav-evidence">
                        <i class="fa-solid fa-user-plus"></i>
                        Register
                    </a>
                </div>
            }

            <!-- Hamburger -->
            <button type="button" class="cl-hamburger" id="clHamburger" aria-label="Open menu" aria-controls="clDrawer" aria-expanded="false">
                <span></span>
                <span></span>
                <span></span>
            </button>

        </div>
    </nav>

    <!-- ══ MOBILE DRAWER ═══════════════════════════════════════════ -->
    <div class="cl-mobile-backdrop" id="clBackdrop"></div>

    <div class="cl-mobile-drawer" id="clDrawer">

        <div class="cl-drawer-header">
            <div style="display:flex; align-items:center; gap:10px;">
                <img src="~/images/joburg_logo.png"
                     style="width:32px; height:32px; object-fit:contain;
                background:#e6b000; border-radius:6px; padding:3px;" />

                <span style="font-weight:700; font-size:12px; letter-spacing:1.5px; color:#fff;">
                    CITY OF JOHANNESBURG
                </span>
            </div>

            <button type="button" id="clDrawerClose" aria-label="Close menu">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="cl-drawer-scroll">

            @if (isAuth)
            {
                <div style="padding:14px 20px; background:#f7f5f2; border-bottom:1px solid #ede9e3;">
                    <div style="font-size:11px; color:#888; margin-bottom:2px;">
                        Signed in as
                    </div>

                    <div style="font-size:13px; font-weight:600; color:#1a1a1a; word-break:break-all;">
                        @User.Identity?.Name
                    </div>
                </div>
            }

            <!-- Navigation -->
            <div class="cl-drawer-section-title">Navigation</div>

            <a href="@(isAdmin ? "/admin" : "/dashboard")"
                   class="cl-drawer-link @(isAdmin ? (reqPath == "/admin" ? "active" : "") : (reqPath == "/dashboard" ? "active" : ""))">
                <i class="fa-solid fa-gauge-high"></i>
                @(isAdmin ? "Admin Dashboard" : "Dashboard")
            </a>

            @if (isAdmin)
            {
                <div class="cl-drawer-section-title">Admin</div>

                <a href="/admin"
                       class="cl-drawer-link @(reqPath == "/admin" ? "active" : "")">
                    <i class="fa-solid fa-shield-halved"></i>
                    Admin Dashboard
                </a>

                <a href="/admin/search" class="cl-drawer-link">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Search Enquiry
                </a>

                <a href="/admin/notices" class="cl-drawer-link">
                    <i class="fa-solid fa-bell"></i>
                    Client Notices
                </a>
            }

            <!-- Property Search
                 Shown to both clients and Admin.
                 Admin is always enabled because canSearchRoll() returns true for Admin. -->
            <div class="cl-drawer-section-title">Property Search</div>

            @foreach (var roll in objectionSearchRolls)
            {
                var enabled = canSearchRoll(roll.Source);

                if (enabled)
                {
                    <a href="/search/@roll.Source"
                           class="cl-drawer-link @(reqPath.Equals($"/search/{roll.Source}", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                        <i class="fa-solid @roll.Icon"></i>
                        <span>@roll.Label</span>
                    </a>
                }
                else
                {
                    <a href="/Dashboard?openRoll=@roll.Source"
                           class="cl-drawer-link cl-drawer-link-disabled @(openRoll == roll.Source ? "active" : "")"
                           title="The objection period is closed. Open the roll dashboard to view your linked properties and submissions.">
                        <i class="fa-solid @roll.Icon"></i>
                        <span>@roll.Label</span>
                        <span class="roll-period-status">Objection Period Closed</span>
                    </a>
                }
            }

            <a href="/search/Objection_Query"
                   class="cl-drawer-link @(reqPath.Equals("/search/objection_query", StringComparison.OrdinalIgnoreCase) ? "active" : "")">
                <i class="fa-solid fa-magnifying-glass-chart"></i>
                Section 78 Query / Review
            </a>

            <a href="/attributes/search"
                   class="cl-drawer-link @(reqPath.StartsWith("/attributes/search") ? "active" : "")">
                <i class="fa-solid fa-clipboard-list"></i>
                Property Attributes
            </a>

            <!-- Services -->
            <div class="cl-drawer-section-title">Services</div>

            @if (!isAdmin)
            {
                <a href="/notices"
                       class="cl-drawer-link @(reqPath.StartsWith("/notices") ? "active" : "")">
                    <i class="fa-solid fa-bell"></i>
                    Notices
                </a>
            }

            <a href="@(isAttr ? "/attributes/evidence" : "/evidence/verifyObj")"
                   class="cl-drawer-link cl-drawer-evidence">
                <i class="fa-solid fa-paperclip"></i>
                Add Evidence
            </a>

            <a href="/Rebates/Index"
                   class="cl-drawer-link @(reqPath.StartsWith("/rebates") ? "active" : "")">
                <i class="fa-solid fa-percent"></i>
                Rebates
            </a>

            <a href="/attributes/about"
                   class="cl-drawer-link @(reqPath.StartsWith("/attributes") ? "active" : "")">
                <i class="fa-solid fa-clipboard-list"></i>
                Property Attributes
            </a>

            <!-- Support -->
            <div class="cl-drawer-section-title">Support</div>

            <a href="/help/user-manual"
                   class="cl-drawer-link @(reqPath.StartsWith("/help/user-manual") ? "active" : "")">
                <i class="fa-solid fa-book"></i>
                User Manual
            </a>

            <a href="/Home/FAQ" class="cl-drawer-link @(reqPath == "/home/faq" ? "active" : "")">
                <i class="fa-solid fa-comments"></i>
                FAQ
            </a>

            <a href="/Home/Contact" class="cl-drawer-link @(reqPath == "/home/contact" ? "active" : "")">
                <i class="fa-solid fa-headset"></i>
                Contact Support
            </a>

            <a href="/Home/Privacy" class="cl-drawer-link @(reqPath == "/home/privacy" ? "active" : "")">
                <i class="fa-solid fa-shield-halved"></i>
                Privacy Policy
            </a>

            <div class="cl-dd-divider" style="margin:8px 0;"></div>

            @if (isAuth)
            {
                <a href="/my-profile" class="cl-drawer-link">
                    <i class="fa-solid fa-user"></i>
                    My Profile
                </a>

                <form asp-action="Logout" asp-controller="Account" method="post">
                    @Html.AntiForgeryToken()

                    <button type="submit" class="cl-drawer-link cl-drawer-logout">
                        <i class="fa-solid fa-right-from-bracket"></i>
                        Sign Out
                    </button>
                </form>
            }
            else
            {
                <a href="/account/login" class="cl-drawer-link">
                    <i class="fa-solid fa-right-to-bracket"></i>
                    Sign In
                </a>

                <a href="/account/register" class="cl-drawer-link cl-drawer-evidence">
                    <i class="fa-solid fa-user-plus"></i>
                    Register
                </a>
            }

        </div>
    </div>

    <!-- ══ MAIN ════════════════════════════════════════════════════ -->
    <main class="cl-main">
        @RenderBody()
    </main>

    <!-- ══ FOOTER ══════════════════════════════════════════════════ -->
    <footer class="cl-footer">
        <div class="cl-footer-inner">
            <span class="cl-footer-brand">
                <i class="fa-solid fa-city" style="margin-right:6px;"></i>
                City of Johannesburg Valuation Portal
            </span>

            <nav class="cl-footer-links">
                <a href="/Home/Privacy">Privacy Policy</a>
                <a href="/Home/FAQ">FAQ</a>
                <a href="/Home/Contact">Contact Us</a>
            </nav>

            <span class="cl-footer-copy">
                © @DateTime.Now.Year City of Johannesburg. All rights reserved.
            </span>
        </div>
    </footer>

    <!-- Roll availability message -->
    <div id="rollPeriodToast"
         class="roll-period-toast"
         role="status"
         aria-live="polite"
         aria-atomic="true">
        <i class="fa-solid fa-calendar-xmark"></i>
        <span id="rollPeriodToastText"></span>
        <button type="button"
                id="rollPeriodToastClose"
                aria-label="Close">
            &times;
        </button>
    </div>

    <!-- ══ SCRIPTS ═════════════════════════════════════════════════ -->

    <script src="~/js/dropdown-escape.js" asp-append-version="true"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

   


    <!-- DataTables Core -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <!-- IMPORTANT: required for the mobile + expandable row -->
    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>

    <!-- DataTables Buttons -->
    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>


    <script>
        // Desktop dropdowns
        document.querySelectorAll('.cl-dropdown').forEach(dd => {
        const toggle = dd.querySelector('.cl-dropdown-toggle');
        const menu = dd.querySelector('.cl-dropdown-menu');

        if (!toggle || !menu) return;

        toggle.addEventListener('click', e => {
        e.stopPropagation();

        document.querySelectorAll('.cl-dropdown-menu.open').forEach(m => {
        if (m !== menu) {
        m.classList.remove('open');
        }
        });

        document.querySelectorAll('.cl-dd-chevron').forEach(c => {
        if (c !== toggle.querySelector('.cl-dd-chevron')) {
        c.style.transform = '';
        }
        });

        menu.classList.toggle('open');

        const chev = toggle.querySelector('.cl-dd-chevron');

        if (chev) {
        chev.style.transform = menu.classList.contains('open')
        ? 'rotate(180deg)'
        : '';
        }
        });
        });

        document.addEventListener('click', () => {
        document.querySelectorAll('.cl-dropdown-menu.open').forEach(m => {
        m.classList.remove('open');
        });

        document.querySelectorAll('.cl-dd-chevron').forEach(c => {
        c.style.transform = '';
        });

        document.getElementById('clUserMenu')?.classList.remove('open');
        });


        // Roll period availability message
        const rollPeriodToast = document.getElementById('rollPeriodToast');
        const rollPeriodToastText = document.getElementById('rollPeriodToastText');
        let rollPeriodToastTimer;

        function showRollPeriodMessage(message) {
        if (!message) return;

        if (!rollPeriodToast || !rollPeriodToastText) {
        window.alert(message);
        return;
        }

        window.clearTimeout(rollPeriodToastTimer);
        rollPeriodToastText.textContent = message;
        rollPeriodToast.classList.add('show');

        rollPeriodToastTimer = window.setTimeout(() => {
        rollPeriodToast.classList.remove('show');
        }, 6000);
        }

        document.querySelectorAll('.js-roll-period-disabled').forEach(item => {
        item.addEventListener('click', e => {
        e.preventDefault();
        e.stopPropagation();

        if (item.closest('#clDrawer')) {
        closeDrawer();
        }

        showRollPeriodMessage(
        item.dataset.rollPeriodMessage ||
        'The objection period is closed. You can no longer search and link a property for this roll.'
        );
        });
        });

        document.getElementById('rollPeriodToastClose')?.addEventListener('click', () => {
        window.clearTimeout(rollPeriodToastTimer);
        rollPeriodToast?.classList.remove('show');
        });

        // User menu
        document.getElementById('clUserBtn')?.addEventListener('click', e => {
        e.stopPropagation();
        document.getElementById('clUserMenu')?.classList.toggle('open');
        });

        // Mobile drawer
        const drawer = document.getElementById('clDrawer');
        const backdrop = document.getElementById('clBackdrop');

        const hamburger = document.getElementById('clHamburger');

        function openDrawer() {
        drawer?.classList.add('open');
        backdrop?.classList.add('open');
        hamburger?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        }

        function closeDrawer() {
        drawer?.classList.remove('open');
        backdrop?.classList.remove('open');
        hamburger?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        }

        hamburger?.addEventListener('click', openDrawer);
        document.getElementById('clDrawerClose')?.addEventListener('click', closeDrawer);

        backdrop?.addEventListener('click', closeDrawer);


        // Close mobile menu after selecting an item and reset when returning to desktop.
        drawer?.querySelectorAll('a, button[type="submit"]').forEach(item => {
        item.addEventListener('click', closeDrawer);
        });

        window.addEventListener('resize', () => {
        if (window.innerWidth > 1180) {
        closeDrawer();
        }
        });

        document.addEventListener('keydown', e => {
        if (e.key === 'Escape') {
        closeDrawer();
        }
        });
    </script>

    <script src="~/js/global-action-loader.js" asp-append-version="true"></script>
    <script src="~/js/form-submission-loader.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
