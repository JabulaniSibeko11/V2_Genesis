@using V2_Genesis.Models.LIS
@{
    var rollSource = ViewBag.RollSource  as string       ?? "Objection_Supp3";
    var rollName   = ViewBag.RollName    as string       ?? rollSource;
    var towns      = ViewBag.Towns       as List<string> ?? new List<string>();
    var schemes    = ViewBag.Schemes     as List<string> ?? new List<string>();
    var sp         = ViewBag.SearchParams as LisSearchParams ?? new LisSearchParams();

    // ── Auto-detect probable property type from search params ─────────
    bool likelyST  = !string.IsNullOrWhiteSpace(sp.SearchScheme)
                  || !string.IsNullOrWhiteSpace(sp.SearchUnit);
    string defaultType = likelyST ? "ST" : "FH";
}
<link href="~/css/views/ommission-view.css" rel="stylesheet" asp-append-version="true" />
<div class="omit-wrap">

    <div class="omit-banner">
        <div class="omit-banner-icon">
            <i class="fa-solid fa-circle-xmark"></i>
        </div>
        <div>
            <h3 class="omit-banner-title">Property Not Found on Roll or LIS</h3>
            <p class="omit-banner-sub">
                We searched the Land Information System for <strong>@rollName</strong>
                but could not locate this property. If the property exists but is
                missing from the roll, you can lodge it as an <strong>omission</strong>.
            </p>
        </div>
    </div>

   
    <div class="omit-info">
        <i class="fa-solid fa-circle-info"></i>
        <div>
            <strong>What is an omission?</strong>
            A property that physically exists but is not included on the valuation roll.
            Lodging an omission objection notifies the City so it can be added
            and correctly valued.
        </div>
    </div>

   
    <div class="omit-card">
        <div class="omit-card-header">
            <i class="fa-solid fa-pen-to-square"></i>
            Confirm Property Details
            <span class="omit-card-sub">
                Verify the details below — we've pre-filled from your search
            </span>
        </div>

        <form method="post"
              action="/search/@rollSource/omission"
              id="omissionForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="rollSource" value="@rollSource" />
            <input type="hidden" name="propType" id="propTypeInput" value="@defaultType" />

            <div class="omit-form-body">

             
                <div class="omit-field omit-field-full">
                    <label class="omit-label">
                        <i class="fa-solid fa-house"></i>
                        Property Type <span class="omit-required">*</span>
                    </label>
                    <div class="omit-type-row">
                        <label class="omit-type-card @(defaultType == "FH" ? "selected" : "")"
                               id="lbl-FH" onclick="switchType('FH')">
                            <input type="radio" name="propTypeRadio" value="FH"
                                   @(defaultType == "FH" ? "checked" : "")
                                   style="display:none;" />
                            <i class="fa-solid fa-house-chimney"></i>
                            <div>
                                <strong>Full Title (Freehold)</strong>
                                <small>Stand / ERF based property</small>
                            </div>
                        </label>
                        <label class="omit-type-card @(defaultType == "ST" ? "selected" : "")"
                               id="lbl-ST" onclick="switchType('ST')">
                            <input type="radio" name="propTypeRadio" value="ST"
                                   @(defaultType == "ST" ? "checked" : "")
                                   style="display:none;" />
                            <i class="fa-solid fa-building"></i>
                            <div>
                                <strong>Sectional Title</strong>
                                <small>Scheme / Unit based property</small>
                            </div>
                        </label>
                    </div>
                </div>

              
                <div class="omit-field omit-field-full">
                    <label class="omit-label" for="FH_Town">
                        <i class="fa-solid fa-map-pin"></i>
                        Township <span class="omit-required">*</span>
                    </label>
                    <select name="FH_Town" id="FH_Town" class="omit-input" required>
                        <option value="">— Select Township —</option>
                        @foreach (var town in towns)
                        {
                            bool match = string.Equals(town,
                                sp.SearchTownName?.Trim(),
                                StringComparison.OrdinalIgnoreCase);
                          
                            <option value="@town" selected="@(match ? "selected" : null)">@town</option>
                        }
                    </select>
                </div>

             
                <div id="fhFields" class="omit-field-group"
                     style="display:@(defaultType == "FH" ? "contents" : "none");">

                    <div class="omit-field">
                        <label class="omit-label" for="FH_ERF">
                            <i class="fa-solid fa-hashtag"></i>
                            ERF / Stand Number
                        </label>
                        <input type="text" name="FH_ERF" id="FH_ERF"
                               class="omit-input" placeholder="e.g. 1234"
                               value="@(sp.SearchStand ?? "")" />
                    </div>

                    <div class="omit-field">
                        <label class="omit-label" for="FH_Portion">
                            <i class="fa-solid fa-square"></i>
                            Portion
                        </label>
                        <input type="text" name="FH_Portion" id="FH_Portion"
                               class="omit-input" placeholder="e.g. 0"
                               onkeypress="return isNumKey(event)" />
                    </div>

                    <div class="omit-field">
                        <label class="omit-label" for="FH_RE">
                            <i class="fa-solid fa-ruler"></i>
                            RE <span class="omit-required">*</span>
                        </label>
                        <select name="FH_RE" id="FH_RE" class="omit-input">
                            <option value="" disabled selected>Select RE option</option>
                            <option value="RE">RE</option>
                            <option value="00">00</option>
                        </select>
                    </div>

                    <div class="omit-field">
                        <label class="omit-label" for="FH_Right">
                            <i class="fa-solid fa-file-signature"></i>
                            Property Right
                            <span class="omit-optional">(optional)</span>
                        </label>
                        <select name="FH_Right" id="FH_Right" class="omit-input">
                            <option value="">None</option>
                            <option value="Lease on ">Long-Term Lease</option>
                            <option value="Mining Right on ">Mining Rights</option>
                        </select>
                    </div>

                    <div class="omit-field">
                        <label class="omit-label" for="FH_Address">
                            <i class="fa-solid fa-road"></i>
                            Street Address
                            <span class="omit-optional">(optional)</span>
                        </label>
                        <input type="text" name="FH_Address" id="FH_Address"
                               class="omit-input" placeholder="e.g. 123 Main Street"
                               value="@(sp.SearchAddress ?? "")" />
                    </div>

                </div>

                <div id="stFields" class="omit-field-group"
                     style="display:@(defaultType == "ST" ? "contents" : "none");">

                    <div class="omit-field">
                        <label class="omit-label" for="ST_Scheme">
                            <i class="fa-solid fa-building"></i>
                            Scheme Name <span class="omit-required">*</span>
                        </label>
                        @if (schemes.Any())
                        {
                            <select name="ST_Scheme" id="ST_Scheme" class="omit-input">
                                <option value="">— Select Scheme —</option>
                                @foreach (var scheme in schemes)
                                {
                                    bool match = string.Equals(scheme,
                                        sp.SearchScheme?.Trim(),
                                        StringComparison.OrdinalIgnoreCase);
                                   
                                    <option value="@scheme" selected="@(match ? "selected" : null)">@scheme</option>
                                }
                            </select>
                        }
                        else
                        {
                            <input type="text" name="ST_Scheme" id="ST_Scheme"
                                   class="omit-input" placeholder="Scheme name"
                                   value="@(sp.SearchScheme ?? "")" />
                        }
                    </div>

                    <div class="omit-field">
                        <label class="omit-label" for="ST_SchemeNumber">
                            <i class="fa-solid fa-hashtag"></i>
                            Scheme Number <span class="omit-required">*</span>
                        </label>
                        <input type="text" name="ST_SchemeNumber" id="ST_SchemeNumber"
                               class="omit-input" placeholder="e.g. 1234"
                               onkeypress="return isNumKey(event)" />
                    </div>

                    <div class="omit-field">
                        <label class="omit-label" for="ST_SchemeYear">
                            <i class="fa-solid fa-calendar-alt"></i>
                            Scheme Year <span class="omit-required">*</span>
                        </label>
                        <input type="text" name="ST_SchemeYear" id="ST_SchemeYear"
                               class="omit-input" placeholder="e.g. 2018"
                               onkeypress="return isNumKey(event)" />
                    </div>

                    <div class="omit-field">
                        <label class="omit-label" for="ST_Unit">
                            <i class="fa-solid fa-door-open"></i>
                            Unit Number <span class="omit-required">*</span>
                        </label>
                        <input type="text" name="ST_Unit" id="ST_Unit"
                               class="omit-input" placeholder="e.g. 5"
                               value="@(sp.SearchUnit ?? "")"
                               onkeypress="return isNumKey(event)" />
                    </div>

                    <div class="omit-field">
                        <label class="omit-label" for="ST_Right">
                            <i class="fa-solid fa-file-signature"></i>
                            Property Right
                            <span class="omit-optional">(optional)</span>
                        </label>
                        <select name="ST_Right" id="ST_Right" class="omit-input">
                            <option value="">None</option>
                            <option value="Lease on ">Long-Term Lease</option>
                            <option value="Mining Right on ">Mining Rights</option>
                        </select>
                    </div>

                </div>

            </div>

       
            <div class="omit-actions">
                <button type="submit" class="omit-btn-primary" id="omitSubmitBtn">
                    <i class="fa-solid fa-file-signature"></i>
                    Lodge as Omission
                </button>
                <button type="button" class="omit-btn-ghost"
                        onclick="resetOmission()">
                    <i class="fa-solid fa-rotate-left"></i>
                    Refine Search
                </button>
            </div>

        </form>
    </div>

 
    <div class="omit-notice">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <div>
            <strong>Important:</strong> Lodging an omission does not guarantee
            the property will be added to the roll. The City will investigate
            and determine the appropriate valuation. Contact
            <strong>011 407-6622</strong> for assistance.
        </div>
    </div>

</div>

<script>
function switchType(type) {
    document.getElementById('propTypeInput').value = type;

    var fh = document.getElementById('fhFields');
    var st = document.getElementById('stFields');

    if (type === 'FH') {
        fh.style.display = 'contents';
        st.style.display = 'none';
        document.getElementById('lbl-FH').classList.add('selected');
        document.getElementById('lbl-ST').classList.remove('selected');
        // FH fields required, ST not
        setRequired(['FH_Town', 'FH_RE'], true);
        setRequired(['ST_Scheme', 'ST_SchemeNumber', 'ST_SchemeYear', 'ST_Unit'], false);
    } else {
        fh.style.display = 'none';
        st.style.display = 'contents';
        document.getElementById('lbl-ST').classList.add('selected');
        document.getElementById('lbl-FH').classList.remove('selected');
        setRequired(['ST_Scheme', 'ST_SchemeNumber', 'ST_SchemeYear', 'ST_Unit'], true);
        setRequired(['FH_RE'], false);
    }
}

function setRequired(ids, required) {
    ids.forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.required = required;
    });
}

function isNumKey(e) {
    var c = e.which ?? e.keyCode;
    return !(c > 31 && (c < 48 || c > 57));
}

function resetOmission() {
    document.getElementById('lisResultsContainer').innerHTML = '';
    var sf = document.querySelector('.ps-search-form, form[action*="/search/"]');
    if (sf) sf.scrollIntoView({ behavior: 'smooth', block: 'start' });
}

// Client-side validation
document.getElementById('omissionForm')?.addEventListener('submit', function(e) {
    var type = document.getElementById('propTypeInput').value;
    var town = document.getElementById('FH_Town').value.trim();

    if (!town) {
        e.preventDefault();
        showOmitError('Please select a township before proceeding.');
        document.getElementById('FH_Town').focus();
        return;
    }

    if (type === 'FH') {
        var erf = document.getElementById('FH_ERF').value.trim();
        var re  = document.getElementById('FH_RE').value;
        if (!erf) {
            e.preventDefault();
            showOmitError('Please enter the ERF / Stand number for Freehold property.');
            return;
        }
        if (!re) {
            e.preventDefault();
            showOmitError('Please select the RE option for Freehold property.');
            return;
        }
    } else {
        var scheme = document.getElementById('ST_Scheme').value.trim();
        var sNo    = document.getElementById('ST_SchemeNumber').value.trim();
        var sYr    = document.getElementById('ST_SchemeYear').value.trim();
        var unit   = document.getElementById('ST_Unit').value.trim();
        if (!scheme || !sNo || !sYr || !unit) {
            e.preventDefault();
            showOmitError('Please fill in all Scheme details: Name, Number, Year and Unit.');
            return;
        }
    }

    var btn = document.getElementById('omitSubmitBtn');
    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing…';
    btn.disabled = true;
});

function showOmitError(msg) {
    var ex = document.getElementById('omitValidationError');
    if (ex) ex.remove();
    var err = document.createElement('div');
    err.id = 'omitValidationError';
    err.className = 'omit-validation-error';
    err.innerHTML = '<i class="fa-solid fa-circle-xmark"></i> ' + msg;
    document.querySelector('.omit-actions').insertAdjacentElement('beforebegin', err);
    err.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    setTimeout(function() { err.remove(); }, 5000);
}

// Init correct required state on load
switchType('@defaultType');
</script>


