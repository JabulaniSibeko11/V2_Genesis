<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – City of Johannesburg</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16x16.png">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/css/views/homeindex1.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/layout.css" rel="stylesheet" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="@(User.IsInRole("Admin") ? "role-admin" : "role-client")">

    @{
        var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
        bool isAuth = User.Identity?.IsAuthenticated == true;
        bool isAdmin = User.IsInRole("Admin");
    }

    <!-- ══════════════════════════════════════════
         PUBLIC NAVBAR
    ══════════════════════════════════════════ -->
    <nav class="pub-nav" id="pubNav">
        <div class="pub-nav-inner">

            <!-- Brand -->
            <a asp-action="Index" asp-controller="Home" class="pub-brand">
                <div class="nav-brand-mark">
                    <img src="~/images/joburg_logo.png"
                         class="brand-logo" alt="Joburg" />
                </div>
                <div class="pub-brand-text">
                    <span class="pub-brand-name">City of Johannesburg</span>
                    <span class="pub-brand-sub">Valuation Portal</span>
                </div>
            </a>

            <!-- Desktop links -->
            <ul class="pub-nav-links">
                @if (isAuth && !isAdmin)
                {
                    <li>
                        <a href="/dashboard"
                           class="pub-nav-link @(currentPath=="/dashboard" ? "active":"")">
                            <i class="fa-solid fa-gauge-high"></i> Dashboard
                        </a>
                    </li>
                }
                @if (isAuth && isAdmin)
                {
                    <li>
                        <a href="/admin"
                           class="pub-nav-link @(currentPath=="/admin" ? "active":"")">
                            <i class="fa-solid fa-shield-halved"></i> Admin
                        </a>
                    </li>
                }
            </ul>
            <a href="/section51/verify" class="pub-nav-evidence">
                <i class="fa-solid fa-file-circle-check"></i>
                Section 51
            </a>
            @* ── Add Evidence — visible to EVERYONE ── *@
            <a href="/evidence/verify" class="pub-nav-evidence">
                <i class="fa-solid fa-upload"></i>
                Add Evidence
            </a>

            <!-- Right side — auth or sign in -->
            <div class="pub-nav-right">
                @if (isAuth)
                {
                    <div style="position:relative;" id="pubUserWrap">
                        <button class="pub-user-btn" id="pubUserBtn">
                            <div class="pub-avatar">
                                @User.Identity!.Name?.Substring(0,1).ToUpper()
                            </div>
                            <span class="d-none d-md-inline">
                                @(isAdmin ? "Admin" : User.Identity.Name?.Split('@')[0])
                            </span>
                            <i class="fa-solid fa-chevron-down" style="font-size:10px;"></i>
                        </button>
                        <div class="pub-user-menu" id="pubUserMenu">
                            @if (!isAdmin)
                            {
                                <a href="/my-profile" class="pub-dd-item">
                                    <i class="fa-solid fa-user"></i> My Profile
                                </a>
                                <div class="pub-dd-divider"></div>
                            }
                            <form asp-action="Logout" asp-controller="Account" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="pub-dd-item pub-dd-logout">
                                    <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/login" class="pub-btn-signin">
                        <i class="fa-solid fa-right-to-bracket"></i> Sign In
                    </a>
                    <a href="/register" class="pub-btn-register">
                        <i class="fa-solid fa-user-plus"></i> Register
                    </a>
                }
            </div>

            <!-- Hamburger -->
            <button class="pub-hamburger" id="pubHamburger">
                <span></span><span></span><span></span>
            </button>

        </div>
    </nav>

    <!-- Mobile overlay + drawer -->
    <div class="pub-mobile-overlay" id="pubOverlay"></div>
    <div class="pub-mobile-drawer" id="pubDrawer">

        <div class="pub-drawer-header">
            <span style="font-size:11px;font-weight:800;letter-spacing:2px;color:#e6b000;">
                CITY OF JOHANNESBURG
            </span>
            <button class="pub-drawer-close" id="pubDrawerClose">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <a href="/section51/verify" class="pub-drawer-link">
            <i class="fa-solid fa-file-circle-check"></i> Section 51 Upload
        </a>
        @* Add Evidence — always at top of mobile menu *@
        <a href="/evidence/verify" class="pub-drawer-link pub-drawer-evidence">
            <i class="fa-solid fa-upload"></i> Add Evidence
        </a>

        <div class="pub-drawer-divider"></div>

        @if (isAuth && !isAdmin)
        {
            <a href="/dashboard" class="pub-drawer-link">
                <i class="fa-solid fa-gauge-high"></i> Dashboard
            </a>
            <a href="/my-profile" class="pub-drawer-link">
                <i class="fa-solid fa-user"></i> My Profile
            </a>
        }
        @if (isAuth && isAdmin)
        {
            <a href="/admin" class="pub-drawer-link">
                <i class="fa-solid fa-shield-halved"></i> Admin Dashboard
            </a>
        }
        @if (!isAuth)
        {
            <a href="/login" class="pub-drawer-link">
                <i class="fa-solid fa-right-to-bracket"></i> Sign In
            </a>
            <a href="/register" class="pub-drawer-link">
                <i class="fa-solid fa-user-plus"></i> Register
            </a>
        }

        @if (isAuth)
        {
            <div class="pub-drawer-divider"></div>
            <form asp-action="Logout" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="pub-drawer-link pub-drawer-logout">
                    <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                </button>
            </form>
        }

    </div>

    <!-- ═══════════ MAIN ═══════════ -->
    <main class="main-content">
        @RenderBody()
    </main>

    <!-- ═══════════ FOOTER ═══════════ -->
    <footer class="site-footer">
        <div class="footer-inner">
            <div class="footer-brand">
                <span class="footer-brand-name">City of Johannesburg Valuation</span>
                <span class="footer-brand-sub">Portal</span>
            </div>
            <div class="footer-links">
                <a href="#">Terms of Use</a>
                <a href="#">POPIA Notice</a>
                <a href="#">Support</a>
            </div>
            <div class="footer-copy">
                © @DateTime.Now.Year City of Johannesburg. All rights reserved.
            </div>
        </div>
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // ── User dropdown ──────────────────────────────────────────────
        const pubUserBtn  = document.getElementById('pubUserBtn');
        const pubUserMenu = document.getElementById('pubUserMenu');

        if (pubUserBtn) {
            pubUserBtn.addEventListener('click', e => {
                e.stopPropagation();
                pubUserMenu.classList.toggle('open');
            });
            document.addEventListener('click', () => {
                pubUserMenu?.classList.remove('open');
            });
        }

        // ── Mobile drawer ──────────────────────────────────────────────
        const pubHam     = document.getElementById('pubHamburger');
        const pubDrawer  = document.getElementById('pubDrawer');
        const pubOverlay = document.getElementById('pubOverlay');
        const pubClose   = document.getElementById('pubDrawerClose');

        function openPubDrawer() {
            pubDrawer?.classList.add('open');
            pubOverlay?.classList.add('open');
            document.body.style.overflow = 'hidden';
        }
        function closePubDrawer() {
            pubDrawer?.classList.remove('open');
            pubOverlay?.classList.remove('open');
            document.body.style.overflow = '';
        }

        pubHam?.addEventListener('click',      openPubDrawer);
        pubClose?.addEventListener('click',    closePubDrawer);
        pubOverlay?.addEventListener('click',  closePubDrawer);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
