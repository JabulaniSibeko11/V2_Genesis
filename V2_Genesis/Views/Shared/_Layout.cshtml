<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] – City of Johannesburg</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />

  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.8/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.4.2/css/buttons.dataTables.min.css" />

    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16x16.png">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link href="~/css/views/homeindex1.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/layout.css" rel="stylesheet" />
    <link href="~/css/global-action-loader.css" rel="stylesheet" asp-append-version="true" />


    @await RenderSectionAsync("Styles", required: false)
    <link rel="stylesheet" href="~/css/views/genesis-datatables.css" asp-append-version="true" />

    <style>
        i[class*="fa-"], i[class^="fa-"] {
            font-family: "Font Awesome 6 Free", "Font Awesome 6 Brands" !important;
            font-weight: 900 !important;
        }
        i.fa-regular { font-weight: 400 !important; }
        i.fa-brands  { font-family: "Font Awesome 6 Brands" !important; font-weight: 400 !important; }
    </style>

</head>

<body class="@(User.IsInRole("Admin") ? "role-admin" : "role-client")">
    <partial name="_GlobalActionLoader" />

    @{
        var currentPath = Context.Request.Path.Value?.ToLower() ?? "";
        bool isAuth = User.Identity?.IsAuthenticated == true;
        bool isAdmin = User.IsInRole("Admin");
    }

    <!-- ══════════════════════════════════════════
         PUBLIC NAVBAR
    ══════════════════════════════════════════ -->
    <nav class="pub-nav" id="pubNav">
        <div class="pub-nav-inner">

            <!-- Brand -->
            <a asp-action="Index" asp-controller="Home" class="pub-brand">
                <div class="nav-brand-mark">
                    <img src="~/images/joburg_logo.png"
                         class="brand-logo" alt="Joburg" />
                </div>
               @*  <div class="pub-brand-text">
                    <span class="pub-brand-name" style="font-family:'Poppins', sans-serif">City of Johannesburg</span>
                    <span class="pub-brand-sub" style="font-family:'Poppins', sans-serif">Valuation Portal</span>
                </div> *@
            </a>

            <!-- Desktop links -->
            <ul class="pub-nav-links">
                @if (isAuth && isAdmin)
                {
                    <li>
                        <a href="/dashboard"
                           class="pub-nav-link @(currentPath=="/dashboard" ? "active":"")">
                            <i class="fa-solid fa-gauge-high"></i> Dashboard
                        </a>
                    </li>
                }
                @if (isAuth && isAdmin)
                {
                    <li>
                        <a href="/admin"
                           class="pub-nav-link @(currentPath=="/admin" ? "active":"")">
                            <i class="fa-solid fa-shield-halved"></i> Admin
                        </a>
                    </li>
                }
            </ul>
            <!-- Replace the Section 51, Add Evidence, Attr Evidence block with this -->

            <div class="pub-nav-actions">

                <!-- Evidence dropdown -->
                <div class="pub-nav-dropdown" id="pubEvidenceDrop">
                    <button type="button"
                            class="pub-nav-action-link pub-nav-dropdown-toggle"
                            id="pubEvidenceBtn"
                            onclick="togglePubDrop('pubEvidenceDrop')">
                        <i class="fa-solid fa-upload"></i>
                        Add Evidence
                        <i class="fa-solid fa-chevron-down"
                           style="font-size:10px; margin-left:2px;"></i>
                    </button>

                    <ul class="pub-nav-drop-menu">
                        <li>
                            <a href="/evidence/VerifyObj" class="pub-nav-drop-item">
                                <i class="fa-solid fa-upload"></i>
                                Objection Evidence
                            </a>
                        </li>
                        <li>
                            <a href="/section51/verify" class="pub-nav-drop-item">
                                <i class="fa-solid fa-file-circle-check"></i>
                                Section 51
                            </a>
                        </li>
                        <li>
                            <a href="/attributes/evidence" class="pub-nav-drop-item">
                                <i class="fa-solid fa-paperclip"></i>
                                Attribute Evidence
                            </a>
                        </li>
                        <li>
                            <a href="/valuer-inspection" class="pub-nav-drop-item">
                                <i class="fa-solid fa-camera"></i>
                                Valuer Physical Inspection Evidence
                            </a>
                        </li>
                        <li>
                            <a href="/evidence/verify?rollSource=Objection_Query"
                               class="pub-nav-drop-item">
                                <i class="fa-solid fa-file-alt"></i>
                                Section 78 Query / Review Evidence
                            </a>
                        </li>
                    </ul>
                </div>

                <!-- Rebates -->
                <a href="/Rebates/Index" class="pub-nav-action-link">
                    <i class="fa-solid fa-percent"></i>
                    Rebates
                </a>
                
                <a href="/Home/Privacy" class="pub-nav-action-link">
                        <i class="fa-solid fa-headset"></i>
                        Privacy
                    </a>
                
                <!-- Help dropdown -->
                <div class="pub-nav-dropdown" id="pubHelpDrop">
                    <button type="button"
                            class="pub-nav-action-link pub-nav-dropdown-toggle"
                            id="pubHelpBtn"
                            onclick="togglePubDrop('pubHelpDrop')">
                        <i class="fa-solid fa-circle-question"></i>
                        Help
                        <i class="fa-solid fa-chevron-down"
                           style="font-size:10px; margin-left:2px;"></i>
                    </button>

                    <ul class="pub-nav-drop-menu">
                        <li>
                            <a href="/Sup1/ViewGuide" class="pub-nav-drop-item">
                                <i class="fa-solid fa-book-open"></i>
                                User Guidelines
                            </a>
                        </li>

                        <li>
                            <a href="/Home/FAQ" class="pub-nav-drop-item">
                                <i class="fa-solid fa-comments"></i>
                                FAQ
                            </a>
                        </li>

                        <li>
                            <a href="/Home/Contact" class="pub-nav-drop-item">
                                <i class="fa-solid fa-headset"></i>
                                Contact Support
                            </a>
                        </li>
                       
                    </ul>
                </div>

            </div>
            <!-- Right side — auth or sign in -->
            <div class="pub-nav-right">
                @if (isAuth)
                {
                    <div style="position:relative;" id="pubUserWrap">
                        <button class="pub-user-btn" id="pubUserBtn">
                            <div class="pub-avatar">
                                @User.Identity!.Name?.Substring(0,1).ToUpper()
                            </div>
                            <span class="d-none d-md-inline">
                                @(isAdmin ? "Admin" : User.Identity.Name?.Split('@')[0])
                            </span>
                            <i class="fa-solid fa-chevron-down" style="font-size:10px;"></i>
                        </button>
                        <div class="pub-user-menu" id="pubUserMenu">
                            @if (!isAdmin)
                            {
                                <a href="/my-profile" class="pub-dd-item">
                                    <i class="fa-solid fa-user"></i> My Profile
                                </a>
                                <div class="pub-dd-divider"></div>
                            }
                            <form asp-action="Logout" asp-controller="Account" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="pub-dd-item pub-dd-logout">
                                    <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                                </button>
                            </form>
                        </div>
                    </div>
                }
                else
                {
                    <a href="/login" class="pub-btn-signin">
                        <i class="fa-solid fa-right-to-bracket"></i> Sign In
                    </a>
                    <a href="/register" class="pub-btn-register">
                        <i class="fa-solid fa-user-plus"></i> Register
                    </a>
                }
            </div>

            <!-- Hamburger -->
            <button type="button" class="pub-hamburger" id="pubHamburger" aria-label="Open navigation" aria-controls="pubDrawer" aria-expanded="false">
                <span></span><span></span><span></span>
            </button>

        </div>
    </nav>

    <!-- Mobile overlay + drawer -->
    <div class="pub-mobile-overlay" id="pubOverlay"></div>
    <div class="pub-mobile-drawer" id="pubDrawer">

        <div class="pub-drawer-header">
            <span style="font-size:11px;font-weight:800;letter-spacing:2px;color:#e6b000;">
                CITY OF JOHANNESBURG
            </span>
            <button class="pub-drawer-close" id="pubDrawerClose">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
        <a href="/evidence/verify" class="pub-drawer-link pub-drawer-evidence">
            <i class="fa-solid fa-upload"></i> Objection Evidence
        </a>
        <a href="/section51/verify" class="pub-drawer-link pub-drawer-evidence">
            <i class="fa-solid fa-file-circle-check"></i> Section 51 upload
        </a>
        <a href="/attributes/evidence" class="pub-drawer-link pub-drawer-evidence">
            <i class="fa-solid fa-paperclip"></i> Attribute Evidence
        </a>
        <a href="/valuer-inspection" class="pub-drawer-link pub-drawer-evidence">
            <i class="fa-solid fa-camera"></i> Valuer Physical Inspection Evidence
        </a>
        <a href="/evidence/verify?rollSource=Objection_Query"
           class="pub-drawer-link pub-drawer-evidence">
            <i class="fa-solid fa-file-alt"></i> Section 78 Query / Review Evidence
        </a>
        <div class="pub-drawer-divider"></div>
        <a href="/Rebates/Index" class="pub-drawer-link">
            <i class="fa-solid fa-percent"></i> Rebates
        </a>
        <a href="/Home/Privacy" class="pub-drawer-link">
            <i class="fa-solid fa-shield-halved"></i> Privacy
        </a>
        <div class="pub-drawer-divider"></div>
        <a href="/Sup1/ViewGuide" class="pub-drawer-link">
            <i class="fa-solid fa-book-open"></i> User Guidelines
        </a>
        <a href="/Home/FAQ" class="pub-drawer-link">
            <i class="fa-solid fa-comments"></i> FAQ
        </a>
        <a href="/Home/Contact" class="pub-drawer-link">
            <i class="fa-solid fa-headset"></i> Contact Support
        </a>
        @if (isAuth && !isAdmin)
        {
            <a href="/dashboard" class="pub-drawer-link">
                <i class="fa-solid fa-gauge-high"></i> Dashboard
            </a>
            <a href="/my-profile" class="pub-drawer-link">
                <i class="fa-solid fa-user"></i> My Profile
            </a>
        }
        @if (isAuth && isAdmin)
        {
            <a href="/admin" class="pub-drawer-link">
                <i class="fa-solid fa-shield-halved"></i> Admin Dashboard
            </a>
        }
        @if (!isAuth)
        {
            <a href="/login" class="pub-drawer-link">
                <i class="fa-solid fa-right-to-bracket"></i> Sign In
            </a>
            <a href="/register" class="pub-drawer-link">
                <i class="fa-solid fa-user-plus"></i> Register
            </a>
        }

        @if (isAuth)
        {
            <div class="pub-drawer-divider"></div>
            <form asp-action="Logout" asp-controller="Account" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="pub-drawer-link pub-drawer-logout">
                    <i class="fa-solid fa-right-from-bracket"></i> Sign Out
                </button>
            </form>
        }

    </div>

    <!-- ═══════════ MAIN ═══════════ -->
    <main class="main-content">
        @RenderBody()
    </main>

   <!-- ═══════════ FOOTER ═══════════ -->
    <footer class="site-footer">
        <div class="footer-top">
            <div class="footer-inner">

                <!-- Brand + about -->
                <div class="footer-col footer-col-brand">
                    <div class="footer-brand-row">
                        <div class="nav-brand-mark footer-brand-mark">
                            <img src="~/images/joburg_logo.png" alt="Joburg" class="brand-logo" />
                        </div>
                        <div>
                            <span class="footer-brand-name">City of Johannesburg</span>
                            <span class="footer-brand-sub">Valuation Services Portal</span>
                        </div>
                    </div>
                    <p class="footer-about">
                        The official portal for property valuation rolls, objections,
                        appeals, and attribute submissions for the City of Johannesburg.
                    </p>
                </div>

                <!-- Quick Links -->
                <div class="footer-col">
                    <h4 class="footer-col-title">Quick Links</h4>
                    <ul class="footer-col-links">
                        <li><a href="/">Home</a></li>
                        <li><a href="/dashboard">My Dashboard</a></li>
                        <li><a href="/Rebates/Index">Rebates</a></li>
                        <li><a href="/attributes/about">Property Attributes</a></li>
                    </ul>
                </div>

                <!-- Evidence & Support -->
                <div class="footer-col">
                    <h4 class="footer-col-title">Evidence &amp; Support</h4>
                    <ul class="footer-col-links">
                        <li><a href="/evidence/VerifyObj">Objection Evidence</a></li>
                        <li><a href="/section51/verify">Section 51</a></li>
                        <li>
                            <a href="/evidence/verify?rollSource=Objection_Query">
                                Section 78 Query / Review Evidence
                            </a>
                        </li>
                        <li><a href="/Home/FAQ">FAQ</a></li>
                        <li><a href="/Sup1/ViewGuide">User Guidelines</a></li>
                    </ul>
                </div>

                <!-- Contact -->
                <div class="footer-col">
                    <h4 class="footer-col-title">Contact Us</h4>
                    <ul class="footer-contact-list">
                        <li>
                            <i class="fa-solid fa-location-dot"></i>
                            <span>1st Floor, East Wing, 66 Jorissen Street,<br />Braamfontein, Johannesburg</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-phone"></i>
                            <span>011 407-6622 / 011 407-6597</span>
                        </li>
                        <li>
                            <i class="fa-solid fa-envelope"></i>
                            <a href="mailto:valuationenquiries@joburg.org.za">valuationenquiries@joburg.org.za</a>
                        </li>
                        <li>
                            <i class="fa-solid fa-clock"></i>
                            <span>Mon – Fri, 07:30 – 16:00</span>
                        </li>
                    </ul>
                </div>

            </div>
        </div>

        <div class="footer-bottom">
            <div class="footer-bottom-inner">
                <div class="footer-copy">
                    © @DateTime.Now.Year City of Johannesburg. All rights reserved.
                </div>
                <div class="footer-legal">
                    <a href="/Home/Privacy">Privacy Policy</a>
                    <span class="footer-dot">&middot;</span>
                    <a href="/Home/FAQ">FAQ</a>
                    <span class="footer-dot">&middot;</span>
                    <a href="/Home/Contact">Contact Us</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- Core JS libraries: jQuery must load before validation scripts in child views -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.8/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>
    <script src="https://cdn.datatables.net/buttons/2.4.2/js/buttons.html5.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/global-action-loader.js" asp-append-version="true"></script>

    <script>
            // ── User dropdown ──────────────────────────────────────────────
            const pubUserBtn = document.getElementById('pubUserBtn');
            const pubUserMenu = document.getElementById('pubUserMenu');

            if (pubUserBtn && pubUserMenu) {
                pubUserBtn.addEventListener('click', function (e) {
                    e.stopPropagation();
                    pubUserMenu.classList.toggle('open');
                });
            }

            // ── Mobile drawer ──────────────────────────────────────────────
            const pubHam = document.getElementById('pubHamburger');
            const pubDrawer = document.getElementById('pubDrawer');
            const pubOverlay = document.getElementById('pubOverlay');
            const pubClose = document.getElementById('pubDrawerClose');

            function openPubDrawer() {
                pubDrawer?.classList.add('open');
                pubOverlay?.classList.add('open');
                pubHam?.setAttribute('aria-expanded', 'true');
                document.body.style.overflow = 'hidden';
            }

            function closePubDrawer() {
                pubDrawer?.classList.remove('open');
                pubOverlay?.classList.remove('open');
                pubHam?.setAttribute('aria-expanded', 'false');
                document.body.style.overflow = '';
            }

            pubHam?.addEventListener('click', openPubDrawer);
            pubClose?.addEventListener('click', closePubDrawer);
            pubOverlay?.addEventListener('click', closePubDrawer);

            pubDrawer?.querySelectorAll('a, button[type="submit"]').forEach(function (item) {
                item.addEventListener('click', closePubDrawer);
            });

            window.addEventListener('resize', function () {
                if (window.innerWidth > 1180) {
                    closePubDrawer();
                }
            });

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closePubDrawer();
                }
            });

            // ── Public nav dropdowns: Evidence / Help ──────────────────────
            function togglePubDrop(dropId) {
                const dropdown = document.getElementById(dropId);

                if (!dropdown) return;

                document.querySelectorAll('.pub-nav-dropdown').forEach(function (item) {
                    if (item.id !== dropId) {
                        item.classList.remove('open');
                    }
                });

                dropdown.classList.toggle('open');
            }

            // ── Close menus on outside click ───────────────────────────────
            document.addEventListener('click', function (e) {
                if (!e.target.closest('.pub-nav-dropdown')) {
                    document.querySelectorAll('.pub-nav-dropdown').forEach(function (item) {
                        item.classList.remove('open');
                    }); 
                }

                if (!e.target.closest('#pubUserWrap')) {
                    pubUserMenu?.classList.remove('open');
                }
            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
