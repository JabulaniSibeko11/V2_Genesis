@model V2_Genesis.Models.ViewModels.Attributes.AttributeSubmissionViewModel

@{
    bool isRes = Model.FormType == "Residential";
    bool isSt = Model.FormType == "ResidentialST";
    bool isBus = Model.FormType == "BusinessCommercial";
    bool isDrc = Model.FormType == "DRCMethod";

    string DisplayValue(object? value)
    {
        if (value == null) return "–";
        var text = value.ToString();
        return string.IsNullOrWhiteSpace(text) ? "–" : text;
    }

    string BoolValue(bool? value)
    {
        if (value == true) return "Yes";
        if (value == false) return "No";
        return "–";
    }

    bool HasBusinessBuildingData()
    {
        return Model.BusinessBuildings != null &&
               Model.BusinessBuildings.Any(x =>
                   !string.IsNullOrWhiteSpace(x.BuildingNr) ||
                   !string.IsNullOrWhiteSpace(x.Quality) ||
                   !string.IsNullOrWhiteSpace(x.Condition) ||
                   x.YearBuilt != null ||
                   x.Storeys != null ||
                   x.GBA != null);
    }

    bool HasBusinessSectionData()
    {
        return Model.BusinessSections != null &&
               Model.BusinessSections.Any(x =>
                   !string.IsNullOrWhiteSpace(x.BuildingNr) ||
                   !string.IsNullOrWhiteSpace(x.Usage) ||
                   x.GBA != null ||
                   x.NLA != null ||
                   x.Rental != null);
    }

    bool HasDrcBuildingData()
    {
        return Model.DrcBuildings != null &&
               Model.DrcBuildings.Any(x =>
                   !string.IsNullOrWhiteSpace(x.BuildingDescription) ||
                   !string.IsNullOrWhiteSpace(x.Quality) ||
                   !string.IsNullOrWhiteSpace(x.Condition) ||
                   x.GrossBuildingArea != null);
    }

    bool HasDrcImprovementData()
    {
        return Model.DrcImprovements != null &&
               Model.DrcImprovements.Any(x =>
                   !string.IsNullOrWhiteSpace(x.ImprovementDescription) ||
                   !string.IsNullOrWhiteSpace(x.Quality) ||
                   !string.IsNullOrWhiteSpace(x.Condition) ||
                   x.AreaUnit != null);
    }

    bool HasDrcVacantLandData()
    {
        return Model.DrcVacantLands != null &&
               Model.DrcVacantLands.Any(x =>
                   !string.IsNullOrWhiteSpace(x.Region) ||
                   x.Area != null);
    }
}

<link href="~/css/views/attribute-ackn.css" rel="stylesheet" />

<div class="sub-wrap">

    <div class="sub-title">
        <i class="fa-solid fa-file-lines"></i>
        Submitted Attribute Information
    </div>

    @* ── Property Details ─────────────────────────── *@
    <div class="sub-card">
        <div class="sub-card-bar">
            <i class="fa-solid fa-location-dot"></i>
            <h4>Property Details</h4>
        </div>
        <div class="sub-card-body">
            <div class="sub-grid">
                <div class="sub-field full">
                    <span class="sub-field-label">Property Description</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.PropertyDesc)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">H Area</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.HArea)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Data Controller</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.DataController)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Collection Block</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.CollectionBlock)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Data Collector</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.DataCollector)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">SG Number</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.SGNumber)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Centroid</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.Centroid)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Erf</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.Erf)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Extent</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.Extent)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Sectional Title</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.SectionalTitle)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Land Use Financials</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.LandUseFinancials)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Municipality</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.Municipality)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Ward</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.Ward)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Township</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.Township)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Zoning</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.Zoning)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Sources</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.Sources)</div>
                </div>
                <div class="sub-field full">
                    <span class="sub-field-label">Address</span>
                    <div class="sub-field-value">@DisplayValue(Model.PropertyDetails?.Address)</div>
                </div>
            </div>
        </div>
    </div>

    @* ── Valuation Details ────────────────────────── *@
    <div class="sub-card">
        <div class="sub-card-bar">
            <i class="fa-solid fa-tags"></i>
            <h4>Valuation Details</h4>
        </div>
        <div class="sub-card-body">
            <div class="sub-grid">
                <div class="sub-field">
                    <span class="sub-field-label">Valuation Category on Roll</span>
                    <div class="sub-field-value">@DisplayValue(Model.ValuationDetails?.ValuationCategoryOnRoll)</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Actual Use</span>
                    <div class="sub-field-value">@DisplayValue(Model.ValuationDetails?.ActualUse)</div>
                </div>
                @if (Model.ValuationDetails?.IsMixedUse == true ||
                     !string.IsNullOrWhiteSpace(Model.ValuationDetails?.AlternateUsages))
                {
                    <div class="sub-field full">
                        <span class="sub-field-label">Mixed Use</span>
                        <div class="sub-field-value">@DisplayValue(Model.ValuationDetails?.AlternateUsages)</div>
                    </div>
                }
            </div>
        </div>
    </div>

    @* ── Contact Information ──────────────────────── *@
    <div class="sub-card">
        <div class="sub-card-bar">
            <i class="fa-solid fa-address-book"></i>
            <h4>Contact Information</h4>
        </div>
        <div class="sub-card-body">
            @if (Model.ContactInfos == null || !Model.ContactInfos.Any())
            {
                <div class="sub-empty">No contact information was submitted.</div>
            }
            else
            {
                @for (int i = 0; i < Model.ContactInfos.Count; i++)
                {
                    var contact = Model.ContactInfos[i];

                    <div class="sub-contact-block">
                        <div class="sub-contact-heading">
                            <i class="fa-solid fa-user" style="color:#006570;font-size:12px;"></i>
                            Contact @(i + 1)
                            <span class="sub-contact-badge">@(contact.IsCompany ? "Company" : "Owner")</span>
                        </div>

                        <div class="sub-grid">
                            @if (contact.IsCompany)
                            {
                                <div class="sub-field">
                                    <span class="sub-field-label">Company Name</span>
                                    <div class="sub-field-value">@DisplayValue(contact.CompanyName)</div>
                                </div>
                                <div class="sub-field">
                                    <span class="sub-field-label">Registration No.</span>
                                    <div class="sub-field-value">@DisplayValue(contact.CompanyRegistrationNumber)</div>
                                </div>
                            }
                            else
                            {
                                <div class="sub-field">
                                    <span class="sub-field-label">First Names</span>
                                    <div class="sub-field-value">@DisplayValue(contact.FirstNames)</div>
                                </div>
                                <div class="sub-field">
                                    <span class="sub-field-label">Last Name</span>
                                    <div class="sub-field-value">@DisplayValue(contact.LastName)</div>
                                </div>
                            }

                            <div class="sub-field full">
                                <span class="sub-field-label">Physical Address</span>
                                <div class="sub-field-value">@DisplayValue(contact.PhysicalAddress)</div>
                            </div>
                            <div class="sub-field full">
                                <span class="sub-field-label">Postal Address</span>
                                <div class="sub-field-value">@DisplayValue(contact.PostalAddress)</div>
                            </div>
                            <div class="sub-field">
                                <span class="sub-field-label">Email</span>
                                <div class="sub-field-value">@DisplayValue(contact.Email)</div>
                            </div>
                            <div class="sub-field">
                                <span class="sub-field-label">Cell No</span>
                                <div class="sub-field-value">@DisplayValue(contact.CellNo)</div>
                            </div>
                            <div class="sub-field">
                                <span class="sub-field-label">Home Phone</span>
                                <div class="sub-field-value">@DisplayValue(contact.HomePhoneNo)</div>
                            </div>
                            <div class="sub-field">
                                <span class="sub-field-label">Work Phone</span>
                                <div class="sub-field-value">@DisplayValue(contact.WorkPhoneNo)</div>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    @* ── Residential ───────────────────────────────── *@
    @if (isRes)
    {
        <div class="sub-card">
            <div class="sub-card-bar">
                <i class="fa-solid fa-house"></i>
                <h4>Residential Attributes</h4>
            </div>
            <div class="sub-card-body">

                <div class="sub-section-bar">Primary Attributes</div>
                <div class="sub-grid">
                    <div class="sub-field"><span class="sub-field-label">TLA 1</span><div class="sub-field-value">@DisplayValue(Model.PrimaryAttributes?.Tla1)</div></div>
                    <div class="sub-field"><span class="sub-field-label">TLA 2</span><div class="sub-field-value">@DisplayValue(Model.PrimaryAttributes?.Tla2)</div></div>
                    <div class="sub-field"><span class="sub-field-label">TLA 3</span><div class="sub-field-value">@DisplayValue(Model.PrimaryAttributes?.Tla3)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Garage</span><div class="sub-field-value">@DisplayValue(Model.PrimaryAttributes?.Garage)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Carport CP</span><div class="sub-field-value">@DisplayValue(Model.PrimaryAttributes?.CarportCp)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Granny Flat GF</span><div class="sub-field-value">@DisplayValue(Model.PrimaryAttributes?.GrannyFlatGf)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Staff Quarters SQ</span><div class="sub-field-value">@DisplayValue(Model.PrimaryAttributes?.StaffQuartersSq)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Storage</span><div class="sub-field-value">@DisplayValue(Model.PrimaryAttributes?.Storage)</div></div>
                </div>

                <div class="sub-section-bar">Secondary Attributes</div>
                <div class="sub-grid">
                    <div class="sub-field"><span class="sub-field-label">Storeys</span><div class="sub-field-value">@DisplayValue(Model.SecondaryAttributes?.Storeys)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Security</span><div class="sub-field-value">@DisplayValue(Model.SecondaryAttributes?.Security)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Noise</span><div class="sub-field-value">@DisplayValue(Model.SecondaryAttributes?.Noise)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Topography</span><div class="sub-field-value">@DisplayValue(Model.SecondaryAttributes?.Topography)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Quality</span><div class="sub-field-value">@DisplayValue(Model.SecondaryAttributes?.Quality)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Condition</span><div class="sub-field-value">@DisplayValue(Model.SecondaryAttributes?.Condition)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Swimming Pool</span><div class="sub-field-value">@BoolValue(Model.SecondaryAttributes?.SwimmingPool)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Tennis Court</span><div class="sub-field-value">@BoolValue(Model.SecondaryAttributes?.TennisCourt)</div></div>
                </div>

            </div>
        </div>
    }

    @* ── Residential ST ────────────────────────────── *@
    @if (isSt)
    {
        <div class="sub-card">
            <div class="sub-card-bar">
                <i class="fa-solid fa-building"></i>
                <h4>Residential Sectional Title Attributes</h4>
            </div>
            <div class="sub-card-body">

                <div class="sub-section-bar">Primary Attributes</div>
                <div class="sub-grid">
                    <div class="sub-field"><span class="sub-field-label">ST Main</span><div class="sub-field-value">@DisplayValue(Model.PrimaryAttributes?.STMain)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Garage</span><div class="sub-field-value">@DisplayValue(Model.PrimaryAttributes?.Garage)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Carport CP</span><div class="sub-field-value">@DisplayValue(Model.PrimaryAttributes?.CarportCp)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Storage</span><div class="sub-field-value">@DisplayValue(Model.PrimaryAttributes?.Storage)</div></div>
                </div>

                <div class="sub-section-bar">Secondary Attributes</div>
                <div class="sub-grid">
                    <div class="sub-field"><span class="sub-field-label">ST Condition</span><div class="sub-field-value">@DisplayValue(Model.SecondaryAttributes?.STCondition)</div></div>
                    <div class="sub-field"><span class="sub-field-label">ST Floor</span><div class="sub-field-value">@DisplayValue(Model.SecondaryAttributes?.STFloor)</div></div>
                    <div class="sub-field"><span class="sub-field-label">Quality</span><div class="sub-field-value">@DisplayValue(Model.SecondaryAttributes?.Quality)</div></div>
                </div>

            </div>
        </div>
    }

    @* ── Business / Non-Residential ────────────────── *@
    @if (isBus)
    {
        <div class="sub-card">
            <div class="sub-card-bar">
                <i class="fa-solid fa-store"></i>
                <h4>Non-Residential / Business and Commercial</h4>
            </div>
            <div class="sub-card-body">

                <div class="sub-section-bar">Buildings</div>
                @if (!HasBusinessBuildingData())
                {
                    <div class="sub-empty">No building information was submitted.</div>
                }
                else
                {
                    <div class="sub-table-wrap">
                        <table class="sub-table">
                            <thead>
                                <tr>
                                    <th>Building Nr</th><th>Quality</th><th>Condition</th>
                                    <th>Year Built</th><th>Storeys</th><th>GBA</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.BusinessBuildings.Where(x =>
                                   !string.IsNullOrWhiteSpace(x.BuildingNr) ||
                                   !string.IsNullOrWhiteSpace(x.Quality) ||
                                   !string.IsNullOrWhiteSpace(x.Condition) ||
                                   x.YearBuilt != null || x.Storeys != null || x.GBA != null))
                                {
                                    <tr>
                                        <td>@DisplayValue(b.BuildingNr)</td>
                                        <td>@DisplayValue(b.Quality)</td>
                                        <td>@DisplayValue(b.Condition)</td>
                                        <td>@DisplayValue(b.YearBuilt)</td>
                                        <td>@DisplayValue(b.Storeys)</td>
                                        <td>@DisplayValue(b.GBA)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="sub-section-bar">Sections / Lease Details</div>
                @if (!HasBusinessSectionData())
                {
                    <div class="sub-empty">No section information was submitted.</div>
                }
                else
                {
                    <div class="sub-table-wrap">
                        <table class="sub-table">
                            <thead>
                                <tr><th>Building Nr</th><th>Usage</th><th>GBA</th><th>NLA</th><th>Rental R/m²</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var s in Model.BusinessSections.Where(x =>
                                   !string.IsNullOrWhiteSpace(x.BuildingNr) ||
                                   !string.IsNullOrWhiteSpace(x.Usage) ||
                                   x.GBA != null || x.NLA != null || x.Rental != null))
                                {
                                    <tr>
                                        <td>@DisplayValue(s.BuildingNr)</td>
                                        <td>@DisplayValue(s.Usage)</td>
                                        <td>@DisplayValue(s.GBA)</td>
                                        <td>@DisplayValue(s.NLA)</td>
                                        <td>@DisplayValue(s.Rental)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="sub-section-bar">General</div>
                <div class="sub-grid">
                    <div class="sub-field">
                        <span class="sub-field-label">Unutilised Land Extent</span>
                        <div class="sub-field-value">@DisplayValue(Model.BusinessGeneral?.UnutilisedLandExtent)</div>
                    </div>
                </div>

            </div>
        </div>
    }

    @* ── DRC ───────────────────────────────────────── *@
    @if (isDrc)
    {
        <div class="sub-card">
            <div class="sub-card-bar">
                <i class="fa-solid fa-calculator"></i>
                <h4>DRC Method</h4>
            </div>
            <div class="sub-card-body">

                <div class="sub-section-bar">Buildings</div>
                @if (!HasDrcBuildingData())
                {
                    <div class="sub-empty">No DRC building information was submitted.</div>
                }
                else
                {
                    <div class="sub-table-wrap">
                        <table class="sub-table">
                            <thead>
                                <tr><th>Building Description</th><th>Quality</th><th>GBA</th><th>Condition</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var b in Model.DrcBuildings.Where(x =>
                                   !string.IsNullOrWhiteSpace(x.BuildingDescription) ||
                                   !string.IsNullOrWhiteSpace(x.Quality) ||
                                   !string.IsNullOrWhiteSpace(x.Condition) ||
                                   x.GrossBuildingArea != null))
                                {
                                    <tr>
                                        <td>@DisplayValue(b.BuildingDescription)</td>
                                        <td>@DisplayValue(b.Quality)</td>
                                        <td>@DisplayValue(b.GrossBuildingArea)</td>
                                        <td>@DisplayValue(b.Condition)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="sub-section-bar">Improvements</div>
                @if (!HasDrcImprovementData())
                {
                    <div class="sub-empty">No DRC improvement information was submitted.</div>
                }
                else
                {
                    <div class="sub-table-wrap">
                        <table class="sub-table">
                            <thead>
                                <tr><th>Improvement Description</th><th>Quality</th><th>Area / Unit</th><th>Condition</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var i in Model.DrcImprovements.Where(x =>
                                   !string.IsNullOrWhiteSpace(x.ImprovementDescription) ||
                                   !string.IsNullOrWhiteSpace(x.Quality) ||
                                   !string.IsNullOrWhiteSpace(x.Condition) ||
                                   x.AreaUnit != null))
                                {
                                    <tr>
                                        <td>@DisplayValue(i.ImprovementDescription)</td>
                                        <td>@DisplayValue(i.Quality)</td>
                                        <td>@DisplayValue(i.AreaUnit)</td>
                                        <td>@DisplayValue(i.Condition)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                <div class="sub-section-bar">Vacant Land</div>
                @if (!HasDrcVacantLandData())
                {
                    <div class="sub-empty">No vacant land information was submitted.</div>
                }
                else
                {
                    <div class="sub-table-wrap">
                        <table class="sub-table">
                            <thead><tr><th>Region</th><th>Area</th></tr></thead>
                            <tbody>
                                @foreach (var v in Model.DrcVacantLands.Where(x =>
                                   !string.IsNullOrWhiteSpace(x.Region) || x.Area != null))
                                {
                                    <tr>
                                        <td>@DisplayValue(v.Region)</td>
                                        <td>@DisplayValue(v.Area)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

            </div>
        </div>
    }

    @* ── Comments ──────────────────────────────────── *@
    <div class="sub-card">
        <div class="sub-card-bar">
            <i class="fa-solid fa-comment"></i>
            <h4>Additional Comments</h4>
        </div>
        <div class="sub-card-body">
            <div class="sub-comment-box">@DisplayValue(Model.ClientComment)</div>
        </div>
    </div>

    @* ── Declaration ───────────────────────────────── *@
    <div class="sub-card">
        <div class="sub-card-bar">
            <i class="fa-solid fa-signature"></i>
            <h4>Declaration</h4>
        </div>
        <div class="sub-card-body">
            <div class="sub-grid">
                <div class="sub-field">
                    <span class="sub-field-label">Declaration Accepted</span>
                    <div class="sub-field-value">@(Model.Declaration?.DeclarationAccepted == true ? "Yes" : "No")</div>
                </div>
                <div class="sub-field">
                    <span class="sub-field-label">Signature Name</span>
                    <div class="sub-field-value">@DisplayValue(Model.Declaration?.SignatureName)</div>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.Declaration?.SignaturePicture))
            {
                <div class="sub-sig-box">
                    <span class="sub-sig-label">Electronic Signature</span>
                    <img src="@Model.Declaration.SignaturePicture" alt="Signature" />
                </div>
            }
        </div>
    </div>

</div>
