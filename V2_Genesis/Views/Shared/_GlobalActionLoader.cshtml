<div id="genesisActionLoader"
     class="genesis-loader"
     role="dialog"
     aria-modal="true"
     aria-labelledby="genesisLoaderTitle"
     aria-describedby="genesisLoaderMessage"
     aria-hidden="true">
    <div class="genesis-loader-card">
        <div class="genesis-loader-brand">
            <span class="genesis-loader-logo" aria-hidden="true">
                <i class="fa-solid fa-building-columns"></i>
            </span>
            <span>City of Johannesburg Valuation Portal</span>
        </div>

        <div class="genesis-loader-body">
            <div class="genesis-loader-spinner" aria-hidden="true"></div>
            <h2 id="genesisLoaderTitle">Please wait</h2>
            <p id="genesisLoaderMessage">Your request is being processed.</p>
            <div class="genesis-loader-progress" aria-hidden="true">
                <span></span>
            </div>
            <small>Please do not refresh the page or click the button again.</small>
        </div>
    </div>
</div>
