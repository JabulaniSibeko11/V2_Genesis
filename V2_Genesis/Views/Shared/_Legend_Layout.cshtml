    <!-- ============================================================
         SCRIPTS
         ============================================================ -->

    <script src="~/js/dropdown-escape.js"
            asp-append-version="true"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>

    <script src="~/js/global-action-loader.js"
            asp-append-version="true"></script>

    <script src="~/js/form-submission-loader.js"
            asp-append-version="true"></script>

    <script>
        (() => {
        'use strict';

        // ==============================================
        // Desktop dropdowns - same as _ClientLayout
        // ==============================================
        document
        .querySelectorAll('.cl-dropdown')
        .forEach(dropdown => {

        const toggle =
        dropdown.querySelector(
        '.cl-dropdown-toggle');

        const menu =
        dropdown.querySelector(
        '.cl-dropdown-menu');

        if (!toggle || !menu) {
        return;
        }

        toggle.addEventListener(
        'click',
        event => {

        event.preventDefault();
        event.stopPropagation();

        document
        .querySelectorAll(
        '.cl-dropdown-menu.open')
        .forEach(openMenu => {

        if (openMenu !== menu) {
        openMenu.classList.remove(
        'open');
        }
        });

        document
        .querySelectorAll(
        '.cl-dd-chevron')
        .forEach(chevron => {

        if (
        chevron !==
        toggle.querySelector(
        '.cl-dd-chevron')
        ) {
        chevron.style.transform =
        '';
        }
        });

        menu.classList.toggle(
        'open');

        const chevron =
        toggle.querySelector(
        '.cl-dd-chevron');

        if (chevron) {
        chevron.style.transform =
        menu.classList.contains(
        'open')
        ? 'rotate(180deg)'
        : '';
        }
        });
        });

        function closeDesktopMenus() {
        document
        .querySelectorAll(
        '.cl-dropdown-menu.open')
        .forEach(menu => {
        menu.classList.remove(
        'open');
        });

        document
        .querySelectorAll(
        '.cl-dd-chevron')
        .forEach(chevron => {
        chevron.style.transform =
        '';
        });

        document
        .getElementById(
        'clUserMenu')
        ?.classList.remove(
        'open');
        }

        document.addEventListener(
        'click',
        closeDesktopMenus);

        // ==============================================
        // Profile - same as _ClientLayout
        // ==============================================
        document
        .getElementById(
        'clUserBtn')
        ?.addEventListener(
        'click',
        event => {

        event.preventDefault();
        event.stopPropagation();

        document
        .querySelectorAll(
        '.cl-dropdown-menu.open')
        .forEach(menu => {
        menu.classList.remove(
        'open');
        });

        document
        .getElementById(
        'clUserMenu')
        ?.classList.toggle(
        'open');
        });

        document
        .getElementById(
        'clUserMenu')
        ?.addEventListener(
        'click',
        event => {

        event.stopPropagation();
        });

        // ==============================================
        // Responsive drawer - same as _ClientLayout
        // ==============================================
        const drawer =
        document.getElementById(
        'clDrawer');

        const backdrop =
        document.getElementById(
        'clBackdrop');

        const hamburger =
        document.getElementById(
        'clHamburger');

        function openDrawer() {
        closeDesktopMenus();

        drawer?.classList.add(
        'open');

        backdrop?.classList.add(
        'open');

        hamburger?.setAttribute(
        'aria-expanded',
        'true');

        document.body.style.overflow =
        'hidden';
        }

        function closeDrawer() {
        drawer?.classList.remove(
        'open');

        backdrop?.classList.remove(
        'open');

        hamburger?.setAttribute(
        'aria-expanded',
        'false');

        document.body.style.overflow =
        '';
        }

        hamburger?.addEventListener(
        'click',
        openDrawer);

        document
        .getElementById(
        'clDrawerClose')
        ?.addEventListener(
        'click',
        closeDrawer);

        backdrop?.addEventListener(
        'click',
        closeDrawer);

        drawer
        ?.querySelectorAll(
        'a, button[type="submit"]')
        .forEach(item => {

        item.addEventListener(
        'click',
        closeDrawer);
        });

        window.addEventListener(
        'resize',
        () => {

        if (
        window.innerWidth > 1180
        ) {
        closeDrawer();
        }
        });

        document.addEventListener(
        'keydown',
        event => {

        if (
        event.key === 'Escape'
        ) {
        closeDesktopMenus();
        closeDrawer();
        }
        });
        })();
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>
