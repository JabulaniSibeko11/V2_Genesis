                Section 78
            </div>

            <a href="/search/Objection_Query"
                   class="cl-drawer-link">

                <i class="fa-solid fa-magnifying-glass"></i>
                Search Property

            </a>

            <a href="@RollDashboardUrl("Objection_Query")"
                   class="cl-drawer-link">

                <i class="fa-solid fa-gauge-high"></i>
                Dashboard

            </a>

            <!-- Rebates -->
            <div class="cl-drawer-section-title">
                Rebates
            </div>

            <a href="/Rebates/Index"
                   class="cl-drawer-link">

                <i class="fa-solid fa-file-signature"></i>
                Apply for Rebates

            </a>

            <a href="@ServiceDashboardUrl("rebates")"
                   class="cl-drawer-link">

                <i class="fa-solid fa-gauge-high"></i>
                Dashboard

            </a>

            <!-- Attributes -->
            <div class="cl-drawer-section-title">
                Property Attributes
            </div>

            <a href="/attributes/search"
                   class="cl-drawer-link">

                <i class="fa-solid fa-magnifying-glass"></i>
                Search Property

            </a>

            <a href="@ServiceDashboardUrl("attributes")"
                   class="cl-drawer-link">

                <i class="fa-solid fa-gauge-high"></i>
                Dashboard

            </a>

            <a href="/attributes/about"
                   class="cl-drawer-link">

                <i class="fa-solid fa-circle-info"></i>
                About Attributes

            </a>

            <!-- Add Evidence -->
            <div class="cl-drawer-section-title">
                Add Evidence
            </div>

            <a href="/evidence/VerifyObj"
                   class="cl-drawer-link">

                <i class="fa-solid fa-file-arrow-up"></i>
                Objection / Appeal Evidence

            </a>

            <a href="/attributes/evidence"
                   class="cl-drawer-link">

                <i class="fa-solid fa-paperclip"></i>
                Attribute Evidence

            </a>

            <a href="/evidence/verify?rollSource=Objection_Query"
                   class="cl-drawer-link">

                <i class="fa-solid fa-file-circle-plus"></i>
                Section 78 Query / Review Evidence

            </a>

            <div class="cl-dd-divider"
                 style="margin:8px 0;">
            </div>

            <!-- Profile -->
            @if (isAuthenticated)
            {
                <a href="/my-profile"
                       class="cl-drawer-link @(profileSelected ? "active" : "")">

                    <i class="fa-solid fa-user"></i>
                    My Profile

                </a>

                <a href="@dashboardUrl"
                       class="cl-drawer-link">

                    <i class="fa-solid fa-gauge-high"></i>

                    @(isAdmin
                        ? "Admin Dashboard"
                        : "Dashboard")

