@using System.Security.Claims
@using Microsoft.Extensions.Options
@using V2_Genesis.Services.PropertySearch
@inject IOptions<RollDatesSettings> RollDatesOptions

@{
    var reqPath =
        Context.Request.Path.Value?.ToLowerInvariant()
        ?? string.Empty;

    var openRoll =
        Context.Request.Query["openRoll"].ToString();

    var isAuthenticated =
        User?.Identity?.IsAuthenticated ?? false;

    var currentEmail =
        User?.FindFirstValue(ClaimTypes.Email)
        ?? User?.FindFirstValue(ClaimTypes.Name)
        ?? User?.Identity?.Name
        ?? string.Empty;

    var isAdmin =
        User?.IsInRole("Admin") == true
        || currentEmail.Equals(
            "AdministrationEnquiries@Joburg.org.za",
            StringComparison.OrdinalIgnoreCase)
        || System.Text.RegularExpressions.Regex.IsMatch(
            currentEmail,
            @"^val\.admin(1[0-9]?|[1-9])@joburg\.org\.za$",
            System.Text.RegularExpressions.RegexOptions.IgnoreCase);

    var dashboardUrl =
        isAdmin
            ? "/admin"
            : "/dashboard";

    var rollDates =
        RollDatesOptions.Value;

    var now =
        DateTime.Now;

    var supplementaryRolls = new[]
    {
        new
        {
            Source = "Objection_Supp4",
            Label = "Supplementary Roll 4",
            Icon = "fa-scroll"
        },
        new
        {
            Source = "Objection_Supp3",
            Label = "Supplementary Roll 3",
            Icon = "fa-scroll"
        },
        new
        {
            Source = "Objection_Supp2",
            Label = "Supplementary Roll 2",
            Icon = "fa-scroll"
        },
        new
        {
            Source = "Objection_Supp1",
            Label = "Supplementary Roll 1",
            Icon = "fa-scroll"
        }
    };

    bool CanSearchRoll(string source)
    {
        if (isAdmin)
            return true;

        var dates =
            rollDates.For(source);

        if (dates is null)
            return true;

        return
            now >= dates.OpenDate
            && now <= dates.VisibleUntil;
    }

    string RollStatus(string source)
    {
        var dates =
            rollDates.For(source);

        if (dates is null)
            return "Open";

        if (now < dates.OpenDate)
            return "Opening Soon";

        if (now <= dates.VisibleUntil)
            return "Open";

        return "Closed";
    }

    string RollStatusClass(string source)
    {
        var status =
            RollStatus(source);

        return status switch
        {
            "Open" => "legend-status-open",
            "Closed" => "legend-status-closed",
            _ => "legend-status-upcoming"
        };
    }

    string RollSearchNote(string source)
    {
        if (isAdmin)
            return string.Empty;

        var dates =
            rollDates.For(source);

        if (dates is null)
            return string.Empty;

        if (now < dates.OpenDate)
            return "Objection period not open";

        if (now > dates.VisibleUntil)
            return "Objection period closed";

        return string.Empty;
    }

    string RollDashboardUrl(string source) =>
        (isAdmin
            ? "/admin?openRoll="
            : "/Dashboard?openRoll=")
        + Uri.EscapeDataString(source);

    string ServiceDashboardUrl(string key) =>
        (isAdmin
            ? "/admin?openRoll="
            : "/Dashboard?openRoll=")
        + Uri.EscapeDataString(key);

    string RollSearchUrl(string source) =>
        CanSearchRoll(source)
            ? "/search/" + source
            : RollDashboardUrl(source);

    bool IsRollSelected(string source) =>
        openRoll.Equals(
            source,
            StringComparison.OrdinalIgnoreCase)
        || reqPath.Equals(
            "/search/" + source.ToLowerInvariant(),
            StringComparison.OrdinalIgnoreCase);

    var gvSelected =
        IsRollSelected("Objection");

    var supplementarySelected =
        supplementaryRolls.Any(x =>
            IsRollSelected(x.Source));

    var querySelected =
        reqPath.StartsWith("/search/objection_query")
        || openRoll.Equals(
            "Objection_Query",
            StringComparison.OrdinalIgnoreCase);

    var rebatesSelected =
        reqPath.StartsWith("/rebates")
        || openRoll.Equals(
            "rebates",
            StringComparison.OrdinalIgnoreCase);

    var attributesSelected =
        reqPath.StartsWith("/attributes")
        || openRoll.Equals(
            "attributes",
            StringComparison.OrdinalIgnoreCase);

    var evidenceSelected =
        reqPath.StartsWith("/evidence")
        || reqPath.StartsWith("/attributes/evidence");

    var supportSelected =
        reqPath.StartsWith("/help/user-manual")
        || reqPath.StartsWith("/home/faq")
        || reqPath.StartsWith("/home/contact")
        || reqPath.StartsWith("/home/privacy");

    var adminSelected =
        reqPath.StartsWith("/admin");
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>
        @ViewData["Title"] - City of Johannesburg Valuation Portal
    </title>

    <link rel="preconnect"
          href="https://fonts.googleapis.com" />

    <link rel="preconnect"
          href="https://fonts.gstatic.com"
          crossorigin />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.6/css/jquery.dataTables.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/responsive/2.4.1/css/responsive.dataTables.min.css" />

    <link rel="stylesheet"
          href="https://cdn.datatables.net/buttons/2.4.1/css/buttons.dataTables.min.css" />

    <link rel="icon"
          type="image/png"
          sizes="32x32"
          href="~/images/favicon-32x32.png" />

    <link rel="icon"
          type="image/png"
          sizes="16x16"
          href="~/images/favicon-16x16.png" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/legend-layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/global-action-loader.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/form-submission-loader.css"
          asp-append-version="true" />

    @await RenderSectionAsync(
        "Styles",
        required: false)

    <!-- Same global responsive safety net used by ClientLayout. -->
    <link rel="stylesheet"
          href="~/css/genesis-responsive.css"
          asp-append-version="true" />

</head>

<body class="legend-body">

    <partial name="_GlobalActionLoader" />
    <partial name="_SubmissionActionLoader" />

    <!-- ============================================================
         LEGEND TOP BAR
         One navigation pattern on desktop, tablet and phone.
         ============================================================ -->
    <header class="legend-topbar">

        <div class="legend-topbar-inner">

            <a href="@dashboardUrl"
                   class="legend-brand"
                   aria-label="City of Johannesburg Valuation Portal">

                <span class="legend-brand-mark">

                    <img src="~/images/joburg_logo.png"
                         alt="City of Johannesburg"
                         class="legend-brand-logo" />

                </span>

                <span class="legend-brand-copy">

                    <strong>
                        City of Johannesburg
                    </strong>

                    <small>
                        Valuation Portal
                    </small>

                </span>

            </a>

            @if (isAuthenticated)
            {
                <span class="legend-topbar-user"
                      title="@currentEmail">
                    @currentEmail
                </span>
            }

            <button type="button"
                    class="legend-menu-button"
                    id="legendMenuButton"
                    aria-controls="legendDrawer"
                    aria-expanded="false"
                    aria-label="Open navigation">

                <i class="fa-solid fa-bars"></i>

            </button>

        </div>

    </header>

    <!-- Drawer backdrop -->
    <div class="legend-drawer-backdrop"
         id="legendDrawerBackdrop"
         aria-hidden="true">
    </div>

    <!-- ============================================================
         LEGEND DRAWER
         ClientLayout-style right drawer.
         ============================================================ -->
    <aside class="legend-drawer"
           id="legendDrawer"
           aria-hidden="true"
           aria-label="Portal navigation">

        <div class="legend-drawer-header">

            <div class="legend-drawer-brand">

                <span class="legend-drawer-logo">

                    <img src="~/images/joburg_logo.png"
                         alt=""
                         class="legend-drawer-logo-image" />

                </span>

                <span>

                    <strong>
                        CITY OF JOHANNESBURG
                    </strong>

                    <small>
                        Valuation Portal
                    </small>

                </span>

            </div>

            <button type="button"
                    class="legend-drawer-close"
                    id="legendDrawerClose"
                    aria-label="Close navigation">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>

        <div class="legend-drawer-scroll">

            @if (isAuthenticated)
            {
                <div class="legend-signed-in">

                    <small>
                        Signed in as
                    </small>

                    <strong title="@currentEmail">
                        @currentEmail
                    </strong>

                </div>
            }

            <!-- ====================================================
                 VALUATION ROLLS
                 ==================================================== -->
            <div class="legend-drawer-section-title">
                Valuation Rolls
            </div>

            <!-- GV23 -->
            <div class="legend-drawer-group @(gvSelected ? "open" : "")">

                <button type="button"
                        class="legend-drawer-toggle"
                        aria-expanded="@(gvSelected ? "true" : "false")">

                    <i class="fa-solid fa-landmark"></i>

                    <span class="legend-drawer-label">
                        GV23 Valuation Roll
                    </span>

                    <span class="legend-roll-status @RollStatusClass("Objection")">
                        @RollStatus("Objection")
                    </span>

                    <i class="fa-solid fa-chevron-down legend-drawer-chevron"></i>

                </button>

                <div class="legend-drawer-sub">

                    @if (CanSearchRoll("Objection"))
                    {
                        <a href="/search/Objection"
                               class="legend-drawer-link legend-drawer-child">

                            <i class="fa-solid fa-magnifying-glass"></i>
                            Search Property

                        </a>
                    }
                    else
                    {
                        <a href="@RollDashboardUrl("Objection")"
                               class="legend-drawer-link legend-drawer-child legend-drawer-disabled">

                            <i class="fa-solid fa-lock"></i>

                            <span>
                                Search Property

                                <small class="legend-drawer-note">
                                    @RollSearchNote("Objection")
                                </small>
                            </span>

                        </a>
                    }

                    <a href="@RollDashboardUrl("Objection")"
                           class="legend-drawer-link legend-drawer-child">

                        <i class="fa-solid fa-gauge-high"></i>
                        Dashboard

                    </a>

                </div>
            </div>

            <!-- Supplementary Rolls -->
            <div class="legend-drawer-group @(supplementarySelected ? "open" : "")">

                <button type="button"
                        class="legend-drawer-toggle"
                        aria-expanded="@(supplementarySelected ? "true" : "false")">

                    <i class="fa-solid fa-scroll"></i>

                    <span class="legend-drawer-label">
                        Supplementary Rolls
                    </span>

                    <i class="fa-solid fa-chevron-down legend-drawer-chevron"></i>

                </button>

                <div class="legend-drawer-sub legend-supplementary-list">

                    @foreach (var roll in supplementaryRolls)
                    {
                        var rollSelected =
                            IsRollSelected(roll.Source);

                        <div class="legend-drawer-group legend-roll-group @(rollSelected ? "open" : "")">

                            <button type="button"
                                    class="legend-drawer-toggle legend-roll-toggle"
                                    aria-expanded="@(rollSelected ? "true" : "false")">

                                <i class="fa-solid @roll.Icon"></i>

                                <span class="legend-drawer-label">
                                    @roll.Label
                                </span>

                                <span class="legend-roll-status @RollStatusClass(roll.Source)">
                                    @RollStatus(roll.Source)
                                </span>

                                <i class="fa-solid fa-chevron-down legend-drawer-chevron"></i>

                            </button>

                            <div class="legend-drawer-sub legend-roll-actions">

                                @if (CanSearchRoll(roll.Source))
                                {
                                    <a href="/search/@roll.Source"
                                           class="legend-drawer-link legend-drawer-grandchild">

                                        <i class="fa-solid fa-magnifying-glass"></i>
                                        Search Property

                                    </a>
                                }
                                else
                                {
                                    <a href="@RollDashboardUrl(roll.Source)"
                                           class="legend-drawer-link legend-drawer-grandchild legend-drawer-disabled">

                                        <i class="fa-solid fa-lock"></i>

                                        <span>
                                            Search Property

                                            <small class="legend-drawer-note">
                                                @RollSearchNote(roll.Source)
                                            </small>
                                        </span>

                                    </a>
                                }

                                <a href="@RollDashboardUrl(roll.Source)"
                                       class="legend-drawer-link legend-drawer-grandchild">

                                    <i class="fa-solid fa-gauge-high"></i>
                                    Dashboard

                                </a>

                            </div>
                        </div>
                    }

                </div>
            </div>

            <!-- Section 78 -->
            <div class="legend-drawer-group @(querySelected ? "open" : "")">

                <button type="button"
                        class="legend-drawer-toggle"
                        aria-expanded="@(querySelected ? "true" : "false")">

                    <i class="fa-solid fa-magnifying-glass-chart"></i>

                    <span class="legend-drawer-label">
                        Section 78
                    </span>

                    <i class="fa-solid fa-chevron-down legend-drawer-chevron"></i>

                </button>

                <div class="legend-drawer-sub">

                    <a href="/search/Objection_Query"
                           class="legend-drawer-link legend-drawer-child">

                        <i class="fa-solid fa-magnifying-glass"></i>
                        Search Property

                    </a>

                    <a href="@RollDashboardUrl("Objection_Query")"
                           class="legend-drawer-link legend-drawer-child">

                        <i class="fa-solid fa-gauge-high"></i>
                        Dashboard

                    </a>

                </div>
            </div>

            <!-- Rebates -->
            <div class="legend-drawer-group @(rebatesSelected ? "open" : "")">

                <button type="button"
                        class="legend-drawer-toggle"
                        aria-expanded="@(rebatesSelected ? "true" : "false")">

                    <i class="fa-solid fa-percent"></i>

                    <span class="legend-drawer-label">
                        Rebates
                    </span>

                    <i class="fa-solid fa-chevron-down legend-drawer-chevron"></i>

                </button>

                <div class="legend-drawer-sub">

                    <a href="/Rebates/Index"
                           class="legend-drawer-link legend-drawer-child">

                        <i class="fa-solid fa-file-signature"></i>
                        Apply for Rebates

                    </a>

                    <a href="@ServiceDashboardUrl("rebates")"
                           class="legend-drawer-link legend-drawer-child">

                        <i class="fa-solid fa-gauge-high"></i>
                        Dashboard

                    </a>

                </div>
            </div>

            <!-- Property Attributes -->
            <div class="legend-drawer-group @(attributesSelected ? "open" : "")">

                <button type="button"
                        class="legend-drawer-toggle"
                        aria-expanded="@(attributesSelected ? "true" : "false")">

                    <i class="fa-solid fa-clipboard-list"></i>

                    <span class="legend-drawer-label">
                        Property Attributes
                    </span>

                    <i class="fa-solid fa-chevron-down legend-drawer-chevron"></i>

                </button>

                <div class="legend-drawer-sub">

                    <a href="/attributes/search"
                           class="legend-drawer-link legend-drawer-child">

                        <i class="fa-solid fa-magnifying-glass"></i>
                        Search Property

                    </a>

                    <a href="@ServiceDashboardUrl("attributes")"
                           class="legend-drawer-link legend-drawer-child">

                        <i class="fa-solid fa-gauge-high"></i>
                        Dashboard

                    </a>

                    <a href="/attributes/about"
                           class="legend-drawer-link legend-drawer-child">

                        <i class="fa-solid fa-circle-info"></i>
                        About Attributes

                    </a>

                </div>
            </div>

            <!-- ====================================================
                 SERVICES
                 ==================================================== -->
            <div class="legend-drawer-section-title">
                Services
            </div>

            <!-- Add Evidence
                 Section 51 intentionally hidden for this deployment.
                 Valuer Physical Inspection intentionally hidden here. -->
            <div class="legend-drawer-group @(evidenceSelected ? "open" : "")">

                <button type="button"
                        class="legend-drawer-toggle"
                        aria-expanded="@(evidenceSelected ? "true" : "false")">

                    <i class="fa-solid fa-paperclip"></i>

                    <span class="legend-drawer-label">
                        Add Evidence
                    </span>

                    <i class="fa-solid fa-chevron-down legend-drawer-chevron"></i>

                </button>

                <div class="legend-drawer-sub">

                    <a href="/evidence/VerifyObj"
                           class="legend-drawer-link legend-drawer-child">

                        <i class="fa-solid fa-file-arrow-up"></i>
                        Objection / Appeal Evidence

                    </a>

                    <a href="/attributes/evidence"
                           class="legend-drawer-link legend-drawer-child">

                        <i class="fa-solid fa-paperclip"></i>
                        Attribute Evidence

                    </a>

                    <a href="/evidence/verify?rollSource=Objection_Query"
                           class="legend-drawer-link legend-drawer-child">

                        <i class="fa-solid fa-file-circle-plus"></i>
                        Section 78 Query / Review Evidence

                    </a>

                </div>
            </div>

            @if (!isAdmin)
            {
                <a href="/notices"
                       class="legend-drawer-link @(reqPath.StartsWith("/notices") ? "active" : "")">

                    <i class="fa-solid fa-bell"></i>
                    Notices

                </a>
            }

            <!-- ====================================================
                 ADMIN
                 ==================================================== -->
            @if (isAdmin)
            {
                <div class="legend-drawer-section-title">
                    Admin
                </div>

                <div class="legend-drawer-group @(adminSelected ? "open" : "")">

                    <button type="button"
                            class="legend-drawer-toggle"
                            aria-expanded="@(adminSelected ? "true" : "false")">

                        <i class="fa-solid fa-shield-halved"></i>

                        <span class="legend-drawer-label">
                            Admin Tools
                        </span>

                        <i class="fa-solid fa-chevron-down legend-drawer-chevron"></i>

                    </button>

                    <div class="legend-drawer-sub">

                        <a href="/admin"
                               class="legend-drawer-link legend-drawer-child">

                            <i class="fa-solid fa-gauge-high"></i>
                            Admin Dashboard

                        </a>

                        <a href="/admin/search"
                               class="legend-drawer-link legend-drawer-child">

                            <i class="fa-solid fa-magnifying-glass"></i>
                            Search Enquiries

                        </a>

                        <a href="/admin/notices"
                               class="legend-drawer-link legend-drawer-child">

                            <i class="fa-solid fa-bell"></i>
                            Client Notices

                        </a>

                    </div>
                </div>
            }

            <!-- ====================================================
                 SUPPORT
                 ==================================================== -->
            <div class="legend-drawer-section-title">
                Support
            </div>

            <a href="/help/user-manual"
                   class="legend-drawer-link @(reqPath.StartsWith("/help/user-manual") ? "active" : "")">

                <i class="fa-solid fa-book"></i>
                User Manual

            </a>

            <a href="/Home/FAQ"
                   class="legend-drawer-link @(reqPath == "/home/faq" ? "active" : "")">

                <i class="fa-solid fa-comments"></i>
                FAQ

            </a>

            <a href="/Home/Contact"
                   class="legend-drawer-link @(reqPath == "/home/contact" ? "active" : "")">

                <i class="fa-solid fa-headset"></i>
                Contact Support

            </a>

            <a href="/Home/Privacy"
                   class="legend-drawer-link @(reqPath == "/home/privacy" ? "active" : "")">

                <i class="fa-solid fa-shield-halved"></i>
                Privacy Policy

            </a>

            <div class="legend-drawer-divider"></div>

            @if (isAuthenticated)
            {
                <a href="/my-profile"
                       class="legend-drawer-link @(reqPath.StartsWith("/my-profile") ? "active" : "")">

                    <i class="fa-solid fa-user"></i>
                    My Profile

                </a>

                <form asp-action="Logout"
                      asp-controller="Account"
                      method="post">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="legend-drawer-link legend-drawer-logout">

                        <i class="fa-solid fa-right-from-bracket"></i>
                        Sign Out

                    </button>

                </form>
            }
            else
            {
                <a href="/account/login?returnUrl=@Context.Request.Path@Context.Request.QueryString"
                       class="legend-drawer-link">

                    <i class="fa-solid fa-right-to-bracket"></i>
                    Sign In

                </a>
            }

        </div>

    </aside>

    <!-- ============================================================
         PAGE CONTENT
         ============================================================ -->
    <main class="legend-main">
        @RenderBody()
    </main>

    <!-- ============================================================
         FOOTER
         ============================================================ -->
    <footer class="legend-footer">

        <div class="legend-footer-inner">

            <span class="legend-footer-brand">
                <i class="fa-solid fa-city"></i>
                City of Johannesburg Valuation Portal
            </span>

            <nav class="legend-footer-links">

                <a href="/Home/Privacy">
                    Privacy Policy
                </a>

                <a href="/Home/FAQ">
                    FAQ
                </a>

                <a href="/Home/Contact">
                    Contact Us
                </a>

            </nav>

            <span class="legend-footer-copy">
                © @DateTime.Now.Year City of Johannesburg. All rights reserved.
            </span>

        </div>

    </footer>

    <!-- ============================================================
         SCRIPTS
         ============================================================ -->

    <script src="~/js/dropdown-escape.js"
            asp-append-version="true"></script>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>

    <script src="https://cdn.datatables.net/responsive/2.4.1/js/dataTables.responsive.min.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.1/js/dataTables.buttons.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/pdfmake.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.2.7/vfs_fonts.js"></script>

    <script src="https://cdn.datatables.net/buttons/2.4.1/js/buttons.html5.min.js"></script>

    <script src="~/js/global-action-loader.js"
            asp-append-version="true"></script>

    <script src="~/js/form-submission-loader.js"
            asp-append-version="true"></script>

    <script>
        (() => {

        const drawer =
        document.getElementById(
        'legendDrawer');

        const backdrop =
        document.getElementById(
        'legendDrawerBackdrop');

        const menuButton =
        document.getElementById(
        'legendMenuButton');

        const closeButton =
        document.getElementById(
        'legendDrawerClose');

        if (!drawer ||
        !backdrop ||
        !menuButton) {

        return;
        }

        function openDrawer() {

        drawer.classList.add(
        'open');

        backdrop.classList.add(
        'open');

        drawer.setAttribute(
        'aria-hidden',
        'false');

        backdrop.setAttribute(
        'aria-hidden',
        'false');

        menuButton.setAttribute(
        'aria-expanded',
        'true');

        document.body.classList.add(
        'legend-drawer-open');

        closeButton?.focus();
        }

        function closeDrawer() {

        drawer.classList.remove(
        'open');

        backdrop.classList.remove(
        'open');

        drawer.setAttribute(
        'aria-hidden',
        'true');

        backdrop.setAttribute(
        'aria-hidden',
        'true');

        menuButton.setAttribute(
        'aria-expanded',
        'false');

        document.body.classList.remove(
        'legend-drawer-open');
        }

        function closeSiblingGroups(
        group) {

        const parent =
        group.parentElement;

        if (!parent) {
        return;
        }

        Array.from(
        parent.children)
        .filter(item =>
        item.classList
        ?.contains(
        'legend-drawer-group')
        && item !== group)
        .forEach(item => {

        item.classList.remove(
        'open');

        item
        .querySelector(
        ':scope > .legend-drawer-toggle')
        ?.setAttribute(
        'aria-expanded',
        'false');
        });
        }

        drawer
        .querySelectorAll(
        '.legend-drawer-toggle')
        .forEach(toggle => {

        toggle.addEventListener(
        'click',
        event => {

        event.preventDefault();

        const group =
        toggle.closest(
        '.legend-drawer-group');

        if (!group) {
        return;
        }

        const willOpen =
        !group.classList
        .contains(
        'open');

        if (willOpen) {
        closeSiblingGroups(
        group);
        }

        group.classList.toggle(
        'open',
        willOpen);

        toggle.setAttribute(
        'aria-expanded',
        willOpen
        ? 'true'
        : 'false');
        });
        });

        menuButton.addEventListener(
        'click',
        openDrawer);

        closeButton?.addEventListener(
        'click',
        closeDrawer);

        backdrop.addEventListener(
        'click',
        closeDrawer);

        drawer
        .querySelectorAll(
        'a, button[type="submit"]')
        .forEach(item => {

        item.addEventListener(
        'click',
        () => {

        if (!item.classList
        .contains(
        'legend-drawer-toggle')) {

        closeDrawer();
        }
        });
        });

        document.addEventListener(
        'keydown',
        event => {

        if (event.key === 'Escape') {
        closeDrawer();
        }
        });

        })();
    </script>

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>
</html>
