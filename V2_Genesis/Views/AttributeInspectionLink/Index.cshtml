@model V2_Genesis.Models.ViewModels.Attributes.PublicInspectionLinkVm
@*
    Secure attribute inspection page  (/attributes/inspection/{token})
    Opened from the City e-mail or from Dashboard → Attributes → Enter PIN.

    • Anyone with the link can choose an inspection date.
    • The authorised valuer (name, phone, e-mail, vehicle, photo) is shown
      ONLY to the signed-in client who owns the submission, after the PIN,
      inside the PIN validity window (AttributeInspectionLinkController).
    • The valuer card is watermarked with the viewer's e-mail and the time,
      cannot be selected / copied / printed, and is hidden when the page
      is not in front or after 3 minutes.
    Styles: ~/css/Views/inspection-link.css
*@
@{
    ViewData["Title"] = "Attribute Inspection";
    Layout = "~/Views/Shared/_Legend_Layout.cshtml";

    var instanceKey = Model.InspectionRequestId.ToString();

    var availableSlots = Model.Slots
        .Where(x =>
            string.Equals(
                x.Status,
                "Available",
                StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.ProposedDateTime)
        .ToList();

    var dayGroups = availableSlots
        .GroupBy(x => x.ProposedDateTime.Date)
        .OrderBy(x => x.Key)
        .ToList();

    var monthStart = Model.CurrentMonth;
    var daysInMonth = DateTime.DaysInMonth(
        monthStart.Year,
        monthStart.Month);

    var leading = ((int)monthStart.DayOfWeek + 6) % 7;

    var byDate = availableSlots
        .GroupBy(x => x.ProposedDateTime.Date)
        .ToDictionary(
            x => x.Key,
            x => x.OrderBy(s => s.ProposedDateTime).ToList());

    var rawStatus = (Model.Status ?? string.Empty).Trim();

    var clientStatus = rawStatus switch
    {
        "PendingClientResponse" => "Choose a date",
        "Confirmed" => "Appointment confirmed",
        "InspectionConfirmed" => "Appointment confirmed",
        "InspectionDetailsSent" => "Valuer details released",
        "InspectionCompleted" => "Inspection completed",
        _ => "In progress"
    };

    var statusClass = rawStatus switch
    {
        "PendingClientResponse" => "waiting",
        "InspectionCompleted" => "done",
        _ => ""
    };

    var completed = rawStatus == "InspectionCompleted";
    var step1Done = Model.ConfirmedDateTime.HasValue;
    var step2Done = Model.ValuerDetailsReleased || completed;

    var pinError = TempData["InspectionPinError"]?.ToString();
    var askedForValuer = string.Equals(
        Context.Request.Query["view"].ToString(), "valuer", StringComparison.OrdinalIgnoreCase);

    // Watermark tile for the valuer card (viewer + reference + time).
    var wm = System.Net.WebUtility.HtmlEncode(Model.WatermarkText ?? "CONFIDENTIAL");
    var wmSvg =
        "<svg xmlns='http://www.w3.org/2000/svg' width='600' height='230'>" +
        "<text x='20' y='130' transform='rotate(-20 300 115)' font-family='Arial' font-size='15' font-weight='700' fill='%23003a40'>" +
        wm + "</text></svg>";
    var wmUrl = "data:image/svg+xml;utf8," + Uri.EscapeDataString(wmSvg).Replace("%2523", "%23");
}

@section Styles {
    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />
    <link href="~/css/Views/inspection-link.css" rel="stylesheet" asp-append-version="true" />
}

<div class="ail">

    <header class="ail-hero">
        <div class="ail-wrap ail-hero-inner">
            <div class="ail-hero-left">
                <div class="ail-hero-icon"><i class="fa-solid fa-house-circle-check"></i></div>
                <div>
                    <div class="ail-eyebrow">City of Johannesburg · Valuation Services</div>
                    <h1>Property Attribute <span>Inspection</span></h1>
                    <p class="ail-hero-sub">Secure appointment page for your physical inspection.</p>
                </div>
            </div>
            <div class="ail-hero-right">
                <span class="ail-chip"><i class="fa-solid fa-hashtag"></i>@Model.AttrNo</span>
                <span class="ail-chip gold"><i class="fa-solid fa-circle-dot"></i>@clientStatus</span>
            </div>
        </div>
    </header>

    <main class="ail-wrap">

        @if (TempData["InspectionLinkSuccess"] != null)
        {
            <div class="ail-alert ok" role="status">
                <i class="fa-solid fa-circle-check"></i>
                <div>@TempData["InspectionLinkSuccess"]</div>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="ail-alert info" role="status">
                <i class="fa-solid fa-circle-info"></i>
                <div>@Model.Message</div>
            </div>
        }

        @if (Model.IsExpired)
        {
            <div class="ail-alert bad" role="alert">
                <i class="fa-solid fa-link-slash"></i>
                <div>
                    <strong>This secure link has expired.</strong>
                    Please contact Valuation Administration at AdministrationEnquiries@joburg.org.za if you need help.
                </div>
            </div>
        }

        <div class="ail-grid">

            <div class="ail-main">
        @if (Model.CanSelectDate)
        {
            <section class="ail-card" aria-labelledby="calendar-heading">
                <div class="ail-card-head">
                    <div class="ico"><i class="fa-solid fa-calendar-days"></i></div>
                    <div>
                        <h2 id="calendar-heading">Choose your inspection date &amp; time</h2>
                        <p>On a phone, tap a date first and then choose the time.</p>
                    </div>
                </div>

                <div class="ail-card-body">
                    <div class="month-nav"
                         aria-label="Inspection calendar month navigation">

                        <div class="month-nav-side">
                            @if (Model.HasPreviousMonth &&
                                 Model.PreviousMonth.HasValue)
                            {
                                <a class="month-nav-btn"
                                   asp-controller="AttributeInspectionLink"
                                   asp-action="Index"
                                   asp-route-token="@Model.Token"
                                   asp-route-year="@Model.PreviousMonth.Value.Year"
                                   asp-route-month="@Model.PreviousMonth.Value.Month">
                                    <i class="fa-solid fa-chevron-left"></i> Previous
                                </a>
                            }
                            else
                            {
                                <span class="month-nav-btn disabled">
                                    <i class="fa-solid fa-chevron-left"></i> Previous
                                </span>
                            }
                        </div>

                        <div class="month-nav-title">
                            @Model.CurrentMonth.ToString("MMMM yyyy")
                        </div>

                        <div class="month-nav-side month-nav-right">
                            @if (Model.HasNextMonth &&
                                 Model.NextMonth.HasValue)
                            {
                                <a class="month-nav-btn"
                                   asp-controller="AttributeInspectionLink"
                                   asp-action="Index"
                                   asp-route-token="@Model.Token"
                                   asp-route-year="@Model.NextMonth.Value.Year"
                                   asp-route-month="@Model.NextMonth.Value.Month">
                                    Next <i class="fa-solid fa-chevron-right"></i>
                                </a>
                            }
                            else
                            {
                                <span class="month-nav-btn disabled">
                                    Next <i class="fa-solid fa-chevron-right"></i>
                                </span>
                            }
                        </div>
                    </div>

                    <div class="calendar-range-note">
                        Online booking is available from
                        <strong>@Model.MinimumMonth.ToString("MMMM yyyy")</strong>
                        to
                        <strong>@Model.MaximumMonth.ToString("MMMM yyyy")</strong>.
                    </div>

                    @if (!availableSlots.Any())
                    {
                        <div class="ail-alert info" role="status">
                            <i class="fa-solid fa-circle-info"></i>
                            <div>
                            <strong>
                                No inspection appointments are currently available
                                for @Model.CurrentMonth.ToString("MMMM yyyy").
                            </strong>

                            @if (Model.HasNextMonth)
                            {
                                <div class="small-gap">
                                    You can move to the next month or tell us that
                                    you are unavailable for this whole month.
                                </div>
                            }
                            else
                            {
                                <div class="small-gap">
                                    This is the final online booking month.
                                    If no suitable appointment is available,
                                    request assistance from Valuation Administration.
                                </div>
                            }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="cal-help">
                            Choose one suitable date and time.
                            Your selection will be checked again before
                            the appointment is confirmed.
                        </div>

                        <form asp-controller="AttributeInspectionLink"
                              asp-action="Confirm"
                              asp-route-token="@Model.Token"
                              method="post"
                              id="inspectionCalendarForm"
                              autocomplete="off">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="selectedDateTime"
                                   id="selectedDateTime" />

                            <!-- DESKTOP -->
                            <div class="calendar-desktop"
                                 aria-label="Available inspection calendar">

                                <div class="cal-month">
                                    <div class="cal-grid">
                                        @foreach (var dow in new[]
                                        {
                                            "Mon", "Tue", "Wed",
                                            "Thu", "Fri", "Sat", "Sun"
                                        })
                                        {
                                            <div class="cal-dow">@dow</div>
                                        }

                                        @for (var i = 0; i < leading; i++)
                                        {
                                            <div class="cal-day empty"
                                                 aria-hidden="true">
                                            </div>
                                        }

                                        @for (var day = 1;
                                              day <= daysInMonth;
                                              day++)
                                        {
                                            var date = new DateTime(
                                                monthStart.Year,
                                                monthStart.Month,
                                                day);

                                            byDate.TryGetValue(
                                                date,
                                                out var daySlots);

                                            <div class="cal-day @(daySlots?.Any() == true ? "available-day" : "")">
                                                <div class="cal-date">@day</div>

                                                @if (daySlots?.Any() == true)
                                                {
                                                    @foreach (var slot in daySlots)
                                                    {
                                                        var iso =
                                                            slot.ProposedDateTime
                                                                .ToString("yyyy-MM-ddTHH:mm:ss");

                                                        var label =
                                                            slot.ProposedDateTime
                                                                .ToString("dddd, dd MMMM yyyy 'at' HH:mm");

                                                        <button type="button"
                                                                class="time-btn"
                                                                data-slot="@iso"
                                                                data-label="@label"
                                                                aria-label="Select @label"
                                                                onclick="chooseInspectionSlot(this)">
                                                            @slot.ProposedDateTime.ToString("HH:mm")
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- MOBILE: DATE FIRST -->
                            <div class="mobile-date-picker"
                                 aria-label="Select inspection date">

                                <div class="mobile-calendar-grid">
                                    @foreach (var dow in new[]
                                    {
                                        "M", "T", "W", "T", "F", "S", "S"
                                    })
                                    {
                                        <div class="mobile-calendar-dow">@dow</div>
                                    }

                                    @for (var i = 0; i < leading; i++)
                                    {
                                        <div class="mobile-calendar-empty"
                                             aria-hidden="true"></div>
                                    }

                                    @for (var day = 1;
                                          day <= daysInMonth;
                                          day++)
                                    {
                                        var date = new DateTime(
                                            monthStart.Year,
                                            monthStart.Month,
                                            day);

                                        byDate.TryGetValue(
                                            date,
                                            out var mobileDaySlots);

                                        if (mobileDaySlots?.Any() == true)
                                        {
                                            var dateKey =
                                                date.ToString("yyyy-MM-dd");

                                            var fullDate =
                                                date.ToString(
                                                    "dddd, dd MMMM yyyy");

                                            <button type="button"
                                                    class="mobile-date-btn"
                                                    aria-label="Select @fullDate"
                                                    onclick="openMobileTimeSheet('@dateKey', '@fullDate')">
                                                @day
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="mobile-date-disabled"
                                                  aria-label="@date.ToString("dd MMMM yyyy") unavailable">
                                                @day
                                            </span>
                                        }
                                    }
                                </div>

                                <div class="mobile-calendar-legend">
                                    <span class="mobile-calendar-legend-dot"></span>
                                    Selectable dates have available inspection times.
                                </div>
                            </div>

                            <div class="confirm-box"
                                 id="confirmBox"
                                 role="region"
                                 aria-live="polite"
                                 aria-label="Confirm selected appointment">

                                <div class="confirm-inner">
                                    <span class="confirm-value"
                                          id="confirmValue">
                                    </span>

                                    <button type="submit"
                                            class="confirm-btn"
                                            id="confirmAppointmentButton">
                                        Confirm Appointment
                                    </button>
                                </div>
                            </div>

                            <!-- MOBILE TIME BOTTOM SHEET -->
                            <div class="mobile-time-sheet-backdrop"
                                 id="mobileTimeSheet"
                                 aria-hidden="true"
                                 onclick="closeMobileTimeSheetFromBackdrop(event)">

                                <div class="mobile-time-sheet"
                                     role="dialog"
                                     aria-modal="true"
                                     aria-labelledby="mobileTimeSheetTitle">

                                    <div class="mobile-sheet-handle"></div>

                                    <div class="mobile-sheet-head">
                                        <div>
                                            <div class="mobile-sheet-title"
                                                 id="mobileTimeSheetTitle">
                                                Select a time
                                            </div>

                                            <div class="mobile-sheet-date"
                                                 id="mobileTimeSheetDate">
                                            </div>
                                        </div>

                                        <button type="button"
                                                class="mobile-sheet-close"
                                                aria-label="Close time selection"
                                                onclick="closeMobileTimeSheet()">
                                            ×
                                        </button>
                                    </div>

                                    @foreach (var dayGroup in dayGroups)
                                    {
                                        var dateKey =
                                            dayGroup.Key.ToString("yyyy-MM-dd");

                                        <div class="mobile-time-day"
                                             data-date="@dateKey"
                                             style="display:none;">

                                            <div class="mobile-time-options">
                                                @foreach (var slot in dayGroup)
                                                {
                                                    var iso =
                                                        slot.ProposedDateTime
                                                            .ToString("yyyy-MM-ddTHH:mm:ss");

                                                    var label =
                                                        slot.ProposedDateTime
                                                            .ToString("dddd, dd MMMM yyyy 'at' HH:mm");

                                                    <button type="button"
                                                            class="mobile-sheet-time"
                                                            data-slot="@iso"
                                                            data-label="@label"
                                                            onclick="chooseMobileInspectionTime(this)">
                                                        @slot.ProposedDateTime.ToString("HH:mm")
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <div class="mobile-sheet-selected"
                                         id="mobileSheetSelected">
                                    </div>

                                    <button type="submit"
                                            class="mobile-sheet-confirm"
                                            id="mobileConfirmAppointmentButton"
                                            disabled>
                                        Confirm Appointment
                                    </button>
                                </div>
                            </div>
                        </form>
                    }

                    <div class="calendar-actions">
                        <form asp-controller="AttributeInspectionLink"
                              asp-action="UnavailableThisMonth"
                              asp-route-token="@Model.Token"
                              method="post"
                              class="calendar-action-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="year"
                                   value="@Model.CurrentMonth.Year" />

                            <input type="hidden"
                                   name="month"
                                   value="@Model.CurrentMonth.Month" />

                            <button type="submit"
                                    class="secondary-action-btn"
                                    onclick="return confirm('Confirm that you are unavailable for the whole of @Model.CurrentMonth.ToString("MMMM yyyy")?');">
                                I'm unavailable this month
                            </button>
                        </form>

                        @if (!Model.AdministrationAssistanceRequested)
                        {
                            <button type="button"
                                    class="admin-action-btn"
                                    onclick="toggleAdminAssistance()">
                                Request Administration Assistance
                            </button>
                        }
                        else
                        {
                            <div class="admin-requested">
                                <i class="fa-solid fa-circle-check"></i> Administration assistance has already been requested.
                            </div>
                        }
                    </div>

                    @if (!Model.AdministrationAssistanceRequested)
                    {
                        <div class="admin-assistance-panel"
                             id="adminAssistancePanel"
                             hidden>

                            <h3>Request Administration Assistance</h3>

                            <p>
                                Use this option if none of the online appointment
                                months work for you. Your inspection request will
                                remain open and Valuation Administration will be
                                asked to assist.
                            </p>

                            <form asp-controller="AttributeInspectionLink"
                                  asp-action="RequestAdministrationAssistance"
                                  asp-route-token="@Model.Token"
                                  method="post"
                                  autocomplete="off">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="year"
                                       value="@Model.CurrentMonth.Year" />

                                <input type="hidden"
                                       name="month"
                                       value="@Model.CurrentMonth.Month" />

                                <label for="assistanceReason">
                                    Reason / preferred arrangement
                                </label>

                                <textarea id="assistanceReason"
                                          name="reason"
                                          maxlength="500"
                                          rows="4"
                                          placeholder="Example: I am unavailable during the displayed months. Please contact me to arrange another date."></textarea>

                                <button type="submit"
                                        class="admin-submit-btn"
                                        onclick="return confirm('Send this request to Valuation Administration?');">
                                    Send Assistance Request
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </section>
        }


                @* ── Authorised valuer ─────────────────────────────────── *@
                @if (Model.ValuerAccess == "Visible" && Model.Valuer != null)
                {
                    var vehicleText = string.Join(" · ",
                        new[] { Model.Valuer.VehicleColour, Model.Valuer.VehicleMake }
                            .Where(x => !string.IsNullOrWhiteSpace(x)));
                    if (string.IsNullOrWhiteSpace(vehicleText)) { vehicleText = "-"; }

                    <section class="ail-card ail-valuer" id="ailValuer" aria-labelledby="valuer-heading">
                        <div class="ail-watermark" style="background-image:url(&quot;@Html.Raw(wmUrl)&quot;);"></div>

                        <div class="ail-card-head">
                            <div class="ico"><i class="fa-solid fa-user-shield"></i></div>
                            <div>
                                <h2 id="valuer-heading">Authorised valuer</h2>
                                <p>Check that the person and the vehicle match before you let anyone in.</p>
                            </div>
                        </div>

                        <div class="ail-card-body">
                            <div class="ail-valuer-body">
                                <div class="ail-photo">
                                    @if (Model.Valuer.HasPhoto)
                                    {
                                        <img src="@Url.Action("ValuerPhoto", new { token = Model.Token })"
                                             alt="Photo of the authorised valuer"
                                             draggable="false"
                                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex';" />
                                        <div class="ail-photo-empty" style="display:none;">
                                            <i class="fa-solid fa-user"></i>
                                            Photo not available
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="ail-photo-empty">
                                            <i class="fa-solid fa-user"></i>
                                            Photo not available
                                        </div>
                                    }
                                    <span class="ail-verified"><i class="fa-solid fa-check"></i> City official</span>
                                </div>

                                <div>
                                    <div class="ail-valuer-name">@Model.Valuer.ValuerName</div>
                                    <div class="ail-valuer-role">Valuer · City of Johannesburg Valuation Services</div>

                                    <div class="ail-kv">
                                        <div class="ail-kv-item">
                                            <span>Cell</span>
                                            <strong>@(Model.Valuer.CellNumber ?? "-")</strong>
                                        </div>
                                        <div class="ail-kv-item">
                                            <span>E-mail</span>
                                            <strong>@(Model.Valuer.EmailAddress ?? "-")</strong>
                                        </div>
                                        <div class="ail-kv-item reg">
                                            <span>Vehicle registration</span>
                                            <strong>@(Model.Valuer.VehicleRegistration ?? "-")</strong>
                                        </div>
                                        <div class="ail-kv-item">
                                            <span>Vehicle</span>
                                            <strong>@vehicleText</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="ail-safety">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <div>
                                    <strong>Safety check:</strong> do not allow the inspection if the person, the photo or
                                    the vehicle registration does not match. If you are unsure, e-mail
                                    AdministrationEnquiries@joburg.org.za before the inspection continues.
                                </div>
                            </div>

                            <div class="ail-valuer-meta">
                                <span><i class="fa-solid fa-lock"></i> Confidential. Do not share, save or screenshot.</span>
                                <span>Shown to @(Model.WatermarkText?.Split('·').ElementAtOrDefault(2)?.Trim())</span>
                            </div>
                        </div>

                        <div class="ail-shield" id="ailShield" role="status">
                            <i class="fa-solid fa-eye-slash"></i>
                            <strong>Valuer details hidden</strong>
                            <p>For the valuer's safety the details are hidden when this page is not in front or after a few minutes.</p>
                            <button type="button" class="ail-btn primary" id="ailReveal">
                                <i class="fa-solid fa-eye"></i> Show again
                            </button>
                        </div>
                    </section>
                }
                else if (Model.ValuerAccess is "Pin" or "SignIn" or "NotOwner" or "Locked" or "NotYetValid" or "Ended"
                         || (Model.ValuerAccess == "NotReleased" && Model.ConfirmedDateTime.HasValue))
                {
                    var gateBad = Model.ValuerAccess is "NotOwner" or "Locked" or "Ended";

                    <section class="ail-card" aria-labelledby="valuer-gate-heading">
                        <div class="ail-card-head">
                            <div class="ico"><i class="fa-solid fa-user-shield"></i></div>
                            <div>
                                <h2 id="valuer-gate-heading">Authorised valuer</h2>
                                <p>Who will come to the property for the inspection.</p>
                            </div>
                        </div>
                        <div class="ail-card-body">
                            <div class="ail-gate @(gateBad ? "bad" : "")">
                                @switch (Model.ValuerAccess)
                                {
                                    case "Pin":
                                        <div class="big"><i class="fa-solid fa-key"></i></div>
                                        <div>
                                            <h3>Enter your inspection PIN</h3>
                                            <p>
                                                The valuer's name, photo and vehicle are released. Enter the 4-digit PIN
                                                from the City e-mail to see them.
                                                @if (Model.PinAttemptsLeft < 5)
                                                {
                                                    <br /><strong>@Model.PinAttemptsLeft attempt@(Model.PinAttemptsLeft == 1 ? "" : "s") left.</strong>
                                                }
                                            </p>
                                            <button type="button" class="ail-btn primary" onclick="GsPin.open('@instanceKey')">
                                                <i class="fa-solid fa-unlock-keyhole"></i> Enter PIN
                                            </button>
                                        </div>
                                        break;

                                    case "SignIn":
                                        <div class="big"><i class="fa-solid fa-right-to-bracket"></i></div>
                                        <div>
                                            <h3>Sign in to see the valuer</h3>
                                            <p>
                                                To protect our valuers, their details are only shown to the account that
                                                submitted the property attributes. Sign in, then enter the PIN from the City e-mail.
                                            </p>
                                            <a class="ail-btn primary" href="@Model.LoginUrl">
                                                <i class="fa-solid fa-right-to-bracket"></i> Sign in
                                            </a>
                                        </div>
                                        break;

                                    case "NotOwner":
                                        <div class="big"><i class="fa-solid fa-user-lock"></i></div>
                                        <div>
                                            <h3>This inspection belongs to another account</h3>
                                            <p>
                                                Sign in with the account that submitted the property attributes to see the
                                                valuer. Contact Valuation Administration if you need help.
                                            </p>
                                        </div>
                                        break;

                                    case "Locked":
                                        <div class="big"><i class="fa-solid fa-lock"></i></div>
                                        <div>
                                            <h3>The PIN is locked</h3>
                                            <p>
                                                The PIN was entered incorrectly too many times. Please contact Valuation
                                                Administration at AdministrationEnquiries@joburg.org.za to unlock it.
                                            </p>
                                        </div>
                                        break;

                                    case "NotYetValid":
                                        <div class="big"><i class="fa-solid fa-hourglass-half"></i></div>
                                        <div>
                                            <h3>Available closer to the inspection</h3>
                                            <p>
                                                The valuer's details can be viewed from
                                                <strong>@Model.PinValidFrom?.ToString("dddd, dd MMMM yyyy 'at' HH:mm")</strong>.
                                            </p>
                                        </div>
                                        break;

                                    case "Ended":
                                        <div class="big"><i class="fa-solid fa-calendar-xmark"></i></div>
                                        <div>
                                            <h3>No longer available</h3>
                                            <p>The period to view the valuer's details has ended.</p>
                                        </div>
                                        break;

                                    default:
                                        <div class="big"><i class="fa-solid fa-envelope-open-text"></i></div>
                                        <div>
                                            <h3>Not released yet</h3>
                                            <p>
                                                Before the inspection you will receive an e-mail with a PIN. With the PIN you
                                                can see the valuer's name, photo and vehicle on this page.
                                            </p>
                                        </div>
                                        break;
                                }
                            </div>
                        </div>
                    </section>
                }
            </div>

            <aside class="ail-side">
                <section class="ail-card" aria-labelledby="inspection-heading">
                    <div class="ail-card-head">
                        <div class="ico"><i class="fa-solid fa-clipboard-list"></i></div>
                        <div>
                            <h2 id="inspection-heading">Your inspection</h2>
                            <p>Physical inspection of property attributes</p>
                        </div>
                    </div>
                    <div class="ail-card-body">
                        <div class="ail-facts">
                            <div class="ail-fact">
                                <span>Reference</span>
                                <strong>@Model.AttrNo</strong>
                            </div>
                            <div class="ail-fact">
                                <span>Property</span>
                                <strong>@Model.PropertyDescription</strong>
                            </div>
                            <div class="ail-fact">
                                <span>Status</span>
                                <strong class="ail-status @statusClass">@clientStatus</strong>
                            </div>
                            @if (Model.ExpiresAt.HasValue && !Model.IsExpired)
                            {
                                <div class="ail-fact">
                                    <span>Link valid until</span>
                                    <strong>@Model.ExpiresAt.Value.ToString("dd MMM yyyy HH:mm")</strong>
                                </div>
                            }
                        </div>

                        @if (Model.ConfirmedDateTime.HasValue)
                        {
                            <div class="ail-confirmed">
                                <i class="fa-solid fa-calendar-check"></i>
                                <div>
                                    <small>Appointment confirmed</small>
                                    <strong>@Model.ConfirmedDateTime.Value.ToString("dddd, dd MMMM yyyy 'at' HH:mm")</strong>
                                </div>
                            </div>
                        }
                    </div>
                </section>

                <section class="ail-card" aria-label="Progress">
                    <div class="ail-card-body">
                        <ol class="ail-steps">
                            <li class="@(step1Done ? "done" : "now")">
                                <span class="dot">@(step1Done ? Html.Raw("<i class='fa-solid fa-check'></i>") : Html.Raw("1"))</span>
                                <div><strong>Choose a date</strong>Pick a time that suits you.</div>
                            </li>
                            <li class="@(step2Done ? "done" : step1Done ? "now" : "")">
                                <span class="dot">@(step2Done ? Html.Raw("<i class='fa-solid fa-check'></i>") : Html.Raw("2"))</span>
                                <div><strong>Valuer released</strong>You get an e-mail with a PIN.</div>
                            </li>
                            <li class="@(completed ? "done" : step2Done ? "now" : "")">
                                <span class="dot">@(completed ? Html.Raw("<i class='fa-solid fa-check'></i>") : Html.Raw("3"))</span>
                                <div><strong>Inspection</strong>Check the valuer, then let them in.</div>
                            </li>
                        </ol>
                    </div>
                </section>

                <div class="ail-secure">
                    <i class="fa-solid fa-shield-halved"></i>
                    <div>
                        <strong>Keep this link private.</strong> It belongs to this inspection only. The City will never
                        ask you for money or banking details for an inspection.
                    </div>
                </div>
            </aside>
        </div>
    </main>
</div>

@if (Model.ValuerAccess == "Pin")
{
    var pinModal =
        new V2_Genesis.Models.ViewModels.Attributes.InspectionPinModalVm
        {
            InstanceKey = instanceKey,
            AppointmentRef = Model.AttrNo,
            FormAction = Url.Action(
                "VerifyPin",
                "AttributeInspectionLink",
                new { token = Model.Token })
                ?? Url.Content(
                    $"~/attributes/inspection/{Model.Token:D}/verify-pin"),
            PinFieldName = "inspectionPin",
            ConfirmedDateTime = Model.ConfirmedDateTime,
            ErrorMessage = pinError,
            AutoOpen = askedForValuer || !string.IsNullOrWhiteSpace(pinError)
        };

    <partial name="Attributes/_InspectionPinModal" model="pinModal" />
}
else if (!string.IsNullOrWhiteSpace(pinError))
{
    <div class="ail ail-wrap">
        <div class="ail-alert bad" role="alert">
            <i class="fa-solid fa-circle-exclamation"></i>
            <div>@pinError</div>
        </div>
    </div>
}

@section Scripts {
    <script>
        (function () {
            'use strict';

            const hidden =
                document.getElementById('selectedDateTime');

            const box =
                document.getElementById('confirmBox');

            const value =
                document.getElementById('confirmValue');

            const form =
                document.getElementById('inspectionCalendarForm');

            const desktopSubmitButton =
                document.getElementById('confirmAppointmentButton');

            const mobileSubmitButton =
                document.getElementById('mobileConfirmAppointmentButton');

            const mobileSheet =
                document.getElementById('mobileTimeSheet');

            const mobileSheetDate =
                document.getElementById('mobileTimeSheetDate');

            const mobileSheetSelected =
                document.getElementById('mobileSheetSelected');

            window.chooseInspectionSlot = function (button) {
                if (!button || !hidden || !box || !value) {
                    return;
                }

                document
                    .querySelectorAll('.time-btn.selected')
                    .forEach(x =>
                        x.classList.remove('selected'));

                const selected =
                    button.dataset.slot;

                document
                    .querySelectorAll('.time-btn')
                    .forEach(x => {
                        if (x.dataset.slot === selected) {
                            x.classList.add('selected');
                        }
                    });

                hidden.value =
                    selected || '';

                value.textContent =
                    button.dataset.label
                        ? 'Selected: ' + button.dataset.label
                        : 'Selected inspection appointment';

                box.style.display = 'block';

                if (desktopSubmitButton) {
                    desktopSubmitButton.disabled = false;
                }
            };

            window.openMobileTimeSheet = function (dateKey, label) {
                if (!mobileSheet) {
                    return;
                }

                document
                    .querySelectorAll('.mobile-time-day')
                    .forEach(x => {
                        x.style.display =
                            x.dataset.date === dateKey
                                ? 'block'
                                : 'none';
                    });

                document
                    .querySelectorAll('.mobile-sheet-time.selected')
                    .forEach(x =>
                        x.classList.remove('selected'));

                if (hidden) {
                    hidden.value = '';
                }

                if (mobileSubmitButton) {
                    mobileSubmitButton.disabled = true;
                    mobileSubmitButton.textContent =
                        'Confirm Appointment';
                }

                if (mobileSheetSelected) {
                    mobileSheetSelected.style.display = 'none';
                    mobileSheetSelected.textContent = '';
                }

                if (mobileSheetDate) {
                    mobileSheetDate.textContent = label || '';
                }

                mobileSheet.classList.add('open');
                mobileSheet.setAttribute('aria-hidden', 'false');

                document.body.style.overflow = 'hidden';
            };

            window.closeMobileTimeSheet = function () {
                if (!mobileSheet) {
                    return;
                }

                mobileSheet.classList.remove('open');
                mobileSheet.setAttribute('aria-hidden', 'true');

                document.body.style.overflow = '';
            };

            window.closeMobileTimeSheetFromBackdrop = function (event) {
                if (event.target === mobileSheet) {
                    closeMobileTimeSheet();
                }
            };

            window.chooseMobileInspectionTime = function (button) {
                if (!button || !hidden) {
                    return;
                }

                document
                    .querySelectorAll('.mobile-sheet-time.selected')
                    .forEach(x =>
                        x.classList.remove('selected'));

                button.classList.add('selected');

                hidden.value =
                    button.dataset.slot || '';

                if (mobileSheetSelected) {
                    mobileSheetSelected.textContent =
                        button.dataset.label
                            ? 'Selected: ' + button.dataset.label
                            : 'Selected inspection appointment';

                    mobileSheetSelected.style.display = 'block';
                }

                if (mobileSubmitButton) {
                    mobileSubmitButton.disabled = false;
                }
            };

            if (form) {
                form.addEventListener(
                    'submit',
                    function (event) {
                        if (!hidden || !hidden.value) {
                            event.preventDefault();

                            alert(
                                'Please select an inspection date and time.');

                            return;
                        }

                        if (!confirm(
                            'Confirm this inspection appointment? ' +
                            'The City will re-check that this time is still available.')) {
                            event.preventDefault();
                            return;
                        }

                        if (desktopSubmitButton) {
                            desktopSubmitButton.disabled = true;
                            desktopSubmitButton.textContent =
                                'Confirming...';
                        }

                        if (mobileSubmitButton) {
                            mobileSubmitButton.disabled = true;
                            mobileSubmitButton.textContent =
                                'Confirming...';
                        }
                    });
            }

            window.toggleAdminAssistance = function () {
                const panel =
                    document.getElementById(
                        'adminAssistancePanel');

                if (!panel) {
                    return;
                }

                panel.hidden =
                    !panel.hidden;

                if (!panel.hidden) {
                    panel.scrollIntoView({
                        behavior: 'smooth',
                        block: 'nearest'
                    });
                }
            };
        })();
    </script>


    <script src="~/js/attribute-inspection-modals.js" asp-append-version="true"></script>

    @if (Model.ValuerAccess == "Visible")
    {
        <script>
            // Protecting the valuer: no copy, no right-click, no printing, and the
            // details are hidden when the page is not in front or after 3 minutes.
            // (A browser cannot block every screenshot; the watermark shows who
            // looked and when.)
            (function () {
                'use strict';
                var card = document.getElementById('ailValuer');
                var reveal = document.getElementById('ailReveal');
                if (!card) return;

                var SHOW_MS = 3 * 60 * 1000;
                var timer = null;

                function hide() {
                    card.classList.add('is-shielded');
                    clearTimeout(timer);
                }

                function show() {
                    card.classList.remove('is-shielded');
                    clearTimeout(timer);
                    timer = setTimeout(hide, SHOW_MS);
                }

                show();
                if (reveal) reveal.addEventListener('click', show);

                document.addEventListener('visibilitychange', function () { if (document.hidden) hide(); });
                window.addEventListener('blur', hide);
                window.addEventListener('beforeprint', hide);

                ['contextmenu', 'copy', 'cut', 'dragstart', 'selectstart'].forEach(function (type) {
                    card.addEventListener(type, function (e) { e.preventDefault(); });
                });

                document.addEventListener('keydown', function (e) {
                    var k = (e.key || '').toLowerCase();
                    if ((e.ctrlKey || e.metaKey) && (k === 'p' || k === 's' || k === 'c')) {
                        e.preventDefault();
                        hide();
                    }
                });

                document.addEventListener('keyup', function (e) {
                    if (e.key === 'PrintScreen') {
                        hide();
                        try { navigator.clipboard && navigator.clipboard.writeText(''); } catch (err) { /* ignore */ }
                    }
                });
            })();
        </script>
    }
}
