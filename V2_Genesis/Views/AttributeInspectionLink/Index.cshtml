@model V2_Genesis.Models.ViewModels.Attributes.PublicInspectionLinkVm
@{
    ViewData["Title"] = "Attribute Inspection";
    Layout = null;

    var instanceKey = Model.InspectionRequestId.ToString();

    var availableSlots = Model.Slots
        .Where(x =>
            string.Equals(
                x.Status,
                "Available",
                StringComparison.OrdinalIgnoreCase))
        .OrderBy(x => x.ProposedDateTime)
        .ToList();

    var dayGroups = availableSlots
        .GroupBy(x => x.ProposedDateTime.Date)
        .OrderBy(x => x.Key)
        .ToList();

    var monthStart = Model.CurrentMonth;
    var daysInMonth = DateTime.DaysInMonth(
        monthStart.Year,
        monthStart.Month);

    var leading = ((int)monthStart.DayOfWeek + 6) % 7;

    var byDate = availableSlots
        .GroupBy(x => x.ProposedDateTime.Date)
        .ToDictionary(
            x => x.Key,
            x => x.OrderBy(s => s.ProposedDateTime).ToList());

    var clientStatus = (Model.Status ?? string.Empty).Trim() switch
    {
        "PendingClientResponse" => "Awaiting Appointment Selection",
        "Confirmed" => "Appointment Confirmed",
        "InspectionConfirmed" => "Appointment Confirmed",
        "InspectionDetailsSent" => "Valuer Details Available",
        "InspectionCompleted" => "Inspection Completed",
        _ => "Inspection In Progress"
    };

    var statusClass = (Model.Status ?? string.Empty).Trim() switch
    {
        "PendingClientResponse" => "status-waiting",
        "Confirmed" => "status-confirmed",
        "InspectionConfirmed" => "status-confirmed",
        "InspectionDetailsSent" => "status-ready",
        "InspectionCompleted" => "status-complete",
        _ => "status-neutral"
    };
}
<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <meta name="referrer" content="no-referrer" />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet" />

    <link rel="icon" type="image/png" sizes="32x32" href="~/images/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="~/images/favicon-16x16.png" />

    <title>City of Johannesburg - Attribute Inspection</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <link href="~/css/views/calendar-css.css"
          rel="stylesheet"
          asp-append-version="true" />

    <link href="~/css/views/calendar-link-css.css"
          rel="stylesheet"
          asp-append-version="true" />

    <link href="~/css/views/Pin-Entry.css"
          rel="stylesheet"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

  
</head>

<body>
    <div class="top">
        <strong>City of Johannesburg</strong><br />
        Valuation Services - Property Attributes
    </div>

    <main class="wrap">
        @if (TempData["InspectionLinkSuccess"] != null)
        {
            <div class="successx" role="status">
                @TempData["InspectionLinkSuccess"]
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <div class="notice" role="status">
                @Model.Message
            </div>
        }

        @if (Model.IsExpired)
        {
            <div class="errorx" role="alert">
                <strong>This secure link has expired.</strong>
                Please contact Valuation Administration if assistance is required.
            </div>
        }

        <section class="cardx" aria-labelledby="inspection-heading">
            <div class="headx">
                <h1 id="inspection-heading">Physical Inspection</h1>

                <div class="muted">
                    Secure City of Johannesburg Valuation Administration appointment link.
                </div>
            </div>

            <div class="bodyx">
                <div class="gridx">
                    <div class="fieldx">
                        <span>Reference</span>
                        <strong>@Model.AttrNo</strong>
                    </div>

                    <div class="fieldx">
                        <span>Status</span>
                        <strong class="client-status @statusClass">
                            @clientStatus
                        </strong>
                    </div>

                    <div class="fieldx">
                        <span>Property</span>
                        <strong>@Model.PropertyDescription</strong>
                    </div>
                </div>

                <div class="secure-note">
                    <span class="secure-badge" aria-hidden="true">✓</span>

                    <div>
                        <strong>Security notice</strong><br />
                        This link is unique to this inspection request.
                        Do not forward or share it. Valuer personal details are
                        not displayed until the authorised PIN stage.
                    </div>
                </div>

                @if (Model.ConfirmedDateTime.HasValue)
                {
                    <div class="successx calendar-top-gap" role="status">
                        <strong>Inspection appointment confirmed</strong><br />
                        @Model.ConfirmedDateTime.Value.ToString(
                            "dddd, dd MMMM yyyy 'at' HH:mm")
                    </div>
                }
            </div>
        </section>

        @if (Model.CanSelectDate)
        {
            <section class="cardx" aria-labelledby="calendar-heading">
                <div class="headx">
                    <h1 id="calendar-heading">
                        Select Inspection Date &amp; Time
                    </h1>

                    <div class="muted">
                        On a phone, select a date first and then choose the time.
                    </div>
                </div>

                <div class="bodyx">
                    <div class="month-nav"
                         aria-label="Inspection calendar month navigation">

                        <div class="month-nav-side">
                            @if (Model.HasPreviousMonth &&
                                 Model.PreviousMonth.HasValue)
                            {
                                <a class="month-nav-btn"
                                   asp-controller="AttributeInspectionLink"
                                   asp-action="Index"
                                   asp-route-token="@Model.Token"
                                   asp-route-year="@Model.PreviousMonth.Value.Year"
                                   asp-route-month="@Model.PreviousMonth.Value.Month">
                                    ← Previous
                                </a>
                            }
                            else
                            {
                                <span class="month-nav-btn disabled">
                                    ← Previous
                                </span>
                            }
                        </div>

                        <div class="month-nav-title">
                            @Model.CurrentMonth.ToString("MMMM yyyy")
                        </div>

                        <div class="month-nav-side month-nav-right">
                            @if (Model.HasNextMonth &&
                                 Model.NextMonth.HasValue)
                            {
                                <a class="month-nav-btn"
                                   asp-controller="AttributeInspectionLink"
                                   asp-action="Index"
                                   asp-route-token="@Model.Token"
                                   asp-route-year="@Model.NextMonth.Value.Year"
                                   asp-route-month="@Model.NextMonth.Value.Month">
                                    Next →
                                </a>
                            }
                            else
                            {
                                <span class="month-nav-btn disabled">
                                    Next →
                                </span>
                            }
                        </div>
                    </div>

                    <div class="calendar-range-note">
                        Online booking is available from
                        <strong>@Model.MinimumMonth.ToString("MMMM yyyy")</strong>
                        to
                        <strong>@Model.MaximumMonth.ToString("MMMM yyyy")</strong>.
                    </div>

                    @if (!availableSlots.Any())
                    {
                        <div class="notice" role="status">
                            <strong>
                                No inspection appointments are currently available
                                for @Model.CurrentMonth.ToString("MMMM yyyy").
                            </strong>

                            @if (Model.HasNextMonth)
                            {
                                <div class="small-gap">
                                    You can move to the next month or tell us that
                                    you are unavailable for this whole month.
                                </div>
                            }
                            else
                            {
                                <div class="small-gap">
                                    This is the final online booking month.
                                    If no suitable appointment is available,
                                    request assistance from Valuation Administration.
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="cal-help">
                            Choose one suitable date and time.
                            Your selection will be checked again before
                            the appointment is confirmed.
                        </div>

                        <form asp-controller="AttributeInspectionLink"
                              asp-action="Confirm"
                              asp-route-token="@Model.Token"
                              method="post"
                              id="inspectionCalendarForm"
                              autocomplete="off">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="selectedDateTime"
                                   id="selectedDateTime" />

                            <!-- DESKTOP -->
                            <div class="calendar-desktop"
                                 aria-label="Available inspection calendar">

                                <div class="cal-month">
                                    <div class="cal-grid">
                                        @foreach (var dow in new[]
                                        {
                                            "Mon", "Tue", "Wed",
                                            "Thu", "Fri", "Sat", "Sun"
                                        })
                                        {
                                            <div class="cal-dow">@dow</div>
                                        }

                                        @for (var i = 0; i < leading; i++)
                                        {
                                            <div class="cal-day empty"
                                                 aria-hidden="true">
                                            </div>
                                        }

                                        @for (var day = 1;
                                              day <= daysInMonth;
                                              day++)
                                        {
                                            var date = new DateTime(
                                                monthStart.Year,
                                                monthStart.Month,
                                                day);

                                            byDate.TryGetValue(
                                                date,
                                                out var daySlots);

                                            <div class="cal-day @(daySlots?.Any() == true ? "available-day" : "")">
                                                <div class="cal-date">@day</div>

                                                @if (daySlots?.Any() == true)
                                                {
                                                    @foreach (var slot in daySlots)
                                                    {
                                                        var iso =
                                                            slot.ProposedDateTime
                                                                .ToString("yyyy-MM-ddTHH:mm:ss");

                                                        var label =
                                                            slot.ProposedDateTime
                                                                .ToString("dddd, dd MMMM yyyy 'at' HH:mm");

                                                        <button type="button"
                                                                class="time-btn"
                                                                data-slot="@iso"
                                                                data-label="@label"
                                                                aria-label="Select @label"
                                                                onclick="chooseInspectionSlot(this)">
                                                            @slot.ProposedDateTime.ToString("HH:mm")
                                                        </button>
                                                    }
                                                }
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- MOBILE: DATE FIRST -->
                            <div class="mobile-date-picker"
                                 aria-label="Select inspection date">

                                <div class="mobile-calendar-grid">
                                    @foreach (var dow in new[]
                                    {
                                        "M", "T", "W", "T", "F", "S", "S"
                                    })
                                    {
                                        <div class="mobile-calendar-dow">@dow</div>
                                    }

                                    @for (var i = 0; i < leading; i++)
                                    {
                                        <div class="mobile-calendar-empty"
                                             aria-hidden="true"></div>
                                    }

                                    @for (var day = 1;
                                          day <= daysInMonth;
                                          day++)
                                    {
                                        var date = new DateTime(
                                            monthStart.Year,
                                            monthStart.Month,
                                            day);

                                        byDate.TryGetValue(
                                            date,
                                            out var mobileDaySlots);

                                        if (mobileDaySlots?.Any() == true)
                                        {
                                            var dateKey =
                                                date.ToString("yyyy-MM-dd");

                                            var fullDate =
                                                date.ToString(
                                                    "dddd, dd MMMM yyyy");

                                            <button type="button"
                                                    class="mobile-date-btn"
                                                    aria-label="Select @fullDate"
                                                    onclick="openMobileTimeSheet('@dateKey', '@fullDate')">
                                                @day
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="mobile-date-disabled"
                                                  aria-label="@date.ToString("dd MMMM yyyy") unavailable">
                                                @day
                                            </span>
                                        }
                                    }
                                </div>

                                <div class="mobile-calendar-legend">
                                    <span class="mobile-calendar-legend-dot"></span>
                                    Selectable dates have available inspection times.
                                </div>
                            </div>

                            <div class="confirm-box"
                                 id="confirmBox"
                                 role="region"
                                 aria-live="polite"
                                 aria-label="Confirm selected appointment">

                                <div class="confirm-inner">
                                    <span class="confirm-value"
                                          id="confirmValue">
                                    </span>

                                    <button type="submit"
                                            class="confirm-btn"
                                            id="confirmAppointmentButton">
                                        Confirm Appointment
                                    </button>
                                </div>
                            </div>

                            <!-- MOBILE TIME BOTTOM SHEET -->
                            <div class="mobile-time-sheet-backdrop"
                                 id="mobileTimeSheet"
                                 aria-hidden="true"
                                 onclick="closeMobileTimeSheetFromBackdrop(event)">

                                <div class="mobile-time-sheet"
                                     role="dialog"
                                     aria-modal="true"
                                     aria-labelledby="mobileTimeSheetTitle">

                                    <div class="mobile-sheet-handle"></div>

                                    <div class="mobile-sheet-head">
                                        <div>
                                            <div class="mobile-sheet-title"
                                                 id="mobileTimeSheetTitle">
                                                Select a time
                                            </div>

                                            <div class="mobile-sheet-date"
                                                 id="mobileTimeSheetDate">
                                            </div>
                                        </div>

                                        <button type="button"
                                                class="mobile-sheet-close"
                                                aria-label="Close time selection"
                                                onclick="closeMobileTimeSheet()">
                                            ×
                                        </button>
                                    </div>

                                    @foreach (var dayGroup in dayGroups)
                                    {
                                        var dateKey =
                                            dayGroup.Key.ToString("yyyy-MM-dd");

                                        <div class="mobile-time-day"
                                             data-date="@dateKey"
                                             style="display:none;">

                                            <div class="mobile-time-options">
                                                @foreach (var slot in dayGroup)
                                                {
                                                    var iso =
                                                        slot.ProposedDateTime
                                                            .ToString("yyyy-MM-ddTHH:mm:ss");

                                                    var label =
                                                        slot.ProposedDateTime
                                                            .ToString("dddd, dd MMMM yyyy 'at' HH:mm");

                                                    <button type="button"
                                                            class="mobile-sheet-time"
                                                            data-slot="@iso"
                                                            data-label="@label"
                                                            onclick="chooseMobileInspectionTime(this)">
                                                        @slot.ProposedDateTime.ToString("HH:mm")
                                                    </button>
                                                }
                                            </div>
                                        </div>
                                    }

                                    <div class="mobile-sheet-selected"
                                         id="mobileSheetSelected">
                                    </div>

                                    <button type="submit"
                                            class="mobile-sheet-confirm"
                                            id="mobileConfirmAppointmentButton"
                                            disabled>
                                        Confirm Appointment
                                    </button>
                                </div>
                            </div>
                        </form>
                    }

                    <div class="calendar-actions">
                        <form asp-controller="AttributeInspectionLink"
                              asp-action="UnavailableThisMonth"
                              asp-route-token="@Model.Token"
                              method="post"
                              class="calendar-action-form">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="year"
                                   value="@Model.CurrentMonth.Year" />

                            <input type="hidden"
                                   name="month"
                                   value="@Model.CurrentMonth.Month" />

                            <button type="submit"
                                    class="secondary-action-btn"
                                    onclick="return confirm('Confirm that you are unavailable for the whole of @Model.CurrentMonth.ToString("MMMM yyyy")?');">
                                I'm unavailable this month
                            </button>
                        </form>

                        @if (!Model.AdministrationAssistanceRequested)
                        {
                            <button type="button"
                                    class="admin-action-btn"
                                    onclick="toggleAdminAssistance()">
                                Request Administration Assistance
                            </button>
                        }
                        else
                        {
                            <div class="admin-requested">
                                ✓ Administration assistance has already been requested.
                            </div>
                        }
                    </div>

                    @if (!Model.AdministrationAssistanceRequested)
                    {
                        <div class="admin-assistance-panel"
                             id="adminAssistancePanel"
                             hidden>

                            <h3>Request Administration Assistance</h3>

                            <p>
                                Use this option if none of the online appointment
                                months work for you. Your inspection request will
                                remain open and Valuation Administration will be
                                asked to assist.
                            </p>

                            <form asp-controller="AttributeInspectionLink"
                                  asp-action="RequestAdministrationAssistance"
                                  asp-route-token="@Model.Token"
                                  method="post"
                                  autocomplete="off">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="year"
                                       value="@Model.CurrentMonth.Year" />

                                <input type="hidden"
                                       name="month"
                                       value="@Model.CurrentMonth.Month" />

                                <label for="assistanceReason">
                                    Reason / preferred arrangement
                                </label>

                                <textarea id="assistanceReason"
                                          name="reason"
                                          maxlength="500"
                                          rows="4"
                                          placeholder="Example: I am unavailable during the displayed months. Please contact me to arrange another date."></textarea>

                                <button type="submit"
                                        class="admin-submit-btn"
                                        onclick="return confirm('Send this request to Valuation Administration?');">
                                    Send Assistance Request
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </section>
        }

        @if (Model.ValuerDetailsAvailable &&
             Model.Valuer != null)
        {
            <section class="cardx valuer"
                     aria-labelledby="valuer-heading">

                <div class="headx">
                    <h1 id="valuer-heading">
                        Authorised Valuer Details
                    </h1>

                    <div class="muted">
                        Use these details to verify the City official
                        who arrives for the inspection.
                    </div>
                </div>

                <div class="bodyx valuer-grid">
                    <div>
                        @if (Model.Valuer.HasPhoto)
                        {
                            <img class="photo"
                                 src="@Url.Action(
                                     "ValuerPhoto",
                                     new { token = Model.Token })"
                                 alt="Authorised valuer" />
                        }
                    </div>

                    <div class="gridx">
                        <div class="fieldx">
                            <span>Valuer</span>
                            <strong>@Model.Valuer.ValuerName</strong>
                        </div>

                        <div class="fieldx">
                            <span>Cell</span>
                            <strong>@(Model.Valuer.CellNumber ?? "-")</strong>
                        </div>

                        <div class="fieldx">
                            <span>Email</span>
                            <strong>@(Model.Valuer.EmailAddress ?? "-")</strong>
                        </div>

                        <div class="fieldx">
                            <span>Vehicle Registration</span>
                            <strong>@(Model.Valuer.VehicleRegistration ?? "-")</strong>
                        </div>

                        <div class="fieldx">
                            <span>Vehicle Make</span>
                            <strong>@(Model.Valuer.VehicleMake ?? "-")</strong>
                        </div>

                        <div class="fieldx">
                            <span>Vehicle Colour</span>
                            <strong>@(Model.Valuer.VehicleColour ?? "-")</strong>
                        </div>
                    </div>
                </div>
            </section>
        }

        <footer class="foot">
            AdministrationEnquiries@joburg.org.za ·
            Secure City of Johannesburg appointment link ·
            Do not forward this link.
        </footer>
    </main>

    @if (Model.RequiresPinVerification)
    {
        var pinModal =
            new V2_Genesis.Models.ViewModels.Attributes.InspectionPinModalVm
            {
                InstanceKey = instanceKey,
                AppointmentRef = Model.AttrNo,
                FormAction = Url.Action(
                    "VerifyPin",
                    "AttributeInspectionLink",
                    new { token = Model.Token })
                    ?? Url.Content(
                        $"~/attributes/inspection/{Model.Token:D}/verify-pin"),
                PinFieldName = "inspectionPin",
                ConfirmedDateTime = Model.ConfirmedDateTime,
                ErrorMessage =
                    TempData["InspectionPinError"]?.ToString(),
                AutoOpen = true
            };

        <partial name="Attributes/_InspectionPinModal"
                 model="pinModal" />
    }

    <script>
        (function () {
            'use strict';

            const hidden =
                document.getElementById('selectedDateTime');

            const box =
                document.getElementById('confirmBox');

            const value =
                document.getElementById('confirmValue');

            const form =
                document.getElementById('inspectionCalendarForm');

            const desktopSubmitButton =
                document.getElementById('confirmAppointmentButton');

            const mobileSubmitButton =
                document.getElementById('mobileConfirmAppointmentButton');

            const mobileSheet =
                document.getElementById('mobileTimeSheet');

            const mobileSheetDate =
                document.getElementById('mobileTimeSheetDate');

            const mobileSheetSelected =
                document.getElementById('mobileSheetSelected');

            window.chooseInspectionSlot = function (button) {
                if (!button || !hidden || !box || !value) {
                    return;
                }

                document
                    .querySelectorAll('.time-btn.selected')
                    .forEach(x =>
                        x.classList.remove('selected'));

                const selected =
                    button.dataset.slot;

                document
                    .querySelectorAll('.time-btn')
                    .forEach(x => {
                        if (x.dataset.slot === selected) {
                            x.classList.add('selected');
                        }
                    });

                hidden.value =
                    selected || '';

                value.textContent =
                    button.dataset.label
                        ? 'Selected: ' + button.dataset.label
                        : 'Selected inspection appointment';

                box.style.display = 'block';

                if (desktopSubmitButton) {
                    desktopSubmitButton.disabled = false;
                }
            };

            window.openMobileTimeSheet = function (dateKey, label) {
                if (!mobileSheet) {
                    return;
                }

                document
                    .querySelectorAll('.mobile-time-day')
                    .forEach(x => {
                        x.style.display =
                            x.dataset.date === dateKey
                                ? 'block'
                                : 'none';
                    });

                document
                    .querySelectorAll('.mobile-sheet-time.selected')
                    .forEach(x =>
                        x.classList.remove('selected'));

                if (hidden) {
                    hidden.value = '';
                }

                if (mobileSubmitButton) {
                    mobileSubmitButton.disabled = true;
                    mobileSubmitButton.textContent =
                        'Confirm Appointment';
                }

                if (mobileSheetSelected) {
                    mobileSheetSelected.style.display = 'none';
                    mobileSheetSelected.textContent = '';
                }

                if (mobileSheetDate) {
                    mobileSheetDate.textContent = label || '';
                }

                mobileSheet.classList.add('open');
                mobileSheet.setAttribute('aria-hidden', 'false');

                document.body.style.overflow = 'hidden';
            };

            window.closeMobileTimeSheet = function () {
                if (!mobileSheet) {
                    return;
                }

                mobileSheet.classList.remove('open');
                mobileSheet.setAttribute('aria-hidden', 'true');

                document.body.style.overflow = '';
            };

            window.closeMobileTimeSheetFromBackdrop = function (event) {
                if (event.target === mobileSheet) {
                    closeMobileTimeSheet();
                }
            };

            window.chooseMobileInspectionTime = function (button) {
                if (!button || !hidden) {
                    return;
                }

                document
                    .querySelectorAll('.mobile-sheet-time.selected')
                    .forEach(x =>
                        x.classList.remove('selected'));

                button.classList.add('selected');

                hidden.value =
                    button.dataset.slot || '';

                if (mobileSheetSelected) {
                    mobileSheetSelected.textContent =
                        button.dataset.label
                            ? 'Selected: ' + button.dataset.label
                            : 'Selected inspection appointment';

                    mobileSheetSelected.style.display = 'block';
                }

                if (mobileSubmitButton) {
                    mobileSubmitButton.disabled = false;
                }
            };

            if (form) {
                form.addEventListener(
                    'submit',
                    function (event) {
                        if (!hidden || !hidden.value) {
                            event.preventDefault();

                            alert(
                                'Please select an inspection date and time.');

                            return;
                        }

                        if (!confirm(
                            'Confirm this inspection appointment? ' +
                            'The City will re-check that this time is still available.')) {
                            event.preventDefault();
                            return;
                        }

                        if (desktopSubmitButton) {
                            desktopSubmitButton.disabled = true;
                            desktopSubmitButton.textContent =
                                'Confirming...';
                        }

                        if (mobileSubmitButton) {
                            mobileSubmitButton.disabled = true;
                            mobileSubmitButton.textContent =
                                'Confirming...';
                        }
                    });
            }

            window.toggleAdminAssistance = function () {
                const panel =
                    document.getElementById(
                        'adminAssistancePanel');

                if (!panel) {
                    return;
                }

                panel.hidden =
                    !panel.hidden;

                if (!panel.hidden) {
                    panel.scrollIntoView({
                        behavior: 'smooth',
                        block: 'nearest'
                    });
                }
            };
        })();
    </script>

    <script src="~/js/attribute-inspection-modals.js"
            asp-append-version="true">
    </script>
</body>
</html>
