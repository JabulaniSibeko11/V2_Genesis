@model List<V2_Genesis.Models.Results.Home.HomeSearchResult>
@{
    bool isAuth = ViewBag.IsAuthenticated as bool? ?? false;
}

@if (!isAuth)
{
    <div class="hs-login-notice">
        <i class="fa-solid fa-circle-info"></i>
        <span>
            Found <strong>@Model.Count</strong> propert@(Model.Count == 1 ? "y" : "ies").
            <a href="/account/login">Sign in</a> to view full details, link
            to your profile and download Section 49.
        </span>
    </div>
}

<table id="homeResultsTable"
       class="display table hs-table">
    <thead>
        <tr>
            <th>ROLL</th>
            <th>TOWNSHIP</th>
            <th>ADDRESS</th>
            <th>ERF</th>
            <th>PTN</th>
            <th>CATEGORY</th>
            <th>EXTENT</th>
            <th>MARKET VALUE</th>
            <th>SCHEME</th>
            <th>UNIT</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    <span class="hs-roll-badge hs-roll-@item.RollSource.ToLower()
                                                            .Replace("_","").Replace(" ","")">
                        @item.RollName
                    </span>
                </td>
                <td>@(item.TownNameDesc ?? "–")</td>
                <td>@(item.LisStreetAddress ?? "–")</td>
                <td>@item.Erf</td>
                <td>@item.Ptn</td>
                <td>@(item.CatDesc ?? "–")</td>
                <td>@(item.RateableArea ?? "–")</td>
                <td class="hs-value">@item.MarketValue</td>
                <td>@(item.SchemeName ?? "–")</td>
                <td>@(item.UnitNo > 0 ? item.UnitNo.ToString() : "–")</td>
                <td>
                    @if (isAuth)
                    {
                    
                            var url = $"/property/view?rollSource={item.RollSource}" +
                                      $"&unitKey={item.UnitKey}" +
                                      $"&valuationKey={item.ValuationKey}" +
                                      $"&propertyFrom={item.RollSource}";
                        
                        <a href="@url" class="hs-view-btn">
                            <i class="fa-solid fa-circle-arrow-right"></i>
                            View
                        </a>
                    }
                    else
                    {
                        <a href="/account/login?returnUrl=/property/view%3FrollSource=@item.RollSource%26unitKey=@item.UnitKey%26valuationKey=@item.ValuationKey"
                           class="hs-view-btn hs-view-locked">
                            <i class="fa-solid fa-lock"></i>
                            Sign In
                        </a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

<script>
$(document).ready(function () {
    if (!$.fn.DataTable.isDataTable('#homeResultsTable')) {
        $('#homeResultsTable').DataTable({
            responsive : false,
            scrollX    : true,
            autoWidth  : false,
            destroy    : true,
            dom        : '<"hs-dt-top"lBf>rt<"hs-dt-bottom"ip>',
            lengthMenu : [[10, 25, 50, -1], [10, 25, 50, 'All']],
            pageLength : 10,
            buttons: [
                {
                    extend   : 'excel',
                    text     : '<i class="fa-solid fa-file-excel"></i> Excel',
                    className: 'hs-dt-btn'
                },
                {
                    extend   : 'pdf',
                    text     : '<i class="fa-solid fa-file-pdf"></i> PDF',
                    className: 'hs-dt-btn'
                }
            ],
            language: {
                search           : '_INPUT_',
                searchPlaceholder: 'Filter results…',
                emptyTable       : 'No properties found',
                info             : 'Showing _START_ to _END_ of _TOTAL_',
                infoEmpty        : 'No properties found',
                infoFiltered     : '(filtered from _MAX_ total)'
            },
            columnDefs: [
                { width: '140px', targets: 0 },
                { width: '150px', targets: 1 },
                { width: '180px', targets: 2 },
                { width: '60px',  targets: [3,4] },
                { width: '120px', targets: 5 },
                { orderable: false, targets: 10 }
            ],
            drawCallback: function() { formatMv(); },
            initComplete: function() {
                formatMv();
                var count = this.api().rows().count();
                var badge = document.getElementById('hsResultCount');
                if (badge) badge.textContent =
                    count + ' propert' + (count === 1 ? 'y' : 'ies') + ' found';
            }
        });
    }
});

function formatMv() {
    document.querySelectorAll('.hs-value').forEach(function(el) {
        var raw = parseFloat(el.textContent.replace(/[^0-9.-]+/g,''));
        if (!isNaN(raw) && raw > 0) {
            el.textContent = raw.toLocaleString('en-ZA',{
                style:'currency', currency:'ZAR',
                minimumFractionDigits:0, maximumFractionDigits:0
            });
        }
    });
}
</script>
