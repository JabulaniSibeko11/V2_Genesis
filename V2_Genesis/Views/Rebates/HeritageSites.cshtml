@model V2_Genesis.Models.Rebates.RebateFormBinding
@{
    ViewData["Title"] = "Heritage Sites Rebate";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}
@section Styles {
    <link href="~/css/views/rebates-form.css" rel="stylesheet" asp-append-version="true" />
     
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
}

<div class="rf-page">
    <div class="rf-header">
        <div class="rf-header-inner">
            <a asp-controller="Rebates" asp-action="Index" class="rf-back-btn">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
            <div>
                <div class="rf-eyebrow">Rates Rebates</div>
                <h1 class="rf-title">Application for Rates Rebate — Heritage Sites</h1>
            </div>
        </div>
    </div>
    <div class="rf-conditions">
        <div class="rf-conditions-inner">
            <i class="fa-solid fa-circle-info"></i>
            <div>
                <strong>Period: From 1 July 2023.</strong>
                Applicable to properties officially declared as Heritage Sites under
                the National Heritage Resources Act (No. 25 of 1999) or the
                National Monuments Act (1969). The property owner must apply.
            </div>
        </div>
    </div>
    <div class="rf-body">
        <form id="rebateForm"
              data-submission-loader
              data-submission-title="Submitting your Rebate application..."
              data-submission-message="Please wait while the Valuation Department receives your Rebate application and prepares the acknowledgement. Do not close or refresh this page." method="post" enctype="multipart/form-data"
              asp-controller="Rebates" asp-action="HeritageSites">
            @Html.AntiForgeryToken()

          
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">1</div>
                    <h2 class="rf-section-title">Account &amp; Property Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Account Number</label>
                        <input asp-for="S1.AccountNumber" class="rf-input"
                               minlength="9" maxlength="9" placeholder="9-digit account number"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                        <span asp-validation-for="S1.AccountNumber" class="rf-error"></span>
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Erf Number and Township</label>
                        <input asp-for="S9.ErfandTownship" class="rf-input" id="ErfandTownship"
                               maxlength="50" placeholder="e.g. Erf 1234 Johannesburg" required />
                        <span asp-validation-for="S9.ErfandTownship" class="rf-error"></span>
                    </div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Street Address of Property</label>
                        <input asp-for="S2.StreetAddress" class="rf-input" id="StreetAddress"
                               maxlength="50" placeholder="Physical address of the heritage property" required />
                        <span asp-validation-for="S2.StreetAddress" class="rf-error"></span>
                    </div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label">Postal Address</label>
                        <input asp-for="S2.PostalAddress" class="rf-input" id="PostalAddress"
                               maxlength="50" placeholder="Postal / correspondence address" />
                        <span asp-validation-for="S2.PostalAddress" class="rf-error"></span>
                    </div>
                </div>
            </div>

            
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">2</div>
                    <h2 class="rf-section-title">Heritage Property Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Name of Applicant</label>
                        <input asp-for="S9.NameOfApplicant" class="rf-input" id="NameOfApplicant"
                               maxlength="100" placeholder="Full name of applicant" required />
                        <span asp-validation-for="S9.NameOfApplicant" class="rf-error"></span>
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Name of Heritage Property</label>
                        <input asp-for="S9.NameOfHeritageProperty" class="rf-input" id="NameOfHeritageProperty"
                               maxlength="100" placeholder="Official name of the heritage site" required />
                        <span asp-validation-for="S9.NameOfHeritageProperty" class="rf-error"></span>
                    </div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Brief Physical Description of Heritage Site</label>
                        <input asp-for="S9.BriefDescriptionHS" class="rf-input" id="BriefDescriptionHS"
                               maxlength="200" placeholder="e.g. Victorian-era sandstone building built in 1895" required />
                        <span asp-validation-for="S9.BriefDescriptionHS" class="rf-error"></span>
                    </div>
                </div>
            </div>

          
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">3</div>
                    <h2 class="rf-section-title">Contact Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field rf-field-quarter">
                        <label class="rf-label rf-required">Cell Number</label>
                        <input asp-for="S3.CellNo" class="rf-input" id="CellNo" maxlength="14"
                               placeholder="0XX XXX XXXX"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                    </div>
                    <div class="rf-field rf-field-quarter">
                        <label class="rf-label">Work Telephone</label>
                        <input asp-for="S3.WorkTel" class="rf-input" id="WorkTel" maxlength="14"
                               placeholder="011 000 0000"
                               onkeypress="return isNumericKey(event)" onpaste="return false" />
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Email Address</label>
                        <input asp-for="S3.Email" class="rf-input" id="Email"
                               type="email" maxlength="100" required />
                    </div>
                </div>
            </div>

         
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">4</div>
                    <h2 class="rf-section-title">Official Protection Status</h2>
                </div>
                <div class="rf-section-body">
                    <p style="font-size:14px; color:#645a50; width:100%; margin:0 0 12px;">
                        Select the protection status that applies to this heritage property.
                        <strong>Only one option may be selected.</strong>
                    </p>
                    <div class="rf-protection-grid" id="protectionGrid">
                        <label class="rf-protection-option">
                            <input type="checkbox" asp-for="S9.NationalHeritageSite"
                                   class="heritage-chk" data-field="NationalHeritageSite" value="true" />
                            <span><i class="fa-solid fa-flag" style="color:#36626d;margin-right:6px;"></i>National Heritage Site</span>
                        </label>
                        <label class="rf-protection-option">
                            <input type="checkbox" asp-for="S9.ProvincialHeritageSite"
                                   class="heritage-chk" data-field="ProvincialHeritageSite" value="true" />
                            <span><i class="fa-solid fa-map" style="color:#36626d;margin-right:6px;"></i>Provincial Heritage Site</span>
                        </label>
                        <label class="rf-protection-option">
                            <input type="checkbox" asp-for="S9.HeritageArea"
                                   class="heritage-chk" data-field="HeritageArea" value="true" />
                            <span><i class="fa-solid fa-map-location-dot" style="color:#36626d;margin-right:6px;"></i>Heritage Area</span>
                        </label>
                        <label class="rf-protection-option">
                            <input type="checkbox" asp-for="S9.ProvisionalProtection"
                                   class="heritage-chk" data-field="ProvisionalProtection" value="true" />
                            <span><i class="fa-solid fa-shield-halved" style="color:#36626d;margin-right:6px;"></i>Provisional Protection</span>
                        </label>
                        <label class="rf-protection-option">
                            <input type="checkbox" asp-for="S9.Other"
                                   class="heritage-chk" data-field="Other" value="true" id="otherChk" />
                            <span><i class="fa-solid fa-ellipsis" style="color:#36626d;margin-right:6px;"></i>Other</span>
                        </label>
                    </div>
                    <div id="protectionError" class="rf-error" style="width:100%;"></div>
                    <div class="rf-field rf-field-full" id="specifyOtherGroup">
                        <label class="rf-label rf-required">Please Specify Other</label>
                        <input asp-for="S9.SpecifyOther" class="rf-input" id="SpecifyOther"
                               maxlength="100" placeholder="Describe the other protection type" />
                        <span asp-validation-for="S9.SpecifyOther" class="rf-error"></span>
                    </div>
                </div>
            </div>

           
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">5</div>
                    <h2 class="rf-section-title">Legal &amp; Gazette Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-gazette-note">
                        <i class="fa-solid fa-circle-info" style="margin-right:8px;"></i>
                        Complete these fields with details from the official Government Gazette
                        in which the heritage declaration appeared.
                    </div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">
                            Number and Date of Government Notice for Heritage Declaration
                        </label>
                        <input asp-for="S9.NumberDateGovernmentNotice" class="rf-input" id="NumberDateGovernmentNotice"
                               maxlength="100"
                               placeholder="e.g. Notice No. 1234, dated 15 March 2010" required />
                        <span asp-validation-for="S9.NumberDateGovernmentNotice" class="rf-error"></span>
                    </div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">
                            Details of the Gazette in which the Government Notice Appeared
                        </label>
                        <input asp-for="S9.DetailsGazette" class="rf-input" id="DetailsGazette"
                               maxlength="100"
                               placeholder="e.g. Government Gazette Vol. 530 No. 32828" required />
                        <span asp-validation-for="S9.DetailsGazette" class="rf-error"></span>
                    </div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label">
                            Former Protection Status (under the National Monuments Act, 1969)
                        </label>
                        <input asp-for="S9.FormerProtection" class="rf-input"
                               maxlength="100"
                               placeholder="If applicable — describe former protection status" />
                        <span asp-validation-for="S9.FormerProtection" class="rf-error"></span>
                    </div>
                </div>
            </div>

          
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">6</div>
                    <h2 class="rf-section-title">Supporting Documents</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-upload-notice">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        All documents must be <strong>PDF format only</strong>.
                        Maximum file size: <strong>20 MB</strong>.
                    </div>
                    <div class="rf-field rf-field-upload">
                        <label class="rf-label rf-required">Copy of the Heritage Declaration Notice</label>
                        <input type="file" name="files" class="rf-file" accept=".pdf"
                               onchange="validatePdf(this)" required />
                        <span class="rf-file-help">Official Government Gazette notice of heritage declaration</span>
                    </div>
                    <div class="rf-field rf-field-upload">
                        <label class="rf-label">Any Additional Supporting Documentation</label>
                        <input type="file" name="files" class="rf-file" accept=".pdf" onchange="validatePdf(this)" />
                        <span class="rf-file-help">Optional</span>
                    </div>
                </div>
            </div>

            <div class="rf-submit-bar">
                <a asp-controller="Rebates" asp-action="Index" class="rf-cancel-btn">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
                <button type="submit" class="rf-submit-btn" id="submitBtn">
                    <i class="fa-solid fa-paper-plane"></i> Submit Application
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    window.isNumericKey = function (e) { var c=e.which??e.keyCode; return !(c>31&&(c<48||c>57)); };
    window.validatePdf = function (i) { var f=i.files[0]; if(f&&!f.name.toLowerCase().endsWith('.pdf')){ alert('PDF only.'); i.value=''; } };

    // ── Exclusive checkboxes (only one at a time) ───────────────
    var chks = document.querySelectorAll('.heritage-chk');
    chks.forEach(function (cb) {
        cb.addEventListener('change', function () {
            if (this.checked) {
                // Uncheck all others
                chks.forEach(function (other) { if (other !== cb) { other.checked=false; other.closest('.rf-protection-option').classList.remove('selected'); } });
                this.closest('.rf-protection-option').classList.add('selected');
            } else {
                this.closest('.rf-protection-option').classList.remove('selected');
            }
            // Show/hide "Specify Other"
            var otherChk = document.getElementById('otherChk');
            var specifyGrp = document.getElementById('specifyOtherGroup');
            var specifyInput = document.getElementById('SpecifyOther');
            var show = otherChk && otherChk.checked;
            specifyGrp.style.display = show ? 'block' : 'none';
            if (specifyInput) specifyInput.required = show;
        });
    });

    // ── Submit validation ───────────────────────────────────────
    document.getElementById('rebateForm')?.addEventListener('submit', function (e) {
        var ids=['NameOfApplicant','NameOfHeritageProperty','BriefDescriptionHS',
                 'ErfandTownship','StreetAddress','CellNo','Email',
                 'NumberDateGovernmentNotice','DetailsGazette'];
        var failed=false;
        ids.forEach(function(id){ var el=document.getElementById(id); if(el&&el.value.trim()===''){ el.style.borderColor='#dc2626'; failed=true; } else if(el){ el.style.borderColor=''; } });

        // At least one checkbox checked
        var anyChecked = Array.from(document.querySelectorAll('.heritage-chk')).some(function(c){ return c.checked; });
        if (!anyChecked) {
            document.getElementById('protectionError').textContent = 'Please select at least one protection status.';
            failed = true;
        } else {
            document.getElementById('protectionError').textContent = '';
        }

        if (failed) {
            e.preventDefault();
            document.querySelector('input[style*="dc2626"], #protectionError')
                ?.scrollIntoView({behavior:'smooth',block:'center'});
        } else {
            var btn=document.getElementById('submitBtn');
            if(btn){ btn.disabled=true; btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Submitting...'; }
        }
    });
})();
</script>
}
