@model V2_Genesis.Models.Rebates.RebateFormBinding
@{
    ViewData["Title"] = "Protection of Animals Rebate";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}
@section Styles {
    <link href="~/css/views/rebates-form.css" rel="stylesheet" asp-append-version="true" />
        <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true"/>
   
}

<div class="rf-page">

    <div class="rf-header">
        <div class="rf-header-inner">
            <a asp-controller="Rebates" asp-action="Index" class="rf-back-btn">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
            <div>
                <div class="rf-eyebrow">Rates Rebates</div>
                <h1 class="rf-title">Application for Protection of Animals Rebate</h1>
            </div>
        </div>
    </div>

    <div class="rf-conditions">
        <div class="rf-conditions-inner">
            <i class="fa-solid fa-circle-info"></i>
            <div>
                <strong>Period: From 1 July 2023 &nbsp;|&nbsp; Maximum rebate: 100%.</strong>
                Property must be registered in the name of an institution whose
                <strong>exclusive objective</strong> is the protection of animals.
                The property owner must apply — this is not automatic.
            </div>
        </div>
    </div>

    <div class="rf-body">

        <form id="rebateForm"
              data-submission-loader
              data-submission-title="Submitting your Rebate application..."
              data-submission-message="Please wait while the Valuation Department receives your Rebate application and prepares the acknowledgement. Do not close or refresh this page."
              method="post"
              enctype="multipart/form-data"
              asp-controller="Rebates"
              asp-action="ProtectionAnimal">

            @Html.AntiForgeryToken()

         
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">1</div>
                    <h2 class="rf-section-title">Account &amp; Property Details</h2>
                </div>
                <div class="rf-section-body">

                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Account Number</label>
                        <input asp-for="S1.AccountNumber" class="rf-input" id="AccountNumber"
                               minlength="9" maxlength="9" placeholder="9-digit account number"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                        <span asp-validation-for="S1.AccountNumber" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Erf and Township</label>
                        <input asp-for="S9.ErfandTownship" class="rf-input" id="ErfandTownship"
                               maxlength="50" placeholder="e.g. Erf 456 Randburg" required />
                        <span asp-validation-for="S9.ErfandTownship" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Street Address of Property</label>
                        <input asp-for="S2.StreetAddress" class="rf-input" id="StreetAddress"
                               maxlength="50" placeholder="Physical address where the organisation operates" required />
                        <span asp-validation-for="S2.StreetAddress" class="rf-error"></span>
                    </div>

                </div>
            </div>

  
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">2</div>
                    <h2 class="rf-section-title">Organisation Details</h2>
                </div>
                <div class="rf-section-body">

                    <div class="rf-conditions-list">
                        <div class="rf-conditions-list-title">
                            <i class="fa-solid fa-paw"></i> Eligibility Criteria
                        </div>
                        <ol>
                            <li>The property must be registered in the name of the organisation.</li>
                            <li>The organisation's <strong>exclusive objective</strong> must be the protection of animals.</li>
                            <li>The organisation must be registered with SARS.</li>
                        </ol>
                    </div>

                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Name of Organisation</label>
                        <input asp-for="S10.NameOfTheOrganisation" class="rf-input" id="NameOfTheOrganisation"
                               maxlength="100" placeholder="Full legal name of the organisation" required />
                        <span asp-validation-for="S10.NameOfTheOrganisation" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Registration Number</label>
                        <input asp-for="S10.RegistrationNumber" class="rf-input" id="RegistrationNumber"
                               maxlength="50" placeholder="e.g. 2004/012345/08" required />
                        <span asp-validation-for="S10.RegistrationNumber" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Name, Surname &amp; Designation of Applicant</label>
                        <input asp-for="S10.NameSurnameDesignation" class="rf-input" id="NameSurnameDesignation"
                               maxlength="100" placeholder="e.g. Jane Dlamini — Director" required />
                        <span asp-validation-for="S10.NameSurnameDesignation" class="rf-error"></span>
                    </div>

                </div>
            </div>

 
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">3</div>
                    <h2 class="rf-section-title">Contact Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field" style="flex:2; min-width:180px;">
                        <label class="rf-label rf-required">Email Address</label>
                        <input asp-for="S3.Email" class="rf-input" id="Email"
                               type="email" maxlength="100"
                               placeholder="organisation@@email.com" required />
                        <span asp-validation-for="S3.Email" class="rf-error"></span>
                    </div>
                    <div class="rf-field" style="flex:1; min-width:100px;">
                        <label class="rf-label rf-required">Cell / Contact Number</label>
                        <input asp-for="S3.CellNo" class="rf-input" id="CellNo"
                               maxlength="14" placeholder="0XX XXX XXXX"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                        <span asp-validation-for="S3.CellNo" class="rf-error"></span>
                    </div>
                </div>
            </div>

          
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">4</div>
                    <h2 class="rf-section-title">SARS Registration</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Is the organisation registered with SARS?</label>
                        <select asp-for="S10.RegisteredWithSARS" class="rf-input"
                                id="sarsSelect" onchange="handleSars(this)" required>
                            <option value="">Select...</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>
                        </select>
                        <span asp-validation-for="S10.RegisteredWithSARS" class="rf-error"></span>
                    </div>
                    <div class="rf-reject-warning" id="sarsWarning">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <strong>Does not qualify.</strong>
                        The organisation must be registered with SARS to qualify.
                        Your application will be automatically declined.
                    </div>
                </div>
            </div>

         
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">5</div>
                    <h2 class="rf-section-title">Supporting Documents</h2>
                </div>
                <div class="rf-section-body">

                    <div class="rf-upload-notice">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        All documents must be <strong>PDF format only</strong>.
                        Maximum file size: <strong>20 MB</strong> per document.
                    </div>

                    <div class="rf-field rf-field-upload">
                        <label class="rf-label" id="sarsLabel">
                            SARS Certificate
                        </label>
                        <input type="file" id="sarsFile" name="files" class="rf-file"
                               accept=".pdf" onchange="validatePdf(this)" />
                        <span class="rf-file-help">Required if registered with SARS</span>
                    </div>

                    <div class="rf-field rf-field-upload">
                        <label class="rf-label rf-required">
                            3-Year Audited Financial Statements
                        </label>
                        <input type="file" name="files" class="rf-file"
                               accept=".pdf" onchange="validatePdf(this)" required />
                        <span class="rf-file-help">Required</span>
                    </div>

                </div>
            </div>

            <div class="rf-submit-bar">
                <a asp-controller="Rebates" asp-action="Index" class="rf-cancel-btn">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
                <button type="submit" class="rf-submit-btn" id="submitBtn">
                    <i class="fa-solid fa-paper-plane"></i> Submit Application
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    window.isNumericKey = function (e) {
        var c = e.which ?? e.keyCode;
        return !(c > 31 && (c < 48 || c > 57));
    };
    window.handleSars = function (sel) {
        var w = document.getElementById('sarsWarning');
        var f = document.getElementById('sarsFile');
        w.style.display = sel.value === 'No' ? 'block' : 'none';
        f.required      = sel.value === 'Yes';
    };
    window.validatePdf = function (input) {
        var file = input.files[0];
        if (file && !file.name.toLowerCase().endsWith('.pdf')) {
            alert('Please select a PDF file only.'); input.value = '';
        }
    };
    document.getElementById('rebateForm')?.addEventListener('submit', function (e) {
        var ids = ['AccountNumber','ErfandTownship','StreetAddress',
                   'NameOfTheOrganisation','RegistrationNumber',
                   'NameSurnameDesignation','Email','CellNo'];
        var failed = false;
        ids.forEach(function (id) {
            var el = document.getElementById(id);
            if (el && el.value.trim() === '') {
                el.style.borderColor = '#dc2626'; failed = true;
            } else if (el) { el.style.borderColor = ''; }
        });
        if (failed) {
            e.preventDefault();
            var btn = document.getElementById('submitBtn');
            if (btn) { btn.disabled=false; btn.innerHTML='<i class="fa-solid fa-paper-plane"></i> Submit Application'; }
            document.querySelector('input[style*="dc2626"]')?.scrollIntoView({behavior:'smooth',block:'center'});
        } else {
            var btn = document.getElementById('submitBtn');
            if (btn) { btn.disabled=true; btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Submitting...'; }
        }
    });
})();
</script>
}
