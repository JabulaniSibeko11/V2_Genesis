@model V2_Genesis.Models.Rebates.RebateFormBinding
@{
    ViewData["Title"] = "Pensioner Rebate — Age 60–69";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}
@section Styles {
    <link href="~/css/views/rebates-form.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
}

<div class="rf-page">

    <div class="rf-header">
        <div class="rf-header-inner">
            <a asp-controller="Rebates" asp-action="Pensioner" class="rf-back-btn">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
            <div>
                <div class="rf-eyebrow">Pensioner Rebate — Age 60 to 69</div>
                <h1 class="rf-title">Application for Pensioner Rebate on Property Rates</h1>
            </div>
        </div>
    </div>

    <div class="rf-conditions">
        <div class="rf-conditions-inner">
            <i class="fa-solid fa-circle-info"></i>
            <div>
                <strong>Period: From 1 July 2023 &nbsp;|&nbsp; Conditions:</strong>
                Pensioners must be between 60–69 years of age, own the property and personally occupy it.
                The first <strong>R1.5 million</strong> of the property value is exempt from rating.
                Income below R11 531/month — 100% rebate. Income R11 531–R19 765 — 50% rebate.
                Above R19 765 — does not qualify. One property only.
            </div>
        </div>
    </div>

    <div class="rf-body">

        <form id="rebateForm"
              method="post"
              enctype="multipart/form-data"
              asp-controller="Rebates"
              asp-action="ViewForm60">

            @Html.AntiForgeryToken()

           
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">1</div>
                    <h2 class="rf-section-title">Personal Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Account Number</label>
                        <input asp-for="S1.AccountNumber" class="rf-input" minlength="9" maxlength="9"
                               placeholder="9-digit account number"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                        <span asp-validation-for="S1.AccountNumber" class="rf-error"></span>
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Gender</label>
                        <div class="rf-radio-group">
                            <label class="rf-radio-label">
                                <input type="radio" asp-for="S1.Gender" value="Male" required /><span>Male</span>
                            </label>
                            <label class="rf-radio-label">
                                <input type="radio" asp-for="S1.Gender" value="Female" required /><span>Female</span>
                            </label>
                        </div>
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Marital Status</label>
                        <select asp-for="S1.MaritalStatus" class="rf-input" id="maritalStatus" required>
                            <option value="">Select...</option>
                            <option value="Single">Single</option>
                            <option value="Married">Married</option>
                            <option value="Widow">Widow</option>
                            <option value="Widower">Widower</option>
                        </select>
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Surname</label>
                        <input asp-for="S1.Surname" class="rf-input" id="Surname" maxlength="50" required />
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">First Names</label>
                        <input asp-for="S1.FirstNames" class="rf-input" id="FirstNames" maxlength="50" required />
                    </div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Identification Type</label>
                        <div class="rf-radio-group">
                            <label class="rf-radio-label">
                                <input type="radio" name="identificationType" value="IDNumber" required /><span>RSA ID Number</span>
                            </label>
                            <label class="rf-radio-label">
                                <input type="radio" name="identificationType" value="PassportNumber" /><span>Passport</span>
                            </label>
                        </div>
                    </div>
                    <div class="rf-field rf-field-half" id="idNumberGroup" style="display:none;">
                        <label class="rf-label rf-required">RSA ID Number</label>
                        <input asp-for="S1.IDNumber" class="rf-input" id="RSAIDNumber"
                               minlength="13" maxlength="13" placeholder="13-digit ID"
                               onkeypress="return isNumericKey(event)" onpaste="return false" />
                    </div>
                    <div class="rf-field rf-field-half" id="passportGroup" style="display:none;">
                        <label class="rf-label rf-required">Passport Number</label>
                        <input asp-for="S1.PassportNumber" class="rf-input" id="PassportNumber" maxlength="30" />
                    </div>
                    <div id="spouseFields" style="display:none;" class="rf-field-full rf-spouse-group">
                        <div class="rf-spouse-banner"><i class="fa-solid fa-user-group"></i> Spouse Details</div>
                        <div class="rf-fields-row">
                            <div class="rf-field rf-field-third">
                                <label class="rf-label rf-required">Spouse Surname</label>
                                <input asp-for="S1.SpouseSurname" class="rf-input" id="SpouseSurname" maxlength="50" />
                            </div>
                            <div class="rf-field rf-field-third">
                                <label class="rf-label rf-required">Spouse First Names</label>
                                <input asp-for="S1.SpouseFirstNames" class="rf-input" id="SpouseFirstNames" maxlength="50" />
                            </div>
                            <div class="rf-field rf-field-third">
                                <label class="rf-label">Spouse ID Number</label>
                                <input asp-for="S1.SpouseIDNumber" class="rf-input" id="SpouseIDNumber"
                                       minlength="13" maxlength="13"
                                       onkeypress="return isNumericKey(event)" onpaste="return false" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>

      
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">2</div>
                    <h2 class="rf-section-title">Address Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-address-group-label">Physical Address</div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Street Address</label>
                        <input asp-for="S2.StreetAddress" class="rf-input" id="StreetAddress" maxlength="50" required />
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">City / Suburb</label>
                        <input asp-for="S2.CitySuburb" class="rf-input" id="CitySuburb" maxlength="50" required />
                    </div>
                    <div class="rf-field rf-field-quarter">
                        <label class="rf-label rf-required">Postal Code</label>
                        <input asp-for="S2.PostalCode" class="rf-input" id="PostalCode" maxlength="4"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                    </div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-checkbox-label">
                            <input type="checkbox" id="sameAddress" onchange="copyAddress(this)" />
                            <span>Postal address is the same as physical address</span>
                        </label>
                    </div>
                    <div class="rf-address-group-label">Postal Address</div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label">Postal Address</label>
                        <input asp-for="S2.PostalAddress" class="rf-input" id="PostalAddress" maxlength="50" />
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label">City / Suburb</label>
                        <input asp-for="S2.PostalAddressCitySuburb" class="rf-input" id="PostalAddressCitySuburb" maxlength="50" />
                    </div>
                    <div class="rf-field rf-field-quarter">
                        <label class="rf-label">Postal Code</label>
                        <input asp-for="S2.PostalAddressPostalCode" class="rf-input" id="PostalAddressPostalCode" maxlength="4"
                               onkeypress="return isNumericKey(event)" onpaste="return false" />
                    </div>
                </div>
            </div>

        
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">3</div>
                    <h2 class="rf-section-title">Contact Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field rf-field-quarter">
                        <label class="rf-label">Home Telephone</label>
                        <input asp-for="S3.HomeTel" class="rf-input" maxlength="14"
                               onkeypress="return isNumericKey(event)" onpaste="return false" />
                    </div>
                    <div class="rf-field rf-field-quarter">
                        <label class="rf-label rf-required">Cell Number</label>
                        <input asp-for="S3.CellNo" class="rf-input" id="CellNo" maxlength="14"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                    </div>
                    <div class="rf-field rf-field-quarter">
                        <label class="rf-label">Work Telephone</label>
                        <input asp-for="S3.WorkTel" class="rf-input" maxlength="14"
                               onkeypress="return isNumericKey(event)" onpaste="return false" />
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Email Address</label>
                        <input asp-for="S3.Email" class="rf-input" id="Email" type="email" maxlength="50" required />
                    </div>
                </div>
            </div>

           
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">4</div>
                    <h2 class="rf-section-title">Property Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Do you occupy the mentioned property?</label>
                        <select asp-for="S1.OccupyMentionedProperty" class="rf-input" required>
                            <option value="">Select...</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>
                        </select>
                    </div>
                    <div class="rf-field rf-field-quarter">
                        <label class="rf-label">Stand Number</label>
                        <input asp-for="S4.StandNumber" class="rf-input" maxlength="50" />
                    </div>
                    <div class="rf-field rf-field-quarter">
                        <label class="rf-label">Portion Number</label>
                        <input asp-for="S4.PortionNumber" class="rf-input" maxlength="50" />
                    </div>
                    <div class="rf-field rf-field-third">
                        <label class="rf-label">Suburb</label>
                        <input asp-for="S4.Suburb" class="rf-input" maxlength="50" />
                    </div>
                    <div class="rf-field rf-field-third">
                        <label class="rf-label">Name of Body Corporate</label>
                        <input asp-for="S4.NameOfBodyCorporate" class="rf-input" maxlength="50" />
                    </div>
                    <div class="rf-field rf-field-third">
                        <label class="rf-label">Unit / Door Number</label>
                        <input asp-for="S4.DoorNumber" class="rf-input" maxlength="50" />
                    </div>
                </div>
            </div>

        
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">5</div>
                    <h2 class="rf-section-title">Monthly Income</h2>
                </div>
                <div class="rf-section-body">
                    <p class="rf-income-note">
                        Enter monthly income for the applicant and spouse (if married).
                        Leave blank if not applicable. Format: R 10,000
                    </p>
                    <div class="rf-income-table-wrap">
                        <table class="rf-income-table">
                            <thead>
                                <tr>
                                    <th class="rf-it-label">Type of Income</th>
                                    <th>Applicant</th>
                                    <th>Spouse</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="rf-it-label">Salary</td>
                                    <td>
                                        <input asp-for="S6.SalaryIncomeApplicant" class="rf-input rf-currency"
                                               placeholder="R 0" onkeypress="return isNumericKey(event)" />
                                    </td>
                                    <td>
                                        <input asp-for="S6.SalaryIncomeSpouse" class="rf-input rf-currency"
                                               placeholder="R 0" onkeypress="return isNumericKey(event)" />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="rf-it-label">Interest on Investments</td>
                                    <td>
                                        <input asp-for="S6.InterestOnInvestmentsApplicant" class="rf-input rf-currency"
                                               placeholder="R 0" onkeypress="return isNumericKey(event)" />
                                    </td>
                                    <td>
                                        <input asp-for="S6.InterestOnInvestmentsSpouse" class="rf-input rf-currency"
                                               placeholder="R 0" onkeypress="return isNumericKey(event)" />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="rf-it-label">Monthly Pension</td>
                                    <td>
                                        <input asp-for="S6.MonthlyPensionApplicant" class="rf-input rf-currency"
                                               placeholder="R 0" onkeypress="return isNumericKey(event)" />
                                    </td>
                                    <td>
                                        <input asp-for="S6.MonthlyPensionSpouse" class="rf-input rf-currency"
                                               placeholder="R 0" onkeypress="return isNumericKey(event)" />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="rf-it-label">State Disability Allowance</td>
                                    <td>
                                        <input asp-for="S6.StateDisabilityAllowanceApplicant" class="rf-input rf-currency"
                                               placeholder="R 0" onkeypress="return isNumericKey(event)" />
                                    </td>
                                    <td>
                                        <input asp-for="S6.StateDisabilityAllowanceSpouse" class="rf-input rf-currency"
                                               placeholder="R 0" onkeypress="return isNumericKey(event)" />
                                    </td>
                                </tr>
                                <tr>
                                    <td class="rf-it-label">Other Income</td>
                                    <td>
                                        <input asp-for="S6.OtherIncomeApplicant" class="rf-input rf-currency"
                                               placeholder="R 0" onkeypress="return isNumericKey(event)" />
                                    </td>
                                    <td>
                                        <input asp-for="S6.OtherIncomeSpouse" class="rf-input rf-currency"
                                               placeholder="R 0" onkeypress="return isNumericKey(event)" />
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">6</div>
                    <h2 class="rf-section-title">Supporting Documents</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-upload-notice">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        All documents must be <strong>PDF format only</strong>. Max <strong>20 MB</strong> per file.
                    </div>
                    <div class="rf-field rf-field-upload">
                        <label class="rf-label rf-required">Certified Copy of ID / Passport</label>
                        <input type="file" name="files" class="rf-file" accept=".pdf"
                               onchange="validatePdf(this)" required />
                        <span class="rf-file-help">Required</span>
                    </div>
                    <div class="rf-field rf-field-upload">
                        <label class="rf-label">Proof of Income</label>
                        <input type="file" name="files" class="rf-file" accept=".pdf" onchange="validatePdf(this)" />
                        <span class="rf-file-help">Payslip or pension statement</span>
                    </div>
                    <div class="rf-field rf-field-upload">
                        <label class="rf-label">SASSA Card Copy</label>
                        <input type="file" name="files" class="rf-file" accept=".pdf" onchange="validatePdf(this)" />
                        <span class="rf-file-help">If applicable</span>
                    </div>
                    <div class="rf-field rf-field-upload">
                        <label class="rf-label">3-Month Bank Statement</label>
                        <input type="file" name="files" class="rf-file" accept=".pdf" onchange="validatePdf(this)" />
                    </div>
                    <div class="rf-field rf-field-upload">
                        <label class="rf-label">SARS Income Tax Certificate</label>
                        <input type="file" name="files" class="rf-file" accept=".pdf" onchange="validatePdf(this)" />
                    </div>
                </div>
            </div>

            <div class="rf-submit-bar">
                <a asp-controller="Rebates" asp-action="Pensioner" class="rf-cancel-btn">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
                <button type="submit" class="rf-submit-btn" id="submitBtn">
                    <i class="fa-solid fa-paper-plane"></i> Submit Application
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            window.isNumericKey = function (e) {
                var c = e.which ?? e.keyCode;
                return !(c > 31 && (c < 48 || c > 57));
            };
            var marital = document.getElementById('maritalStatus');
            var spouseFields = document.getElementById('spouseFields');
            marital?.addEventListener('change', function () {
                var show = this.value === 'Married';
                spouseFields.style.display = show ? 'block' : 'none';
                ['SpouseSurname','SpouseFirstNames'].forEach(function (id) {
                    var el = document.getElementById(id);
                    if (el) el.required = show;
                });
            });
            document.querySelectorAll('input[name="identificationType"]').forEach(function (r) {
                r.addEventListener('change', function () {
                    var ig = document.getElementById('idNumberGroup');
                    var pg = document.getElementById('passportGroup');
                    var ii = document.getElementById('RSAIDNumber');
                    var pi = document.getElementById('PassportNumber');
                    if (this.value === 'IDNumber') {
                        ig.style.display='block'; pg.style.display='none';
                        ii.required=true; if(pi) pi.required=false;
                    } else {
                        ig.style.display='none'; pg.style.display='block';
                        if(pi) pi.required=true; ii.required=false;
                    }
                });
            });
            window.copyAddress = function (cb) {
                [['StreetAddress','PostalAddress'],['CitySuburb','PostalAddressCitySuburb'],
                 ['PostalCode','PostalAddressPostalCode']].forEach(function (p) {
                    var s = document.getElementById(p[0]);
                    var d = document.getElementById(p[1]);
                    if (d) d.value = cb.checked && s ? s.value : '';
                });
            };
            window.validatePdf = function (input) {
                var f = input.files[0];
                if (f && !f.name.toLowerCase().endsWith('.pdf')) {
                    alert('Please select a PDF file only.'); input.value = '';
                }
            };
            document.getElementById('rebateForm')?.addEventListener('submit', function () {
                var btn = document.getElementById('submitBtn');
                if (btn) { btn.disabled=true; btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Submitting...'; }
            });
        })();
    </script>
}
