@{
    ViewData["Title"] = "Application Submitted";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    var rebateNo = TempData["id"]?.ToString() ?? "";
    var rebateType = TempData["Type"]?.ToString() ?? "Rebate Application";
    var status = TempData["Status"]?.ToString() ?? "Acknowledge";
    var date = TempData["Date"]?.ToString() ?? DateTime.Now.ToString("dd MMM yyyy HH:mm");
    var count = TempData["Count"]?.ToString() ?? "0";

    // Keep TempData so refresh doesn't wipe it
    TempData.Keep("id"); TempData.Keep("Type"); TempData.Keep("Status");
    TempData.Keep("Date"); TempData.Keep("Count");
    for (int k = 1; k <= 10; k++) TempData.Keep($"File{k}");

    var files = new List<string>();
    for (int i = 1; i <= 10; i++)
    {
        var f = TempData[$"File{i}"]?.ToString();
        if (!string.IsNullOrWhiteSpace(f)) files.Add(f);
    }

    bool isRejected = status == "Auto Reject";
}

@section Styles {
    <link href="~/css/views/rebates-display.css" rel="stylesheet" asp-append-version="true" />
        
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
}

<div class="disp-wrap">

  
    <div class="disp-hero @(isRejected ? "disp-hero-reject" : "disp-hero-success")">
        <div class="disp-hero-icon">
            @if (isRejected)
            {
                <i class="fa-solid fa-circle-xmark"></i>
            }
            else
            {
                <i class="fa-solid fa-circle-check"></i>
            }
        </div>
        <div class="disp-hero-text">
            @if (isRejected)
            {
                <h1>Application Unsuccessful</h1>
                <p>Your application did not meet the qualifying criteria and has been automatically declined.</p>
            }
            else
            {
                <h1>Application Submitted!</h1>
                <p>Your rebate application has been received. Your acknowledgement has been emailed to you.</p>
            }
        </div>
    </div>

    <div class="disp-body">

  
        <div class="disp-card">
            <div class="disp-card-head">
                <i class="fa-solid fa-receipt"></i> Application Details
            </div>
            <div class="disp-card-body">
                <div class="disp-ref-grid">
                    <div>
                        <div class="disp-ref-label">Application No.</div>
                        <div class="disp-ref-value hero-num">@rebateNo</div>
                    </div>
                    <div>
                        <div class="disp-ref-label">Status</div>
                        <div class="disp-ref-value">
                            <span class="disp-pill @(isRejected ? "disp-pill-reject" : "disp-pill-ok")">
                                @if (isRejected)
                                {
                                    <i class="fa-solid fa-circle-xmark"></i><span>Auto Rejected</span>
                                }
                                else
                                {
                                    <i class="fa-solid fa-circle-check"></i><span>Acknowledged</span>
                                }
                            </span>
                        </div>
                    </div>
                    <div>
                        <div class="disp-ref-label">Rebate Type</div>
                        <div class="disp-ref-value" style="font-size:13.5px;">@rebateType</div>
                    </div>
                    <div>
                        <div class="disp-ref-label">Date &amp; Time</div>
                        <div class="disp-ref-value" style="font-size:13.5px;">@date</div>
                    </div>
                    <div>
                        <div class="disp-ref-label">Documents Uploaded</div>
                        <div class="disp-ref-value">@count file@(count == "1" ? "" : "s")</div>
                    </div>
                </div>
            </div>
        </div>

       
        @if (files.Any())
        {
            <div class="disp-card">
                <div class="disp-card-head">
                    <i class="fa-solid fa-paperclip"></i>
                    Uploaded Documents (@files.Count)
                </div>
                <div class="disp-card-body" style="padding-bottom:10px;">
                    @for (int i = 0; i < files.Count; i++)
                    {
                        <div class="disp-file-row">
                            <i class="fa-solid fa-file-pdf"></i>
                            <span class="disp-file-num">@(i + 1)</span>
                            <span>@files[i]</span>
                        </div>
                    }
                </div>
            </div>
        }

        @if (isRejected)
        {
            <div class="disp-notice disp-notice-rej">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <div>
                    <strong>Automatically declined.</strong>
                    Your application did not meet the qualifying criteria.
                    To enquire, contact us at
                    <strong>011 407-6622</strong> or
                    <a href="mailto:valuationenquiries@joburg.org.za"
                           style="color:#7a2010;font-weight:600;">
                        valuationenquiries@joburg.org.za
                    </a>.
                </div>
            </div>
        }
        else
        {
            <div class="disp-notice disp-notice-ok">
                <i class="fa-solid fa-envelope"></i>
                <div>
                    <strong>Acknowledgement emailed and available to download.</strong><br />
                    Keep your reference number <strong>@rebateNo</strong> for your records.
                </div>
            </div>
        }

 
        <div class="disp-card">
            <div class="disp-actions">
                @if (!isRejected)
                {
                    <a asp-controller="Rebates" asp-action="Download"
                           asp-route-rebateNo="@rebateNo"
                           class="disp-btn disp-btn-gold">
                        <i class="fa-solid fa-file-pdf"></i>
                        Download Acknowledgement
                    </a>
                }
                <a asp-controller="Dashboard" asp-action="Index"
                       asp-route-openRoll="Rebates"
                       class="disp-btn disp-btn-teal">
                    <i class="fa-solid fa-gauge-high"></i>
                    My Applications
                </a>
                <a asp-controller="Rebates" asp-action="Index"
                       class="disp-btn disp-btn-outline">
                    <i class="fa-solid fa-plus"></i>
                    New Application
                </a>
            </div>
        </div>

    </div>
</div>
