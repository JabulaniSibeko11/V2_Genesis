@model V2_Genesis.Models.Rebates.RebateFormBinding
@{
    ViewData["Title"] = "Life Rights Rebate";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}
@section Styles {
    <link href="~/css/views/rebates-form.css" rel="stylesheet" asp-append-version="true" />
     <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true"/>
   
}

<div class="rf-page">

    <div class="rf-header">
        <div class="rf-header-inner">
            <a asp-controller="Rebates" asp-action="Index" class="rf-back-btn">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
            <div>
                <div class="rf-eyebrow">Rates Rebates</div>
                <h1 class="rf-title">Application for Life Rights / Housing Schemes for Retired Persons</h1>
            </div>
        </div>
    </div>

    <div class="rf-conditions">
        <div class="rf-conditions-inner">
            <i class="fa-solid fa-circle-info"></i>
            <div>
                <strong>Period: From 1 July 2023 &nbsp;|&nbsp; Maximum rebate: 50%.</strong>
                Applicable to properties under the Housing Development Schemes for Retired Persons Act (65 of 1988).
                Applicant must be aged <strong>60+</strong>. First <strong>R1.5 million</strong> exempt from rating.
                The owner must pass the benefit on to the registered holder(s) of the right of occupation.
            </div>
        </div>
    </div>

    <div class="rf-body">

        <form id="rebateForm"
              data-submission-loader
              data-submission-title="Submitting your Rebate application..."
              data-submission-message="Please wait while the Valuation Department receives your Rebate application and prepares the acknowledgement. Do not close or refresh this page."
              method="post"
              enctype="multipart/form-data"
              asp-controller="Rebates"
              asp-action="LifeRights">

            @Html.AntiForgeryToken()

           
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">1</div>
                    <h2 class="rf-section-title">Personal Details</h2>
                </div>
                <div class="rf-section-body">

                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Account Number</label>
                        <input asp-for="S1.AccountNumber" class="rf-input"
                               minlength="9" maxlength="9" placeholder="9-digit account number"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                        <span asp-validation-for="S1.AccountNumber" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Gender</label>
                        <div class="rf-radio-group">
                            <label class="rf-radio-label">
                                <input type="radio" asp-for="S1.Gender" value="Male" required />
                                <span>Male</span>
                            </label>
                            <label class="rf-radio-label">
                                <input type="radio" asp-for="S1.Gender" value="Female" required />
                                <span>Female</span>
                            </label>
                        </div>
                        <span asp-validation-for="S1.Gender" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Marital Status</label>
                        <select asp-for="S1.MaritalStatus" class="rf-input"
                                id="maritalStatus" required>
                            <option value="">Select...</option>
                            <option value="Single">Single</option>
                            <option value="Married">Married</option>
                            <option value="Widow">Widow</option>
                            <option value="Widower">Widower</option>
                        </select>
                        <span asp-validation-for="S1.MaritalStatus" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Surname</label>
                        <input asp-for="S1.Surname" class="rf-input" id="Surname"
                               maxlength="50" placeholder="Your surname" required />
                        <span asp-validation-for="S1.Surname" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">First Names</label>
                        <input asp-for="S1.FirstNames" class="rf-input" id="FirstNames"
                               maxlength="50" placeholder="Your first names" required />
                        <span asp-validation-for="S1.FirstNames" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Identification Type</label>
                        <div class="rf-radio-group">
                            <label class="rf-radio-label">
                                <input type="radio" name="identificationType" value="IDNumber" required />
                                <span>RSA ID Number</span>
                            </label>
                            <label class="rf-radio-label">
                                <input type="radio" name="identificationType" value="PassportNumber" />
                                <span>Passport</span>
                            </label>
                        </div>
                    </div>

                    <div class="rf-field rf-field-full" id="idNumberGroup" style="display:none;">
                        <label class="rf-label rf-required">RSA ID Number</label>
                        <input asp-for="S1.IDNumber" class="rf-input" id="RSAIDNumber"
                               minlength="13" maxlength="13" placeholder="13-digit ID"
                               onkeypress="return isNumericKey(event)" onpaste="return false" />
                        <span asp-validation-for="S1.IDNumber" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-full" id="passportGroup" style="display:none;">
                        <label class="rf-label rf-required">Passport Number</label>
                        <input asp-for="S1.PassportNumber" class="rf-input" id="PassportNumber"
                               maxlength="30" placeholder="Passport number" />
                        <span asp-validation-for="S1.PassportNumber" class="rf-error"></span>
                    </div>

                   
                    <div id="spouseFields" class="rf-field-full rf-spouse-group" style="display:none;">
                        <div class="rf-spouse-banner">
                            <i class="fa-solid fa-user-group"></i> Spouse Details
                        </div>
                        <div class="rf-fields-row">
                            <div class="rf-field rf-field-third">
                                <label class="rf-label rf-required">Spouse Surname</label>
                                <input asp-for="S1.SpouseSurname" class="rf-input"
                                       id="SpouseSurname" maxlength="50" />
                            </div>
                            <div class="rf-field rf-field-third">
                                <label class="rf-label rf-required">Spouse First Names</label>
                                <input asp-for="S1.SpouseFirstNames" class="rf-input"
                                       id="SpouseFirstNames" maxlength="50" />
                            </div>
                            <div class="rf-field rf-field-third">
                                <label class="rf-label">Spouse ID Number</label>
                                <input asp-for="S1.SpouseIDNumber" class="rf-input"
                                       id="SpouseIDNumber" minlength="13" maxlength="13"
                                       onkeypress="return isNumericKey(event)" onpaste="return false" />
                            </div>
                        </div>
                    </div>

                </div>
            </div>

            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">2</div>
                    <h2 class="rf-section-title">Address Details</h2>
                </div>
                <div class="rf-section-body">

                    <div class="rf-address-group-label">Physical Address</div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Street Address</label>
                        <input asp-for="S2.StreetAddress" class="rf-input" id="StreetAddress"
                               maxlength="50" placeholder="e.g. 15 Main Street" required />
                        <span asp-validation-for="S2.StreetAddress" class="rf-error"></span>
                    </div>
                    <div class="rf-field" style="flex:2; min-width:180px;">
                        <label class="rf-label rf-required">City / Suburb</label>
                        <input asp-for="S2.CitySuburb" class="rf-input" id="CitySuburb"
                               maxlength="50" required />
                        <span asp-validation-for="S2.CitySuburb" class="rf-error"></span>
                    </div>
                    <div class="rf-field" style="flex:1; min-width:100px;">
                        <label class="rf-label rf-required">Postal Code</label>
                        <input asp-for="S2.PostalCode" class="rf-input" id="PostalCode"
                               maxlength="4" placeholder="0000"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                        <span asp-validation-for="S2.PostalCode" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-full">
                        <label class="rf-checkbox-label">
                            <input type="checkbox" id="sameAddress" onchange="copyAddress(this)" />
                            <span>Postal address is the same as physical address</span>
                        </label>
                    </div>

                    <div class="rf-address-group-label">Postal Address</div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Postal Address</label>
                        <input asp-for="S2.PostalAddress" class="rf-input" id="PostalAddress"
                               maxlength="50" required />
                        <span asp-validation-for="S2.PostalAddress" class="rf-error"></span>
                    </div>
                    <div class="rf-field" style="flex:2; min-width:180px;">
                        <label class="rf-label rf-required">City / Suburb</label>
                        <input asp-for="S2.PostalAddressCitySuburb" class="rf-input"
                               id="PostalAddressCitySuburb" maxlength="50" required />
                        <span asp-validation-for="S2.PostalAddressCitySuburb" class="rf-error"></span>
                    </div>
                    <div class="rf-field" style="flex:1; min-width:100px;">
                        <label class="rf-label rf-required">Postal Code</label>
                        <input asp-for="S2.PostalAddressPostalCode" class="rf-input"
                               id="PostalAddressPostalCode" maxlength="4"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                        <span asp-validation-for="S2.PostalAddressPostalCode" class="rf-error"></span>
                    </div>

                </div>
            </div>

          
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">3</div>
                    <h2 class="rf-section-title">Contact Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field rf-field-third">
                        <label class="rf-label">Home Telephone</label>
                        <input asp-for="S3.HomeTel" class="rf-input" maxlength="14"
                               placeholder="011 000 0000"
                               onkeypress="return isNumericKey(event)" onpaste="return false" />
                    </div>
                    <div class="rf-field rf-field-third">
                        <label class="rf-label rf-required">Cell Number</label>
                        <input asp-for="S3.CellNo" class="rf-input" id="CellNo"
                               maxlength="14" placeholder="0XX XXX XXXX"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                    </div>
                    <div class="rf-field rf-field-third">
                        <label class="rf-label">Work Telephone</label>
                        <input asp-for="S3.WorkTel" class="rf-input" maxlength="14"
                               placeholder="011 000 0000"
                               onkeypress="return isNumericKey(event)" onpaste="return false" />
                    </div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Email Address</label>
                        <input asp-for="S3.Email" class="rf-input" id="Email"
                               type="email" maxlength="100" placeholder="your@@email.com" required />
                    </div>
                </div>
            </div>

        
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">4</div>
                    <h2 class="rf-section-title">Scheme / Unit Details</h2>
                </div>
                <div class="rf-section-body">

                    <div class="rf-scheme-banner">
                        <i class="fa-solid fa-circle-info"></i>
                        <span>
                            Complete this section if the property forms part of a
                            housing scheme for retired persons. Enter the scheme details
                            and the account number for any multiple units on the scheme.
                        </span>
                    </div>

                    <div class="rf-field rf-field-half">
                        <label class="rf-label">Name of Scheme / Building</label>
                        <input asp-for="S8.SchemeBuilding" class="rf-input"
                               maxlength="50" placeholder="e.g. Sunset Retirement Village" />
                        <span asp-validation-for="S8.SchemeBuilding" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-half">
                        <label class="rf-label">Account Number — Multiple Units</label>
                        <input asp-for="S8.AccountNo_MultipleUnits" class="rf-input"
                               placeholder="Account number if multiple units" />
                        <span asp-validation-for="S8.AccountNo_MultipleUnits" class="rf-error"></span>
                    </div>

                    <div class="rf-field rf-field-full">
                        <label class="rf-label">Scheme Contact Cell Number</label>
                        <input asp-for="S8.Contact_CellNo" class="rf-input"
                               maxlength="14" placeholder="0XX XXX XXXX"
                               onkeypress="return isNumericKey(event)" onpaste="return false" />
                        <span asp-validation-for="S8.Contact_CellNo" class="rf-error"></span>
                    </div>

                </div>
            </div>

          
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">5</div>
                    <h2 class="rf-section-title">Supporting Documents</h2>
                </div>
                <div class="rf-section-body">

                    <div class="rf-upload-notice">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        All documents must be in <strong>PDF format only</strong>.
                        Maximum file size: <strong>20 MB</strong> per document.
                    </div>

                    <div class="rf-field rf-field-upload">
                        <label class="rf-label rf-required">Certified Copy of ID / Passport</label>
                        <input type="file" name="files" class="rf-file"
                               accept=".pdf" onchange="validatePdf(this)" required />
                        <span class="rf-file-help">Required — Certified copy</span>
                    </div>

                    <div class="rf-field rf-field-upload">
                        <label class="rf-label rf-required">
                            Proof of Scheme Registration
                        </label>
                        <input type="file" name="files" class="rf-file"
                               accept=".pdf" onchange="validatePdf(this)" required />
                        <span class="rf-file-help">
                            Registration under the Housing Development Schemes for Retired Persons Act
                        </span>
                    </div>

                    <div class="rf-field rf-field-upload">
                        <label class="rf-label">
                            Any Additional Supporting Documents
                        </label>
                        <input type="file" name="files" class="rf-file"
                               accept=".pdf" onchange="validatePdf(this)" />
                        <span class="rf-file-help">Optional</span>
                    </div>

                </div>
            </div>

            <div class="rf-submit-bar">
                <a asp-controller="Rebates" asp-action="Index" class="rf-cancel-btn">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
                <button type="submit" class="rf-submit-btn" id="submitBtn">
                    <i class="fa-solid fa-paper-plane"></i> Submit Application
                </button>
            </div>

        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    window.isNumericKey = function (e) {
        var c = e.which ?? e.keyCode;
        return !(c > 31 && (c < 48 || c > 57));
    };

    // ── Marital Status → Spouse fields ──────────────────────────
    document.getElementById('maritalStatus')?.addEventListener('change', function () {
        var show = this.value === 'Married';
        var sf = document.getElementById('spouseFields');
        if (sf) sf.style.display = show ? 'block' : 'none';
        ['SpouseSurname','SpouseFirstNames'].forEach(function (id) {
            var el = document.getElementById(id);
            if (el) el.required = show;
        });
    });

    // ── ID / Passport toggle ─────────────────────────────────────
    document.querySelectorAll('input[name="identificationType"]').forEach(function (r) {
        r.addEventListener('change', function () {
            var ig = document.getElementById('idNumberGroup');
            var pg = document.getElementById('passportGroup');
            var ii = document.getElementById('RSAIDNumber');
            var pi = document.getElementById('PassportNumber');
            if (this.value === 'IDNumber') {
                ig.style.display='block'; pg.style.display='none';
                ii.required=true; if(pi) pi.required=false;
            } else {
                ig.style.display='none'; pg.style.display='block';
                if(pi) pi.required=true; ii.required=false;
            }
        });
    });

    // ── Same address ─────────────────────────────────────────────
    window.copyAddress = function (cb) {
        [['StreetAddress','PostalAddress'],
         ['CitySuburb','PostalAddressCitySuburb'],
         ['PostalCode','PostalAddressPostalCode']].forEach(function (p) {
            var s = document.getElementById(p[0]);
            var d = document.getElementById(p[1]);
            if (d) d.value = cb.checked && s ? s.value : '';
        });
    };

    // ── PDF validation ───────────────────────────────────────────
    window.validatePdf = function (input) {
        var f = input.files[0];
        if (f && !f.name.toLowerCase().endsWith('.pdf')) {
            alert('Please select a PDF file only.'); input.value = '';
        }
    };

    // ── Submit guard ─────────────────────────────────────────────
    document.getElementById('rebateForm')?.addEventListener('submit', function (e) {
        var ids = ['Surname','FirstNames','StreetAddress','CitySuburb',
                   'PostalCode','PostalAddress','PostalAddressCitySuburb',
                   'PostalAddressPostalCode','CellNo','Email'];
        var failed = false;
        ids.forEach(function (id) {
            var el = document.getElementById(id);
            if (el && el.value.trim() === '') {
                el.style.borderColor = '#dc2626'; failed = true;
            } else if (el) { el.style.borderColor = ''; }
        });
        if (failed) {
            e.preventDefault();
            var btn = document.getElementById('submitBtn');
            if (btn) { btn.disabled=false; btn.innerHTML='<i class="fa-solid fa-paper-plane"></i> Submit Application'; }
            document.querySelector('input[style*="dc2626"]')?.scrollIntoView({behavior:'smooth',block:'center'});
        } else {
            var btn = document.getElementById('submitBtn');
            if (btn) { btn.disabled=true; btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Submitting...'; }
        }
    });
})();
</script>
}
