@model V2_Genesis.Models.Rebates.RebateFormBinding
@{
    ViewData["Title"] = "Education Rebate";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}
@section Styles {
    <link href="~/css/views/rebates-form.css" rel="stylesheet" asp-append-version="true" />
    
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
}

<div class="rf-page">
    <div class="rf-header">
        <div class="rf-header-inner">
            <a asp-controller="Rebates" asp-action="Index" class="rf-back-btn">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
            <div>
                <div class="rf-eyebrow">Rates Rebates</div>
                <h1 class="rf-title">Application — Private Learning Institutions (From 1 July 2023)</h1>
            </div>
        </div>
    </div>
    <div class="rf-conditions">
        <div class="rf-conditions-inner">
            <i class="fa-solid fa-circle-info"></i>
            <div>
                <strong>Period: From 1 July 2023.</strong>
                For private schools, colleges and universities in respect of property rating.
                The institution must be registered with SARS and provide 3 years of
                audited financial statements. Financial summary of projected income and
                expenditure is required.
            </div>
        </div>
    </div>
    <div class="rf-body">
        <form id="rebateForm"
              data-submission-loader
              data-submission-title="Submitting your Rebate application..."
              data-submission-message="Please wait while the Valuation Department receives your Rebate application and prepares the acknowledgement. Do not close or refresh this page." method="post" enctype="multipart/form-data"
              asp-controller="Rebates" asp-action="EducationRebate">
            @Html.AntiForgeryToken()

           
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">1</div>
                    <h2 class="rf-section-title">Organisation Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Account Number</label>
                        <input asp-for="S1.AccountNumber" class="rf-input"
                               minlength="9" maxlength="9" placeholder="9-digit account number"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                    </div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Name of Organisation / Institution</label>
                        <input asp-for="S10.NameOfTheOrganisation" class="rf-input" id="Organisation"
                               maxlength="100" placeholder="Full legal name of the institution" required />
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Name, Surname &amp; Designation of Applicant</label>
                        <input asp-for="S10.NameSurnameDesignation" class="rf-input" id="NameSurnameDesignation"
                               maxlength="100" placeholder="e.g. Dr. Jane Smith — Principal" required />
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Registration Number</label>
                        <input asp-for="S10.RegistrationNumber" class="rf-input" id="RegistrationNumber"
                               maxlength="50" placeholder="DoE or SAQA registration number" required />
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Period of Operation</label>
                        <input asp-for="S10.OperationTime" class="rf-input" id="OperationTime"
                               maxlength="50" placeholder="e.g. Since 1998 / 25 years" required />
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Contact Person for CoJ Statements</label>
                        <input asp-for="S10.ContactPersonWithCOJStatements" class="rf-input" id="ContactPersonWithCOJStatements"
                               maxlength="100" placeholder="Name and contact details" required />
                    </div>
                </div>
            </div>

            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">2</div>
                    <h2 class="rf-section-title">Address &amp; Contact Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Street Address</label>
                        <input asp-for="S2.StreetAddress" class="rf-input" id="StreetAddress"
                               maxlength="50" required />
                    </div>
                    <div class="rf-field rf-field-full">
                        <label class="rf-label">Postal Address</label>
                        <input asp-for="S2.PostalAddress" class="rf-input" id="PostalAddress" maxlength="50" />
                    </div>
                    <div class="rf-field rf-field-quarter">
                        <label class="rf-label">Work Telephone</label>
                        <input asp-for="S3.WorkTel" class="rf-input" maxlength="14"
                               onkeypress="return isNumericKey(event)" onpaste="return false" />
                    </div>
                    <div class="rf-field rf-field-quarter">
                        <label class="rf-label rf-required">Cell Number</label>
                        <input asp-for="S3.CellNo" class="rf-input" id="CellNo" maxlength="14"
                               onkeypress="return isNumericKey(event)" onpaste="return false" required />
                    </div>
                    <div class="rf-field rf-field-half">
                        <label class="rf-label rf-required">Email Address</label>
                        <input asp-for="S3.Email" class="rf-input" id="Email" type="email" maxlength="100" required />
                    </div>
                </div>
            </div>

            
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">3</div>
                    <h2 class="rf-section-title">SARS Registration</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Is the organisation registered with SARS?</label>
                        <select asp-for="S10.RegisteredWithSARS" class="rf-input"
                                id="sarsSelect" onchange="handleSars(this)" required>
                            <option value="">Select...</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>
                        </select>
                    </div>
                    <div class="rf-reject-warning" id="sarsWarning">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <strong>Does not qualify.</strong>
                        The organisation must be registered with SARS to qualify.
                        Your application will be automatically declined.
                    </div>
                </div>
            </div>

            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">4</div>
                    <h2 class="rf-section-title">Institution Details</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-field rf-field-full">
                        <label class="rf-label rf-required">Is the institution part of a large organisation?</label>
                        <select asp-for="S10.LargeOrganisation" class="rf-input"
                                id="largeOrgSelect" onchange="handleLargeOrg(this)" required>
                            <option value="">Select...</option>
                            <option value="Yes">Yes</option>
                            <option value="No">No</option>
                        </select>
                    </div>
                    <div class="rf-field rf-field-full" id="largeOrgDescGroup">
                        <label class="rf-label rf-required">Description of Large Organisation</label>
                        <input asp-for="S10.LargeOrganisationDescription" class="rf-input"
                               id="LargeOrganisationDescription" maxlength="100"
                               placeholder="Name and relationship to the large organisation" />
                    </div>

                    <div class="rf-stats-grid">
                        <div class="rf-field">
                            <label class="rf-label">Number of Permanent Staff</label>
                            <input asp-for="S10.NoPermantStaff" class="rf-input" maxlength="10"
                                   placeholder="e.g. 45"
                                   onkeypress="return isNumericKey(event)" onpaste="return false" />
                        </div>
                        <div class="rf-field">
                            <label class="rf-label">Number of Full-Time Scholars / Students</label>
                            <input asp-for="S10.FulltimeScholars" class="rf-input" maxlength="10"
                                   placeholder="e.g. 500"
                                   onkeypress="return isNumericKey(event)" onpaste="return false" />
                        </div>
                        <div class="rf-field">
                            <label class="rf-label">Scholars Paying Full Fees</label>
                            <input asp-for="S10.NoOfScholarsPayingFull" class="rf-input" maxlength="10"
                                   placeholder="e.g. 350"
                                   onkeypress="return isNumericKey(event)" onpaste="return false" />
                        </div>
                        <div class="rf-field">
                            <label class="rf-label">Scholars Not Paying Fees</label>
                            <input asp-for="S10.NoOfScholarsNotPaying" class="rf-input" maxlength="10"
                                   placeholder="e.g. 150"
                                   onkeypress="return isNumericKey(event)" onpaste="return false" />
                        </div>
                        <div class="rf-field">
                            <label class="rf-label">Estimated Revenue — Paying Fees</label>
                            <input asp-for="S10.EstimatedRevenuePayingFees" class="rf-input rf-currency"
                                   placeholder="R 0" onkeypress="return isNumericKey(event)" />
                        </div>
                        <div class="rf-field">
                            <label class="rf-label">Estimated Revenue — Not Paying Fees</label>
                            <input asp-for="S10.EstimatedRevenueNotPayingFees" class="rf-input rf-currency"
                                   placeholder="R 0" onkeypress="return isNumericKey(event)" />
                        </div>
                    </div>
                </div>
            </div>

      
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">5</div>
                    <h2 class="rf-section-title">Summary of Projected Income &amp; Expenditure</h2>
                </div>
                <div class="rf-section-body">
                    <p style="width:100%; font-size:13.5px; color:#645a50; margin:0 0 12px;">
                        Enter amounts in South African Rand (R). Leave blank if not applicable.
                    </p>
                    <div class="rf-fin-wrap">
                        <table class="rf-fin-table">
                            <thead>
                                <tr class="rf-fin-head-group">
                                    <th style="width:30%;">Category</th>
                                    <th>Past Year</th>
                                    <th>Current Year</th>
                                    <th>Next Year</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="rf-fin-section-row">
                                    <td colspan="4">INCOME</td>
                                </tr>
                                @{
                                    var incomeRows = new[]
                                    {
                                        ("Expected Income 1", "S11.ExpectedIncome1",  "S11.EIPastYear1",  "S11.EICurrentYear1",  "S11.EINextYear1"),
                                        ("Expected Income 2", "S11.ExpectedIncome2",  "S11.EIPastYear2",  "S11.EICurrentYear2",  "S11.EINextYear2"),
                                        ("Expected Income 3", "S11.ExpectedIncome3",  "S11.EIPastYear3",  "S11.EICurrentYear3",  "S11.EINextYear3"),
                                        ("Expected Income 4", "S11.ExpectedIncome4",  "S11.EIPastYear4",  "S11.EICurrentYear4",  "S11.EINextYear4"),
                                    };
                                    foreach (var r in incomeRows)
                                    {
                                        <tr>
                                            <td class="rf-fin-label">@r.Item1</td>
                                            <td><input asp-for="@r.Item2" class="rf-input rf-currency" placeholder="R 0" onkeypress="return isNumericKey(event)" /></td>
                                            <td><input asp-for="@r.Item3" class="rf-input rf-currency" placeholder="R 0" onkeypress="return isNumericKey(event)" /></td>
                                            <td><input asp-for="@r.Item4" class="rf-input rf-currency" placeholder="R 0" onkeypress="return isNumericKey(event)" /></td>
                                        </tr>
                                    }
                                }
                                <tr class="rf-fin-section-row">
                                    <td colspan="4">EXPENDITURE</td>
                                </tr>
                                @{
                                    var expRows = new[]
                                    {
                                        ("Expenditure 1", "S11.Expediture1", "S11.ExpediturePastYear1", "S11.ExpeditureCurrentYear1", "S11.ExpeditureNextYear1"),
                                        ("Expenditure 2", "S11.Expediture2", "S11.ExpediturePastYear2", "S11.ExpeditureCurrentYear2", "S11.ExpeditureNextYear2"),
                                        ("Expenditure 3", "S11.Expediture3", "S11.ExpediturePastYear3", "S11.ExpeditureCurrentYear3", "S11.ExpeditureNextYear3"),
                                        ("Salaries",      "",                "S11.SalaryPastYear",       "S11.SalaryCurrentYear",       "S11.SalaryNextYear"),
                                        ("Bonuses",       "",                "S11.BonusPastYear",        "S11.BonusCurrentYear",        "S11.BonusNextYear"),
                                    };
                                    foreach (var r in expRows)
                                    {
                                        <tr>
                                            <td class="rf-fin-label">@r.Item1</td>
                                            @if (!string.IsNullOrEmpty(r.Item2))
                                            {
                                                <td><input asp-for="@r.Item2" class="rf-input rf-currency" placeholder="R 0" onkeypress="return isNumericKey(event)" /></td>
                                            }
                                            else
                                            {
                                                <td><input asp-for="@r.Item3" class="rf-input rf-currency" placeholder="R 0" onkeypress="return isNumericKey(event)" /></td>
                                            }
                                            <td><input asp-for="@r.Item4" class="rf-input rf-currency" placeholder="R 0" onkeypress="return isNumericKey(event)" /></td>
                                            <td><input asp-for="@r.Item5" class="rf-input rf-currency" placeholder="R 0" onkeypress="return isNumericKey(event)" /></td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

           
            <div class="rf-section">
                <div class="rf-section-head">
                    <div class="rf-section-num">6</div>
                    <h2 class="rf-section-title">Supporting Documents</h2>
                </div>
                <div class="rf-section-body">
                    <div class="rf-upload-notice">
                        <i class="fa-solid fa-circle-exclamation"></i>
                        All documents must be <strong>PDF format only</strong>.
                        Maximum file size: <strong>20 MB</strong>.
                    </div>
                    <div class="rf-field rf-field-upload">
                        <label class="rf-label rf-required">3-Year Audited Financial Statements</label>
                        <input type="file" name="files" class="rf-file" accept=".pdf"
                               onchange="validatePdf(this)" required />
                        <span class="rf-file-help">Required</span>
                    </div>
                    <div class="rf-field rf-field-upload">
                        <label class="rf-label" id="sarsFileLabel">SARS Income Tax Certificate</label>
                        <input type="file" name="files" class="rf-file" id="sarsFile"
                               accept=".pdf" onchange="validatePdf(this)" />
                        <span class="rf-file-help" id="sarsFileHelp">Required if registered with SARS</span>
                    </div>
                </div>
            </div>

            <div class="rf-submit-bar">
                <a asp-controller="Rebates" asp-action="Index" class="rf-cancel-btn">
                    <i class="fa-solid fa-arrow-left"></i> Back
                </a>
                <button type="submit" class="rf-submit-btn" id="submitBtn">
                    <i class="fa-solid fa-paper-plane"></i> Submit Application
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
(function () {
    window.isNumericKey = function (e) { var c=e.which??e.keyCode; return !(c>31&&(c<48||c>57)); };
    window.validatePdf  = function (i) { var f=i.files[0]; if(f&&!f.name.toLowerCase().endsWith('.pdf')){ alert('PDF only.'); i.value=''; } };

    window.handleSars = function (sel) {
        var w=document.getElementById('sarsWarning');
        var sf=document.getElementById('sarsFile');
        w.style.display = sel.value==='No' ? 'block' : 'none';
        if (sf) sf.required = sel.value==='Yes';
    };

    window.handleLargeOrg = function (sel) {
        var grp=document.getElementById('largeOrgDescGroup');
        var inp=document.getElementById('LargeOrganisationDescription');
        var show=sel.value==='Yes';
        grp.style.display=show?'block':'none';
        if(inp) inp.required=show;
    };

    document.getElementById('rebateForm')?.addEventListener('submit', function (e) {
        var ids=['Organisation','NameSurnameDesignation','OperationTime','RegistrationNumber',
                 'StreetAddress','ContactPersonWithCOJStatements','CellNo','Email'];
        var failed=false;
        ids.forEach(function(id){ var el=document.getElementById(id); if(el&&el.value.trim()===''){ el.style.borderColor='#dc2626'; failed=true; } else if(el){ el.style.borderColor=''; } });
        if(failed){ e.preventDefault(); document.querySelector('input[style*="dc2626"]')?.scrollIntoView({behavior:'smooth',block:'center'}); }
        else { var btn=document.getElementById('submitBtn'); if(btn){ btn.disabled=true; btn.innerHTML='<i class="fa-solid fa-spinner fa-spin"></i> Submitting...'; } }
    });
})();
</script>
}
