@{
    Layout = "~/Views/Shared/_ClientLayout.cshtml";

    var queryRef   = TempData.Peek("objection_ref")?.ToString()
                     ?? TempData.Peek("Id")?.ToString();
    var pin        = TempData.Peek("pin")?.ToString();
    var isAppeal   = TempData.Peek("IsAppeal")?.ToString() == "True";
    var isMulti    = TempData.Peek("IsMulti")?.ToString() == "True";
    var typeWord   = isAppeal ? "Appeal" : "Objection";
    var count      = TempData.Peek("Count")?.ToString() ?? "0";
    var date       = TempData.Peek("time")?.ToString();

    var oldPropDesc = TempData.Peek("Old_Property_Description")?.ToString();
    var oldCat      = TempData.Peek("Old_Category")?.ToString();
    var oldAddress  = TempData.Peek("Old_Address")?.ToString();
    var oldExtent   = TempData.Peek("Old_Extent")?.ToString();
    var oldMV       = TempData.Peek("Old_Market_Value")?.ToString();
    var oldOwner    = TempData.Peek("Old_Owner")?.ToString();

    var newPropDesc = TempData.Peek("new_Property_Description")?.ToString();
    var newCat      = TempData.Peek("new_Category")?.ToString();
    var newAddress  = TempData.Peek("new_Address")?.ToString();
    var newExtent   = TempData.Peek("new_Extent")?.ToString();
    var newMV       = TempData.Peek("new_Market_Value")?.ToString();
    var newOwner    = TempData.Peek("new_Owner")?.ToString();

    var reason      = TempData.Peek("objection_reason")?.ToString();

    TempData.Keep();

    bool hasChanges = new[] { newPropDesc, newCat, newAddress, newExtent, newMV, newOwner }
                          .Any(v => !string.IsNullOrWhiteSpace(v));
}
@section Styles{
    <link href="~/css/views/objection-display.css" rel="stylesheet" asp-append-version="true" />


    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
}


<div class="dp-page">
    <div class="dp-inner">


        <div class="dp-hero">
            <div class="dp-hero-top">
                <div class="dp-hero-icon">
                    <i class="fa-solid @(isAppeal ? "fa-gavel" : "fa-file-pen")"></i>
                </div>
                <div class="dp-hero-text">
                    <div class="dp-hero-eyebrow">City of Johannesburg · Valuation Services</div>
                    <h1 class="dp-hero-title">
                        <span>@typeWord</span> Successfully Submitted
                    </h1>
                    <p class="dp-hero-sub">
                        Your @typeWord.ToLower() has been received and logged.
                        An acknowledgement has been sent to your registered email address.
                    </p>
                </div>
                <div class="dp-type-badge">
                    <i class="fa-solid fa-circle-check"></i>
                    @(isAppeal ? "Appeal" : isMulti ? "Multi-Purpose" : "Objection")
                </div>
            </div>

            <div class="dp-hero-meta">
                <div class="dp-hero-meta-item">
                    <div class="dp-hero-meta-label">Reference No.</div>
                    <div class="dp-hero-meta-value gold">@queryRef</div>
                </div>
                @if (!string.IsNullOrWhiteSpace(pin))
                {
                    <div class="dp-hero-meta-item">
                        <div class="dp-hero-meta-label">PIN</div>
                        <div class="dp-hero-meta-value gold">@pin</div>
                    </div>
                }
                @if (!string.IsNullOrWhiteSpace(date))
                {
                    <div class="dp-hero-meta-item">
                        <div class="dp-hero-meta-label">Submitted On</div>
                        <div class="dp-hero-meta-value">@date</div>
                    </div>
                }
                <div class="dp-hero-meta-item">
                    <div class="dp-hero-meta-label">Documents</div>
                    <div class="dp-hero-meta-value">@count uploaded</div>
                </div>
            </div>
        </div>

  
        <div class="dp-body">

            
            <div class="dp-section">
                <div class="dp-section-header">
                    <i class="fa-solid fa-scale-balanced"></i>
                    Valuation Details &amp; Requested Changes
                </div>
                <div class="dp-section-body">
                    <div class="dp-compare">

                       
                        <div>
                            <div class="dp-compare-col-head current">
                                <i class="fa-solid fa-book" style="margin-right:6px;"></i>
                                Current Valuation Roll
                            </div>
                            <table class="dp-compare-table">
                                <tr><td>Property</td><td>@oldPropDesc</td></tr>
                                <tr><td>Category</td><td>@oldCat</td></tr>
                                <tr><td>Address</td><td>@oldAddress</td></tr>
                                <tr><td>Extent</td><td>@oldExtent</td></tr>
                                <tr><td>Market Value</td><td>@oldMV</td></tr>
                                <tr><td>Owner</td><td>@oldOwner</td></tr>
                            </table>
                        </div>

                       
                        <div>
                            <div class="dp-compare-col-head requested">
                                <i class="fa-solid fa-pen-to-square" style="margin-right:6px;"></i>
                                Requested Changes
                            </div>
                            <table class="dp-compare-table">
                                @{
                                    void NewVal(string? v) {
                                        <td class="dp-new-val @(string.IsNullOrWhiteSpace(v) ? "empty" : "")">
                                            @(string.IsNullOrWhiteSpace(v) ? "No change requested" : v)
                                        </td>
                                    }
                                }
                                <tr><td>Property</td>@{ NewVal(newPropDesc); }</tr>
                                <tr><td>Category</td>@{ NewVal(newCat); }</tr>
                                <tr><td>Address</td>@{ NewVal(newAddress); }</tr>
                                <tr><td>Extent</td>@{ NewVal(newExtent); }</tr>
                                <tr><td>Market Value</td>@{ NewVal(newMV); }</tr>
                                <tr><td>Owner</td>@{ NewVal(newOwner); }</tr>
                            </table>
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(reason))
                    {
                        <div style="margin-top:20px;">
                            <div class="dp-reason">
                                <div class="dp-reason-label">
                                    <i class="fa-solid fa-quote-left" style="margin-right:5px;"></i>
                                    @typeWord Reason / Adverse Features
                                </div>
                                @reason
                            </div>
                        </div>
                    }
                </div>
            </div>

     
            <div class="dp-actions">
                <a class="dp-btn-primary"
                   asp-controller="Notice"
                   asp-action="DownloadAcknowledgement"
                   asp-route-objectionNo="@queryRef">
                    <i class="fa-solid fa-download"></i>
                    Download Acknowledgement
                </a>
                <a href="/dashboard" class="dp-btn-secondary">
                    <i class="fa-solid fa-house"></i>
                    Back to Dashboard
                </a>
            </div>

        </div>
    </div>
</div>
