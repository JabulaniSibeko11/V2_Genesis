    // ── Check all three selections made → show lodge button ────────
    function checkQueryFormCompletion() {
        var propOk      = property_type  !== "";
        var objectorOk  = objector_type  !== "";
        var submissionOk= submission_type !== "";

        if (propOk && objectorOk && submissionOk) {
            document.getElementById("lodgeSection").style.display = "block";
            updateQueryButtonVisibility();
            updateLodgeSummary();
        } else {
            document.getElementById("lodgeSection").style.display = "none";
        }
    }

    // ── Show correct lodge button based on direction + type ─────────
    function updateQueryButtonVisibility() {
        var isMulti = sessionStorage.getItem('direction') === "Multi";

        $("#btn_choice, #btn_choice1, #btn_choiceM, #btn_choiceM1")
            .attr("hidden", true);

        if (isMulti) {
            if (submission_type === "Query")  $("#btn_choiceM").removeAttr("hidden");
            else                              $("#btn_choiceM1").removeAttr("hidden");
        } else {
            if (submission_type === "Query")  $("#btn_choice").removeAttr("hidden");
            else                              $("#btn_choice1").removeAttr("hidden");
        }

        // Inject Direct param into visible button href
        var directVal = isMulti ? "Multi" : "";
        $("#form_key a:visible, #lodgeSection a:not([hidden])").each(function () {
            try {
                var href = new URL(this.href);
                href.searchParams.set("Direct", directVal);
                href.searchParams.set("objectorType", objector_type);
                this.href = href.toString();
            } catch(e) {}
        });
    }

    // ── Summary line above lodge button ────────────────────────────
    function updateLodgeSummary() {
        var propLabels = {
            Res: 'Residential', Agric: 'Agricultural',
            Bus: 'Business / Other', Multi: 'Multiple Purposes'
        };
        var subLabel = submission_type === "Query" ? "Section 78 Query" : "Section 78 Review";
        var typeLabel = objector_type === "Owner" ? "Owner" : "Representative";

        var el = document.getElementById("lodgeSummary");
        if (el) {
            el.innerHTML =
                '<i class="fa-solid fa-circle-check" style="color:#22c55e;"></i> ' +
                subLabel + ' as <strong>' + typeLabel + '</strong> on a ' +
                '<strong>' + (propLabels[property_type] || property_type) + '</strong> property';
        }
    }

    // ── Expose for onchange on radio cards ─────────────────────────
    window.onQueryTypeSelect = function (type) {
        submission_type = type;
        query_type      = type;
        document.getElementById("sub_type").value = type;
        sessionStorage.setItem('query_choice', type);
        document.getElementById("q_type").innerHTML =
            type === "Query" ? "Lodging A Query" : "Lodging A Review";
        $("#q_type").show();

        direction = document.getElementById("btncheck4")?.checked ? "Multi" : "Normal";
        sessionStorage.setItem('direction', direction);

        checkQueryFormCompletion();
    };

} // end IS_QUERY block


