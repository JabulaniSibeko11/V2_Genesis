@model V2_Genesis.Models.ViewModels.Objections.CheckPropertyViewModel
@{
    ViewData["Title"] = Model.IsAppeal ? "Property Appeal" : "Property Objection";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
    var d = Model.Main;
    var src = Model.SourceTable;
}

@section Styles {
    <link href="~/css/views/objection.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/clientdashboard.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/property-search.css" rel="stylesheet" asp-append-version="true" />
    <style>
        .obj-prop-omission-badge {
            grid-column: 1 / -1;
        }

        .obj-omission-tag {
            display: inline-flex;
            align-items: center;
            gap: 7px;
            padding: 6px 14px;
            border-radius: 100px;
            background: #fff7ed;
            color: #c2410c;
            border: 1.5px solid #fed7aa;
            font-size: 12.5px;
            font-weight: 700;
        }
    </style>

   
}

<div class="obj-page">
    <div class="obj-inner">

        <!-- ── Page heading ─────────────────────────────────── -->
        <div class="obj-heading">
            <div class="obj-heading-icon">
                <i class="fa-solid @(Model.IsAppeal ? "fa-gavel" : "fa-file-pen")"></i>
            </div>
            <div>
                <h1 class="obj-title" id="pageTitle">
                    @(Model.IsAppeal ? "Property Appeal System" : "Property Objection System")
                </h1>
                <p class="obj-subtitle" id="pageSubtitle">
                    @(Model.IsAppeal
                        ? "Submit your property appeal online"
                        : "Submit your property objection online")
                </p>
            </div>
        </div>

        <!-- ══════════════════════════════════════════════════
             STEP 1 — Disclaimer
        ══════════════════════════════════════════════════ -->
        <div class="obj-card" id="disclaimerSection">
            <div class="obj-card-header">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span id="disclaimerTitle">
                    @(Model.IsAppeal ? "Disclaimer | Online Appeal" : "Disclaimer | Online Objection")
                </span>
            </div>
            <div class="obj-card-body">
                <p id="disclaimerIntro">
                    You are about to commence with the online
                    <strong id="actionWord">@(Model.IsAppeal ? "appeal" : "objection")</strong> process.
                </p>
                <p>If you wish to upload supporting documents, please ensure your evidence is ready:</p>

                <div class="obj-disclaimer-list">
                    <div class="obj-dl-item">
                        <i class="fa-solid fa-file-pdf"></i>
                        Evidence attachments must be in <strong>PDF format</strong>
                    </div>
                    <div class="obj-dl-item">
                        <i class="fa-solid fa-upload"></i>
                        You may upload up to <strong>10 attachments</strong>
                    </div>
                    <div class="obj-dl-item">
                        <i class="fa-solid fa-weight-hanging"></i>
                        Maximum total size for all attachments: <strong>10 MB</strong>
                    </div>
                    <div class="obj-dl-item">
                        <i class="fa-solid fa-file-lines"></i>
                        Each attachment may have as many pages as needed within the 10 MB limit
                    </div>
                </div>

                <p class="obj-disclaimer-note">
                    The municipality assumes no responsibility or liability for any errors
                    or omissions in the content of this site. Information is provided on
                    an "as is" basis.
                </p>

                <div class="obj-agree-row">
                    <label class="obj-agree-label">
                        <input type="checkbox" id="agreeCheckbox"
                               onchange="onAgreeChange(this)" />
                        <span class="obj-agree-check"></span>
                        By checking this box I confirm that I have read and understand
                        the above information.
                    </label>
                </div>

                <div class="obj-agree-btn-row">
                    <button id="continueBtn"
                            class="obj-btn obj-btn-primary"
                            disabled
                            onclick="showMainForm()">
                        <i class="fa-solid fa-circle-check"></i>
                        <span id="continueBtnText">
                            Continue to @(Model.IsAppeal ? "Appeal" : "Objection") Form
                        </span>
                    </button>
                </div>
            </div>
        </div>

        <!-- ══════════════════════════════════════════════════
             STEP 2 — Main form
        ══════════════════════════════════════════════════ -->
        <div id="mainForm" style="display:none; flex-direction:column; gap:20px;">

            <!-- Property info -->
            <div class="obj-card">
                <div class="obj-card-header">
                    <i class="fa-solid fa-map-marker-alt"></i>
                    Property Information
                    <span class="obj-card-sub" id="propInfoSub">
                        Details of the property you are
                        @(Model.IsAppeal ? "appealing" : "objecting to")
                    </span>
                </div>
                <div class="obj-card-body obj-prop-grid">
                    @if (Model.IsOmission)
                    {
                        <!-- Omission: show confirmed details, no DB values -->
                        <div class="obj-prop-item obj-prop-omission-badge">
                            <span class="obj-omission-tag">
                                <i class="fa-solid fa-circle-exclamation"></i>
                                Omitted Property — Not on Valuation Roll
                            </span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(Model.OmittedTownName))
                        {
                            <div class="obj-prop-item">
                                <span class="obj-prop-label">
                                    <i class="fa-solid fa-map-pin"></i> Township
                                </span>
                                <span class="obj-prop-value">@Model.OmittedTownName</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.OmittedPropertyDesc))
                        {
                            <div class="obj-prop-item">
                                <span class="obj-prop-label">
                                    <i class="fa-solid fa-file-alt"></i> Property Description
                                </span>
                                <span class="obj-prop-value">@Model.OmittedPropertyDesc</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.OmittedAddress))
                        {
                            <div class="obj-prop-item">
                                <span class="obj-prop-label">
                                    <i class="fa-solid fa-road"></i> Address
                                </span>
                                <span class="obj-prop-value">@Model.OmittedAddress</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.OmittedStand))
                        {
                            <div class="obj-prop-item">
                                <span class="obj-prop-label">
                                    <i class="fa-solid fa-hashtag"></i> ERF / Stand
                                </span>
                                <span class="obj-prop-value">@Model.OmittedStand</span>
                            </div>
                        }
                    }
                    else if (d is not null)
                    {
                        <div class="obj-prop-item">
                            <span class="obj-prop-label">
                                <i class="fa-solid fa-file-alt"></i> Property Description
                            </span>
                            <span class="obj-prop-value">@(d.PropertyDesc ?? "N/A")</span>
                        </div>
                        <div class="obj-prop-item">
                            <span class="obj-prop-label">
                                <i class="fa-solid fa-home"></i> Address
                            </span>
                            <span class="obj-prop-value">@(d.LisStreetAddress ?? "N/A")</span>
                        </div>
                        <div class="obj-prop-item">
                            <span class="obj-prop-label">
                                <i class="fa-solid fa-tag"></i> Category
                            </span>
                            <span class="obj-prop-value">@(d.CatDesc ?? "N/A")</span>
                        </div>
                        <div class="obj-prop-item">
                            <span class="obj-prop-label">
                                <i class="fa-solid fa-city"></i> Township
                            </span>
                            <span class="obj-prop-value">@(d.TownNameDesc ?? "N/A")</span>
                        </div>
                    }
                </div>
            </div>

            <!-- Property type -->
            <div class="obj-card">
                <div class="obj-card-header">
                    <i class="fa-solid fa-house"></i>
                    Property Type
                    <span class="obj-card-sub" id="propTypeSub">
                        Choose the property type you want to
                        @(Model.IsAppeal ? "appeal on" : "object on")
                    </span>
                </div>
                <div class="obj-card-body">
                    <div class="obj-radio-grid">

                        <label class="obj-radio-card" id="card-res">
                            <input type="radio" name="propertyType" value="Res"
                                   onchange="onTypeSelect('propertyType','res-feedback')" />
                            <div class="obj-radio-content">
                                <i class="fa-solid fa-house-chimney"></i>
                                <strong>Residential</strong>
                                <small>Full Title and Sectional Title used for Residential Purposes</small>
                            </div>
                            <div class="obj-radio-check">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </label>

                        <label class="obj-radio-card" id="card-agric">
                            <input type="radio" name="propertyType" value="Agric"
                                   onchange="onTypeSelect('propertyType','res-feedback')" />
                            <div class="obj-radio-content">
                                <i class="fa-solid fa-tractor"></i>
                                <strong>Agricultural</strong>
                                <small>Holdings or Farms</small>
                            </div>
                            <div class="obj-radio-check">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </label>

                        <label class="obj-radio-card" id="card-bus">
                            <input type="radio" name="propertyType" value="Bus"
                                   onchange="onTypeSelect('propertyType','res-feedback')" />
                            <div class="obj-radio-content">
                                <i class="fa-solid fa-building"></i>
                                <strong>Business / Other</strong>
                                <small>Business, Factories, Offices, Schools</small>
                            </div>
                            <div class="obj-radio-check">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </label>

                        <label class="obj-radio-card" id="card-multi">
                            <input type="radio" name="propertyType" value="Multi"
                                   onchange="onTypeSelect('propertyType','res-feedback')" />
                            <div class="obj-radio-content">
                                <i class="fa-solid fa-layer-group"></i>
                                <strong>Multiple Purposes</strong>
                                <small>Property used for more than one purpose</small>
                            </div>
                            <div class="obj-radio-check">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </label>

                    </div>
                    <div class="obj-selection-feedback" id="res-feedback"></div>
                </div>
            </div>

            <!-- Objector / Appellant type -->
            <div class="obj-card">
                <div class="obj-card-header">
                    <i class="fa-solid fa-user"></i>
                    <span id="objectorTypeHeader">
                        @(Model.IsAppeal ? "Appellant Type" : "Objector Type")
                    </span>
                    <span class="obj-card-sub" id="objectorTypeSub">
                        Choose the type of @(Model.IsAppeal ? "appellant" : "objector")
                    </span>
                </div>
                <div class="obj-card-body">
                    <div class="obj-radio-grid obj-radio-grid-3">

                        <label class="obj-radio-card">
                            <input type="radio" name="objectorType" value="Owner"
                                   onchange="onTypeSelect('objectorType','obj-feedback')" />
                            <div class="obj-radio-content">
                                <i class="fa-solid fa-user-check"></i>
                                <strong>Owner</strong>
                            </div>
                            <div class="obj-radio-check">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </label>

                        <label class="obj-radio-card">
                            <input type="radio" name="objectorType" value="Third_Party"
                                   onchange="onTypeSelect('objectorType','obj-feedback')" />
                            <div class="obj-radio-content">
                                <i class="fa-solid fa-users"></i>
                                <strong>Third Party</strong>
                            </div>
                            <div class="obj-radio-check">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </label>

                        <label class="obj-radio-card">
                            <input type="radio" name="objectorType" value="Representative"
                                   onchange="onTypeSelect('objectorType','obj-feedback')" />
                            <div class="obj-radio-content">
                                <i class="fa-solid fa-user-tie"></i>
                                <strong>Representative</strong>
                            </div>
                            <div class="obj-radio-check">
                                <i class="fa-solid fa-circle-check"></i>
                            </div>
                        </label>

                    </div>
                    <div class="obj-selection-feedback" id="obj-feedback"></div>
                </div>
            </div>

            <!-- Lodge button (hidden until both types selected) -->
            <div id="lodgeSection" style="display:none;">
                <div class="obj-card obj-lodge-card">
                    <div class="obj-card-body obj-lodge-body">
                        <div class="obj-lodge-summary" id="lodgeSummary"></div>
                        <a href="#" id="btn_choice" class="obj-lodge-btn" hidden>
                            <i class="fa-solid fa-file-signature"></i>
                            <span id="lodgeBtnText">
                                @(Model.IsAppeal ? "Lodge Appeal" : "Lodge Objection")
                            </span>
                        </a>
                        <a href="#" id="btn_choice1" class="obj-lodge-btn" hidden>
                            <i class="fa-solid fa-file-signature"></i>
                            <span id="lodgeBtnText1">
                                @(Model.IsAppeal ? "Lodge Appeal" : "Lodge Objection")
                            </span>
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════
     Instructions modal
══════════════════════════════════════════════════ -->
<div class="obj-modal-backdrop" id="instrBackdrop"></div>
<div class="obj-modal" id="instrModal">
    <div class="obj-modal-header">
        <div>
            <h2>
                <i class="fa-solid fa-clipboard-list"></i>
                <span id="modalTitle">
                    @(Model.IsAppeal ? "Appeal" : "Objection") Form Instructions
                </span>
            </h2>
            <p id="modalSubtitle">
                Please read all instructions carefully before starting your
                @(Model.IsAppeal ? "appeal" : "objection")
            </p>
        </div>
        <button class="obj-modal-close" onclick="closeInstrModal()">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <div class="obj-modal-body">

        <div class="obj-instr-section">
            <h3><i class="fa-solid fa-user"></i> Section 1: Personal Information</h3>
            <ul>
                <li>
                    Complete at least one field to submit your
                    <span class="instr-action-word">@(Model.IsAppeal ? "appeal" : "objection")</span>
                </li>
                <li>
                    <strong>ID Number or Passport:</strong> SA citizens enter their ID number.
                    Non-citizens provide a valid Passport or Asylum number
                </li>
                <li><strong>Contact Numbers:</strong> Populate at least one contact number</li>
                <li>
                    <strong>Address:</strong> Fill all address fields.
                    Click "Yes" if postal = physical address
                </li>
            </ul>
        </div>

        <div class="obj-instr-section">
            <h3>
                <i class="fa-solid fa-users"></i>
                <span id="instrSection2Title">
                    @(Model.IsAppeal ? "Appellant" : "Objector") Type Requirements
                </span>
            </h3>
            <ul>
                <li>
                    <strong>Third Party:</strong> Clearly mention your
                    <span class="instr-action-word">@(Model.IsAppeal ? "appellant" : "objector")</span> status
                </li>
                <li><strong>Representative:</strong> Provide an authorised letter in Section 1</li>
            </ul>
        </div>

        <div class="obj-instr-section">
            <h3>
                <i class="fa-solid fa-pen"></i>
                Section 6: <span class="instr-action-word-cap">
                @(Model.IsAppeal ? "Appeal" : "Objection")
            </span> Details
        </h3>
        <ul>
            <li>
                Only fill in fields you wish to
                <span class="instr-action-word">@(Model.IsAppeal ? "appeal" : "object to")</span>
                — leave others blank
            </li>
            <li>Do not enter values identical to the original</li>
        </ul>
    </div>

    <div class="obj-instr-section">
        <h3><i class="fa-solid fa-upload"></i> Document Upload</h3>
        <ul>
            <li>Upload up to <strong>10 documents</strong> (PDF, PNG, JPG)</li>
            <li>Additional uploads possible within 48 hours</li>
            <li>Ensure your signature is clear and visible</li>
        </ul>
    </div>

    <div class="obj-instr-warning">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <div>
            <strong>Important Notice:</strong> If you experience problems,
            do not retry multiple times. Contact the Valuation Admission Team
            or visit the office.
        </div>
    </div>

</div>
<div class="obj-modal-footer">
    <label class="obj-agree-label">
        <input type="checkbox" id="instrAgree"
               onchange="onInstrAgree(this)" />
        <span class="obj-agree-check"></span>
        I have read and understood all the instructions
    </label>
    <div class="obj-modal-actions">
        <button class="obj-btn obj-btn-outline" onclick="closeInstrModal()">
            <i class="fa-solid fa-xmark"></i> Cancel
        </button>
        <button class="obj-btn obj-btn-primary" id="startFormBtn"
                disabled onclick="proceedToForm()">
            <i class="fa-solid fa-play"></i>
            Start <span id="startBtnWord">
            @(Model.IsAppeal ? "Appeal" : "Objection")
        </span> Form
    </button>
</div>
</div>
</div>

@section Scripts {
    <script>
        // ════════════════════════════════════════════════════════════
        //  CheckProperty — V2 inline script
        //  All logic self-contained, no external index.js dependency
        // ════════════════════════════════════════════════════════════

        // ── Config injected from Razor ────────────────────────────────
        var CONTROLLER  = '@Model.ControllerName';
        var SOURCE      = '@Model.SourceTable';
        var IS_LIS      = SOURCE === 'LIS';

        // ── Appeal status: prefer Razor model, fall back to URL/session ──
        var IS_APPEAL = (function () {
            // 1. Razor model is authoritative
            var fromRazor = '@Model.AppealStatus';
            if (fromRazor === 'True' || fromRazor === 'False')
                return fromRazor === 'True';

            // 2. URL param fallback (for pages arriving without model)
            var urlParam = new URLSearchParams(window.location.search)
                .get('AppealStatus');
            if (urlParam !== null) {
                sessionStorage.setItem('AppealStatus', urlParam);
                return urlParam === 'True';
            }

            // 3. sessionStorage fallback
            return sessionStorage.getItem('AppealStatus') === 'True';
        })();

        // Store for other pages
        sessionStorage.setItem('AppealStatus', IS_APPEAL ? 'True' : 'False');

        // ── State ─────────────────────────────────────────────────────
        var selectedProperty = '';
        var selectedObjector = '';
        var pendingUrl       = '';

        // ════════════════════════════════════════════════════════════
        //  APPEAL LABEL SWAP
        //  Handles pages that may arrive without the model populated
        //  (Razor already renders correct text, this updates any DOM
        //   element that Razor missed or that was hydrated later)
        // ════════════════════════════════════════════════════════════
        function updateAppealLabels() {
            if (!IS_APPEAL) return;   // nothing to change — Razor already set text

            var action    = 'appeal';
            var Action    = 'Appeal';
            var actor     = 'appellant';
            var Actor     = 'Appellant';

            // Page heading
            setText('pageTitle',          'Property Appeal System');
            setText('pageSubtitle',       'Submit your property appeal online');

            // Disclaimer
            setText('disclaimerTitle',    'Disclaimer | Online Appeal');
            setText('actionWord',         action);
            setText('continueBtnText',    'Continue to Appeal Form');

            // Property card sub-label
            setText('propTypeSub',        'Choose the property type you want to appeal on');
            setText('propInfoSub',        'Details of the property you are appealing');

            // Objector → Appellant
            setText('objectorTypeHeader', Actor + ' Type');
            setText('objectorTypeSub',    'Choose the type of ' + actor);

            // Lodge buttons
            setText('lodgeBtnText',       'Lodge Appeal');
            setText('lodgeBtnText1',      'Lodge Appeal');

            // Modal
            setText('modalTitle',         'Appeal Form Instructions');
            setText('modalSubtitle',      'Please read all instructions carefully before starting your appeal');
            setText('instrSection2Title', Actor + ' Type Requirements');
            setText('startBtnWord',       Action);

            // Inline spans with class .instr-action-word
            document.querySelectorAll('.instr-action-word').forEach(function (el) {
                el.textContent = el.textContent
                    .replace(/objection/gi, action)
                    .replace(/objector/gi,  actor)
                    .replace(/object to/gi, action);
            });
            document.querySelectorAll('.instr-action-word-cap').forEach(function (el) {
                el.textContent = Action;
            });
        }

        function setText(id, text) {
            var el = document.getElementById(id);
            if (el) el.textContent = text;
        }

        // ════════════════════════════════════════════════════════════
        //  STEP 1 — DISCLAIMER
        // ════════════════════════════════════════════════════════════
        function onAgreeChange(cb) {
            document.getElementById('continueBtn').disabled = !cb.checked;
        }

        function showMainForm() {
            document.getElementById('disclaimerSection').style.display = 'none';
            var f = document.getElementById('mainForm');
            f.style.display = 'flex';
        }

        // ════════════════════════════════════════════════════════════
        //  STEP 2 — RADIO CARD SELECTION
        // ════════════════════════════════════════════════════════════
        function onTypeSelect(name, feedbackId) {
            var selected = document.querySelector('input[name="' + name + '"]:checked');
            if (!selected) return;

            // Mark selected card
            document.querySelectorAll('input[name="' + name + '"]').forEach(function (r) {
                r.closest('.obj-radio-card').classList.remove('selected');
            });
            selected.closest('.obj-radio-card').classList.add('selected');

            if (name === 'propertyType') {
                selectedProperty = selected.value;
                sessionStorage.setItem('property_choice', selectedProperty);
            }
            if (name === 'objectorType') {
                selectedObjector = selected.value;
                sessionStorage.setItem('objector_choice', selectedObjector);
                localStorage.setItem('objectorType', selectedObjector);
            }

            // Update feedback label
            var feedback = document.getElementById(feedbackId);
            if (feedback) {
                var labels = {
                    Res          : 'Residential',
                    Agric        : 'Agricultural',
                    Bus          : 'Business / Other',
                    Multi        : 'Multiple Purposes',
                    Owner        : 'Owner',
                    Third_Party  : 'Third Party',
                    Representative: 'Representative'
                };
                feedback.innerHTML =
                    '<i class="fa-solid fa-circle-check" style="color:#22c55e;"></i> ' +
                    'Selected: <strong>' + (labels[selected.value] || selected.value) + '</strong>';
            }

            checkBothSelected();
        }

        // ════════════════════════════════════════════════════════════
        //  LODGE URL BUILDER — V2 unified routes
        // ════════════════════════════════════════════════════════════
        function buildLodgeUrl(isMulti) {
            var qs = '?PropertyFrom=' + encodeURIComponent(SOURCE) +
                     '&objectorType=' + encodeURIComponent(selectedObjector) +
                     '&appeal='       + (IS_APPEAL ? 'True' : 'False');

            if (IS_LIS) {
                return isMulti
                    ? '/LIS/ViewMultiPurposeFormSup3' + qs
                    : '/LIS/ViewResidentialFormSup3'  + qs;
            }

            return isMulti
                ? '/objection/multipurpose' + qs
                : '/objection/form'         + qs;
        }

        // ════════════════════════════════════════════════════════════
        //  CHECK BOTH SELECTED → show lodge button
        // ════════════════════════════════════════════════════════════
        function checkBothSelected() {
            if (!selectedProperty || !selectedObjector) return;

            var isMulti = selectedProperty === 'Multi';
            var url     = buildLodgeUrl(isMulti);

            // Store for downstream form pages
            localStorage.setItem('propertyType', selectedProperty);
            localStorage.setItem('sourceTable',  SOURCE);

            document.getElementById('lodgeSection').style.display = 'block';

            // Summary line
            var propLabels = {
                Res  : 'Residential', Agric : 'Agricultural',
                Bus  : 'Business / Other', Multi : 'Multiple Purposes'
            };
            var objLabels = {
                Owner: 'Owner', Third_Party: 'Third Party',
                Representative: 'Representative'
            };
            var actionLabel = IS_APPEAL ? 'Appeal' : 'Objection';

            document.getElementById('lodgeSummary').innerHTML =
                '<i class="fa-solid fa-circle-check" style="color:#22c55e;"></i> ' +
                actionLabel + ' as <strong>' + (objLabels[selectedObjector] || selectedObjector) +
                '</strong> on a <strong>' + (propLabels[selectedProperty] || selectedProperty) +
                '</strong> property';

            // Hide both buttons, show the correct one
            ['btn_choice', 'btn_choice1'].forEach(function (id) {
                var el = document.getElementById(id);
                if (el) el.setAttribute('hidden', true);
            });

            var target = document.getElementById(isMulti ? 'btn_choice1' : 'btn_choice');
            if (target) {
                target.href = url;
                target.removeAttribute('hidden');
            }

            // Smooth scroll to lodge section
            setTimeout(function () {
                document.getElementById('lodgeSection')
                    .scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }, 200);
        }

        // ════════════════════════════════════════════════════════════
        //  INTERCEPT LODGE BUTTON → show instructions modal first
        // ════════════════════════════════════════════════════════════
        document.addEventListener('click', function (e) {
            var btn = e.target.closest('#btn_choice, #btn_choice1');
            if (!btn) return;
            e.preventDefault();

            pendingUrl = btn.href;

            // Reset modal state
            document.getElementById('instrAgree').checked = false;
            document.getElementById('startFormBtn').disabled = true;
            document.getElementById('instrBackdrop').classList.add('show');
            document.getElementById('instrModal').classList.add('show');
            document.body.style.overflow = 'hidden';
        });

        // ════════════════════════════════════════════════════════════
        //  INSTRUCTIONS MODAL
        // ════════════════════════════════════════════════════════════
        function onInstrAgree(cb) {
            document.getElementById('startFormBtn').disabled = !cb.checked;
        }

        function closeInstrModal() {
            document.getElementById('instrBackdrop').classList.remove('show');
            document.getElementById('instrModal').classList.remove('show');
            document.body.style.overflow = '';
            pendingUrl = '';
        }

        function proceedToForm() {
            if (!pendingUrl) return;
            window.location.href = pendingUrl;
        }

        // Close modal on backdrop click
        document.getElementById('instrBackdrop')
            .addEventListener('click', closeInstrModal);

        // Close modal on Escape key
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeInstrModal();
        });

        // ════════════════════════════════════════════════════════════
        //  INIT
        // ════════════════════════════════════════════════════════════
        document.addEventListener('DOMContentLoaded', function () {
            // Apply appeal label swap if needed
            updateAppealLabels();

            // Radio card: clicking the card label also triggers the radio
            document.querySelectorAll('.obj-radio-card').forEach(function (card) {
                card.addEventListener('click', function () {
                    var radio = card.querySelector('input[type="radio"]');
                    if (radio) radio.dispatchEvent(new Event('change', { bubbles: true }));
                });
            });
        });
    </script>
}
