// ── State ────────────────────────────────────────────────────────
var selectedProperty = '';
var selectedObjector = '';
var pendingUrl       = '';

// ── Appeal label swap ────────────────────────────────────────────
function updateAppealLabels() {
    if (!IS_APPEAL || IS_QUERY) return;

    setText('pageTitle',          'Property Appeal System');
    setText('pageSubtitle',       'Submit your property appeal online');
    setText('disclaimerTitle',    'Disclaimer | Online Appeal');
    setText('actionWord',         'appeal');
    setText('continueBtnText',    'Continue to Appeal Form');
    setText('propTypeSub',        'Choose the property type you want to appeal on');
    setText('propInfoSub',        'Details of the property you are appealing');
    setText('objectorTypeHeader', 'Appellant Type');
    setText('objectorTypeSub',    'Choose the type of appellant');
    setText('lodgeBtnText',       'Lodge Appeal');
    setText('lodgeBtnText1',      'Lodge Appeal');
    setText('modalTitle',         'Appeal Form Instructions');
    setText('modalSubtitle',
        'Please read all instructions carefully before starting your appeal');
    setText('instrSection2Title', 'Appellant Type Requirements');
    setText('startBtnWord',       'Appeal');

    document.querySelectorAll('.instr-action-word').forEach(function (el) {
        el.textContent = el.textContent
            .replace(/objection/gi, 'appeal')
            .replace(/objector/gi,  'appellant')
            .replace(/object to/gi, 'appeal');
    });
    document.querySelectorAll('.instr-action-word-cap').forEach(function (el) {
        el.textContent = 'Appeal';
    });
}

function setText(id, text) {
    var el = document.getElementById(id);
    if (el) el.textContent = text;
}

// ── Disclaimer ───────────────────────────────────────────────────
function onAgreeChange(cb) {
    document.getElementById('continueBtn').disabled = !cb.checked;
}

function showMainForm() {
    document.getElementById('disclaimerSection').style.display = 'none';
    var f = document.getElementById('mainForm');
    f.style.display = 'flex';
}

// ── Radio cards — Objection / Appeal flow ───────────────────────
function onTypeSelect(name, feedbackId) {
    if (IS_QUERY) return;   // Query uses V1 JS handlers above

    var selected = document.querySelector('input[name="' + name + '"]:checked');
    if (!selected) return;

    document.querySelectorAll('input[name="' + name + '"]').forEach(function (r) {
        r.closest('.obj-radio-card').classList.remove('selected');
    });
    selected.closest('.obj-radio-card').classList.add('selected');

    if (name === 'propertyType') {
        selectedProperty = selected.value;
        sessionStorage.setItem('property_choice', selectedProperty);
    }
    if (name === 'objectorType') {
        selectedObjector = selected.value;
        sessionStorage.setItem('objector_choice', selectedObjector);
        localStorage.setItem('objectorType', selectedObjector);
    }

    var feedback = document.getElementById(feedbackId);
    if (feedback) {
        var labels = {
            Res: 'Residential', Agric: 'Agricultural',
            Bus: 'Business / Other', Multi: 'Multiple Purposes',
            Owner: 'Owner', Third_Party: 'Third Party',
            Representative: 'Representative'
        };
        feedback.innerHTML =
            '<i class="fa-solid fa-circle-check" style="color:#22c55e;"></i> ' +
            'Selected: <strong>' + (labels[selected.value] || selected.value) + '</strong>';
    }

    checkBothSelected();
}

// ── Build lodge URL (Objection / Appeal) ─────────────────────────
function buildLodgeUrl(isMulti) {
    var qs = '?PropertyFrom=' + encodeURIComponent(SOURCE) +
             '&objectorType=' + encodeURIComponent(selectedObjector) +
             '&appeal='       + (IS_APPEAL ? 'True' : 'False');

    if (IS_LIS)
        return isMulti ? '/LIS/ViewMultiPurposeFormSup3' + qs
                       : '/LIS/ViewResidentialFormSup3'  + qs;

    return isMulti ? '/objection/multipurpose' + qs
                   : '/objection/form'         + qs;
}

// ── Check both selected → show lodge ────────────────────────────
function checkBothSelected() {
    if (IS_QUERY) return;
    if (!selectedProperty || !selectedObjector) return;

    var isMulti = selectedProperty === 'Multi';
    var url     = buildLodgeUrl(isMulti);

    localStorage.setItem('propertyType', selectedProperty);
    localStorage.setItem('sourceTable',  SOURCE);

    document.getElementById('lodgeSection').style.display = 'block';

    var propLabels = { Res:'Residential', Agric:'Agricultural',
                       Bus:'Business / Other', Multi:'Multiple Purposes' };
    var objLabels  = { Owner:'Owner', Third_Party:'Third Party',
                       Representative:'Representative' };
    var actionLabel = IS_APPEAL ? 'Appeal' : 'Objection';

    document.getElementById('lodgeSummary').innerHTML =
        '<i class="fa-solid fa-circle-check" style="color:#22c55e;"></i> ' +
        actionLabel + ' as <strong>' + (objLabels[selectedObjector] || selectedObjector) +
        '</strong> on a <strong>' + (propLabels[selectedProperty] || selectedProperty) +
        '</strong> property';

    ['btn_choice', 'btn_choice1'].forEach(function (id) {
        var el = document.getElementById(id);
        if (el) el.setAttribute('hidden', true);
    });

    var target = document.getElementById(isMulti ? 'btn_choice1' : 'btn_choice');
    if (target) {
        target.href = url;
        target.removeAttribute('hidden');
    }

    setTimeout(function () {
        document.getElementById('lodgeSection')
            .scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    }, 200);
}

// ── Lodge button → instructions modal ───────────────────────────
document.addEventListener('click', function (e) {
    var btn = e.target.closest(
        '#btn_choice, #btn_choice1, #btn_choiceM, #btn_choiceM1');
    if (!btn) return;
    e.preventDefault();

    pendingUrl = btn.href;
    document.getElementById('instrAgree').checked = false;
    document.getElementById('startFormBtn').disabled = true;
    document.getElementById('instrBackdrop').classList.add('show');
    document.getElementById('instrModal').classList.add('show');
    document.body.style.overflow = 'hidden';
});

function onInstrAgree(cb) {
    document.getElementById('startFormBtn').disabled = !cb.checked;
}

function closeInstrModal() {
    document.getElementById('instrBackdrop').classList.remove('show');
    document.getElementById('instrModal').classList.remove('show');
    document.body.style.overflow = '';
    pendingUrl = '';
}

function proceedToForm() {
    if (!pendingUrl) return;
    window.location.href = pendingUrl;
}

document.getElementById('instrBackdrop')
    ?.addEventListener('click', closeInstrModal);
document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeInstrModal();
});

// ── INIT ─────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', function () {
    updateAppealLabels();

    // Radio card click → trigger change event
    document.querySelectorAll('.obj-radio-card').forEach(function (card) {
        card.addEventListener('click', function () {
            var radio = card.querySelector('input[type="radio"]');
            if (radio) radio.dispatchEvent(new Event('change', { bubbles: true }));
        });
    });

    // Query: restore session selections if any
    if (IS_QUERY) {
        var savedProp = sessionStorage.getItem('property_choice');
        var savedObj  = sessionStorage.getItem('objector_choice');
        var savedQry  = sessionStorage.getItem('query_choice');

        if (savedProp) {
            var propInput = document.getElementById('btn' + savedProp.toLowerCase()) ||
                            document.querySelector('input[value="' + savedProp + '"]');
            if (propInput) {
                propInput.checked = true;
                property_type = savedProp;
            }
        }
    }
});
</script>
}

