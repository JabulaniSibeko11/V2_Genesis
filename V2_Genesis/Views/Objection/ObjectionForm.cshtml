            </div>
            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const yesRadio = document.querySelector('input[name="Agri_Another_Purpose_Not_Agriculture"][value="Yes"]');
                    const noRadio = document.querySelector('input[name="Agri_Another_Purpose_Not_Agriculture"][value="No"]');
                    const descSection = document.getElementById("desc_use_section");

                    function toggleDescSection() {
                        if (yesRadio.checked) {
                            descSection.style.display = "block";
                        } else {
                            descSection.style.display = "none";
                        }
                    }

                    // Event listeners
                    yesRadio.addEventListener("change", toggleDescSection);
                    noRadio.addEventListener("change", toggleDescSection);

                    // Initial check on page load
                    toggleDescSection();
                });
            </script>
