            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const yesRadio = document.querySelector('input[name="Res_Fence"][value="Yes"]');
                    const noRadio = document.querySelector('input[name="Res_Fence"][value="No"]');
                    const fenceTable = document.getElementById("fence_table");

                    function toggleFenceTable() {
                        if (yesRadio.checked) {
                            fenceTable.style.display = "block";
                        } else {
                            fenceTable.style.display = "none";
                        }
                    }

                    yesRadio.addEventListener("change", toggleFenceTable);
                    noRadio.addEventListener("change", toggleFenceTable);

                    // Run once on page load to handle pre-filled data
                    toggleFenceTable();
                });
            </script>

