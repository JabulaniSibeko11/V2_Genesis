    }

    function initializeCompensationToaster() {
        document.querySelectorAll('input[name="Compensation_Paid"]').forEach(radio => {
            radio.addEventListener('change', function () {
                if (this.value === 'Yes') {
                    showToaster('Compensation Details', 'Please provide payment details', 3000);
                } else {
                    showToaster('No Compensation', 'Compensation section skipped', 2000);
                }
            });
