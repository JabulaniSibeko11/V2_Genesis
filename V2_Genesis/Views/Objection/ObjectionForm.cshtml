                                type="button" id="Clear" class="btn"
                                onmouseover="this.style.background='#004d56';this.style.transform='translateY(-2px)';this.style.boxShadow='0 5px 15px rgba(0,101,112,0.3)'"
                                onmouseout="this.style.background='#006570';this.style.transform='translateY(0)';this.style.boxShadow='none'"
                                ontouchstart="this.style.background='#004d56'"
                                ontouchend="this.style.background='#006570'">
                            Clear
                        </button>

                        <button type="button" id="accept" class="btn"
                                style="flex:1;min-width:140px;max-width:200px;color:white;background:#006570;border:2px solid #e6b000;padding:12px 20px;font-size:14px;font-weight:600;border-radius:8px;cursor:pointer;transition:all 0.3s;font-family:'Poppins',sans-serif;white-space:nowrap;"
                                onclick="checkCanvas()"
                                onmouseover="this.style.background='#004d56';this.style.transform='translateY(-2px)';this.style.boxShadow='0 5px 15px rgba(0,101,112,0.3)'"
                                onmouseout="this.style.background='#006570';this.style.transform='translateY(0)';this.style.boxShadow='none'"
                                ontouchstart="this.style.background='#004d56'"
                                ontouchend="this.style.background='#006570'">
                            Accept signature
                        </button>
                    </div>

                    <input type="text" onpaste="return false;" ondrop="return false;" id="SignatureDataUrl" asp-for="Signature_Picture" hidden="hidden">
                </div>

            </div>
                <div>
                    <button style="margin-top: 10px; margin-left: 2%;color:white; background-color:#006572;" type="button" class="btn_p7 btn"><strong>Previous</strong></button>
                    <button type="submit" class="btn" disabled id="submitForm" onclick="showInput()" style="margin-top: 10px;float:right;margin-right: 2%;color:white; background-color:#006572;"><strong>Submit</strong></button>
                </div>
        </div>

    </div>


    @{
        TempData.Keep("CurrentFilter_MV");
    }
 
