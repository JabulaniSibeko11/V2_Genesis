            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const yesRadio = document.querySelector('input[name="Res_Fence"][value="Yes"]');
                    const noRadio = document.querySelector('input[name="Res_Fence"][value="No"]');
                    const fenceTable = document.getElementById("fencing_table");

                    function toggleFencingTable() {
                        if (yesRadio.checked) {
                            fenceTable.style.display = "block";
                        } else {
                            fenceTable.style.display = "none";
                        }
                    }

                    yesRadio.addEventListener("change", toggleFencingTable);
                    noRadio.addEventListener("change", toggleFencingTable);

                    // Run once on page load to handle pre-filled data
                    toggleFencingTable();
                });
            </script>

