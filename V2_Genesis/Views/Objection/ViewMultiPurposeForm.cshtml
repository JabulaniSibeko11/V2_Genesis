    function initializeFileUploadToasters() {
        const fileInput = document.getElementById('files');
        if (fileInput) {
            fileInput.addEventListener('change', function() {
                const files = this.files;
                const maxFiles = 10;
                const maxSize = 10 * 1024 * 1024; // 10MB
                if (files.length > maxFiles) {
                    showToaster('Too Many Files ❌', `Maximum ${maxFiles} files allowed`, 4000);
                    this.value = '';
                    return;
                }
                let totalSize = 0;
                let invalidFiles = [];
                for (let i = 0; i < files.length; i++) {
                    totalSize += files[i].size;
                    const ext = files[i].name.split('.').pop().toLowerCase();
                    if (!['pdf', 'png', 'jpeg', 'jpg', 'heic'].includes(ext)) {
                        invalidFiles.push(files[i].name);
                    }
                }
                if (invalidFiles.length > 0) {
                    showToaster('Invalid File Type ❌', `Only PDF, PNG, JPEG, HEIC allowed`, 4000);
                    this.value = '';
                    return;
                }
                if (totalSize > maxSize) {
                    showToaster('Files Too Large ❌', `Total size exceeds 10MB`, 4000);
                    this.value = '';
                    return;
                }
                showToaster('Files Uploaded ✅', `${files.length} file(s) ready to upload`, 3000);
            });
        }
        // Representative authorization file
        const fileR = document.getElementById('fileR');
        if (fileR) {
            fileR.addEventListener('change', function() {
                const file = this.files[0];
                if (file) {
                    if (file.type !== 'application/pdf') {
                        showToaster('Invalid File ❌', 'Authorization letter must be PDF', 4000);
                        this.value = '';
                        return;
                    }
                    if (file.size > 10 * 1024 * 1024) {
                        showToaster('File Too Large ❌', 'PDF must not exceed 10MB', 4000);
                        this.value = '';
                        return;
                    }
                    showToaster('Authorization Added ✅', 'Representative letter attached', 3000);
                }
            });
        }
    }

    function initializeSignatureToasters() {
        const acceptButton = document.getElementById('accept');
        const clearButton = document.getElementById('Clear');
        if (acceptButton) {
            acceptButton.addEventListener('click', function() {
                const canvas = document.getElementById('signature');
                const context = canvas.getContext('2d');
                const pixelBuffer = context.getImageData(0, 0, canvas.width, canvas.height).data;
                let isBlank = true;
                for (let i = 0; i < pixelBuffer.length; i += 4) {
                    if (pixelBuffer[i + 3] !== 0) {
                        isBlank = false;
                        break;
                    }
                }
                if (isBlank) {
                    showToaster('Signature Required ❌', 'Please sign in the box above', 4000);
                } else {
                    showToaster('Signature Accepted ✅', 'Your signature has been recorded', 3000);
                }
            });
        }
        if (clearButton) {
            clearButton.addEventListener('click', function() {
                showToaster('Signature Cleared 🗑️', 'Please sign again', 2000);
            });
        }
    }

    function initializeSubmitToaster() {
        const submitButton = document.getElementById('submitForm');
        const submissionOverlay = document.getElementById('submissionOverlay');
        if (submitButton) {
            submitButton.addEventListener('click', function(e) {
                const signatureName = document.getElementById('sign_obj');
                const signatureData = document.getElementById('SignatureDataUrl');
                // Validate signature name
                if (!signatureName || !signatureName.value.trim()) {
                    e.preventDefault();
                    showToaster('Name Required ❌', 'Please enter your name in declaration', 4000);
                    signatureName.focus();
                    return false;
                }
                // Validate signature
                if (!signatureData || !signatureData.value) {
                    e.preventDefault();
                    showToaster('Signature Required ❌', 'Please accept your signature', 4000);
                    return false;
                }
                // Validate Section 6 changes
                const hasChanges = checkForChanges();
                if (!hasChanges) {
                    e.preventDefault();
                    showToaster('No Changes ⚠️', 'Please specify what you want to object to in Section 6', 5000);
                    return false;
                }
                // Validate capturer field
               
                // All validations passed - show loader and toaster
                e.preventDefault(); // Prevent immediate form submission
                // Show toaster
                showToaster('Submitting Objection 📤', 'Generating acknowledgement and saving data...', 5000);
                // Show overlay loader
                if (submissionOverlay) {
                    submissionOverlay.classList.add('active');
                }
                // Disable submit button to prevent double submission
                submitButton.disabled = true;
                submitButton.textContent = 'Processing...';
                submitButton.style.opacity = '0.6';
                // Submit form after a brief delay to ensure loader is visible
                setTimeout(function() {
                    document.getElementById('myForm').submit();
                }, 500);
            });
        }
    }

