@{
    bool _isAdmin = (bool)(ViewBag.IsAdmin ?? false);
    string _fullName = ViewBag.AdminFullName ?? "";
    string _sapNumeric = ViewBag.SapNumeric ?? "";
    bool _isAppeal = TempData.Peek("AppealStatus")?.ToString() == "True";
    string _propDesc = TempData.Peek("CurrentFilter_PD")?.ToString()
                       ?? TempData.Peek("CurrentFilter_Prop")?.ToString()
                       ?? "";
    TempData.Keep("AppealStatus");
    TempData.Keep("CurrentFilter_PD");
    TempData.Keep("CurrentFilter_Prop");
}
<style>
/* ── Objection Form Hero ─────────────────────────────────── */
.obj-hero {
    background: linear-gradient(135deg, #1a2e35 0%, #2d4f58 55%, #36626d 100%);
    border-bottom: 3px solid #e6b000;
    padding: 0;
    margin-bottom: 24px;
    border-radius: 0 0 12px 12px;
    overflow: hidden;
    box-shadow: 0 4px 20px rgba(26,46,53,.2);
    position: relative;
}

.obj-hero::before {
    content: '';
    position: absolute;
    top: -60px; right: -60px;
    width: 220px; height: 220px;
    background: radial-gradient(circle, rgba(230,176,0,.12) 0%, transparent 70%);
    pointer-events: none;
}

.obj-hero::after {
    content: '';
    position: absolute;
    bottom: -30px; left: 30px;
    width: 120px; height: 120px;
    background: radial-gradient(circle, rgba(230,176,0,.06) 0%, transparent 70%);
    pointer-events: none;
}

.obj-hero-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 22px 32px;
    position: relative;
    z-index: 1;
    flex-wrap: wrap;
}

.obj-hero-left {
    display: flex;
    align-items: center;
    gap: 18px;
    flex: 1;
    min-width: 260px;
}

.obj-hero-logo {
    width: 54px; height: 54px;
    border-radius: 12px;
    background: rgba(230,176,0,.15);
    border: 2px solid rgba(230,176,0,.4);
    display: flex; align-items: center; justify-content: center;
    overflow: hidden; padding: 5px; flex-shrink: 0;
}

.obj-hero-logo img {
    width: 100%; height: 100%; object-fit: contain;
}

.obj-hero-text {}

.obj-hero-org {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 2px;
    color: rgba(230,176,0,.7);
    text-transform: uppercase;
    margin-bottom: 2px;
}

.obj-hero-title {
    font-size: 18px;
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
    margin: 0;
}

.obj-hero-title span { color: #e6b000; }

.obj-hero-sub {
    font-size: 12px;
    color: rgba(255,255,255,.55);
    margin-top: 3px;
    letter-spacing: .3px;
}

.obj-hero-right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 8px;
    flex-shrink: 0;
}

.obj-hero-type-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 6px 14px;
    background: rgba(230,176,0,.18);
    border: 1.5px solid rgba(230,176,0,.5);
    border-radius: 100px;
    font-size: 12px;
    font-weight: 700;
    color: #e6b000;
    letter-spacing: .5px;
    text-transform: uppercase;
}

.obj-hero-prop {
    font-size: 12.5px;
    color: rgba(255,255,255,.65);
    text-align: right;
    max-width: 340px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.obj-hero-prop strong { color: rgba(255,255,255,.9); }

/* Form head bar below hero */
.obj-form-head {
    background: linear-gradient(90deg, #1a2e35, #243e48);
    border-bottom: 2px solid #e6b000;
    padding: 10px 32px;
    display: flex;
    align-items: center;
    gap: 12px;
}

.obj-form-head-label {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: rgba(255,255,255,.45);
    text-transform: uppercase;
    white-space: nowrap;
}

.obj-form-head-title {
    font-size: 13px;
    font-weight: 700;
    color: #e6b000;
    text-transform: uppercase;
    letter-spacing: .3px;
}

/* Admin capturer card */
.obj-capturer-card {
    display: flex;
    align-items: center;
    gap: 14px;
    background: linear-gradient(135deg, #1a2e35, #2d4f58);
    border: 1.5px solid rgba(230,176,0,.4);
    border-radius: 10px;
    padding: 12px 18px;
    margin-top: 16px;
}

.obj-capturer-icon {
    width: 38px; height: 38px;
    border-radius: 8px;
    background: rgba(230,176,0,.15);
    border: 1.5px solid rgba(230,176,0,.4);
    display: flex; align-items: center; justify-content: center;
    color: #e6b000; font-size: 16px; flex-shrink: 0;
}

.obj-capturer-label {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 1.5px;
    color: rgba(255,255,255,.45);
    text-transform: uppercase;
    margin-bottom: 2px;
}

.obj-capturer-name {
    font-size: 15px;
    font-weight: 700;
    color: #fff;
}

.obj-capturer-sap {
    font-size: 11px;
    color: rgba(230,176,0,.75);
    font-weight: 600;
    margin-top: 1px;
}

@@media (max-width: 680px) {
    .obj-hero-inner  { flex-direction: column; align-items: flex-start; padding: 18px 20px; }
    .obj-hero-right  { align-items: flex-start; }
    .obj-hero-prop   { text-align: left; white-space: normal; }
    .obj-form-head   { padding: 10px 20px; }
}
</style>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>




