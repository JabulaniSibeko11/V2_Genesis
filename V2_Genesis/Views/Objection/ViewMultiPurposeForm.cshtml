            <script>
                document.addEventListener("DOMContentLoaded", function () {
                    const yesRadio = document.querySelector('input[name="Agri_Another_Purpose_Not_Agriculture"][value="Yes"]');
                    const noRadio = document.querySelector('input[name="Agri_Another_Purpose_Not_Agriculture"][value="No"]');
                    const descSection = document.getElementById("Use_Desc_Section");

                    function toggleDescribingSection() {
                        if (yesRadio.checked) {
                            descSection.style.display = "block";
                        } else {
                            descSection.style.display = "none";
                        }
                    }

                    // Event listeners
                    yesRadio.addEventListener("change", toggleDescribingSection);
                    noRadio.addEventListener("change", toggleDescribingSection);

                    // Initial check on page load
                    toggleDescribingSection();
                });
            </script>


          
