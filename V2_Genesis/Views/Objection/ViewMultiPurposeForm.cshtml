                margin-bottom: 0;
            }

    .bullet {
        color: #006572;
        font-weight: 600;
        font-size: 18px;
        flex-shrink: 0;
    }

    .warning-box {
        background: linear-gradient(135deg, #fff3e0 0%, #ffe0b2 100%);
        border-left: 4px solid #ff9800;
        border-radius: 8px;
        padding: 20px;
        margin-top: 16px;
    }

        .warning-box p {
            margin: 0;
            color: #e65100;
            font-size: 15px;
            line-height: 1.6;
            display: flex;
            align-items: flex-start;
            gap: 10px;
            font-family: 'Poppins', sans-serif;
        }

    .warning-icon {
        font-size: 20px;
        flex-shrink: 0;
        animation: shake 3s infinite;
    }

    .form-header-container {
        max-width: 1200px;
        margin: 0 auto 30px;
        background: white;
        border: 3px solid #e6b000;
        border-radius: 12px;
        padding: 24px 32px;
        box-shadow: 0 4px 20px rgba(230, 176, 0, 0.15);
        position: relative;
        overflow: hidden;
    }

        .form-header-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient(90deg, #e6b000 0%, #ffd700 50%, #e6b000 100%);
        }

        .form-header-container h4 {
            color: #006572;
            font-size: 22px;
            font-weight: 600;
            text-align: center;
            margin: 0;
            line-height: 1.5;
