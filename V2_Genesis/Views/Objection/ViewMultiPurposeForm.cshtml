            font-size: 16px;
            color: #006570;
            font-weight: 600;
            margin: 0;
            font-family: 'Poppins', sans-serif;
        }

    .alert-header {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 24px;
        padding-bottom: 16px;
        border-bottom: 2px solid #f0f0f0;
    }

    .alert-icon {
        font-size: 32px;
        animation: pulse 2s infinite;
    }

    .instruction-box {
        background: linear-gradient(135deg, #667eea15 0%, #764ba215 100%);
        border-left: 4px solid #e6b000;
