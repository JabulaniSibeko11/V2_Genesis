                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                    <div style="height: 2px; background-color: #e6b000; width: 45%;"></div>
                    <div style="height: 8px; width: 8px; border-radius: 50%; background-color: #006570; border: 2px solid #e6b000;"></div>
                    <div style="height: 2px; background-color: #e6b000; width: 45%;"></div>
                </div>
            </div>

            <div class="Div1-1">
