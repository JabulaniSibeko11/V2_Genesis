    document.head.appendChild(style);

    // Extent decimal/comma handling
    function allowDecimalInput(event) {
        const char = String.fromCharCode(event.which ? event.which : event.keyCode);
        const input = event.target;
        const value = input.value;
        if (!/[0-9.,]/.test(char) &&
            event.keyCode !== 8 && event.keyCode !== 46 &&
            (event.keyCode < 37 || event.keyCode > 40)) {
            event.preventDefault();
            return;
        }
        if ((char === '.' || char === ',') && (value.includes('.') || value.includes(','))) {
            event.preventDefault();
            return;
        }
    }

    function formatExtentInput(input) {
        let value = input.value.replace(/,/g, '.');
        input.value = value;
    }

    // Market Value formatting
    function formatMarketValueInput(input) {
        let value = input.value.replace(/^R\s*/, '');
        let rawValue = value.replace(/[\s,]/g, '');
        if (rawValue) {
            let num = parseInt(rawValue);
            let formatted = 'R ' + num.toLocaleString('en-ZA');
            input.value = formatted;
        } else {
            input.value = '';
        }
    }

    // Format original values (ALL SECTIONS)
    function formatOriginalValues() {
        const marketValueIds = ['Market_Value', 'Market_Value1', 'Market_Value2', 'Market_Value3'];
        marketValueIds.forEach(id => {
            const originalMarketValue = document.getElementById(id);
            if (originalMarketValue && originalMarketValue.value) {
                let rawValue = originalMarketValue.value.replace(/[^\d]/g, '');
                if (rawValue) {
                    let formatted = 'R ' + parseInt(rawValue).toLocaleString('en-ZA');
                    originalMarketValue.value = formatted;
                }
            }
        });
        const extentIds = ['extent', 'extent1', 'extent2', 'extent3'];
        extentIds.forEach(id => {
            const originalExtent = document.getElementById(id);
            if (originalExtent && originalExtent.value) {
                let value = originalExtent.value.replace(/,/g, '.');
                if (value.includes('.')) {
                    originalExtent.value = parseFloat(value).toFixed(2);
                }
            }
        });
    }

    function normalizeValue(value) {
        if (!value) return '';
        return value.toString().replace(/\s+/g, '').trim().toLowerCase();
    }

    function normalizeCategory(category) {
        if (!category || category === '' || category === 'Select') return '';
        const normalized = category.toString().trim().toLowerCase();
        const categoryMap = {
            'residential': 'residential property',
            'business': 'business and commercial',
            'commercial': 'business and commercial',
            'multiple purposes': 'multipurpose*',
            'multipurpose': 'multipurpose*',
            'vacant land ': 'vacant land'
        };
        return categoryMap[normalized] || normalized;
    }

    function toggleErrorMessage(inputElement, shouldShow, message) {
        const errorId = inputElement.id + '_error';
        let errorElement = document.getElementById(errorId);
        if (shouldShow) {
            inputElement.style.border = '2px solid red';
            inputElement.style.backgroundColor = '#ffebee';
            if (!errorElement) {
                errorElement = document.createElement('span');
                errorElement.id = errorId;
                errorElement.style.color = 'red';
                errorElement.style.fontSize = '12px';
                errorElement.style.display = 'block';
                errorElement.style.marginTop = '5px';
                errorElement.style.fontFamily = "'Segoe UI', sans-serif";
                errorElement.textContent = message;
                inputElement.parentNode.insertBefore(errorElement, inputElement.nextSibling);
            } else {
                errorElement.textContent = message;
                errorElement.style.display = 'block';
            }
        } else {
            inputElement.style.border = '';
            inputElement.style.backgroundColor = '';
            if (errorElement) {
                errorElement.style.display = 'none';
            }
        }
    }

    function handleFieldError(inputElement, isCategory = false) {
        toggleErrorMessage(inputElement, true, 'The value is the same as the original value');
        setTimeout(function() {
            if (isCategory) {
                inputElement.selectedIndex = 0;
            } else {
                inputElement.value = '';
            }
            toggleErrorMessage(inputElement, false, '');
            if (isCategory) {
                inputElement.dispatchEvent(new Event('change'));
            } else {
                inputElement.dispatchEvent(new Event('input'));
            }
        }, 5000);
    }

    function validateField(newInputId, oldInputId, isCategory = false, isExtent = false) {
        const newInput = document.getElementById(newInputId);
        const oldInput = document.getElementById(oldInputId);
        if (!newInput || !oldInput) return true;
        const newValue = newInput.value;
        const oldValue = oldInput.value;
        if (newValue.trim() === '' || newValue === '--Select Category--') {
            toggleErrorMessage(newInput, false, '');
            return true;
        }
        let isMatch = false;
        if (isCategory) {
            const normalizedNew = normalizeCategory(newValue);
            const normalizedOld = normalizeCategory(oldValue);
            isMatch = normalizedNew === normalizedOld;
        } else if (isExtent) {
            const normalizedNew = normalizeValue(newValue.replace(',', '.'));
            const normalizedOld = normalizeValue(oldValue.replace(',', '.'));
            isMatch = normalizedNew === normalizedOld;
        } else {
            isMatch = normalizeValue(newValue) === normalizeValue(oldValue);
        }
        if (isMatch) {
            handleFieldError(newInput, isCategory);
            return false;
        } else {
            toggleErrorMessage(newInput, false, '');
            return true;
        }
    }

    function validateMarketValue(value) {
        let rawValue = value.replace(/^R\s*/, '').replace(/[^\d]/g, '');
        let numValue = parseInt(rawValue);
        if (!rawValue || rawValue === '' || isNaN(numValue)) {
            return { valid: true };
        }
        if (numValue < 0) {
            return { valid: false, message: 'Negative value not allowed' };
        } else if (numValue > 9999999999) {
            return { valid: false, message: 'Exceeds 1B ZAR' };
        }
        return { valid: true };
    }

    function setupField(newId, oldId, isCategory, isExtent) {
        const newInput = document.getElementById(newId);
        if (!newInput) return;
        if (isCategory) {
            newInput.addEventListener('change', function() {
                validateField(newId, oldId, isCategory, isExtent);
            });
        } else if (isExtent) {
            newInput.addEventListener('keypress', allowDecimalInput);
            newInput.addEventListener('input', function() {
                formatExtentInput(this);
                validateField(newId, oldId, isCategory, isExtent);
            });
            newInput.addEventListener('blur', function() {
                formatExtentInput(this);
                validateField(newId, oldId, isCategory, isExtent);
            });
        } else {
            newInput.addEventListener('input', function() {
                validateField(newId, oldId, isCategory, isExtent);
            });
            newInput.addEventListener('blur', function() {
                validateField(newId, oldId, isCategory, isExtent);
            });
        }
    }

    function setupMarketValueField(newId, oldId) {
        const newInput = document.getElementById(newId);
        if (!newInput) return;
        newInput.addEventListener('input', function() {
            formatMarketValueInput(this);
            const validation = validateMarketValue(this.value);
            if (!validation.valid) {
                toggleErrorMessage(this, true, validation.message);
            } else {
                toggleErrorMessage(this, false, '');
            }
            validateField(newId, oldId, false, false);
        });
        newInput.addEventListener('blur', function() {
            formatMarketValueInput(this);
            const validation = validateMarketValue(this.value);
            if (!validation.valid) {
                toggleErrorMessage(this, true, validation.message);
            } else {
                toggleErrorMessage(this, false, '');
            }
            validateField(newId, oldId, false, false);
        });
    }

    document.addEventListener('DOMContentLoaded', function() {
        formatOriginalValues();
        // SECTION 1
        setupField('NewPropDesc', 'desc', false, false);
        setupField('NewCat', 'cat', true, false);
        setupField('NewAddress', 'add', false, false);
        setupField('NewExtent', 'extent', false, true);
        setupMarketValueField('NewMarketValue', 'Market_Value');
        setupField('NewOwner', 'owner', false, false);
        // SECTION 2
        setupField('NewCat1', 'cat1', true, false);
        setupField('NewExtent1', 'extent1', false, true);
        setupMarketValueField('NewMarketValue1', 'Market_Value1');
        // SECTION 3
        setupField('NewCat2', 'cat2', true, false);
        setupField('NewExtent2', 'extent2', false, true);
        setupMarketValueField('NewMarketValue2', 'Market_Value2');
        // SECTION 4
        setupField('NewCat3', 'cat3', true, false);
        setupField('NewExtent3', 'extent3', false, true);
        setupMarketValueField('NewMarketValue3', 'Market_Value3');
        const nextButton = document.querySelector('.btn_n6');
        if (nextButton) {
            nextButton.addEventListener('click', function(e) {
                if (!validateAllFields()) {
                    e.preventDefault();
                    e.stopPropagation();
                    alert('Please ensure all changed values are different from the original values.');
                    return false;
                }
            });
        }
    });

    function validateAllFields() {
        let isValid = true;
        const allFields = ['NewPropDesc', 'NewCat', 'NewAddress', 'NewExtent', 'NewMarketValue', 'NewOwner',
                          'NewCat1', 'NewExtent1', 'NewMarketValue1',
                          'NewCat2', 'NewExtent2', 'NewMarketValue2',
                          'NewCat3', 'NewExtent3', 'NewMarketValue3'];
        allFields.forEach(fieldId => {
            const field = document.getElementById(fieldId);
            if (field) toggleErrorMessage(field, false, '');
        });
        isValid = validateField('NewPropDesc', 'desc') && isValid;
        isValid = validateField('NewCat', 'cat', true, false) && isValid;
        isValid = validateField('NewAddress', 'add') && isValid;
        isValid = validateField('NewExtent', 'extent', false, true) && isValid;
        isValid = validateField('NewMarketValue', 'Market_Value') && isValid;
        isValid = validateField('NewOwner', 'owner') && isValid;
        isValid = validateField('NewCat1', 'cat1', true, false) && isValid;
        isValid = validateField('NewExtent1', 'extent1', false, true) && isValid;
        isValid = validateField('NewMarketValue1', 'Market_Value1') && isValid;
        isValid = validateField('NewCat2', 'cat2', true, false) && isValid;
        isValid = validateField('NewExtent2', 'extent2', false, true) && isValid;
        isValid = validateField('NewMarketValue2', 'Market_Value2') && isValid;
        isValid = validateField('NewCat3', 'cat3', true, false) && isValid;
        isValid = validateField('NewExtent3', 'extent3', false, true) && isValid;
        isValid = validateField('NewMarketValue3', 'Market_Value3') && isValid;
        return isValid;
    }

    function onlyNumberKey(event) {
        const char = String.fromCharCode(event.which ? event.which : event.keyCode);
        return /[0-9]/.test(char) || event.keyCode === 8 || event.keyCode === 46 || (event.keyCode >= 37 && event.keyCode <= 40);
    }

