        }

    .form-icon {
        display: inline-block;
        margin-right: 12px;
        font-size: 26px;
        vertical-align: middle;
    }

    .declaration-text {
        font-family: 'Poppins', sans-serif;
        margin-bottom: 20px;
        line-height: 1.8;
    }
    #myForm, #myForm input, #myForm select, #myForm textarea, #myForm button {
        font-family: 'Poppins', sans-serif;
    }
</style>

<div class="obj-hero">
    <div class="obj-hero-inner">
        <div class="obj-hero-left">
            <div class="obj-hero-logo">
                <img src="~/images/joburg_logo.png" alt="City of Johannesburg" />
            </div>
            <div class="obj-hero-text">
                <div class="obj-hero-org">City of Johannesburg · Valuation Services</div>
                @if (_isAppeal)
                {
                    <h1 class="obj-hero-title">
                        Lodging of an <span>Appeal</span>
                    </h1>
                    <div class="obj-hero-sub">Appeal against a matter reflected in the Supplementary Valuation Roll</div>
                }
                else
                {
                    <h1 class="obj-hero-title">
                        Lodging of an <span>Objection</span>
                    </h1>
                    <div class="obj-hero-sub">Objection against a matter reflected in the Valuation Roll / Supplementary Valuation Roll</div>
                }
            </div>
        </div>
        <div class="obj-hero-right">
            <div class="obj-hero-type-badge">
                <i class="fa-solid @(_isAppeal ? "fa-gavel" : "fa-file-pen")"></i>
                @(_isAppeal ? "Appeal Form" : "Objection Form")
            </div>
            @if (!string.IsNullOrWhiteSpace(_propDesc))
            {
                <div class="obj-hero-prop">
                    <strong>Property:</strong> @_propDesc
                </div>
            }
        </div>
    </div>

  
    <div class="obj-form-head">
        <span class="obj-form-head-label">Form Type</span>
        <span class="obj-form-head-title" id="form_head">
            FORM A: RESIDENTIAL (FULL TITLE AND SECTIONAL TITLE USED FOR RESIDENTIAL PURPOSES)
        </span>
    </div>
</div>
 <div class="form-header-container">
    <h4 id="form_head">
        <span class="form-icon">📋</span>
        FORM A: RESIDENTIAL (FULL TITLE AND SECTIONAL TITLE USED FOR RESIDENTIAL PURPOSES)
    </h4>
</div>
<form id="myForm" method="post" enctype="multipart/form-data" asp-controller="Sup3" asp-route-PropertyFrom="@sourceTable" asp-route-PropertyUnique="@ViewBag.Id" asp-action="ViewMultiPurposeForm" style="margin-left: 0px">
   
    <input type="hidden" id="userEmail" value="@ViewData["UserEmail"]" />
    <input type="hidden" id="isAdminFlag" value="@(_isAdmin ? "true" : "false")" />
    <div style="display:flex;justify-content: center;">
        <div style="margin-top: 12px; border-radius: 12px; border: 3px solid #e6b000; padding: 20px; width: 1050px; background-color: #ffffff; box-shadow: 0 10px 40px rgba(0, 101, 112, 0.15);">

            <div style="text-align: center; margin-bottom: 25px; border-bottom: 3px solid #e6b000; padding-bottom: 20px; background-color: #006570; border-radius: 10px; padding: 30px; margin-bottom: 30px;">
                <h1 style="color: #ffffff; font-size: 22px; font-weight: 700; margin: 0 0 15px 0; line-height: 1.4; font-family: 'Poppins', sans-serif; text-transform: uppercase; letter-spacing: 1px;">
                    LODGING OF AN OBJECTION AGAINST A MATTER REFLECTED IN OR OMITTED FROM THE
                    <span style="color: #e6b000;">VALUATION ROLL/ SUPPLEMENTARY VALUATION ROLL</span>
                </h1>
                <h2 style="color: #e6b000; font-size: 16px; font-weight: 600; margin: 0; font-family: 'Poppins', sans-serif;">
                    FOR THE PERIOD 1 JULY 2023 TO 30 JUNE 2027
                </h2>
            </div>

            <div style="text-align: center; background-color: #fff3cd; border: 2px solid #e6b000; border-radius: 10px; padding: 20px 15px; margin-bottom: 25px; font-family: 'Poppins', sans-serif;">
                <h3 style="color: #006570; font-size: 18px; font-weight: 700; margin: 0 0 8px 0; text-transform: uppercase; font-family: 'Poppins', sans-serif; letter-spacing: 0.5px;">
                    DESCRIPTION OF PROPERTY IN RESPECT OF WHICH THE OBJECTION IS MADE
                </h3>
                <p style="color: #006570; font-size: 14px; font-weight: 600; margin: 0; letter-spacing: 0.5px; font-family: 'Poppins', sans-serif;">
                    (COMPLETE A SEPARATE FORM FOR EACH ENTRY OBJECTED TO)
                </p>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                <div style="height: 2px; background-color: #e6b000; width: 45%;"></div>
                <div style="height: 8px; width: 8px; border-radius: 50%; background-color: #006570; border: 2px solid #e6b000;"></div>
                <div style="height: 2px; background-color: #e6b000; width: 45%;"></div>
            </div>
        </div>
    </div>

    <div style="display:flex;justify-content: center;">
        <div style="margin-top: 12px; border-radius: 12px; border: 3px solid #e6b000; padding: 25px; width: 1050px; background-color: #ffffff; box-shadow: 0 10px 40px rgba(0, 101, 112, 0.15);">

            <span style="display: inline-block;">
                @{
                    TempData.Keep("CurrentFilter_PD");
                    if (TempData["AppealStatus"].ToString() == "True")
                    {
                        <div style="display: flex; align-items: center; flex-wrap: wrap; background-color: #f8f9fa; padding: 15px; border-radius: 8px; border: 2px solid #e6b000;">
                            <span style="font-weight: 700; font-size: 16px; color: #006570; margin-right: 10px; font-family: 'Poppins', sans-serif; text-transform: uppercase; letter-spacing: 0.5px;">Property Description:</span>
                            <span style="font-size: 15px; color: #333; background-color: #ffffff; padding: 10px 15px; border-radius: 5px; border: 1px solid #e6b000; font-weight: 500;">@messageProp</span>
                            <input value="@messageProp" type="hidden" name="Property_Desc" id="Property_Desc" asp-for="Property_Desc" />
                        </div>
                    }
                    else
                    {
                        <div style="display: flex; align-items: center; flex-wrap: wrap; background-color: #f8f9fa; padding: 15px; border-radius: 8px; border: 2px solid #e6b000;">
                            <span style="font-weight: 700; font-size: 16px; color: #006570; margin-right: 10px; font-family: 'Poppins', sans-serif; text-transform: uppercase; letter-spacing: 0.5px;">Property Description:</span>
                            <span style="font-size: 15px; color: #333; background-color: #ffffff; padding: 10px 15px; border-radius: 5px; border: 1px solid #e6b000; font-weight: 500;">@messagePD</span>
                            <input value="@messagePD" type="hidden" name="Property_Desc" id="Property_Desc" asp-for="Property_Desc" />
                        </div>
                    }
                    TempData.Keep("AppealStatus");
                }
            </span>
        </div>
    </div>
    @{
        TempData.Keep("CurrentFilter_PD");
    }
    @*-----------------------------------------------------------------SECTION 1 -----------------------------------------------------------*@

    <input type="text" hidden onpaste="return false;" ondrop="return false;" class="form-control border-2 rounded shadow-sm px-4 py-2" id="Objector_Type" asp-for="Objector_Type" />
    <input type="text" hidden onpaste="return false;" ondrop="return false;" class="form-control border-2 rounded shadow-sm px-4 py-2" id="Property_Type" asp-for="Property_Type" />
    <input type="text" hidden onpaste="return false;" ondrop="return false;" class="form-control border-2 rounded shadow-sm px-4 py-2" id="Premise_id" value="@messagePID" asp-for="Premise_id" />
    <input type="text" hidden onpaste="return false;" ondrop="return false;" class="form-control border-2 rounded shadow-sm px-4 py-2" id="Unit_key" value="@messageUK" asp-for="Unit_key" />
    <input type="text" hidden onpaste="return false;" ondrop="return false;" class="form-control border-2 rounded shadow-sm px-4 py-2" id="Property_id" value="@messagePI" asp-for="Property_id" />
    <input type="text" hidden onpaste="return false;" ondrop="return false;" class="form-control border-2 rounded shadow-sm px-4 py-2" id="Valuation_Key" value="@messageVK" asp-for="Valuation_Key" />
    <input type="text" hidden onpaste="return false;" ondrop="return false;" class="form-control border-2 rounded shadow-sm px-4 py-2" id="Sector_Type" value="@messageS" asp-for="Sector" />
    <input type="text" hidden onpaste="return false;" ondrop="return false;" class="form-control border-2 rounded shadow-sm px-4 py-2" id="AppealStat" name="AppealStat" value="">
    <input type="text" hidden onpaste="return false;" ondrop="return false;" class="form-control border-2 rounded shadow-sm px-4 py-2" id="obj_appeal" name="obj_appeal" value="@obj_Appeal">

    <div id="section1" style="display:flex;justify-content: center;">

