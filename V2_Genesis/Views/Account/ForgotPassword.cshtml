@model V2_Genesis.Models.ViewModels.Account.ForgotPasswordViewModel
@{ ViewData["Title"] = "Forgot Password"; }

<link href="~/account/forgotpassword.css" rel="stylesheet" />

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-icon"><i class="fa-solid fa-key"></i></div>
    <h1 class="auth-title">Reset Your Password</h1>
    <p class="auth-desc">Enter the email address linked to your portal account and we will send you a password reset link.</p>

    @if (TempData["ForgotSuccess"] != null)
    {
      <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i>
        If an account with that email exists and is confirmed, a reset link has been sent. Please check your inbox.
      </div>
    }
    else
    {
      <form asp-action="ForgotPassword" asp-controller="Account" method="post" novalidate>
        @Html.AntiForgeryToken()
        @if (!ViewData.ModelState.IsValid)
        {
          <div class="val-summary"><i class="fa-solid fa-circle-exclamation"></i> @Html.ValidationSummary(false)</div>
        }
        <div class="f-group">
          <label class="f-label" asp-for="Email">Email Address <em>*</em></label>
          <div class="f-wrap">
            <i class="fa-solid fa-envelope f-icon"></i>
            <input asp-for="Email" class="f-input" type="email" placeholder="yourname@email.com" autocomplete="email" autofocus />
          </div>
          <span asp-validation-for="Email" class="f-err"></span>
        </div>
        <button type="submit" class="auth-submit"><i class="fa-solid fa-paper-plane"></i> Send Reset Link</button>
      </form>
    }

    <p class="auth-back">Remembered it? <a href="/login">Back to sign in</a></p>
  </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
