@model V2_Genesis.Models.ViewModels.Account.ResetPasswordViewModel
@{ ViewData["Title"] = "Reset Password"; }

<link href="~/account/resetpassword.css" rel="stylesheet" />
<div class="auth-page">
  <div class="auth-card">
    <div class="auth-icon"><i class="fa-solid fa-lock-open"></i></div>
    <h1 class="auth-title">Set New Password</h1>
    <p class="auth-desc">Choose a strong new password for your City of Johannesburg Valuation Portal account. Minimum 6 characters.</p>

    @if (!ViewData.ModelState.IsValid)
    {
      <div class="val-summary"><i class="fa-solid fa-circle-exclamation"></i> @Html.ValidationSummary(false)</div>
    }

    <form asp-action="ResetPassword" asp-controller="Account" method="post" novalidate>
      @Html.AntiForgeryToken()
      <input type="hidden" asp-for="UserId" />
      <input type="hidden" asp-for="Code" />
      <input type="hidden" asp-for="Email" />

      <div class="f-group">
        <label class="f-label" asp-for="Password">New Password <em>*</em></label>
        <div class="f-wrap">
          <i class="fa-solid fa-lock f-icon"></i>
          <input asp-for="Password" id="rPw" class="f-input" type="password"
                 placeholder="Minimum 6 characters" autocomplete="new-password"
                 oninput="checkPwStrength(this,'rPwBars','rPwLabel')" style="padding-right:2.6rem" />
          <button type="button" class="f-eye" onclick="togglePw('rPw',this)"><i class="fa-solid fa-eye"></i></button>
        </div>
        <div class="pw-bars" id="rPwBars"><div class="pw-bar"></div><div class="pw-bar"></div><div class="pw-bar"></div><div class="pw-bar"></div></div>
        <div class="f-hint" id="rPwLabel">Minimum 6 characters</div>
        <span asp-validation-for="Password" class="f-err"></span>
      </div>

      <div class="f-group">
        <label class="f-label" asp-for="ConfirmPassword">Confirm Password <em>*</em></label>
        <div class="f-wrap">
          <i class="fa-solid fa-lock f-icon"></i>
          <input asp-for="ConfirmPassword" id="rCPw" class="f-input" type="password"
                 placeholder="Re-enter new password" autocomplete="new-password" style="padding-right:2.6rem" />
          <button type="button" class="f-eye" onclick="togglePw('rCPw',this)"><i class="fa-solid fa-eye"></i></button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="f-err"></span>
      </div>

      <button type="submit" class="auth-submit"><i class="fa-solid fa-check"></i> Update Password</button>
    </form>
    <p class="auth-back"><a href="/login">Back to sign in</a></p>
  </div>
</div>

@section Scripts {
  @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
  <script>
    function checkPwStrength(inp,barsId,labelId){const v=inp.value,lbl=document.getElementById(labelId),bars=document.getElementById(barsId);if(!bars)return;const bs=bars.querySelectorAll('.pw-bar');let s=0;if(v.length>=6)s++;if(v.length>=10)s++;if(/[A-Z]/.test(v)&&/[a-z]/.test(v))s++;if(/\d/.test(v)&&/[^A-Za-z0-9]/.test(v))s++;const cls=['','weak','fair','good','strong'];const hints=['Minimum 6 characters','Weak','Fair','Good','Strong ✓'];bs.forEach((b,i)=>b.className='pw-bar'+(i<s?' '+cls[s]:''));if(lbl){lbl.textContent=hints[s]||hints[0];lbl.style.color=s>=3?'#166534':'#9b9188';}}
    function togglePw(id,btn){const inp=document.getElementById(id),ico=btn.querySelector('i');inp.type=inp.type==='password'?'text':'password';ico.className=inp.type==='password'?'fa-solid fa-eye':'fa-solid fa-eye-slash';}
  </script>
}
