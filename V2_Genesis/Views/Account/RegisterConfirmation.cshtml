@{ ViewData["Title"] = "Registration Successful"; }


<link href="~/account/registerconfirmationcss.css" rel="stylesheet" />
<div class="auth-page">
  <div class="auth-card">
    <div class="confirm-icon"><i class="fa-solid fa-envelope-circle-check"></i></div>
    <h1 class="auth-title">Almost There!</h1>
    <p class="auth-desc">
      Your City of Johannesburg Valuation Portal account has been created. We have sent a confirmation email to your registered email address.
      Please follow the steps below to activate your account.
    </p>
    <div class="steps">
      <div class="step">
        <div class="step-num">1</div>
        <div class="step-text"><strong>Check your inbox</strong><span>Look for an email from City of Johannesburg</span></div>
      </div>
      <div class="step">
        <div class="step-num">2</div>
        <div class="step-text"><strong>Click "Confirm Email Address"</strong><span>This activates your account</span></div>
      </div>
      <div class="step">
        <div class="step-num">3</div>
        <div class="step-text"><strong>Sign in to Portal</strong><span>Start managing your property information</span></div>
      </div>
    </div>
    <a href="/login" class="auth-btn"><i class="fa-solid fa-right-to-bracket"></i> Go to Sign In</a>
  </div>
</div>
