@model V2_Genesis.Models.ViewModels.Account.SapStepViewModel
@{
    ViewData["Title"] = "Verify Identity";
}

<link href="~/account/sapstepcss.css" rel="stylesheet" />

<div class="auth-page">
  <div class="auth-card">
    <div class="auth-icon"><i class="fa-solid fa-id-badge"></i></div>
    <h1 class="auth-title">Identity Verification</h1>
    <p class="auth-desc">
      Your email and password have been verified. Please enter your SAP number to complete
      sign-in and confirm your access rights in the City of Johannesburg system.
    </p>
    <div class="sap-info">
      <i class="fa-solid fa-circle-info"></i>
      <span>Your SAP number is your employee number assigned by the City of Johannesburg (e.g. <strong>30092655</strong>).</span>
    </div>
    @if (!ViewData.ModelState.IsValid)
    {
      <div class="val-summary"><i class="fa-solid fa-circle-exclamation"></i> @Html.ValidationSummary(false)</div>
    }
    <form asp-action="SapStep" asp-controller="Account" method="post" novalidate>
      @Html.AntiForgeryToken()
      <div class="f-group">
        <label class="f-label" asp-for="SapNumber">SAP Number <em>*</em></label>
        <div class="f-wrap">
          <i class="fa-solid fa-hashtag f-icon"></i>
          <input asp-for="SapNumber" class="f-input" placeholder="e.g. 30092655"
                 inputmode="numeric" autocomplete="off" autofocus />
        </div>
        <span asp-validation-for="SapNumber" class="f-err"></span>
      </div>
      <button type="submit" class="auth-submit">
        <i class="fa-solid fa-shield-check"></i> Verify &amp; Sign In
      </button>
    </form>
    <p class="auth-back">Wrong account? <a href="/login">Back to sign in</a></p>
  </div>
</div>

@section Scripts { @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); } }
