@model V2_Genesis.Models.PropertySearchParams
@{
    var roll     = ViewBag.Roll as V2_Genesis.Models.GvList;
    var townships = ViewBag.Townships as List<string> ?? new();
    var schemes   = ViewBag.Schemes   as List<string> ?? new();
    ViewData["Title"] = $"Property Search – {roll?.Short}";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}

@section Styles {
    <link href="~/css/views/clientdashboardcss.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/property-search.css"    rel="stylesheet" asp-append-version="true" />
   @*  <link href="~/css/views/searchpropertycss.css"  rel="stylesheet" asp-append-version="true" /> *@
}



<div class="srch-page">

    <div class="srch-hero">
        <div class="srch-hero-inner">
            <div class="srch-hero-logo">
                <img src="~/images/joburg_logo.png" alt="City of Johannesburg" />
            </div>
            <div class="srch-hero-text">
                <div class="srch-hero-org">City of Johannesburg · Valuation Services</div>
                <h1 class="srch-hero-title">
                    Property Search — <span>@(roll?.Name ?? "Valuation Roll")</span>
                </h1>
                <p class="srch-hero-sub">
                    Search the @(roll?.Short ?? "") to find and link a property before lodging an objection or appeal.
                </p>
            </div>
            <div class="srch-hero-right">
                <div class="srch-roll-badge">
                    <i class="fa-solid fa-landmark"></i>
                    @(roll?.Short ?? "GV23")
                </div>
                <a href="/dashboard" class="srch-back-btn">
                    <i class="fa-solid fa-arrow-left"></i> Dashboard
                </a>
            </div>
        </div>
    </div>

  
    <div class="srch-body">

       
        <div class="srch-left">

            <div class="srch-left-heading">
                <h2>
                    <i class="fa-solid fa-magnifying-glass" style="color:#e6b000;margin-right:8px;font-size:16px;"></i>
                    Search Criteria
                </h2>
                <p>Select a township and fill in at least one field below.</p>
            </div>

            <form id="searchForm">
                @Html.AntiForgeryToken()

        
                <div class="srch-field">
                    <label class="srch-label">
                        <i class="fa-solid fa-map-pin"></i>
                        Township <span class="req">*</span>
                    </label>
                    <select name="TownName" id="TownName" class="srch-select" required>
                        <option value="">Select Township…</option>
                        @foreach (var t in townships)
                        {
                            <option value="@t">@t</option>
                        }
                    </select>
                    <span class="srch-val-msg" id="townErr"></span>
                </div>

                <div class="srch-divider">
                    <div class="srch-divider-line"></div>
                    <div class="srch-divider-dot"></div>
                    <div class="srch-divider-line"></div>
                </div>

           
                <div class="srch-field">
                    <label class="srch-label">
                        <i class="fa-solid fa-road"></i> Address
                    </label>
                    <input type="text" name="Address" id="Address"
                           class="srch-input" minlength="3"
                           placeholder="e.g. 17 Commissioner Street" />
                </div>

          
                <div class="srch-field">
                    <label class="srch-label">
                        <i class="fa-solid fa-hashtag"></i> Stand Number
                    </label>
                    <input type="text" name="Stand" id="Stand"
                           class="srch-input"
                           placeholder="e.g. 1234" />
                </div>

                
                <div class="srch-field">
                    <label class="srch-label">
                        <i class="fa-solid fa-building"></i> Scheme Name
                    </label>
                    <select name="Scheme" id="Scheme" class="srch-select">
                        <option value="">Select Scheme…</option>
                        @foreach (var s in schemes)
                        {
                            <option value="@s">@s</option>
                        }
                    </select>
                </div>

               
                <div class="srch-field">
                    <label class="srch-label">
                        <i class="fa-solid fa-door-open"></i> Unit Number
                    </label>
                    <input type="text" name="Unit" id="Unit"
                           class="srch-input"
                           placeholder="e.g. 5" />
                </div>

                <button type="submit" class="srch-submit" id="searchBtn">
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Search Property
                </button>
            </form>
        </div>

      
        <div class="srch-right">

            <div class="srch-right-heading">
                <h2>How to Search</h2>
                <p>
                    Use the form on the left to locate your property in the
                    @(roll?.Name ?? "Valuation Roll"). Once found, select it to link it to your account.
                </p>
            </div>

            <div class="srch-steps">
                <div class="srch-step">
                    <div class="srch-step-num">1</div>
                    <div class="srch-step-body">
                        <div class="srch-step-title">Select a Township</div>
                        <p class="srch-step-desc">
                            Start by choosing the township your property falls under.
                            This field is required.
                        </p>
                    </div>
                </div>
                <div class="srch-step">
                    <div class="srch-step-num">2</div>
                    <div class="srch-step-body">
                        <div class="srch-step-title">Fill in at least one field</div>
                        <p class="srch-step-desc">
                            Provide one or more of:
                            <ul>
                                <li>Street address</li>
                                <li>Stand number</li>
                                <li>Scheme name + Unit number</li>
                            </ul>
                        </p>
                    </div>
                </div>
                <div class="srch-step">
                    <div class="srch-step-num">3</div>
                    <div class="srch-step-body">
                        <div class="srch-step-title">Click Search &amp; Select</div>
                        <p class="srch-step-desc">
                            Results appear in a panel above. Click <strong>Select</strong>
                            on the matching property to link it to your account.
                        </p>
                    </div>
                </div>
            </div>

            <div class="srch-tip">
                <i class="fa-solid fa-triangle-exclamation srch-tip-icon"></i>
                <div>
                    <strong>Property not found?</strong> If no results appear, try
                    broadening your search — remove one filter, check spelling, or
                    use the LIS (Land Information System) search for the latest
                    property data including recently subdivided or consolidated erfs.
                </div>
            </div>

            <div class="srch-note">
                <i class="fa-solid fa-info-circle" style="margin-right:6px;"></i>
                Stand and Scheme/Unit searches are mutually exclusive — fill one or the other, not both.
            </div>

        </div>
    </div>
</div>


<div class="psm-backdrop" id="psmBackdrop" onclick="closeResultsModal()"></div>
<div class="psm-modal" id="psmModal">
    <div class="psm-header" id="psmHeader">
        <div class="psm-header-left">
            <i class="fa-solid fa-list-check"></i>
            <span id="psmTitle">Search Results</span>
            <span class="ps-results-count" id="psmCount"></span>
        </div>
        <button class="psm-close" onclick="closeResultsModal()">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <div class="psm-body" id="psmBody"></div>
</div>

<div class="ps-preloader" id="psPreloader">
    <div class="ps-spinner"></div>
    <span>Searching the valuation roll…</span>
</div>

@section Scripts {
    <script>
        const stand  = document.getElementById('Stand');
        const scheme = document.getElementById('Scheme');
        const unit   = document.getElementById('Unit');

        function updateFieldStates() {
            if (stand.value.trim() !== '') {
                scheme.disabled = true;
                unit.disabled   = true;
                scheme.value    = '';
                unit.value      = '';
            } else {
                scheme.disabled = false;
                unit.disabled   = scheme.value === '';
                if (scheme.value.trim() !== '') {
                    stand.disabled = true;
                    stand.value    = '';
                } else {
                    stand.disabled = false;
                }
            }
        }
        stand.addEventListener('input',   updateFieldStates);
        scheme.addEventListener('change', updateFieldStates);
        updateFieldStates();

        function openResultsModal() {
            document.getElementById('psmBackdrop').classList.add('show');
            document.getElementById('psmModal').classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeResultsModal() {
            document.getElementById('psmBackdrop').classList.remove('show');
            document.getElementById('psmModal').classList.remove('show');
            document.body.style.overflow = '';
            if ($.fn.DataTable.isDataTable('#psResultsTable'))
                $('#psResultsTable').DataTable().destroy();
        }

        document.getElementById('searchForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const town = document.getElementById('TownName');
            if (!town.value) {
                document.getElementById('townErr').textContent = 'Please select a Township.';
                town.focus();
                return;
            }
            document.getElementById('townErr').textContent = '';
            closeResultsModal();

            document.getElementById('psPreloader').classList.add('show');

            const data  = new FormData(this);
            const token = this.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch('/search/@roll?.Source', {
                method : 'POST',
                headers: { 'RequestVerificationToken': token },
                body   : data
            });

            document.getElementById('psPreloader').classList.remove('show');

            document.getElementById('psmBody').innerHTML = await response.text();
            document.getElementById('psmTitle').textContent =
                'Results – @(roll?.Short ?? "Search")';

            document.querySelectorAll('#psmBody script').forEach(s => {
                const sc = document.createElement('script');
                sc.textContent = s.textContent;
                document.body.appendChild(sc);
            });

            openResultsModal();
        });

        document.addEventListener('keydown', e => {
            if (e.key === 'Escape') closeResultsModal();
        });
    </script>
}
