@model V2_Genesis.Models.PropertySearchParams
@{
    var roll = ViewBag.Roll as V2_Genesis.Models.GvList;
    var townships = ViewBag.Townships as List<string> ?? new();
    var schemes = ViewBag.Schemes as List<string> ?? new();
    ViewData["Title"] = $"Property Search – {roll?.Short}";
    Layout = "~/Views/Shared/_ClientLayout.cshtml";
}

@section Styles {

    <link href="~/css/views/clientdashboard.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/property-search.css" rel="stylesheet" asp-append-version="true" />
    <link href="~/css/views/searchpropertycss.css" rel="stylesheet" asp-append-version="true" />
}

<div class="ps-page">
    <div class="ps-inner">

        <!-- Page title -->
        <div class="ps-title-bar">
            <a href="/dashboard" class="ps-back">
                <i class="fa-solid fa-arrow-left"></i> Back
            </a>
            <div class="ps-title-text">
                <h1>
                    <i class="fa-solid fa-magnifying-glass"></i>
                    Property Search
                </h1>
                <span class="ps-roll-tag">@roll?.Name</span>
            </div>
        </div>

        <!-- Two-column layout — both cards always visible -->
        <div class="ps-layout">

            <!-- ── LEFT: Search form ──────────────────────────────── -->
            <div class="ps-card ps-form-card">
                <div class="ps-card-header">
                    <i class="fa-solid fa-filter"></i> Search Criteria
                </div>
                <div class="ps-card-body">
                    <p class="ps-required-note">
                        <i class="fa-solid fa-circle-info"></i>
                        <strong>Please fill at least one field</strong> in addition to Township.
                    </p>

                    <form id="searchForm">
                        @Html.AntiForgeryToken()

                        <!-- Township -->
                        <div class="ps-field">
                            <label class="ps-label">
                                 <strong>Township <span class="ps-req">*</span></strong>
                            </label>
                            <select name="TownName" id="TownName" class="ps-select" required>
                                <option value=""> Select Township</option>
                                @foreach (var t in townships)
                                {
                                    <option value="@t">@t</option>
                                }
                            </select>
                            <span class="ps-val-msg" id="townErr"></span>
                        </div>

                        <!-- Address -->
                        <div class="ps-field">
                            <label class="ps-label"> <strong>Address:</strong></label>
                            <input type="text" name="Address" id="Address"
                                   class="ps-input" minlength="3"
                                   placeholder="Enter street address" />
                        </div>

                        <!-- Stand -->
                        <div class="ps-field">
                            <label class="ps-label"> <strong>Stand:</strong></label>
                            <input type="text" name="Stand" id="Stand"
                                   class="ps-input"
                                   placeholder="Enter stand number" />
                        </div>

                        <!-- Scheme Name -->
                        <div class="ps-field">
                            <label class="ps-label"> <strong>Scheme Name:</strong></label>
                            <select name="Scheme" id="Scheme" class="ps-select">
                                <option value="">🔽 Select Scheme</option>
                                @foreach (var s in schemes)
                                {
                                    <option value="@s">@s</option>
                                }
                            </select>
                        </div>

                        <!-- Unit No -->
                        <div class="ps-field">
                            <label class="ps-label"> <strong>Unit No:</strong></label>
                            <input type="text" name="Unit" id="Unit"
                                   class="ps-input"
                                   placeholder="Enter unit number" />
                        </div>

                        <div class="ps-btn-row">
                            <a href="/dashboard" class="ps-btn-secondary">
                                ⬅ <strong>Back</strong>
                            </a>
                            <button type="submit" class="ps-btn-primary" id="searchBtn">
                                 <strong>Search Property</strong>
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- ── RIGHT: Instructions (always visible) ───────────── -->
            <div class="ps-card ps-info-card">
                <div class="ps-card-header ps-card-header-gold">
                    📋 <strong>Search Instructions</strong>
                </div>
                <div class="ps-card-body">
                    <ol class="ps-steps">
                        <li>
                            <strong>Step 1:</strong>
                            Select a <strong>Township</strong> (Required)
                        </li>
                        <li>
                            <strong>Step 2:</strong> Fill in at least ONE field:
                            <ul>
                                <li>Address</li>
                                <li>Stand Number</li>
                                <li>Scheme Name + Unit Number</li>
                            </ul>
                        </li>
                        <li>
                            <strong>Step 3:</strong> Click "Search Property"
                        </li>
                    </ol>
                    <div class="ps-warning-box">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        <div>
                            <strong>⚠️ Property Not Found?</strong><br />
                            If no results are found, use the LIS (Land Info System)
                            search for the latest property data.
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════════
     RESULTS MODAL — shown on top of search page
══════════════════════════════════════════════════════ -->
<div class="psm-backdrop" id="psmBackdrop" onclick="closeResultsModal()"></div>
<div class="psm-modal" id="psmModal">
    <div class="psm-header" id="psmHeader">
        <div class="psm-header-left">
            <i class="fa-solid fa-list-check"></i>
            <span id="psmTitle">Search Results</span>
            <span class="ps-results-count" id="psmCount"></span>
        </div>
        <button class="psm-close" onclick="closeResultsModal()">
            <i class="fa-solid fa-xmark"></i>
        </button>
    </div>
    <div class="psm-body" id="psmBody">
        <!-- Partial view injected here -->
    </div>
</div>

<!-- Preloader overlay -->
<div class="ps-preloader" id="psPreloader">
    <div class="ps-spinner"></div>
    <span>Searching properties…</span>
</div>

@section Scripts {
    <script>
        const stand  = document.getElementById('Stand');
        const scheme = document.getElementById('Scheme');
        const unit   = document.getElementById('Unit');

        // ── Stand / Scheme mutual exclusion ───────────────────────────────
        function updateFieldStates() {
            if (stand.value.trim() !== '') {
                scheme.disabled = true;
                unit.disabled   = true;
                scheme.value    = '';
                unit.value      = '';
            } else {
                scheme.disabled = false;
                unit.disabled   = scheme.value === '';
                if (scheme.value.trim() !== '') {
                    stand.disabled = true;
                    stand.value    = '';
                } else {
                    stand.disabled = false;
                }
            }
        }
        stand.addEventListener('input',   updateFieldStates);
        scheme.addEventListener('change', updateFieldStates);
        updateFieldStates();

        // ── Open / close modal ────────────────────────────────────────────
        function openResultsModal() {
            document.getElementById('psmBackdrop').classList.add('show');
            document.getElementById('psmModal').classList.add('show');
            document.body.style.overflow = 'hidden';
        }

        function closeResultsModal() {
            document.getElementById('psmBackdrop').classList.remove('show');
            document.getElementById('psmModal').classList.remove('show');
            document.body.style.overflow = '';

            // Destroy DataTable so it can re-init cleanly next search
            if ($.fn.DataTable.isDataTable('#psResultsTable')) {
                $('#psResultsTable').DataTable().destroy();
            }
        }

        // ── AJAX submit ───────────────────────────────────────────────────
        document.getElementById('searchForm').addEventListener('submit', async function (e) {
            e.preventDefault();

            const town = document.getElementById('TownName');
            if (!town.value) {
                document.getElementById('townErr').textContent = 'Please select a Township.';
                town.focus();
                return;
            }
            document.getElementById('townErr').textContent = '';

            // Close any previous modal + destroy old DataTable
            closeResultsModal();

            document.getElementById('psPreloader').classList.add('show');

            const data  = new FormData(this);
            const token = this.querySelector('input[name="__RequestVerificationToken"]').value;

            const response = await fetch('/search/@roll?.Source', {
                method : 'POST',
                headers: { 'RequestVerificationToken': token },
                body   : data
            });

            document.getElementById('psPreloader').classList.remove('show');

            const html = await response.text();

            // Inject partial into modal body
            document.getElementById('psmBody').innerHTML = html;

            // Update modal header title
            document.getElementById('psmTitle').textContent =
                'Results – @(roll?.Short ?? "Search")';

            // Run scripts inside the partial (DataTables init)
            document.querySelectorAll('#psmBody script').forEach(s => {
                const script = document.createElement('script');
                script.textContent = s.textContent;
                document.body.appendChild(script);
            });

            openResultsModal();
        });

        // Close on Escape key
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeResultsModal();
        });
    </script>
}